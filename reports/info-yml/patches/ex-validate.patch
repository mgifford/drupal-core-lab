+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\Core\Extension;
+
+use Drupal\Core\Extension\ExtensionFileValidator;
+use Drupal\Core\Extension\ExtensionFileViolation;
+use Drupal\Tests\UnitTestCase;
+use org\bovigo\vfs\vfsStream;
+// cspell:ignore FEFF modul
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\DataProvider;
+use PHPUnit\Framework\Attributes\Group;
+
+/**
+ * Tests the extension file validator.
+ */
+#[CoversClass(ExtensionFileValidator::class)]
+#[CoversClass(ExtensionFileViolation::class)]
+#[Group('Extension')]
+class ExtensionFileValidatorTest extends UnitTestCase {
+
+  /**
+   * The validator, with a virtual Drupal root.
+   */
+  protected ExtensionFileValidator $validator;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->validator = new ExtensionFileValidator('vfs://root');
+  }
+
+  /**
+   * Returns the rule, line and severity of each violation.
+   *
+   * @param \Drupal\Core\Extension\ExtensionFileViolation[] $violations
+   *   The violations.
+   *
+   * @return array
+   *   A list of [rule, line, severity].
+   */
+  protected function summarize(array $violations): array {
+    $summary = fn (ExtensionFileViolation $violation) => [$violation->rule, $violation->line, $violation->severity];
+    return array_map($summary, $violations);
+  }
+
+  /**
+   * Tests the checks of one info file.
+   *
+   * @param string $contents
+   *   The contents of example.info.yml.
+   * @param array $expected
+   *   The expected list of [rule, line, severity].
+   * @param string|null $message
+   *   (optional) Text expected in the first violation's message.
+   */
+  #[DataProvider('providerInfoFile')]
+  public function testInfoFile(string $contents, array $expected, ?string $message = NULL): void {
+    vfsStream::setup('root', NULL, ['modules' => ['example' => ['example.info.yml' => $contents]]]);
+    $violations = $this->validator->validateInfoFile('vfs://root/modules/example/example.info.yml');
+    $this->assertSame($expected, $this->summarize($violations));
+    if ($message !== NULL) {
+      $this->assertStringContainsString($message, $violations[0]->message);
+    }
+  }
+
+  /**
+   * Data provider for testInfoFile().
+   *
+   * @return array
+   *   Test cases.
+   */
+  public static function providerInfoFile(): array {
+    $warning = ExtensionFileViolation::WARNING;
+    $valid = "name: Example\ntype: module\ncore_version_requirement: '*'\n";
+    $theme = "name: Example\ntype: theme\nbase theme: false\ncore_version_requirement: '*'\n";
+    return [
+      'valid' => self::infoCase($valid),
+      'valid with dependencies' => self::infoCase($valid . "dependencies:\n  - drupal:node\n  - drupal:user (>=11)\n"),
+      'empty description' => self::infoCase($valid . "description:\n"),
+      'unquoted colon' => self::infoCase($valid . "description: Example: one\n", 'info.yaml', 4, message: 'A colon cannot be used'),
+      'reserved indicator' => self::infoCase($valid . "description: @todo\n", 'info.yaml', 4),
+      'tab indentation' => self::infoCase($valid . "dependencies:\n\t- drupal:node\n", 'info.tab', 5),
+      'byte order mark' => self::infoCase("\u{FEFF}" . $valid, 'info.bom', 1),
+      'duplicate key' => self::infoCase($valid . "name: Again\n", 'info.yaml', 4, message: 'Duplicate key "name"'),
+      'no space after colon' => self::infoCase("name: Example\ntype:module\n", 'info.yaml', 2, message: 'Put a space after the colon'),
+      'indented key' => self::infoCase("name: Example\n type: module\n", 'info.yaml', 2, message: 'top-level keys start in the first column'),
+      'empty file' => self::infoCase('', 'info.mapping', message: 'The file is empty.'),
+      'single value' => self::infoCase("Example\n", 'info.mapping', message: 'single value'),
+      'top-level list' => self::infoCase("- name: Example\n", 'info.mapping', message: 'list'),
+      'missing type' => self::infoCase("name: Example\ncore_version_requirement: '*'\n", 'info.parser', message: 'Missing required keys (type)'),
+      'missing core_version_requirement' => self::infoCase("name: Example\ntype: module\n", 'info.parser', message: "The 'core_version_requirement' key must be present"),
+      'invalid constraint' => self::infoCase("name: Example\ntype: module\ncore_version_requirement: ^12 ||| banana\n", 'info.parser', 3),
+      'comment without a space' => self::infoCase("name: Example\ntype: module\ncore_version_requirement: ^12# Added\n", 'info.parser', 3, message: 'A # starts a comment only after a space'),
+      'incompatible constraint' => self::infoCase("name: Example\ntype: module\ncore_version_requirement: ^7\n", 'info.core_incompatible', 3, $warning),
+      'numeric version' => self::infoCase($valid . "version: 1.0\n", 'info.deprecated', NULL, $warning),
+      'unknown type' => self::infoCase("name: Example\ntype: modul\ncore_version_requirement: '*'\n", 'info.type', 2),
+      'name is a list' => self::infoCase("name: [Example]\ntype: module\ncore_version_requirement: '*'\n", 'info.value', 1),
+      'dependencies is a string' => self::infoCase($valid . "dependencies: drupal:node\n", 'info.value', 4, $warning),
+      // Line 5 is "  - drupal:node", where the folded item starts.
+      'folded dependency' => self::infoCase($valid . "dependencies:\n  - drupal:node\n   - drupal:user\n", 'info.dependency', 5, $warning, 'joined the two lines'),
+      'theme without base theme' => self::infoCase("name: Example\ntype: theme\ncore_version_requirement: '*'\n", 'info.base_theme'),
+      'theme regions is a string' => self::infoCase($theme . "regions: Header\n", 'info.value', 5),
+      'theme with empty libraries' => self::infoCase($theme . "libraries:\n"),
+    ];
+  }
+
+  /**
+   * Builds one test case for testInfoFile().
+   *
+   * @param string $contents
+   *   The contents of the info file.
+   * @param string|null $rule
+   *   (optional) The rule of the one expected violation, or NULL for none.
+   * @param int|null $line
+   *   (optional) The line of the expected violation.
+   * @param string $severity
+   *   (optional) The severity of the expected violation.
+   * @param string|null $message
+   *   (optional) Text expected in the message.
+   *
+   * @return array
+   *   The arguments for testInfoFile().
+   */
+  protected static function infoCase(string $contents, ?string $rule = NULL, ?int $line = NULL, string $severity = ExtensionFileViolation::ERROR, ?string $message = NULL): array {
+    return [$contents, $rule === NULL ? [] : [[$rule, $line, $severity]], $message];
+  }
+
+  /**
+   * Tests which files are found, following extension discovery's rules.
+   */
+  public function testFindFiles(): void {
+    vfsStream::setup('root', NULL, [
+      'modules' => [
+        'example' => [
+          'example.info.yml' => '',
+          'example.module' => '',
+          'example.info.yaml' => '',
+          'src' => ['Example.php' => '', 'fixture.info.yml' => ''],
+          'config' => ['install' => ['inside_config.info.yml' => '']],
+          'tests' => ['modules' => ['example_test' => ['example_test.info.yml' => '', 'example_test.module' => '']]],
+          '.hidden' => ['hidden.info.yml' => ''],
+          'vendor' => ['package.php' => ''],
+          'node_modules' => ['tool.php' => ''],
+        ],
+        'config' => ['config.info.yml' => ''],
+      ],
+    ]);
+    $found = $this->validator->findFiles(['vfs://root/modules']);
+    $this->assertSame([
+      'vfs://root/modules/config/config.info.yml',
+      'vfs://root/modules/example/example.info.yml',
+    ], $found['info']);
+    $this->assertSame([
+      'vfs://root/modules/example/example.module',
+      'vfs://root/modules/example/src/Example.php',
+    ], $found['php']);
+    $this->assertSame(['vfs://root/modules/example/example.info.yaml'], $found['ignored']);
+
+    $found = $this->validator->findFiles(['vfs://root/modules'], TRUE);
+    $this->assertContains('vfs://root/modules/example/tests/modules/example_test/example_test.info.yml', $found['info']);
+    $this->assertContains('vfs://root/modules/example/tests/modules/example_test/example_test.module', $found['php']);
+  }
+
+  /**
+   * Tests file names that extension discovery ignores.
+   */
+  public function testFileNames(): void {
+    vfsStream::setup('root', NULL, [
+      'modules' => [
+        'a' => ['my-module.info.yml' => "name: A\n"],
+        'b' => ['Example.info.yml' => "name: B\ntype: module\ncore_version_requirement: '*'\n"],
+        'c' => ['example.libraries.info.yml' => "name: C\n"],
+        'd' => ['example.info' => "name = D\n"],
+      ],
+    ]);
+    $violations = $this->validator->validateFound($this->validator->findFiles(['vfs://root/modules']));
+    $this->assertSame([
+      ['file.name', NULL, ExtensionFileViolation::WARNING],
+      ['file.name', NULL, ExtensionFileViolation::WARNING],
+      ['file.name', NULL, ExtensionFileViolation::WARNING],
+    ], $this->summarize($violations));
+    $files = array_map(fn ($violation) => $violation->file, $violations);
+    // Paths inside the Drupal root are reported relative to it.
+    $this->assertSame(['modules/d/example.info', 'modules/a/my-module.info.yml', 'modules/b/Example.info.yml'], $files);
+  }
+
+  /**
+   * Tests the PHP syntax check.
+   */
+  public function testPhpFile(): void {
+    vfsStream::setup('root', NULL, [
+      'valid.module' => "<?php\n\nfunction example_help() {\n  return '';\n}\n",
+      'broken.module' => "<?php\n\nfunction example_help( {\n}\n",
+      'deprecated.module' => "<?php\n\n\$a = (integer) '1';\n",
+    ]);
+    $this->assertSame([], $this->validator->validatePhpFile('vfs://root/valid.module'));
+    $this->assertSame([['php.syntax', 3, ExtensionFileViolation::ERROR]], $this->summarize($this->validator->validatePhpFile('vfs://root/broken.module')));
+    // PHP 8.5 deprecates non-canonical casts when the file is compiled.
+    if (PHP_VERSION_ID >= 80500) {
+      $this->assertSame([['php.deprecated', 3, ExtensionFileViolation::WARNING]], $this->summarize($this->validator->validatePhpFile('vfs://root/deprecated.module')));
+    }
+  }
+
+  /**
+   * Tests that a base theme must be among the checked themes or core's.
+   */
+  public function testBaseThemes(): void {
+    $theme = fn (string $base) => "name: Example\ntype: theme\nbase theme: $base\ncore_version_requirement: '*'\n";
+    vfsStream::setup('root', NULL, [
+      'core' => ['themes' => ['stark' => ['stark.info.yml' => $theme('false')]]],
+      'themes' => [
+        'one' => ['one.info.yml' => $theme('stark')],
+        'two' => ['two.info.yml' => $theme('one')],
+        'three' => ['three.info.yml' => $theme('missing')],
+      ],
+    ]);
+    $violations = $this->validator->validateFound($this->validator->findFiles(['vfs://root/themes']));
+    $this->assertSame([['info.base_theme', 3, ExtensionFileViolation::WARNING]], $this->summarize($violations));
+    $this->assertSame('themes/three/three.info.yml', $violations[0]->file);
+  }
+
+}
