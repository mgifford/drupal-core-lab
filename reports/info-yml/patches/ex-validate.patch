diff --git a/core/lib/Drupal/Core/Extension/Command/ExtensionValidateCommand.php b/core/lib/Drupal/Core/Extension/Command/ExtensionValidateCommand.php
new file mode 100644
index 00000000..aea8ab8b
--- /dev/null
+++ b/core/lib/Drupal/Core/Extension/Command/ExtensionValidateCommand.php
@@ -0,0 +1,234 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Core\Extension\Command;
+
+use Drupal\Core\Extension\ExtensionFileValidator;
+use Drupal\Core\Extension\ExtensionFileViolation;
+use Symfony\Component\Console\Command\Command;
+use Symfony\Component\Console\Input\InputArgument;
+use Symfony\Component\Console\Input\InputInterface;
+use Symfony\Component\Console\Input\InputOption;
+use Symfony\Component\Console\Output\OutputInterface;
+use Symfony\Component\Process\Process;
+
+/**
+ * Checks extension info files and PHP syntax without bootstrapping Drupal.
+ *
+ * A malformed .info.yml file breaks the whole site once caches are cleared,
+ * whether or not the extension is installed. Run this command before a
+ * deployment or in continuous integration to find such files first. It needs
+ * no installed site and no database.
+ *
+ * Exit codes: 0 when no errors are found (warnings are allowed, unless
+ * --strict is used), 1 when errors are found, 2 when the command cannot run (a
+ * path or git is missing).
+ *
+ * @see \Drupal\Core\Extension\ExtensionFileValidator
+ *
+ * @internal
+ */
+class ExtensionValidateCommand extends Command {
+
+  /**
+   * The root directory of the Drupal installation.
+   */
+  protected string $root;
+
+  /**
+   * Constructs an ExtensionValidateCommand object.
+   *
+   * @param string|null $root
+   *   (optional) The root directory of the Drupal installation.
+   */
+  public function __construct(?string $root = NULL) {
+    $this->root = $root ?? dirname(__DIR__, 6);
+    parent::__construct();
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function configure(): void {
+    $this->setName('ex:validate')
+      ->setAliases(['extension:validate'])
+      ->setDescription('Checks extension .info.yml files and PHP syntax, without an installed site.')
+      ->addArgument('paths', InputArgument::IS_ARRAY | InputArgument::OPTIONAL, 'Directories or files to check. Defaults to the modules, themes, profiles and sites directories of the Drupal root.')
+      ->addOption('format', NULL, InputOption::VALUE_REQUIRED, 'The output format: text or json.', 'text')
+      ->addOption('changed', NULL, InputOption::VALUE_OPTIONAL, 'Check only files that git reports as changed compared with this commit, plus untracked files.', FALSE)
+      ->addOption('include-tests', NULL, InputOption::VALUE_NONE, 'Also check .info.yml files below tests directories, as a site with $settings[\'extension_discovery_scan_tests\'] = TRUE reads them.')
+      ->addOption('strict', NULL, InputOption::VALUE_NONE, 'Fail on warnings too. Some warnings break a site when the extension is installed (a renamed info file, a missing base theme), which this command cannot know.')
+      ->addOption('php-lint', NULL, InputOption::VALUE_NONE, 'Also run "php -l" on each PHP file with the PHP binary running this command. This finds compile-time errors that the built-in check does not, and needs proc_open().')
+      ->setHelp(<<<'EOT'
+The checks use the same rules as extension discovery, so a file reported as an
+error here breaks a site. Warnings are files that discovery ignores or values
+that do not break the site by themselves.
+
+Examples:
+  php core/scripts/dr ex:validate
+  php core/scripts/dr ex:validate modules/custom themes/custom
+  php core/scripts/dr ex:validate --changed=origin/main --format=json
+EOT);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function execute(InputInterface $input, OutputInterface $output): int {
+    $format = $input->getOption('format');
+    if (!in_array($format, ['text', 'json'], TRUE)) {
+      $output->writeln(sprintf('<error>Unknown format "%s"; use text or json.</error>', $format));
+      return 2;
+    }
+    $include_tests = (bool) $input->getOption('include-tests');
+    $validator = new ExtensionFileValidator($this->root);
+    $notices = [];
+
+    $paths = $input->getArgument('paths');
+    if ($paths === []) {
+      $defaults = ['modules', 'themes', 'profiles', 'sites'];
+      $paths = array_values(array_filter(array_map(fn ($directory) => $this->root . '/' . $directory, $defaults), 'is_dir'));
+    }
+    $missing = array_filter($paths, fn ($path) => !file_exists($path));
+    if ($missing) {
+      $output->writeln(sprintf('<error>Not found: %s</error>', implode(', ', $missing)));
+      return 2;
+    }
+
+    $changed = $input->getOption('changed');
+    if ($changed !== FALSE) {
+      $files = $this->changedFiles($changed ?? 'HEAD', $paths);
+      if ($files === NULL) {
+        $output->writeln('<error>The --changed option needs git and a git working copy, and the commit to compare with must exist.</error>');
+        return 2;
+      }
+      $violations = $validator->validateFiles($files, $include_tests);
+      $php_files = array_filter($files, fn ($file) => in_array(pathinfo($file, PATHINFO_EXTENSION), ExtensionFileValidator::PHP_EXTENSIONS, TRUE));
+      $info_files = array_filter($files, fn ($file) => str_ends_with($file, '.info.yml'));
+      $checked = ['info' => count($info_files), 'php' => count($php_files)];
+    }
+    else {
+      $found = $validator->findFiles($paths, $include_tests);
+      $violations = $validator->validateFound($found);
+      $checked = ['info' => count($found['info']), 'php' => count($found['php'])];
+      $php_files = $found['php'];
+    }
+
+    if ($input->getOption('php-lint')) {
+      if (!function_exists('proc_open') || in_array('proc_open', array_map('trim', explode(',', (string) ini_get('disable_functions'))), TRUE)) {
+        $notices[] = 'The php -l check was skipped: proc_open() is not available.';
+      }
+      else {
+        $reported = array_flip(array_map(fn (ExtensionFileViolation $violation) => $violation->file, array_filter($violations, fn ($violation) => $violation->rule === 'php.syntax')));
+        foreach ($php_files as $file) {
+          if (!isset($reported[$validator->relative($file)])) {
+            array_push($violations, ...$this->phpLint($file, $validator));
+          }
+        }
+        $notices[] = sprintf('php -l was run with %s (PHP %s).', PHP_BINARY, PHP_VERSION);
+      }
+    }
+
+    $errors = count(array_filter($violations, fn ($violation) => $violation->severity === ExtensionFileViolation::ERROR));
+    $warnings = count($violations) - $errors;
+    if ($format === 'json') {
+      $output->writeln(json_encode([
+        'checked' => $checked,
+        'errors' => $errors,
+        'warnings' => $warnings,
+        'notices' => $notices,
+        'violations' => $violations,
+      ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE));
+    }
+    else {
+      foreach ($violations as $violation) {
+        $output->writeln(sprintf('%s%s: %s [%s] %s', $violation->file, $violation->line !== NULL ? ':' . $violation->line : '', $violation->severity, $violation->rule, $violation->message), OutputInterface::OUTPUT_RAW);
+      }
+      foreach ($notices as $notice) {
+        $output->writeln($notice);
+      }
+      $output->writeln(sprintf('Checked %d info file(s) and %d PHP file(s): %d error(s), %d warning(s).', $checked['info'], $checked['php'], $errors, $warnings));
+    }
+    return $errors || ($warnings && $input->getOption('strict')) ? 1 : 0;
+  }
+
+  /**
+   * Lists the files git reports as changed, below the given paths.
+   *
+   * @param string $commit
+   *   The commit to compare the working copy with.
+   * @param string[] $paths
+   *   The directories or files to limit the list to.
+   *
+   * @return string[]|null
+   *   Absolute file paths, or NULL if git cannot be used.
+   */
+  protected function changedFiles(string $commit, array $paths): ?array {
+    $git = function (array $arguments, string $directory): ?string {
+      $process = new Process(['git', ...$arguments], $directory);
+      $process->run();
+      return $process->isSuccessful() ? $process->getOutput() : NULL;
+    };
+    $top = $git(['rev-parse', '--show-toplevel'], $this->root);
+    if ($top === NULL) {
+      return NULL;
+    }
+    // Both lists are run from the top of the working copy, so both are
+    // relative to it. In a Composer project, the top is above the Drupal root.
+    // Added, copied, modified and renamed files; deleted files cannot break
+    // anything.
+    // cspell:ignore ACMR
+    $top = trim($top);
+    $diff = $git(['diff', '--name-only', '-z', '--diff-filter=ACMR', $commit, '--'], $top);
+    $untracked = $diff === NULL ? NULL : $git(['ls-files', '-z', '--others', '--exclude-standard'], $top);
+    if ($untracked === NULL) {
+      return NULL;
+    }
+    $prefixes = array_map(fn ($path) => rtrim(realpath($path) ?: $path, '/'), $paths);
+    $files = [];
+    foreach (array_filter(explode("\0", $diff . "\0" . $untracked)) as $relative) {
+      $file = $top . '/' . $relative;
+      foreach ($prefixes as $prefix) {
+        if (($file === $prefix || str_starts_with($file, $prefix . '/')) && is_file($file)) {
+          $files[] = $file;
+          break;
+        }
+      }
+    }
+    return array_values(array_unique($files));
+  }
+
+  /**
+   * Runs "php -l" on one file.
+   *
+   * @param string $file
+   *   The file path.
+   * @param \Drupal\Core\Extension\ExtensionFileValidator $validator
+   *   The validator, for the path to report.
+   *
+   * @return \Drupal\Core\Extension\ExtensionFileViolation[]
+   *   One violation if php -l reports an error, otherwise none.
+   */
+  protected function phpLint(string $file, ExtensionFileValidator $validator): array {
+    // The same output whatever php.ini says: only the displayed error, as
+    // text, on stderr.
+    $process = new Process([
+      PHP_BINARY,
+      '-d', 'display_errors=stderr',
+      '-d', 'log_errors=0',
+      '-d', 'html_errors=0',
+      '-l', $file,
+    ]);
+    $process->run();
+    if ($process->isSuccessful()) {
+      return [];
+    }
+    $text = trim($process->getErrorOutput() . "\n" . $process->getOutput());
+    $first = trim(strtok($text, "\n") ?: $text);
+    $line = preg_match('/on line (\d+)/', $first, $match) ? (int) $match[1] : NULL;
+    $message = trim(preg_replace(['/^PHP /', '/ in .+ on line \d+$/', '/\s+/'], ['', '', ' '], $first));
+    return [new ExtensionFileViolation($validator->relative($file), $line, 'php.lint', $message)];
+  }
+
+}
