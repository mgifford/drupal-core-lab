diff --git a/core/lib/Drupal/Core/Extension/ExtensionFileValidator.php b/core/lib/Drupal/Core/Extension/ExtensionFileValidator.php
new file mode 100644
index 00000000..bd992b01
--- /dev/null
+++ b/core/lib/Drupal/Core/Extension/ExtensionFileValidator.php
@@ -0,0 +1,654 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Core\Extension;
+
+use Drupal\Core\Extension\Discovery\RecursiveExtensionFilterCallback;
+use Symfony\Component\Yaml\Exception\ParseException;
+use Symfony\Component\Yaml\Parser;
+use Symfony\Component\Yaml\Yaml as SymfonyYaml;
+
+/**
+ * Checks extension files for problems that break a site, without a site.
+ *
+ * Extension discovery parses every .info.yml file it finds while the container
+ * is built, whether or not the extension is installed. One file that cannot be
+ * parsed stops the container build, so every request fails once caches are
+ * cleared. This class finds those problems before the files are deployed. It
+ * does not bootstrap Drupal, so it can run in continuous integration, before a
+ * deployment, or inside Drupal.
+ *
+ * For each .info.yml file it checks:
+ * - The rules extension discovery applies, by calling InfoParserDynamic. That
+ *   class uses the PECL YAML extension when it is loaded.
+ * - YAML that only one of the two parsers accepts, so a file that works on one
+ *   host does not break another. The file is also parsed with Symfony YAML,
+ *   and with PECL YAML when that extension is loaded.
+ * - Problems InfoParserDynamic does not report but other code fails on: an
+ *   empty file, a top level that is not a mapping, value types, an unknown
+ *   extension type, a theme without a base theme, and a byte order mark.
+ * - File names that extension discovery ignores.
+ *
+ * PHP files are checked with token_get_all() in the current process, so no
+ * command is run and the PHP version is the one running this code. This finds
+ * parse errors only; compile-time errors such as a duplicate parameter name
+ * are not found.
+ *
+ * @see \Drupal\Core\Extension\InfoParserDynamic
+ * @see \Drupal\Core\Extension\ExtensionDiscovery
+ * @see \Drupal\Core\Extension\Command\ExtensionValidateCommand
+ */
+class ExtensionFileValidator {
+
+  /**
+   * The file name extensions that are checked as PHP.
+   */
+  public const array PHP_EXTENSIONS = ['php', 'module', 'inc', 'install', 'theme', 'profile', 'engine'];
+
+  /**
+   * The extension types that extension discovery loads.
+   */
+  public const array EXTENSION_TYPES = ['module', 'theme', 'profile', 'theme_engine'];
+
+  /**
+   * The directory names skipped by default, as in default.settings.php.
+   *
+   * @see $settings['file_scan_ignore_directories']
+   */
+  public const array IGNORE_DIRECTORIES = ['node_modules', 'bower_components'];
+
+  /**
+   * The longest extension name that can be installed.
+   *
+   * @see DRUPAL_EXTENSION_NAME_MAX_LENGTH
+   */
+  public const int MAX_NAME_LENGTH = 50;
+
+  /**
+   * Value types of keys that other code uses without checking them.
+   *
+   * Each entry is [expected type, severity, extension types it applies to].
+   * An empty list of extension types means all types. The types are "string",
+   * "string|null", "string|false", "bool", "list" (a list of strings),
+   * "list|null" (a list of strings, or empty) and "map" (a mapping of strings
+   * to strings). Empty lists are accepted where they work at runtime.
+   */
+  protected const array VALUE_TYPES = [
+    // ModulesListForm sorts by name with strcasecmp().
+    'name' => ['string', ExtensionFileViolation::ERROR, []],
+    'type' => ['string', ExtensionFileViolation::ERROR, []],
+    'description' => ['string|null', ExtensionFileViolation::WARNING, []],
+    'package' => ['string', ExtensionFileViolation::WARNING, []],
+    'configure' => ['string', ExtensionFileViolation::WARNING, []],
+    'hidden' => ['bool', ExtensionFileViolation::WARNING, []],
+    'dependencies' => ['list|null', ExtensionFileViolation::WARNING, []],
+    'test_dependencies' => ['list|null', ExtensionFileViolation::WARNING, []],
+    // The theme system passes regions to array functions.
+    'regions' => ['map', ExtensionFileViolation::ERROR, ['theme']],
+    'base theme' => ['string|false', ExtensionFileViolation::ERROR, ['theme']],
+    'libraries' => ['list|null', ExtensionFileViolation::WARNING, ['theme']],
+    'install' => ['list|null', ExtensionFileViolation::WARNING, ['profile']],
+    'themes' => ['list|null', ExtensionFileViolation::WARNING, ['profile']],
+  ];
+
+  /**
+   * The directory names extension discovery skips, keyed by $include_tests.
+   *
+   * @var array<int, string[]>
+   */
+  protected array $skippedFolders = [];
+
+  /**
+   * Parsed info files of the current check, keyed by path.
+   *
+   * @var array<string, array>
+   */
+  protected array $parsed = [];
+
+  /**
+   * Constructs an ExtensionFileValidator object.
+   *
+   * @param string $root
+   *   The root directory of the Drupal installation.
+   */
+  public function __construct(protected string $root) {
+    $this->root = rtrim($root, '/');
+  }
+
+  /**
+   * Finds the files to check below one or more paths.
+   *
+   * An .info.yml file is returned only where extension discovery would read
+   * it: not below a directory that discovery skips (such as src, vendor or a
+   * hidden directory), and not below a tests directory unless $include_tests
+   * is TRUE. That matches the extension_discovery_scan_tests setting. PHP files
+   * are returned from every directory except tests (unless $include_tests),
+   * vendor, hidden directories and $ignore_directories.
+   *
+   * @param string[] $paths
+   *   Directories or files to search.
+   * @param bool $include_tests
+   *   (optional) Whether to include tests directories. Defaults to FALSE.
+   * @param string[] $ignore_directories
+   *   (optional) Directory names to skip, for example the value of the
+   *   file_scan_ignore_directories setting. Defaults to node_modules and
+   *   bower_components.
+   *
+   * @return array
+   *   An array with three keys, each a list of file paths:
+   *   - info: .info.yml files to check.
+   *   - php: PHP files to check.
+   *   - ignored: .info.yaml and .info files where discovery would look for an
+   *     .info.yml file.
+   */
+  public function findFiles(array $paths, bool $include_tests = FALSE, array $ignore_directories = self::IGNORE_DIRECTORIES): array {
+    $found = ['info' => [], 'php' => [], 'ignored' => []];
+    $pruned = array_merge(['vendor'], $ignore_directories, $include_tests ? [] : ['tests']);
+    foreach ($paths as $path) {
+      $path = rtrim($path, '/');
+      if (is_file($path)) {
+        $this->classify($path, basename($path), $include_tests, $found);
+        continue;
+      }
+      if (!is_dir($path)) {
+        continue;
+      }
+      $flags = \FilesystemIterator::UNIX_PATHS | \FilesystemIterator::SKIP_DOTS | \FilesystemIterator::FOLLOW_SYMLINKS;
+      $directories = new \RecursiveDirectoryIterator($path, $flags);
+      $filter = new \RecursiveCallbackFilterIterator($directories, function (\SplFileInfo $file) use ($pruned): bool {
+        $name = $file->getFilename();
+        return $name[0] !== '.' && !($file->isDir() && in_array($name, $pruned, TRUE));
+      });
+      $iterator = new \RecursiveIteratorIterator($filter, \RecursiveIteratorIterator::LEAVES_ONLY, \RecursiveIteratorIterator::CATCH_GET_CHILD);
+      foreach ($iterator as $file) {
+        $this->classify($file->getPathname(), substr($file->getPathname(), strlen($path) + 1), $include_tests, $found);
+      }
+    }
+    foreach ($found as &$list) {
+      sort($list);
+    }
+    return $found;
+  }
+
+  /**
+   * Checks files, choosing the checks by file name.
+   *
+   * @param string[] $files
+   *   The files to check. Other files are skipped.
+   * @param bool $include_tests
+   *   (optional) Whether to check .info.yml files below tests directories.
+   *   Defaults to FALSE.
+   * @param string|null $base
+   *   (optional) The directory the paths are relative to, used to decide where
+   *   extension discovery would read an .info.yml file. Defaults to the Drupal
+   *   root.
+   *
+   * @return \Drupal\Core\Extension\ExtensionFileViolation[]
+   *   The problems found.
+   */
+  public function validateFiles(array $files, bool $include_tests = FALSE, ?string $base = NULL): array {
+    $base = rtrim($base ?? $this->root, '/');
+    $found = ['info' => [], 'php' => [], 'ignored' => []];
+    foreach ($files as $pathname) {
+      $relative = str_starts_with($pathname, $base . '/') ? substr($pathname, strlen($base) + 1) : basename($pathname);
+      $this->classify($pathname, $relative, $include_tests, $found);
+    }
+    return $this->validateFound($found);
+  }
+
+  /**
+   * Checks the files that findFiles() returned.
+   *
+   * @param array $found
+   *   The return value of findFiles().
+   *
+   * @return \Drupal\Core\Extension\ExtensionFileViolation[]
+   *   The problems found.
+   */
+  public function validateFound(array $found): array {
+    $this->parsed = [];
+    $violations = [];
+    foreach ($found['ignored'] as $pathname) {
+      $violations[] = new ExtensionFileViolation($this->relative($pathname), NULL, 'file.name', sprintf('Extension discovery only reads files named <name>.info.yml, so this file is ignored. Rename it to %s.info.yml if it describes an extension.', preg_replace('/\.info(\.yaml)?$/', '', basename($pathname))), ExtensionFileViolation::WARNING);
+    }
+    foreach ($found['info'] as $pathname) {
+      array_push($violations, ...$this->validateInfoFile($pathname));
+    }
+    array_push($violations, ...$this->validateBaseThemes());
+    foreach ($found['php'] as $pathname) {
+      array_push($violations, ...$this->validatePhpFile($pathname));
+    }
+    return $violations;
+  }
+
+  /**
+   * Checks one .info.yml file.
+   *
+   * @param string $pathname
+   *   The path of the file.
+   *
+   * @return \Drupal\Core\Extension\ExtensionFileViolation[]
+   *   The problems found.
+   */
+  public function validateInfoFile(string $pathname): array {
+    $file = $this->relative($pathname);
+    $violation = fn (?int $line, string $rule, string $message, string $severity = ExtensionFileViolation::ERROR) => new ExtensionFileViolation($file, $line, $rule, $message, $severity);
+    $contents = @file_get_contents($pathname);
+    if ($contents === FALSE) {
+      return [$violation(NULL, 'info.read', 'The file cannot be read.')];
+    }
+
+    // Extension discovery only reads files whose name is a valid PHP function
+    // name. Names with a dot are other kinds of info files (for example
+    // *.libraries.info.yml), so they are not reported.
+    $name = basename($pathname, '.info.yml');
+    if (!preg_match(ExtensionDiscovery::PHP_FUNCTION_PATTERN, $name)) {
+      return str_contains($name, '.') ? [] : [$violation(NULL, 'file.name', sprintf('"%s" is not a valid extension machine name (letters, digits and underscores, not starting with a digit), so extension discovery ignores this file.', $name), ExtensionFileViolation::WARNING)];
+    }
+    $violations = [];
+    if (strtolower($name) !== $name) {
+      $violations[] = $violation(NULL, 'file.name', sprintf('Extension machine names are lower case; "%s" is discovered as a different extension from "%s".', $name, strtolower($name)), ExtensionFileViolation::WARNING);
+    }
+    if (strlen($name) > static::MAX_NAME_LENGTH) {
+      $violations[] = $violation(NULL, 'file.name', sprintf('The machine name is longer than %d characters, so the extension cannot be installed.', static::MAX_NAME_LENGTH), ExtensionFileViolation::WARNING);
+    }
+
+    if (str_starts_with($contents, "\xEF\xBB\xBF")) {
+      $violations[] = $violation(1, 'info.bom', 'The file starts with a UTF-8 byte order mark. Symfony YAML reads it as part of the first key, so a required key appears to be missing; PECL YAML ignores it. Save the file without a byte order mark.');
+      return $violations;
+    }
+    foreach (explode("\n", $contents) as $index => $text) {
+      if (preg_match('/^ *\t/', $text)) {
+        $violations[] = $violation($index + 1, 'info.tab', 'A tab is used for indentation. YAML allows only spaces.');
+      }
+    }
+
+    // Parse with Symfony YAML as Drupal does without the PECL extension, and
+    // with PECL YAML when it is loaded, so that a file only one of them
+    // accepts is reported.
+    $pecl = extension_loaded('yaml') ? $this->peclParse($contents) : NULL;
+    try {
+      $data = (new Parser())->parse($contents, SymfonyYaml::PARSE_EXCEPTION_ON_INVALID_TYPE | SymfonyYaml::PARSE_CUSTOM_TAGS);
+    }
+    catch (ParseException $e) {
+      // The tab lines are already reported, one by one.
+      if (str_contains($e->getMessage(), 'cannot contain tabs') && $violations) {
+        return $violations;
+      }
+      // The line is reported separately, so it is removed from the message.
+      $line = $e->getParsedLine() > 0 ? $e->getParsedLine() : NULL;
+      $message = preg_replace('/ at line -?\d+/', '', $e->getMessage()) . $this->hint($contents, $line);
+      if ($pecl !== NULL && $pecl['error'] === NULL) {
+        $message .= ' PECL YAML accepts this file, so it works only on hosts that have the PECL YAML extension.';
+      }
+      $violations[] = $violation($line, 'info.yaml', $message);
+      return $violations;
+    }
+    if ($pecl !== NULL && $pecl['error'] !== NULL) {
+      $violations[] = $violation($pecl['line'], 'info.yaml', $pecl['error'] . ' Symfony YAML accepts this file, but PECL YAML does not, so it breaks on hosts that have the PECL YAML extension.');
+      return $violations;
+    }
+
+    if (!is_array($data) || array_is_list($data)) {
+      $what = match (TRUE) {
+        $data === NULL, $data === [] => 'The file is empty.',
+        is_array($data) => 'The top level of the file is a list, not a mapping of keys to values.',
+        default => 'The file contains a single value, not a mapping of keys to values.',
+      };
+      $violations[] = $violation(NULL, 'info.mapping', $what . ' InfoParserDynamic fails on it with a TypeError, which the module list does not catch.');
+      return $violations;
+    }
+
+    // The same rules as extension discovery. Deprecations are reported too.
+    $deprecations = [];
+    set_error_handler(function (int $level, string $message) use (&$deprecations): bool {
+      $deprecations[] = $message;
+      return TRUE;
+    }, E_USER_DEPRECATED | E_DEPRECATED);
+    try {
+      $info = (new InfoParserDynamic($this->root))->parse($pathname);
+      if (!empty($info['core_incompatible'])) {
+        $violations[] = $violation($this->lineOf($contents, 'core_version_requirement'), 'info.core_incompatible', sprintf('The core_version_requirement (%s) does not include Drupal %s, so the extension cannot be installed on it.', $info['core_version_requirement'], \Drupal::VERSION), ExtensionFileViolation::WARNING);
+      }
+    }
+    catch (InfoParserException $e) {
+      $message = str_replace([' in ' . $pathname, $pathname], ['', 'this file'], $e->getMessage());
+      $key = preg_match("/'(core_version_requirement|version|lifecycle|lifecycle_link)'/", $e->getMessage(), $match) ? $match[1] : NULL;
+      $line = $key ? $this->lineOf($contents, $key) : NULL;
+      $violations[] = $violation($line, 'info.parser', $message . $this->hint($contents, $line));
+    }
+    finally {
+      restore_error_handler();
+    }
+    foreach ($deprecations as $message) {
+      $violations[] = $violation(NULL, 'info.deprecated', str_replace([' in ' . $pathname, $pathname], ['', 'this file'], $message), ExtensionFileViolation::WARNING);
+    }
+
+    $type = is_string($data['type'] ?? NULL) ? $data['type'] : NULL;
+    if ($type !== NULL && !in_array($type, static::EXTENSION_TYPES, TRUE)) {
+      $violations[] = $violation($this->lineOf($contents, 'type'), 'info.type', sprintf('"%s" is not an extension type (%s). Extension discovery files the extension under that type, so Drupal never loads it.', $type, implode(', ', static::EXTENSION_TYPES)));
+    }
+    if ($type === 'theme' && !array_key_exists('base theme', $data)) {
+      $violations[] = $violation(NULL, 'info.base_theme', 'A theme must have a "base theme" key (false for none); without it every rebuild of the theme list fails. See https://www.drupal.org/node/3066038');
+    }
+    foreach (static::VALUE_TYPES as $key => [$expected, $severity, $types]) {
+      if (array_key_exists($key, $data) && ($types === [] || in_array($type, $types, TRUE)) && !$this->hasType($data[$key], $expected)) {
+        $violations[] = $violation($this->lineOf($contents, $key), 'info.value', sprintf('The value of "%s" must be %s; found %s.', $key, $this->describeType($expected), get_debug_type($data[$key])), $severity);
+      }
+    }
+    // A dependency whose name is not a machine name can never be met, so the
+    // extension cannot be installed. A list item indented one space too far
+    // is folded into the item above it and produces such a name.
+    foreach (['dependencies', 'test_dependencies', 'install'] as $key) {
+      foreach (is_array($data[$key] ?? NULL) ? $data[$key] : [] as $item) {
+        if (is_string($item) && !preg_match(ExtensionDiscovery::PHP_FUNCTION_PATTERN, Dependency::createFromString($item)->getName())) {
+          // A folded item spans lines, so the line where it starts is used.
+          $violations[] = $violation($this->lineContaining($contents, strtok($item, ' ')), 'info.dependency', sprintf('"%s" in %s is not a valid dependency (project:machine_name, with an optional version constraint in parentheses), so the extension cannot be installed. If the next line is indented further than this one, YAML has joined the two lines into one value.', $item, $key), ExtensionFileViolation::WARNING);
+        }
+      }
+    }
+    $this->parsed[$pathname] = ['file' => $file, 'contents' => $contents, 'data' => $data, 'name' => $name];
+    return $violations;
+  }
+
+  /**
+   * Checks that the base theme of each checked theme exists.
+   *
+   * A theme whose base theme is not installed breaks the site once caches are
+   * cleared. Without a site, the base theme is looked for among the themes
+   * checked in the same run and the themes in core, so a theme found
+   * elsewhere (for example in themes/contrib, when only themes/custom is
+   * checked) is reported too; the violation is a warning for that reason.
+   *
+   * @return \Drupal\Core\Extension\ExtensionFileViolation[]
+   *   The problems found.
+   */
+  protected function validateBaseThemes(): array {
+    $themes = [];
+    foreach ($this->parsed as $info) {
+      if (($info['data']['type'] ?? NULL) === 'theme') {
+        $themes[$info['name']] = TRUE;
+      }
+    }
+    // scandir() is used because glob() does not support stream wrappers.
+    $directories = [$this->root . '/core/themes'];
+    foreach (is_dir($this->root . '/core/profiles') ? scandir($this->root . '/core/profiles') : [] as $profile) {
+      $directories[] = $this->root . '/core/profiles/' . $profile . '/themes';
+    }
+    foreach ($directories as $directory) {
+      foreach (is_dir($directory) ? scandir($directory) : [] as $theme) {
+        if ($theme[0] !== '.' && is_file("$directory/$theme/$theme.info.yml")) {
+          $themes[$theme] = TRUE;
+        }
+      }
+    }
+    $violations = [];
+    foreach ($this->parsed as $info) {
+      $base = $info['data']['base theme'] ?? NULL;
+      if (($info['data']['type'] ?? NULL) === 'theme' && is_string($base) && !isset($themes[$base])) {
+        $violations[] = new ExtensionFileViolation($info['file'], $this->lineOf($info['contents'], 'base theme'), 'info.base_theme', sprintf('The base theme "%s" is not among the checked themes or the themes in core. If it is not installed, every page fails once caches are cleared.', $base), ExtensionFileViolation::WARNING);
+      }
+    }
+    return $violations;
+  }
+
+  /**
+   * Checks the syntax of one PHP file.
+   *
+   * @param string $pathname
+   *   The path of the file.
+   *
+   * @return \Drupal\Core\Extension\ExtensionFileViolation[]
+   *   The problems found.
+   */
+  public function validatePhpFile(string $pathname): array {
+    $contents = @file_get_contents($pathname);
+    if ($contents === FALSE) {
+      return [new ExtensionFileViolation($this->relative($pathname), NULL, 'php.read', 'The file cannot be read.')];
+    }
+    // Compiling the file can also raise deprecations (for example for
+    // non-canonical casts in PHP 8.5). They are reported as warnings instead
+    // of being printed, because the next major PHP version may reject them.
+    $notices = [];
+    set_error_handler(function (int $level, string $message, string $file = '', int $line = 0) use (&$notices): bool {
+      $notices[] = [$level, $message, $line ?: NULL];
+      return TRUE;
+    });
+    try {
+      token_get_all($contents, TOKEN_PARSE);
+    }
+    catch (\CompileError $e) {
+      return [new ExtensionFileViolation($this->relative($pathname), $e->getLine(), 'php.syntax', $e->getMessage())];
+    }
+    finally {
+      restore_error_handler();
+    }
+    $violations = [];
+    foreach ($notices as [$level, $message, $line]) {
+      $rule = in_array($level, [E_DEPRECATED, E_USER_DEPRECATED], TRUE) ? 'php.deprecated' : 'php.notice';
+      $violations[] = new ExtensionFileViolation($this->relative($pathname), $line, $rule, $message, ExtensionFileViolation::WARNING);
+    }
+    return $violations;
+  }
+
+  /**
+   * Returns a path relative to the Drupal root when it is inside the root.
+   *
+   * @param string $pathname
+   *   A file path.
+   *
+   * @return string
+   *   The path to show in a report.
+   */
+  public function relative(string $pathname): string {
+    $real = realpath($pathname) ?: $pathname;
+    $root = realpath($this->root) ?: $this->root;
+    return str_starts_with($real, $root . '/') ? substr($real, strlen($root) + 1) : $pathname;
+  }
+
+  /**
+   * Adds a file to the lists in $found.
+   *
+   * @param string $pathname
+   *   The file path.
+   * @param string $relative
+   *   The path below the directory being searched.
+   * @param bool $include_tests
+   *   Whether tests directories are included.
+   * @param array $found
+   *   The lists of files, as returned by findFiles().
+   */
+  protected function classify(string $pathname, string $relative, bool $include_tests, array &$found): void {
+    $name = basename($pathname);
+    $extension = pathinfo($name, PATHINFO_EXTENSION);
+    $discoverable = $this->isDiscoverable($pathname, $relative, $include_tests);
+    if (str_ends_with($name, '.info.yml')) {
+      if ($discoverable) {
+        $found['info'][] = $pathname;
+      }
+    }
+    elseif ($discoverable && (str_ends_with($name, '.info.yaml') || ($extension === 'info' && substr_count($name, '.') === 1))) {
+      $found['ignored'][] = $pathname;
+    }
+    elseif (in_array($extension, static::PHP_EXTENSIONS, TRUE) && ($include_tests || !in_array('tests', explode('/', $relative), TRUE))) {
+      $found['php'][] = $pathname;
+    }
+  }
+
+  /**
+   * Whether extension discovery would read an info file at a relative path.
+   *
+   * @param string $pathname
+   *   The full path of the file.
+   * @param string $relative
+   *   A path below the directory being searched.
+   * @param bool $include_tests
+   *   Whether tests directories are included.
+   *
+   * @return bool
+   *   FALSE when a directory in the path is one that discovery skips.
+   *
+   * @see \Drupal\Core\Extension\Discovery\RecursiveExtensionFilterCallback::accept()
+   */
+  protected function isDiscoverable(string $pathname, string $relative, bool $include_tests): bool {
+    $skipped = $this->skippedFolders[(int) $include_tests] ??= (new RecursiveExtensionFilterCallback([], $include_tests))->getSkippedFolders();
+    $base = substr($pathname, 0, strlen($pathname) - strlen($relative));
+    $directories = array_slice(explode('/', $relative), 0, -1);
+    foreach ($directories as $index => $directory) {
+      if ($directory === '' || $directory[0] === '.' || in_array($directory, $skipped, TRUE)) {
+        return FALSE;
+      }
+      // Discovery skips config directories, except the config module itself.
+      if ($directory === 'config' && !str_ends_with($base . implode('/', array_slice($directories, 0, $index + 1)), 'modules/config')) {
+        return FALSE;
+      }
+    }
+    return TRUE;
+  }
+
+  /**
+   * Parses YAML with the PECL YAML extension.
+   *
+   * @param string $contents
+   *   The YAML.
+   *
+   * @return array
+   *   An array with an "error" key (NULL when the YAML parsed) and a "line"
+   *   key.
+   */
+  protected function peclParse(string $contents): array {
+    $error = NULL;
+    set_error_handler(function (int $level, string $message) use (&$error): bool {
+      $error = $message;
+      return TRUE;
+    });
+    try {
+      $result = yaml_parse($contents);
+    }
+    finally {
+      restore_error_handler();
+    }
+    if ($error === NULL && $result === FALSE) {
+      $error = 'PECL YAML could not parse the file.';
+    }
+    $line = $error !== NULL && preg_match('/\(line (\d+)/', $error, $match) ? (int) $match[1] : NULL;
+    return ['error' => $error, 'line' => $line];
+  }
+
+  /**
+   * Explains common spacing mistakes on a line that failed to parse.
+   *
+   * @param string $contents
+   *   The YAML.
+   * @param int|null $line
+   *   The line number, if known.
+   *
+   * @return string
+   *   A hint starting with a space, or an empty string.
+   */
+  protected function hint(string $contents, ?int $line): string {
+    if ($line === NULL) {
+      return '';
+    }
+    $lines = explode("\n", $contents);
+    $text = rtrim($lines[$line - 1] ?? '', "\r");
+    $previous = '';
+    for ($index = $line - 2; $index >= 0 && $previous === ''; $index--) {
+      $previous = trim($lines[$index]);
+    }
+    return match (TRUE) {
+      str_contains($text, "\u{A0}") => ' The line contains a no-break space (U+00A0); use an ordinary space.',
+      // List items such as "- drupal:node" are values, so they are excluded.
+      (bool) preg_match('/^\s*[A-Za-z_][\w ]*:[^\s:\/]/', $text) => ' Put a space after the colon: YAML reads "key:value" as one string.',
+      (bool) preg_match('/^\s+[A-Za-z_][\w ]*:/', $text) && $previous !== '' && !str_ends_with($previous, ':') => ' The line is indented but does not belong to the key above it; top-level keys start in the first column.',
+      (bool) preg_match('/:\s+[^\'"#]*\S#/', $text) => ' A # starts a comment only after a space; here it is part of the value.',
+      default => '',
+    };
+  }
+
+  /**
+   * Finds the first line that contains a string.
+   *
+   * @param string $contents
+   *   The YAML.
+   * @param string $needle
+   *   The string.
+   *
+   * @return int|null
+   *   The line number, or NULL if the string is not found.
+   */
+  protected function lineContaining(string $contents, string $needle): ?int {
+    foreach (explode("\n", $contents) as $index => $text) {
+      if (str_contains($text, $needle)) {
+        return $index + 1;
+      }
+    }
+    return NULL;
+  }
+
+  /**
+   * Finds the line where a top-level key is set.
+   *
+   * @param string $contents
+   *   The YAML.
+   * @param string $key
+   *   The key.
+   *
+   * @return int|null
+   *   The line number, or NULL if the key is not found at the start of a line.
+   */
+  protected function lineOf(string $contents, string $key): ?int {
+    foreach (explode("\n", $contents) as $index => $text) {
+      if (preg_match('/^[\'"]?' . preg_quote($key, '/') . '[\'"]?\s*:/', $text)) {
+        return $index + 1;
+      }
+    }
+    return NULL;
+  }
+
+  /**
+   * Whether a value has the expected type.
+   *
+   * @param mixed $value
+   *   The value.
+   * @param string $expected
+   *   One of the types used in static::VALUE_TYPES.
+   *
+   * @return bool
+   *   TRUE if the value has the type.
+   */
+  protected function hasType(mixed $value, string $expected): bool {
+    return match ($expected) {
+      'string' => is_string($value) && $value !== '',
+      'string|null' => is_string($value) || $value === NULL,
+      'string|false' => is_string($value) || $value === FALSE,
+      'bool' => is_bool($value),
+      'list' => is_array($value) && array_is_list($value) && count(array_filter($value, 'is_string')) === count($value),
+      'list|null' => $value === NULL || $this->hasType($value, 'list'),
+      'map' => is_array($value) && ($value === [] || !array_is_list($value)) && count(array_filter($value, 'is_string')) === count($value),
+    };
+  }
+
+  /**
+   * Describes an expected type in words.
+   *
+   * @param string $expected
+   *   One of the types used in static::VALUE_TYPES.
+   *
+   * @return string
+   *   The description.
+   */
+  protected function describeType(string $expected): string {
+    return match ($expected) {
+      'string' => 'a non-empty string',
+      'string|null' => 'a string or empty',
+      'string|false' => 'a string or false',
+      'bool' => 'true or false',
+      'list' => 'a list of strings',
+      'list|null' => 'a list of strings or empty',
+      'map' => 'a mapping of names to labels',
+    };
+  }
+
+}
diff --git a/core/lib/Drupal/Core/Extension/ExtensionFileViolation.php b/core/lib/Drupal/Core/Extension/ExtensionFileViolation.php
new file mode 100644
index 00000000..eaa5a4ce
--- /dev/null
+++ b/core/lib/Drupal/Core/Extension/ExtensionFileViolation.php
@@ -0,0 +1,59 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Core\Extension;
+
+/**
+ * A problem found in an extension file.
+ *
+ * @see \Drupal\Core\Extension\ExtensionFileValidator
+ */
+final class ExtensionFileViolation implements \JsonSerializable {
+
+  /**
+   * A problem that breaks extension discovery, a page, or an install.
+   */
+  public const string ERROR = 'error';
+
+  /**
+   * A problem that does not break the site by itself.
+   */
+  public const string WARNING = 'warning';
+
+  /**
+   * Constructs an ExtensionFileViolation object.
+   *
+   * @param string $file
+   *   The path of the file, relative to the Drupal root when it is inside it.
+   * @param int|null $line
+   *   The line number, or NULL when the problem is not on one line.
+   * @param string $rule
+   *   A stable identifier of the check that failed, for example "info.yaml".
+   * @param string $message
+   *   A description of the problem.
+   * @param string $severity
+   *   Either self::ERROR or self::WARNING.
+   */
+  public function __construct(
+    public readonly string $file,
+    public readonly ?int $line,
+    public readonly string $rule,
+    public readonly string $message,
+    public readonly string $severity = self::ERROR,
+  ) {}
+
+  /**
+   * {@inheritdoc}
+   */
+  public function jsonSerialize(): array {
+    return [
+      'file' => $this->file,
+      'line' => $this->line,
+      'severity' => $this->severity,
+      'rule' => $this->rule,
+      'message' => $this->message,
+    ];
+  }
+
+}
diff --git a/core/tests/Drupal/Tests/Core/Extension/Command/ExtensionValidateCommandTest.php b/core/tests/Drupal/Tests/Core/Extension/Command/ExtensionValidateCommandTest.php
