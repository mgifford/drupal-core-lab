--- /dev/null
+++ b/core/tests/Drupal/Tests/Core/Extension/Command/ExtensionValidateCommandTest.php
@@ -0,0 +1,190 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\Core\Extension\Command;
+
+use Drupal\Core\Extension\Command\ExtensionValidateCommand;
+use Drupal\Tests\UnitTestCase;
+// cspell:ignore modul
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\DataProvider;
+use PHPUnit\Framework\Attributes\Group;
+use Symfony\Component\Console\Tester\CommandTester;
+use Symfony\Component\Filesystem\Filesystem;
+use Symfony\Component\Process\ExecutableFinder;
+use Symfony\Component\Process\Process;
+
+/**
+ * Tests the ex:validate command.
+ */
+#[CoversClass(ExtensionValidateCommand::class)]
+#[Group('Command')]
+class ExtensionValidateCommandTest extends UnitTestCase {
+
+  /**
+   * A temporary project directory, which contains the Drupal root.
+   */
+  protected string $project;
+
+  /**
+   * The Drupal root, in the web directory of the project directory.
+   */
+  protected string $directory;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->project = sys_get_temp_dir() . '/extension-validate-' . bin2hex(random_bytes(6));
+    $this->directory = $this->project . '/web';
+    $this->writeModule('valid_module', "name: Valid\ntype: module\ncore_version_requirement: '*'\n");
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function tearDown(): void {
+    (new Filesystem())->remove($this->project);
+    parent::tearDown();
+  }
+
+  /**
+   * Writes a module below the temporary Drupal root.
+   *
+   * @param string $name
+   *   The machine name.
+   * @param string $info
+   *   The contents of the .info.yml file.
+   * @param string|null $module
+   *   (optional) The contents of the .module file.
+   */
+  protected function writeModule(string $name, string $info, ?string $module = NULL): void {
+    $filesystem = new Filesystem();
+    $filesystem->dumpFile("$this->directory/modules/custom/$name/$name.info.yml", $info);
+    if ($module !== NULL) {
+      $filesystem->dumpFile("$this->directory/modules/custom/$name/$name.module", $module);
+    }
+  }
+
+  /**
+   * Runs the command.
+   *
+   * @param array $input
+   *   The command input.
+   *
+   * @return \Symfony\Component\Console\Tester\CommandTester
+   *   The tester, after running the command.
+   */
+  protected function runCommand(array $input = []): CommandTester {
+    $tester = new CommandTester(new ExtensionValidateCommand($this->directory));
+    $tester->execute($input);
+    return $tester;
+  }
+
+  /**
+   * Tests text output and exit codes.
+   */
+  public function testText(): void {
+    $tester = $this->runCommand();
+    $this->assertSame(0, $tester->getStatusCode());
+    $this->assertStringContainsString('Checked 1 info file(s) and 0 PHP file(s): 0 error(s), 0 warning(s).', $tester->getDisplay());
+
+    $this->writeModule('broken_module', "name: Broken\ntype: module\ncore_version_requirement: '*'\ndescription: Broken: yes\n", "<?php\n\nfunction broken_module_help( {\n}\n");
+    $tester = $this->runCommand(['paths' => ["$this->directory/modules"]]);
+    $this->assertSame(1, $tester->getStatusCode());
+    $display = $tester->getDisplay();
+    $this->assertStringContainsString('modules/custom/broken_module/broken_module.info.yml:4: error [info.yaml] A colon cannot be used in an unquoted mapping value', $display);
+    $this->assertStringContainsString('modules/custom/broken_module/broken_module.module:3: error [php.syntax]', $display);
+    $this->assertStringContainsString('2 error(s), 0 warning(s)', $display);
+  }
+
+  /**
+   * Tests JSON output and usage errors.
+   */
+  public function testJsonAndUsage(): void {
+    $this->writeModule('Valid_Upper', "name: Upper\ntype: module\ncore_version_requirement: '*'\n");
+    $tester = $this->runCommand(['--format' => 'json']);
+    $this->assertSame(0, $tester->getStatusCode(), 'Warnings do not fail the command.');
+    $result = json_decode($tester->getDisplay(), TRUE);
+    $this->assertSame(['info' => 2, 'php' => 0], $result['checked']);
+    $this->assertSame(0, $result['errors']);
+    $this->assertSame(1, $result['warnings']);
+    $this->assertSame([
+      'file' => 'modules/custom/Valid_Upper/Valid_Upper.info.yml',
+      'line' => NULL,
+      'severity' => 'warning',
+      'rule' => 'file.name',
+    ], array_diff_key($result['violations'][0], ['message' => TRUE]));
+
+    $this->assertSame(1, $this->runCommand(['--strict' => TRUE])->getStatusCode(), 'With --strict, warnings fail the command.');
+    $this->assertSame(2, $this->runCommand(['--format' => 'xml'])->getStatusCode());
+    $this->assertSame(2, $this->runCommand(['paths' => ["$this->directory/does-not-exist"]])->getStatusCode());
+  }
+
+  /**
+   * Tests that --changed checks only the files git reports as changed.
+   *
+   * @param bool $above
+   *   Whether the git working copy is the project directory above the Drupal
+   *   root, as in a Composer project, instead of the Drupal root.
+   */
+  #[DataProvider('providerChanged')]
+  public function testChanged(bool $above): void {
+    if ((new ExecutableFinder())->find('git') === NULL) {
+      $this->markTestSkipped('git is not available.');
+    }
+    $this->writeModule('committed_broken', "name: Committed\ntype: modul\ncore_version_requirement: '*'\n");
+    $identity = ['-c', 'user.name=Test', '-c', 'user.email=test@example.com'];
+    $commands = [['init', '-q'], ['add', '.'], [...$identity, 'commit', '-q', '-m', 'Initial']];
+    foreach ($commands as $arguments) {
+      (new Process(['git', ...$arguments], $above ? $this->project : $this->directory))->mustRun();
+    }
+    $this->writeModule('new_broken', "name: New\ntype: module\n");
+
+    $tester = $this->runCommand(['--changed' => NULL, '--format' => 'json']);
+    $this->assertSame(1, $tester->getStatusCode());
+    $files = array_column(json_decode($tester->getDisplay(), TRUE)['violations'], 'file');
+    $this->assertSame(['modules/custom/new_broken/new_broken.info.yml'], $files);
+
+    $tester = $this->runCommand(['--format' => 'json']);
+    $files = array_column(json_decode($tester->getDisplay(), TRUE)['violations'], 'file');
+    $expected = [
+      'modules/custom/committed_broken/committed_broken.info.yml',
+      'modules/custom/new_broken/new_broken.info.yml',
+    ];
+    $this->assertSame($expected, $files);
+
+    $this->assertSame(2, $this->runCommand(['--changed' => 'not-a-commit'])->getStatusCode());
+  }
+
+  /**
+   * Data provider for testChanged().
+   *
+   * @return array
+   *   Test cases.
+   */
+  public static function providerChanged(): array {
+    return [
+      'git working copy is the Drupal root' => [FALSE],
+      'git working copy is above the Drupal root' => [TRUE],
+    ];
+  }
+
+  /**
+   * Tests that --php-lint finds compile-time errors.
+   */
+  public function testPhpLint(): void {
+    if (!function_exists('proc_open')) {
+      $this->markTestSkipped('proc_open() is not available.');
+    }
+    $this->writeModule('compile_error', "name: Compile\ntype: module\ncore_version_requirement: '*'\n", "<?php\n\nfunction compile_error_test(\$a, \$a) {\n}\n");
+    $this->assertSame(0, $this->runCommand()->getStatusCode(), 'The built-in check finds parse errors only.');
+
+    $tester = $this->runCommand(['--php-lint' => TRUE]);
+    $this->assertSame(1, $tester->getStatusCode());
+    $this->assertStringContainsString('modules/custom/compile_error/compile_error.module:3: error [php.lint] Fatal error: Redefinition of parameter $a', $tester->getDisplay());
+  }
+
+}
