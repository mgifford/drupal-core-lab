+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\system\Kernel\System;
+
+use Drupal\Core\Site\Settings;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Tests the HTML5 validation settings behavior.
+ *
+ * Validates the logic used in SystemRequirementsHooks and FormPreprocess
+ * without requiring a full Drupal kernel bootstrap.
+ */
+#[Group('system')]
+class Html5ValidationRequirementsTest extends TestCase {
+
+  /**
+   * Tests that enable_html5_validation defaults to FALSE when not set.
+   */
+  public function testDefaultSettingIsFalse(): void {
+    new Settings([]);
+    // The default in FormPreprocess is FALSE when the setting is missing.
+    $this->assertFalse(Settings::get('enable_html5_validation', FALSE));
+  }
+
+  /**
+   * Tests that enable_html5_validation returns FALSE when explicitly set.
+   */
+  public function testSettingFalseReturnsFalse(): void {
+    new Settings(['enable_html5_validation' => FALSE]);
+    $this->assertFalse(Settings::get('enable_html5_validation', FALSE));
+  }
+
+  /**
+   * Tests that enable_html5_validation returns TRUE when explicitly set.
+   */
+  public function testSettingTrueReturnsTrue(): void {
+    new Settings(['enable_html5_validation' => TRUE]);
+    // When set to TRUE, the condition === TRUE is used in SystemRequirementsHooks.
+    $this->assertTrue(Settings::get('enable_html5_validation') === TRUE);
+  }
+
+  /**
+   * Tests that the condition used in SystemRequirementsHooks works correctly.
+   */
+  public function testSystemRequirementsConditionBehavior(): void {
+    // Simulates the condition at SystemRequirementsHooks.php:1234
+    // if (Settings::get('enable_html5_validation') === TRUE)
+
+    // Case 1: Setting not set - should NOT trigger warning
+    new Settings([]);
+    $this->assertFalse(Settings::get('enable_html5_validation') === TRUE,
+      'Warning should not appear when setting is not set');
+
+    // Case 2: Setting FALSE - should NOT trigger warning
+    new Settings(['enable_html5_validation' => FALSE]);
+    $this->assertFalse(Settings::get('enable_html5_validation') === TRUE,
+      'Warning should not appear when setting is FALSE');
+
+    // Case 3: Setting TRUE - SHOULD trigger warning
+    new Settings(['enable_html5_validation' => TRUE]);
+    $this->assertTrue(Settings::get('enable_html5_validation') === TRUE,
+      'Warning should appear when setting is TRUE');
+  }
+
+  /**
+   * Tests that the condition used in FormPreprocess works correctly.
+   */
+  public function testFormPreprocessConditionBehavior(): void {
+    // Simulates the condition at FormPreprocess.php:37
+    // if (!Settings::get('enable_html5_validation', FALSE))
+
+    // Case 1: Setting not set - should add novalidate
+    new Settings([]);
+    $this->assertTrue(!Settings::get('enable_html5_validation', FALSE),
+      'novalidate should be added when setting is not set');
+
+    // Case 2: Setting FALSE - should add novalidate
+    new Settings(['enable_html5_validation' => FALSE]);
+    $this->assertTrue(!Settings::get('enable_html5_validation', FALSE),
+      'novalidate should be added when setting is FALSE');
+
+    // Case 3: Setting TRUE - should NOT add novalidate
+    new Settings(['enable_html5_validation' => TRUE]);
+    $this->assertFalse(!Settings::get('enable_html5_validation', FALSE),
+      'novalidate should NOT be added when setting is TRUE');
+  }
+
+}
diff --git a/core/tests/Drupal/Tests/Core/Form/FormPreprocessTest.php b/core/tests/Drupal/Tests/Core/Form/FormPreprocessTest.php
