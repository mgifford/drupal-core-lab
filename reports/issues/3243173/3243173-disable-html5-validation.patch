+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\Core\Form;
+
+use Drupal\Core\Form\FormPreprocess;
+use Drupal\Core\Site\Settings;
+use Drupal\Tests\UnitTestCase;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+
+/**
+ * Tests Drupal\Core\Form\FormPreprocess.
+ */
+#[CoversClass(FormPreprocess::class)]
+#[Group('Form')]
+class FormPreprocessTest extends UnitTestCase {
+
+  /**
+   * The form preprocess instance.
+   *
+   * @var \Drupal\Core\Form\FormPreprocess
+   */
+  protected $formPreprocess;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->formPreprocess = new FormPreprocess();
+  }
+
+  /**
+   * Tests that novalidate is added when enable_html5_validation is FALSE.
+   */
+  public function testNovalidateAddedWhenSettingFalse(): void {
+    new Settings(['enable_html5_validation' => FALSE]);
+
+    $variables = [
+      'element' => [
+        '#action' => '/test',
+        '#method' => 'post',
+        '#attributes' => [],
+        '#children' => '',
+      ],
+    ];
+
+    $this->formPreprocess->preprocessForm($variables);
+    $this->assertTrue($variables['attributes']['novalidate']);
+  }
+
+  /**
+   * Tests that novalidate is added when enable_html5_validation is not set.
+   */
+  public function testNovalidateAddedWhenSettingNotSet(): void {
+    new Settings([]);
+
+    $variables = [
+      'element' => [
+        '#action' => '/test',
+        '#method' => 'post',
+        '#attributes' => [],
+        '#children' => '',
+      ],
+    ];
+
+    $this->formPreprocess->preprocessForm($variables);
+    $this->assertTrue($variables['attributes']['novalidate']);
+  }
+
+  /**
+   * Tests that novalidate is NOT added when enable_html5_validation is TRUE.
+   */
+  public function testNovalidateNotAddedWhenSettingTrue(): void {
+    new Settings(['enable_html5_validation' => TRUE]);
+
+    $variables = [
+      'element' => [
+        '#action' => '/test',
+        '#method' => 'post',
+        '#attributes' => [],
+        '#children' => '',
+      ],
+    ];
+
+    $this->formPreprocess->preprocessForm($variables);
+    $this->assertArrayNotHasKey('novalidate', $variables['attributes']);
+  }
+
+}
