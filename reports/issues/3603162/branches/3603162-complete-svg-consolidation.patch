+  --admin-icon-php: url("../../images/logos/php.svg");
+  --admin-icon-prev: url("../../images/icons/pager-prev.svg");
+  --admin-icon-remove: url("../../images/icons/close.svg");
+  --admin-icon-search: url("../../images/icons/search.svg");
+  --admin-icon-server: url("../../images/icons/server.svg");
+  --admin-icon-show: url("../../images/icons/show.svg");
+  --admin-icon-sidebar: url("../../images/icons/sidebar.svg");
+  --admin-icon-sort: url("../../images/icons/sort.svg");
+  --admin-icon-sort-asc: url("../../images/icons/sort-asc.svg");
+  --admin-icon-sort-desc: url("../../images/icons/sort-desc.svg");
+  --admin-icon-status: url("../../images/icons/status.svg");
+  --admin-icon-tabledrag-handle: url("../../images/icons/tabledrag-handle.svg");
+  --admin-icon-toggle-unchecked: url("../../images/icons/toggle-unchecked.svg");
+  --admin-icon-trash: url("../../images/icons/trash.svg");
+  --admin-icon-warning: url("../../images/icons/warning.svg");
+}
+
+/*
+ * cspell:ignore pretint Pre-tinted
+ * Pre-tinted variants.
+ *
+ * Only for elements that cannot host a masked ::before/::after: native
+ * <select>, checkbox <input>, and <input type="submit">. Masking the control
+ * itself would clip its border and fill, and a url() to a currentColor master
+ * renders black as a background-image, so these contexts point at derived
+ * copies in images/icons/pretint/. Everything else uses mask-image +
+ * background-color with the masters above.
+ *
+ * Each pretint is the master's exact markup with only currentColor replaced
+ * by a baked hex. SVG used as an image cannot read var(), so each hex is a
+ * frozen snapshot of a color token; update the file if the token changes.
+ *
+ *   master             pretint                     hex      token snapshot
+ *   check.svg          check-inverse.svg           #ffffff  --admin-color-white
+ *   check.svg          check-disabled.svg          #767676  --admin-color-gray-700
+ *   check.svg          check-disabled-inverse.svg  #adaeb3  --admin-color-gray-400
+ *   chevron-down.svg   chevron-down-inverse.svg    #ffffff  --admin-color-white
+ *   chevron-down.svg   chevron-down-disabled.svg   #767676  --admin-color-gray-700
+ *   chevron-down.svg   chevron-down-disabled-inverse.svg  #adaeb3  --admin-color-gray-400
+ *   close.svg          remove-inverse.svg          #ffffff  --admin-color-white
+ *   pencil.svg         edit-inverse.svg            #ffffff  --admin-color-white
+ *   loader.svg         loader-inverse.svg          #ffffff  --admin-color-white
+ *   loader.svg         loader-contrast.svg         #111111  --admin-color-text-on-primary dark-mode value
+ *
+ * Do not add to this list unless a native control leaves no other option.
+ */
+:root {
+  --admin-icon-checked-inverse: url("../../images/icons/pretint/check-inverse.svg");
+  --admin-icon-checked-disabled: url("../../images/icons/pretint/check-disabled.svg");
+  --admin-icon-checked-disabled-inverse: url("../../images/icons/pretint/check-disabled-inverse.svg");
+  --admin-icon-chevron-down-inverse: url("../../images/icons/pretint/chevron-down-inverse.svg");
+  --admin-icon-chevron-down-disabled: url("../../images/icons/pretint/chevron-down-disabled.svg");
+  --admin-icon-chevron-down-disabled-inverse: url("../../images/icons/pretint/chevron-down-disabled-inverse.svg");
+  --admin-icon-edit-inverse: url("../../images/icons/pretint/edit-inverse.svg");
+  --admin-icon-loader-inverse: url("../../images/icons/pretint/loader-inverse.svg");
+  --admin-icon-loader-contrast: url("../../images/icons/pretint/loader-contrast.svg");
+  --admin-icon-remove-inverse: url("../../images/icons/pretint/remove-inverse.svg");
+}
+
+/**
+ * Monochrome icon via CSS mask.
+ *
+ * Usage: set --admin-icon to a registry custom property above, e.g.
+ * `--admin-icon: var(--admin-icon-help);`, and optionally --admin-icon-size.
+ * The icon is tinted by background-color (currentColor by default), so it
+ * follows the text color, themes, and dark mode. Note that `fill:
+ * currentColor` inside the SVG does NOT tint a mask-image; only the element's
+ * background-color does.
+ */
+.admin-icon {
+  display: inline-block;
+  flex-shrink: 0;
+  inline-size: var(--admin-icon-size, var(--admin-icon-size-m));
+  block-size: var(--admin-icon-size, var(--admin-icon-size-m));
+  background-color: currentColor;
+  mask-image: var(--admin-icon, none);
+  mask-repeat: no-repeat;
+  mask-position: center;
+  mask-size: contain;
+}
+
+@media (forced-colors: active) {
+  .admin-icon {
+    background-color: CanvasText;
+  }
 }
