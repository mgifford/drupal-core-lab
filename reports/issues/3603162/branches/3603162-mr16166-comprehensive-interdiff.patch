diff --git a/core/themes/default_admin/css/components/form--checkbox-radio.css b/core/themes/default_admin/css/components/form--checkbox-radio.css
index 356cb9de..aed94c11 100644
--- a/core/themes/default_admin/css/components/form--checkbox-radio.css
+++ b/core/themes/default_admin/css/components/form--checkbox-radio.css
@@ -231,6 +231,18 @@
 .form-boolean--type-checkbox[disabled]:checked {
   background-image: var(--admin-icon-checked-disabled);
 }
+/*
+ * The dark-mode disabled surface is darker than the light-mode surface, so
+ * the light-mode gray check (gray-700) no longer separates from it. This is a
+ * discernibility improvement for a disabled control, not a WCAG 1.4.11 fix:
+ * inactive controls are exempt. Forced colors uses the native control, so the
+ * override is limited to non-forced-colors.
+ */
+@media (forced-colors: none) {
+  .dark-mode .form-boolean--type-checkbox[disabled]:checked {
+    background-image: var(--admin-icon-checked-disabled-inverse);
+  }
+}
 .form-boolean--type-radio[disabled]:checked,
 .form-boolean--type-radio[disabled].error:checked {
   /* Same ring-and-dot technique as enabled radios; no image asset needed. */
