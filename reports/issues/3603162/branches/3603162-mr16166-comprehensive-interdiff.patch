+++ b/core/themes/default_admin/css/components/autocomplete-loading.module.pcss.css
@@ -9,6 +9,33 @@
 .admin-autocomplete {
   position: relative;
   width: fit-content;
+
+  /*
+   * The search affordance. The icon is a mask on the wrapper because the
+   * input itself cannot host a pseudo-element, and an external SVG used as a
+   * background image cannot inherit the input's currentColor. The wrapper is
+   * only rendered for autocomplete inputs (see input.html.twig).
+   */
+  &::before {
+    position: absolute;
+    z-index: 1;
+    width: 1rem;
+    height: 1rem;
+    content: "";
+    transform: translateY(-50%);
+    pointer-events: none;
+    background-color: var(--admin-color-gray-500);
+    mask-image: var(--admin-icon-search);
+    mask-repeat: no-repeat;
+    mask-position: center;
+    mask-size: contain;
+    inset-block-start: 50%;
+    inset-inline-end: var(--input-border-size);
+
+    @media (forced-colors: active) {
+      background-color: CanvasText;
+    }
+  }
 }
 
 /* The "Loading" message gets positioned to the top right. */
@@ -48,15 +75,16 @@
 .form-autocomplete {
   margin-inline-end: calc(var(--input-border-size) - 1.5 * var(--input-padding-horizontal));
   padding-inline-end: 36px;
-  background-image: var(--admin-icon-search-muted);
-  background-repeat: no-repeat;
-  background-position: 100% 50%;
-  background-size: 1rem 1rem;
+}
 
-  &:dir(rtl) {
-    background-image: var(--admin-icon-search-muted-rtl);
-    background-position: 0 50%;
-  }
+/*
+ * The wrapper places the icon at the inline end. On this native input
+ * Chromium resolves the logical padding against the document direction
+ * inconsistently, so mirror the physical sides explicitly for RTL.
+ */
+[dir="rtl"] .form-autocomplete {
+  padding-right: var(--input-padding-horizontal);
+  padding-left: 36px;
 }
 
