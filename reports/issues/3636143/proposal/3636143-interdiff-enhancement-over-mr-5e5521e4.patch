+++ b/core/modules/navigation/css/components/admin-toolbar.css
@@ -166,8 +166,33 @@ body {
     border-radius: 50%;
     background-color: transparent;
 
-    &:hover {
+    &:hover,
+    &:focus-visible {
       color: var(--admin-toolbar-color-gray-990);
+      border-color: var(--admin-toolbar-color-gray-990);
+      background-color: var(--admin-toolbar-color-gray-050);
+
+      /* A second ring inside the border: thicker without changing the layout. */
+      box-shadow: inset 0 0 0 1px var(--admin-toolbar-color-gray-990);
+    }
+
+    &:focus-visible {
+      outline: var(--admin-toolbar-size-focus) solid var(--admin-toolbar-color-focus);
+      outline-offset: 2px;
+    }
+
+    @media (forced-colors: active) {
+      &:hover,
+      &:focus-visible {
+        color: ButtonText;
+        border-color: Highlight;
+        outline: 2px solid Highlight;
+        outline-offset: -3px;
+      }
+
+      &:focus-visible {
+        outline-offset: 2px;
+      }
     }
 
     @media (min-width: 64rem) {
