diff --git a/core/modules/navigation/css/components/admin-toolbar.css b/core/modules/navigation/css/components/admin-toolbar.css
index afa4d8db7b53d197d304ab47a504d7407d781896..472fe48c9f991aee61b36a8248e6848c363b52e6 100644
--- a/core/modules/navigation/css/components/admin-toolbar.css
+++ b/core/modules/navigation/css/components/admin-toolbar.css
@@ -166,8 +166,31 @@ body {
     border-radius: 50%;
     background-color: transparent;
 
-    &:hover {
+    &:hover,
+    &:focus-visible {
       color: var(--admin-toolbar-color-gray-990);
+      border-color: var(--admin-toolbar-color-gray-990);
+      background-color: var(--admin-toolbar-color-gray-050);
+      /* Doubles the visible border width without changing the box size. */
+      box-shadow: inset 0 0 0 1px var(--admin-toolbar-color-gray-990);
+    }
+
+    /* The focus outline itself is set in admin-reset-styles.pcss.css. */
+    &:focus-visible {
+      outline-offset: 2px;
+    }
+
+    /* Box shadows are not painted in forced colors mode. */
+    @media (forced-colors: active) {
+      &:focus-visible {
+        border-color: buttonText;
+        outline-color: highlight;
+      }
+
+      /* Declared after :focus-visible so hovering a focused button shows. */
+      &:hover {
+        border-color: highlight;
+      }
     }
 
     @media (min-width: 64rem) {
