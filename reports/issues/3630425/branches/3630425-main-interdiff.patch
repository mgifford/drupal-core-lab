+  /**
+   * Tests the actions-column header before and after widget AJAX updates.
+   */
+  #[DataProvider('providerActionsColumnHeaderThemes')]
+  public function testActionsColumnHeader(string $theme): void {
+    $this->container->get('theme_installer')->install([$theme]);
+    $this->config('system.theme')->set('default', $theme)->save();
+    $this->drupalGet('entity_test/add');
+
+    $assert_session = $this->assertSession();
+    $page = $this->getSession()->getPage();
+    $header = '[data-drupal-selector="edit-field-unlimited-wrapper"] .field-multiple-table thead th:nth-child(2)';
+    $assert_session->elementTextEquals('css', $header, 'Operations');
+    $assert_session->elementExists('css', $header . ' .visually-hidden');
+
+    $page->findButton('field_unlimited_add_more')->click();
+    $this->assertNotEmpty($assert_session->waitForField('field_unlimited[1][value]'));
+    $assert_session->elementTextEquals('css', $header, 'Operations');
+
+    $page->findButton('field_unlimited_1_remove_button')->click();
+    $assert_session->assertWaitOnAjaxRequest();
+    $assert_session->elementTextEquals('css', $header, 'Operations');
+    $assert_session->elementExists('css', $header . ' .visually-hidden');
+  }
+
+  /**
+   * Provides themes for the multi-value actions-column header regression test.
+   */
+  public static function providerActionsColumnHeaderThemes(): array {
+    return [
+      'Stark' => ['stark'],
+      'Default Admin' => ['default_admin'],
+    ];
+  }
+
