+      ->willReturn('summary');
+
+    $form = [
+      '#parents' => [],
+      '#form_id' => 'test_form',
+      '#array_parents' => [],
+    ];
+    $form['table'] = [
+      '#type' => 'table',
+      '#caption' => 'Table caption',
+      '#parents' => ['table'],
+      '#array_parents' => ['table'],
+      '#id' => 'edit-table',
+      '#attributes' => [],
+    ];
+    $form['details'] = [
+      '#type' => 'details',
+      '#title' => 'Details',
+      '#parents' => ['details'],
+      '#array_parents' => ['details'],
+      '#id' => 'edit-details',
+    ];
+    $form['details']['table'] = [
+      '#type' => 'table',
+      '#parents' => ['details', 'table'],
+      '#array_parents' => ['details', 'table'],
+      '#id' => 'edit-details-table',
+      '#attributes' => [],
+    ];
+
+    $form_state = new FormState();
+    $form_state->setErrorByName('table', 'No rows selected.');
+    $form_state->setErrorByName('details', 'Details error.');
+    $this->formErrorHandler->handleFormErrors($form, $form_state);
+
+    $this->assertSame('No rows selected.', $form['table']['#errors']);
+    $this->assertTrue($form['table']['#inline_form_errors_own_error']);
+    $this->assertArrayNotHasKey('#theme_wrappers', $form['table']);
+    $this->assertArrayNotHasKey('#prefix', $form['table']);
+    $this->assertArrayNotHasKey('aria-describedby', $form['table']['#attributes']);
+    // The table inside the details inherited the details error. It must not
+    // be flagged, otherwise the same message would appear twice.
+    $this->assertSame('Details error.', $form['details']['table']['#errors']);
+    $this->assertArrayNotHasKey('#inline_form_errors_own_error', $form['details']['table']);
+  }
+
+  /**
+   * Tests the summary link text for a table without its own title.
+   */
+  public function testTableSummaryLinkText(): void {
+    $this->messenger->expects($this->atLeastOnce())->method('addError');
+
+    $form = [
+      '#parents' => [],
+      '#form_id' => 'test_form',
+      '#array_parents' => [],
+    ];
+    $form['table'] = [
+      '#type' => 'table',
+      '#caption' => 'Table caption',
+      '#parents' => ['table'],
+      '#array_parents' => ['table'],
+      '#id' => 'edit-table',
+      '#attributes' => [],
+    ];
+    $form['no_title'] = [
+      '#type' => 'tableselect',
+      '#parents' => ['no_title'],
+      '#array_parents' => ['no_title'],
+      '#id' => 'edit-no-title',
+      '#attributes' => [],
+      'row1' => [
+        '#type' => 'checkbox',
+        '#title' => 'Update Alpha',
+        '#parents' => ['no_title', 'row1'],
+        '#array_parents' => ['no_title', 'row1'],
+        '#id' => 'edit-no-title-row1',
+      ],
+    ];
+
+    $this->renderer->expects($this->once())
+      ->method('renderInIsolation')
+      ->willReturnCallback(function (array $render_array): string {
+        $titles = [];
+        foreach ($render_array['#error_links'] as $link) {
+          $titles[] = (string) $link['value']['#title'];
+        }
+        $this->assertSame(['Table caption', 'No rows selected.'], $titles);
+        return 'summary';
+      });
+
+    $form_state = new FormState();
+    $form_state->setErrorByName('table', 'No rows selected.');
+    $form_state->setErrorByName('no_title', 'No rows selected.');
+    $this->formErrorHandler->handleFormErrors($form, $form_state);
+  }
+
   /**
    * Tests that the summary render array exposes error_links and form_id.
    */
diff --git a/core/modules/inline_form_errors/tests/src/Unit/RenderElementHelperTest.php b/core/modules/inline_form_errors/tests/src/Unit/RenderElementHelperTest.php
new file mode 100644
index 00000000..f826cfb0
--- /dev/null
+++ b/core/modules/inline_form_errors/tests/src/Unit/RenderElementHelperTest.php
@@ -0,0 +1,169 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\inline_form_errors\Unit;
+
+use Drupal\inline_form_errors\RenderElementHelper;
+use Drupal\Tests\UnitTestCase;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+
+/**
+ * Tests Drupal\inline_form_errors\RenderElementHelper.
+ */
+#[CoversClass(RenderElementHelper::class)]
+#[Group('InlineFormErrors')]
+class RenderElementHelperTest extends UnitTestCase {
+
+  /**
+   * Tests that table pre-render callbacks are added before the default ones.
+   */
+  public function testAlterElementInfo(): void {
+    $callback = static fn (array $element): array => $element;
+    $info = [
+      'table' => [
+        '#pre_render' => [$callback],
+        '#process' => [],
+      ],
+      'tableselect' => [
+        '#pre_render' => [$callback],
+        '#process' => [],
+      ],
+      'textfield' => [
+        '#pre_render' => [],
+        '#process' => [],
+      ],
+    ];
+
+    (new RenderElementHelper())->alterElementInfo($info);
+
+    $table_callbacks = $info['table']['#pre_render'];
+    $this->assertSame([RenderElementHelper::class, 'preRenderTableElement'], $table_callbacks[0]);
+    $this->assertSame($callback, $table_callbacks[1]);
+    $select_callbacks = $info['tableselect']['#pre_render'];
+    $this->assertSame([RenderElementHelper::class, 'preRenderTableElement'], $select_callbacks[0]);
+    $this->assertSame($callback, $select_callbacks[1]);
+    // Other element types do not get the table pre-render callback.
+    $this->assertSame([], $info['textfield']['#pre_render']);
+    // Every element type gets the process callback.
+    $this->assertSame([RenderElementHelper::class, 'processElement'], $info['textfield']['#process'][0]);
+  }
+
+  /**
+   * Tests that a table with its own error gets the error wrapper.
+   */
+  public function testPreRenderTableElementWithError(): void {
+    $element = [
+      '#type' => 'tableselect',
+      '#id' => 'edit-table',
+      '#inline_form_errors_own_error' => TRUE,
+      '#errors' => 'No rows selected.',
+      '#attributes' => [
+        'aria-describedby' => 'table-help',
+        'data-test' => 'value',
+      ],
+      'row1' => [
+        '#type' => 'checkbox',
+        '#id' => 'edit-table-row1',
+        '#errors' => 'No rows selected.',
+      ],
+      'row2' => [
+        '#type' => 'checkbox',
+        '#id' => 'edit-table-row2',
+        '#errors' => 'A different error.',
+      ],
+      'row3' => [
+        '#type' => 'container',
+        'field' => [
+          '#type' => 'textfield',
+          '#errors' => 'No rows selected.',
+        ],
+      ],
+      'row4' => [
+        '#type' => 'table',
+        '#id' => 'edit-nested-table',
+        '#inline_form_errors_own_error' => TRUE,
+        '#errors' => 'No rows selected.',
+      ],
+    ];
+
+    $result = RenderElementHelper::preRenderTableElement($element);
+
+    $this->assertSame('edit-table--error', $result['#inline_form_errors_error_id']);
+    $this->assertContains('inline_form_errors_table', $result['#theme_wrappers']);
+    $this->assertSame('edit-table--error table-help', $result['#attributes']['aria-describedby']);
+    $this->assertSame('-1', $result['#attributes']['tabindex']);
+    $this->assertSame('value', $result['#attributes']['data-test']);
+    // The inherited error is removed from direct and nested children, so it
+    // is not repeated and does not mark every control invalid.
+    $this->assertNull($result['row1']['#errors']);
+    $this->assertTrue($result['row1']['#error_no_message']);
+    $this->assertNull($result['row3']['field']['#errors']);
+    $this->assertTrue($result['row3']['field']['#error_no_message']);
+    // An error that belongs to a child is kept.
+    $this->assertSame('A different error.', $result['row2']['#errors']);
+    $this->assertArrayNotHasKey('#error_no_message', $result['row2']);
+    // A nested table with its own error keeps it and clears its own subtree.
+    $this->assertSame('No rows selected.', $result['row4']['#errors']);
+    $this->assertArrayNotHasKey('#error_no_message', $result['row4']);
+  }
+
+  /**
+   * Tests that unrelated table elements are not changed.
+   */
+  public function testPreRenderTableElementWithoutOwnError(): void {
+    $element = [
+      '#type' => 'table',
+      '#id' => 'edit-table',
+      '#errors' => 'Inherited error.',
+      '#attributes' => [],
+    ];
+
+    $result = RenderElementHelper::preRenderTableElement($element);
+
+    $this->assertArrayNotHasKey('#theme_wrappers', $result);
+    $this->assertSame([], $result['#attributes']);
+  }
+
+  /**
+   * Tests that an error can be suppressed and that an id is required.
+   */
+  public function testPreRenderTableElementSuppressedAndWithoutId(): void {
+    $suppressed = [
+      '#type' => 'table',
+      '#id' => 'edit-table',
+      '#inline_form_errors_own_error' => TRUE,
+      '#errors' => 'No rows selected.',
+      '#error_no_message' => TRUE,
+      '#attributes' => [],
+    ];
+    $this->assertArrayNotHasKey('#theme_wrappers', RenderElementHelper::preRenderTableElement($suppressed));
+
+    $without_id = [
+      '#type' => 'table',
+      '#inline_form_errors_own_error' => TRUE,
+      '#errors' => 'No rows selected.',
+      '#attributes' => [],
+    ];
+    $this->assertArrayNotHasKey('#theme_wrappers', RenderElementHelper::preRenderTableElement($without_id));
+  }
+
+  /**
+   * Tests that an existing error ID in aria-describedby is not duplicated.
+   */
+  public function testPreRenderTableElementDeduplicatesDescribedby(): void {
+    $element = [
+      '#type' => 'table',
+      '#id' => 'edit-table',
+      '#inline_form_errors_own_error' => TRUE,
+      '#errors' => 'No rows selected.',
+      '#attributes' => ['aria-describedby' => 'edit-table--error other-help'],
+    ];
+
+    $result = RenderElementHelper::preRenderTableElement($element);
+
+    $this->assertSame('edit-table--error other-help', $result['#attributes']['aria-describedby']);
+  }
+
+}
