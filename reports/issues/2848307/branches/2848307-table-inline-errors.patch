diff --git a/core/modules/inline_form_errors/templates/inline-form-errors-table.html.twig b/core/modules/inline_form_errors/templates/inline-form-errors-table.html.twig
new file mode 100644
index 00000000..02d073a1
--- /dev/null
+++ b/core/modules/inline_form_errors/templates/inline-form-errors-table.html.twig
@@ -0,0 +1,28 @@
+{#
+/**
+ * @file
+ * Default theme implementation for a table form element with inline errors.
+ *
+ * The wrapper is only added to a table or tableselect form element that has
+ * its own validation error. Ordinary data tables are not wrapped.
+ *
+ * Available variables:
+ * - errors: The validation error message for the table.
+ * - error_id: The HTML ID of the error message container. The table refers to
+ *   it with aria-describedby.
+ * - children: The rendered table.
+ *
+ * @see \Drupal\inline_form_errors\RenderElementHelper::preRenderTableElement()
+ * @see \Drupal\inline_form_errors\Hook\InlineFormErrorsThemeHooks::preprocessInlineFormErrorsTable()
+ *
+ * @ingroup themeable
+ */
+#}
+<div class="form-item form-type-table form-item--error">
+  {% if errors %}
+    <div id="{{ error_id }}" class="form-item--error-message form-item__error-message">
+      {{ errors }}
+    </div>
+  {% endif %}
+  {{ children }}
+</div>
