+++ b/core/modules/inline_form_errors/tests/src/Functional/TableElementInlineErrorsTest.php
@@ -0,0 +1,206 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\inline_form_errors\Functional;
+
+use Drupal\Tests\BrowserTestBase;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests inline errors on table and tableselect form elements.
+ */
+#[Group('InlineFormErrors')]
+#[RunTestsInSeparateProcesses]
+class TableElementInlineErrorsTest extends BrowserTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = ['form_test', 'inline_form_errors'];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * Submits a table error test form and returns the assertion session.
+   */
+  protected function submitVariant(string $variant, array $edit = []): void {
+    $this->drupalGet('form-test/table-error/' . $variant);
+    $this->submitForm($edit, 'Submit');
+  }
+
+  /**
+   * Asserts the group-level inline error and its association with a table.
+   */
+  protected function assertTableError(string $id, string $message): void {
+    $assert_session = $this->assertSession();
+    $assert_session->elementsCount('css', '.form-item--error-message', 1);
+    $assert_session->elementExists('css', '#' . $id . '--error');
+    $assert_session->elementTextContains('css', '#' . $id . '--error', $message);
+    $assert_session->elementAttributeContains('css', 'table#' . $id, 'aria-describedby', $id . '--error');
+    $assert_session->elementAttributeContains('css', 'table#' . $id, 'tabindex', '-1');
+    $assert_session->linkByHrefExists('#' . $id);
+  }
+
+  /**
+   * Tests that an ordinary data table is not changed.
+   */
+  public function testOrdinaryTableUnaffected(): void {
+    $this->drupalGet('form-test/table-error/no-error');
+    $assert_session = $this->assertSession();
+    $assert_session->elementExists('css', 'table#edit-table');
+    $assert_session->elementAttributeNotExists('css', 'table#edit-table', 'aria-describedby');
+    $assert_session->elementAttributeNotExists('css', 'table#edit-table', 'tabindex');
+    $assert_session->elementNotExists('css', '#edit-table--error');
+    $assert_session->elementNotExists('css', '.form-item--error-message');
+  }
+
+  /**
+   * Tests a table element with its own error.
+   */
+  public function testTableElementError(): void {
+    $this->submitVariant('table');
+    $this->assertTableError('edit-table', 'No rows selected.');
+    $this->assertSession()->linkExists('A table with an error');
+  }
+
+  /**
+   * Tests a tableselect with checkboxes and a group-level error.
+   */
+  public function testTableselectCheckboxes(): void {
+    $this->submitVariant('tableselect-checkboxes');
+    $this->assertTableError('edit-tableselect', 'No rows selected.');
+    $assert_session = $this->assertSession();
+    $assert_session->linkExists('Rows to update');
+    // The group error must not be repeated on, or invalidate, every row.
+    $assert_session->elementAttributeNotExists('css', 'input[name="tableselect[row1]"]', 'aria-invalid');
+    $assert_session->elementAttributeNotExists('css', 'input[name="tableselect[row2]"]', 'aria-invalid');
+  }
+
+  /**
+   * Tests a tableselect with radio buttons and a group-level error.
+   */
+  public function testTableselectRadios(): void {
+    $this->submitVariant('tableselect-radios');
+    $this->assertTableError('edit-tableselect', 'No rows selected.');
+    $assert_session = $this->assertSession();
+    $assert_session->linkExists('Rows to update');
+    $assert_session->elementAttributeNotExists('css', 'input[name="tableselect"]', 'aria-invalid');
+  }
+
+  /**
+   * Tests a table with #tableselect enabled.
+   */
+  public function testTableWithTableselect(): void {
+    $this->submitVariant('table-tableselect');
+    $this->assertTableError('edit-table', 'No rows selected.');
+    $assert_session = $this->assertSession();
+    $assert_session->elementAttributeNotExists('css', 'input#edit-table-row1', 'aria-invalid');
+    $assert_session->elementAttributeNotExists('css', 'input#edit-table-row2', 'aria-invalid');
+    // Without a title or caption, the error text is the summary link text.
+    $assert_session->linkExists('No rows selected.');
+  }
+
+  /**
+   * Tests that a child element error stays on its own control.
+   */
+  public function testChildError(): void {
+    $this->submitVariant('child-error');
+    $assert_session = $this->assertSession();
+    $assert_session->pageTextContains('Name in table field is required.');
+    $assert_session->elementsCount('css', '.form-item--error-message', 1);
+    $assert_session->elementExists('css', 'input#edit-table-row1-name[aria-invalid="true"]');
+    // The table itself has no error, so it must not be associated with one.
+    $assert_session->elementAttributeNotExists('css', 'table#edit-table', 'aria-describedby');
+    $assert_session->elementNotExists('css', '#edit-table--error');
+  }
+
+  /**
+   * Tests two tables with errors on the same page.
+   */
+  public function testMultipleTables(): void {
+    $this->submitVariant('multiple');
+    $assert_session = $this->assertSession();
+    $assert_session->elementsCount('css', '.form-item--error-message', 2);
+    $assert_session->elementExists('css', '#edit-table-one--error');
+    $assert_session->elementExists('css', '#edit-table-two--error');
+    $assert_session->elementAttributeContains('css', 'table#edit-table-one', 'aria-describedby', 'edit-table-one--error');
+    $assert_session->elementAttributeContains('css', 'table#edit-table-two', 'aria-describedby', 'edit-table-two--error');
+    $assert_session->linkByHrefExists('#edit-table-one');
+    $assert_session->linkByHrefExists('#edit-table-two');
+  }
+
+  /**
+   * Tests that an error on a parent of a table is not repeated at the table.
+   */
+  public function testDetailsTableErrorIsNotRepeated(): void {
+    $this->submitVariant('details-table');
+    $assert_session = $this->assertSession();
+    $assert_session->pageTextContains('No rows selected.');
+    // The details element owns the error. The table inside it must not show
+    // or be associated with a duplicate.
+    $assert_session->elementAttributeNotExists('css', 'table#edit-table', 'aria-describedby');
+    $assert_session->elementNotExists('css', '#edit-table--error');
+  }
+
+  /**
+   * Tests that an author-supplied aria-describedby is preserved.
+   */
+  public function testExistingDescribedbyIsPreserved(): void {
+    $this->submitVariant('existing-describedby');
+    $assert_session = $this->assertSession();
+    $assert_session->elementExists('css', '#table-help');
+    $assert_session->elementAttributeContains('css', 'table#edit-table', 'aria-describedby', 'table-help');
+    $assert_session->elementAttributeContains('css', 'table#edit-table', 'aria-describedby', 'edit-table--error');
+  }
+
+  /**
+   * Tests that a table #description reference is kept when an error is added.
+   */
+  public function testTableDescriptionIsPreserved(): void {
+    $this->submitVariant('described-table');
+    $this->assertSession()->elementAttributeContains('css', 'table#edit-table', 'aria-describedby', 'edit-table--error');
+    $this->assertSession()->elementAttributeContains('css', 'table#edit-table', 'aria-describedby', 'edit-table--description');
+  }
+
+  /**
+   * Tests that #error_no_message suppresses the table error.
+   */
+  public function testSuppressedError(): void {
+    $this->submitVariant('suppressed');
+    $assert_session = $this->assertSession();
+    $assert_session->elementNotExists('css', '.form-item--error-message');
+    $assert_session->elementNotExists('css', '#edit-table--error');
+    $assert_session->elementAttributeNotExists('css', 'table#edit-table', 'aria-describedby');
+  }
+
+  /**
+   * Tests that inline form errors can be disabled for the whole form.
+   */
+  public function testInlineFormErrorsDisabled(): void {
+    $this->submitVariant('no-ife');
+    $assert_session = $this->assertSession();
+    $assert_session->pageTextContains('No rows selected.');
+    $assert_session->elementNotExists('css', '.form-item--error-message');
+    $assert_session->elementAttributeNotExists('css', 'table#edit-table', 'aria-describedby');
+  }
+
+  /**
+   * Tests correcting the error and resubmitting the form.
+   */
+  public function testCorrectAndResubmit(): void {
+    $this->submitVariant('correct');
+    $this->assertTableError('edit-tableselect', 'Select at least one row.');
+
+    $this->submitVariant('correct', ['tableselect[row1]' => TRUE]);
+    $assert_session = $this->assertSession();
+    $assert_session->pageTextContains('Submitted.');
+    $assert_session->elementNotExists('css', '.form-item--error-message');
+    $assert_session->elementAttributeNotExists('css', 'table#edit-tableselect', 'aria-describedby');
+  }
+
+}
