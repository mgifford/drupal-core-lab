+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\inline_form_errors\FunctionalJavascript;
+
+use Drupal\FunctionalJavascriptTests\WebDriverTestBase;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests focusing a table from the inline errors summary link.
+ */
+#[Group('InlineFormErrors')]
+#[RunTestsInSeparateProcesses]
+class TableElementInlineErrorsTest extends WebDriverTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = ['form_test', 'inline_form_errors'];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * Tests that the summary link moves focus to the table, not the page top.
+   */
+  public function testSummaryLinkFocusesTable(): void {
+    $this->drupalGet('form-test/table-error/tableselect-checkboxes');
+    $this->submitForm([], 'Submit');
+
+    $this->clickLink('Rows to update');
+
+    $this->assertJsCondition('window.location.hash === "#edit-tableselect"');
+    $this->assertJsCondition('document.activeElement.tagName === "TABLE"');
+    $this->assertJsCondition('document.activeElement.id === "edit-tableselect"');
+
+    // The table has focus but is not a tab stop.
+    $this->assertJsCondition('document.activeElement.tabIndex === -1');
+  }
+
+}
