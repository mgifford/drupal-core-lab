+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\form_test\Form;
+
+use Drupal\Core\Form\FormBase;
+use Drupal\Core\Form\FormStateInterface;
+
+/**
+ * Form for testing inline errors on table and tableselect elements.
+ *
+ * @internal
+ */
+class FormTestTableErrorForm extends FormBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getFormId() {
+    return 'form_test_table_error_form';
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function buildForm(array $form, FormStateInterface $form_state, $variant = 'table') {
+    $form['#variant'] = $variant;
+    $form['#error_element'] = 'table';
+
+    switch ($variant) {
+      case 'no-error':
+        $form['table'] = [
+          '#type' => 'table',
+          '#caption' => $this->t('A table without an error'),
+          '#header' => ['Name', 'Value'],
+          '#rows' => [
+            ['Alpha', 'One'],
+            ['Beta', 'Two'],
+          ],
+        ];
+        break;
+
+      case 'table':
+        $form['table'] = [
+          '#type' => 'table',
+          '#caption' => $this->t('A table with an error'),
+          '#header' => ['Name', 'Value'],
+          '#rows' => [
+            ['Alpha', 'One'],
+            ['Beta', 'Two'],
+          ],
+        ];
+        break;
+
+      case 'table-tableselect':
+        $form['table'] = [
+          '#type' => 'table',
+          '#tableselect' => TRUE,
+          '#header' => ['Name', 'Value'],
+          '#empty' => $this->t('Empty text.'),
+        ];
+        $form['table']['row1'] = [
+          'title' => ['#title' => 'Alpha'],
+          'value' => ['#markup' => 'One'],
+        ];
+        $form['table']['row2'] = [
+          'title' => ['#title' => 'Beta'],
+          'value' => ['#markup' => 'Two'],
+        ];
+        break;
+
+      case 'tableselect-radios':
+        $form['tableselect'] = $this->buildTableselect(FALSE);
+        $form['#error_element'] = 'tableselect';
+        break;
+
+      case 'tableselect-checkboxes':
+        $form['tableselect'] = $this->buildTableselect(TRUE);
+        $form['#error_element'] = 'tableselect';
+        break;
+
+      case 'child-error':
+        $form['table'] = [
+          '#type' => 'table',
+          '#caption' => $this->t('A table with a field that has an error'),
+          '#header' => ['Name', 'Value'],
+        ];
+        $form['table']['row1']['name'] = [
+          '#type' => 'textfield',
+          '#title' => $this->t('Name in table'),
+          '#required' => TRUE,
+        ];
+        $form['table']['row1']['value'] = [
+          '#type' => 'textfield',
+          '#title' => $this->t('Value in table'),
+        ];
+        break;
+
+      case 'multiple':
+        $form['table_one'] = [
+          '#type' => 'table',
+          '#caption' => $this->t('First table'),
+          '#header' => ['Name'],
+          '#rows' => [['Alpha']],
+        ];
+        $form['table_two'] = [
+          '#type' => 'tableselect',
+          '#title' => $this->t('Second table'),
+          '#header' => ['name' => 'Name'],
+          '#options' => ['row1' => ['name' => 'Beta']],
+        ];
+        $form['#error_element'] = NULL;
+        break;
+
+      case 'details-table':
+        $form['details'] = [
+          '#type' => 'details',
+          '#title' => $this->t('Details with a table'),
+          '#open' => TRUE,
+        ];
+        $form['details']['table'] = [
+          '#type' => 'table',
+          '#header' => ['Name'],
+          '#rows' => [['Alpha']],
+        ];
+        $form['#error_element'] = 'details';
+        break;
+
+      case 'existing-describedby':
+        $form['table'] = [
+          '#type' => 'table',
+          '#caption' => $this->t('A table with help'),
+          '#header' => ['Name'],
+          '#rows' => [['Alpha']],
+          '#attributes' => ['aria-describedby' => 'table-help'],
+          '#prefix' => '<span id="table-help">Author-supplied help.</span>',
+        ];
+        break;
+
+      case 'suppressed':
+        $form['table'] = [
+          '#type' => 'table',
+          '#caption' => $this->t('A table with a suppressed error'),
+          '#header' => ['Name'],
+          '#rows' => [['Alpha']],
+          '#error_no_message' => TRUE,
+        ];
+        break;
+
+      case 'no-ife':
+        $form['#disable_inline_form_errors'] = TRUE;
+        $form['table'] = [
+          '#type' => 'table',
+          '#caption' => $this->t('A table with inline errors disabled'),
+          '#header' => ['Name'],
+          '#rows' => [['Alpha']],
+        ];
+        break;
+
+      case 'correct':
+        $form['tableselect'] = $this->buildTableselect(TRUE);
+        $form['#error_element'] = 'tableselect';
+        break;
+
+      case 'described-table':
+        $form['table'] = [
+          '#type' => 'table',
+          '#caption' => $this->t('A described table with an error'),
+          '#description' => $this->t('This description is set on the table.'),
+          '#header' => ['Name'],
+          '#rows' => [['Alpha']],
+        ];
+        break;
+
+      default:
+        throw new \InvalidArgumentException("Unknown variant $variant");
+    }
+
+    $form['actions'] = ['#type' => 'actions'];
+    $form['actions']['submit'] = [
+      '#type' => 'submit',
+      '#value' => $this->t('Submit'),
+    ];
+
+    return $form;
+  }
+
+  /**
+   * Builds the tableselect used by several variants.
+   */
+  protected function buildTableselect(bool $multiple): array {
+    return [
+      '#type' => 'tableselect',
+      '#title' => $this->t('Rows to update'),
+      '#header' => ['name' => 'Name', 'value' => 'Value'],
+      '#options' => [
+        'row1' => ['name' => 'Alpha', 'value' => 'One'],
+        'row2' => ['name' => 'Beta', 'value' => 'Two'],
+      ],
+      '#multiple' => $multiple,
+      '#empty' => $this->t('Empty text.'),
+    ];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function validateForm(array &$form, FormStateInterface $form_state): void {
+    $variant = $form['#variant'] ?? 'table';
+    $element = $form['#error_element'] ?? NULL;
+
+    if ($variant === 'correct' && empty(array_filter((array) $form_state->getValue('tableselect')))) {
+      $form_state->setErrorByName('tableselect', $this->t('Select at least one row.'));
+      return;
+    }
+    if ($variant === 'correct' || $variant === 'no-error' || $variant === 'child-error') {
+      return;
+    }
+    if ($variant === 'multiple') {
+      $form_state->setErrorByName('table_one', $this->t('No rows selected in the first table.'));
+      $form_state->setErrorByName('table_two', $this->t('No rows selected in the second table.'));
+      return;
+    }
+    if ($element !== NULL) {
+      $form_state->setErrorByName($element, $this->t('No rows selected.'));
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function submitForm(array &$form, FormStateInterface $form_state): void {
+    $this->messenger()->addStatus($this->t('Submitted.'));
+  }
+
+}
