+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\form_test\Form;
+
+use Drupal\Core\Form\FormBase;
+use Drupal\Core\Form\FormStateInterface;
+
+/**
+ * Form constructor to test aria-invalid on various form element types.
+ *
+ * Provides a form with multiple element types that can be validated
+ * to trigger aria-invalid="true" attributes for accessibility testing.
+ *
+ * @internal
+ */
+class FormTestAriaInvalidForm extends FormBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getFormId() {
+    return 'form_test_aria_invalid_form';
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function buildForm(array $form, FormStateInterface $form_state) {
+    $form['textfield'] = [
+      '#type' => 'textfield',
+      '#title' => 'Textfield',
+      '#required' => TRUE,
+    ];
+    $form['textarea'] = [
+      '#type' => 'textarea',
+      '#title' => 'Textarea',
+      '#required' => TRUE,
+    ];
+    $form['select'] = [
+      '#type' => 'select',
+      '#title' => 'Select',
+      '#options' => ['' => '- None -', 'one' => 'One', 'two' => 'Two'],
+      '#required' => TRUE,
+    ];
+    $form['checkboxes'] = [
+      '#type' => 'checkboxes',
+      '#title' => 'Checkboxes',
+      '#options' => ['one' => 'One', 'two' => 'Two'],
+      '#required' => TRUE,
+      '#element_validate' => ['::validateCheckboxes'],
+    ];
+    $form['radios'] = [
+      '#type' => 'radios',
+      '#title' => 'Radios',
+      '#options' => ['one' => 'One', 'two' => 'Two'],
+      '#required' => TRUE,
+    ];
+    $form['email'] = [
+      '#type' => 'email',
+      '#title' => 'Email',
+      '#required' => TRUE,
+    ];
+    $form['url'] = [
+      '#type' => 'url',
+      '#title' => 'URL',
+      '#maxlength' => 10,
+    ];
+    $form['number'] = [
+      '#type' => 'number',
+      '#title' => 'Number',
+      '#min' => 10,
+      '#max' => 20,
+    ];
+    $form['color'] = [
+      '#type' => 'color',
+      '#title' => 'Color',
+    ];
+    $form['password'] = [
+      '#type' => 'password',
+      '#title' => 'Password',
+      '#required' => TRUE,
+    ];
+    $form['tel'] = [
+      '#type' => 'tel',
+      '#title' => 'Telephone',
+      '#required' => TRUE,
+    ];
+    $form['date'] = [
+      '#type' => 'date',
+      '#title' => 'Date',
+    ];
+    $form['actions'] = ['#type' => 'actions'];
+    $form['actions']['submit'] = ['#type' => 'submit', '#value' => 'Submit'];
+    return $form;
+  }
+
+  /**
+   * Custom validator for checkboxes to trigger required error.
+   */
+  public function validateCheckboxes($element, FormStateInterface $form_state): void {
+    // Checkboxes don't have native required validation, so we validate manually.
+    $value = $form_state->getValue($element['#parents']);
+    $checked = array_filter($value);
+    if (empty($checked)) {
+      $form_state->setError($element, $this->t('@title is required.', ['@title' => $element['#title']]));
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function submitForm(array &$form, FormStateInterface $form_state): void {
+    $this->messenger()->addStatus('The form_test_aria_invalid_form was submitted successfully.');
+  }
+
+}
