+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\lab_radios_2951317\Form;
+
+use Drupal\Core\Form\FormBase;
+use Drupal\Core\Form\FormStateInterface;
+
+/**
+ * Provides identical radio groups on both sides of the lab comparison.
+ *
+ * @internal
+ */
+final class RequiredRadiosForm extends FormBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getFormId(): string {
+    return 'lab_radios_2951317';
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function buildForm(array $form, FormStateInterface $form_state): array {
+    $options = ['red' => $this->t('Red'), 'blue' => $this->t('Blue')];
+    $form['static_required'] = [
+      '#type' => 'radios',
+      '#title' => $this->t('Required color'),
+      '#options' => $options,
+      '#required' => TRUE,
+    ];
+    $form['static_default'] = [
+      '#type' => 'radios',
+      '#title' => $this->t('Required color with default'),
+      '#options' => $options,
+      '#default_value' => 'blue',
+      '#required' => TRUE,
+    ];
+    $form['optional'] = [
+      '#type' => 'radios',
+      '#title' => $this->t('Optional color'),
+      '#options' => $options,
+    ];
+    $form['require_dynamic'] = [
+      '#type' => 'checkbox',
+      '#title' => $this->t('Require a dynamic color'),
+    ];
+    $form['dynamic'] = [
+      '#type' => 'radios',
+      '#title' => $this->t('Dynamic color'),
+      '#options' => ['_none' => $this->t('- None -')] + $options,
+      '#states' => [
+        'required' => [
+          ':input[name="require_dynamic"]' => ['checked' => TRUE],
+        ],
+      ],
+      '#description' => $this->t('Toggle the checkbox with nothing selected, None selected, or a color selected. The selection must be preserved.'),
+    ];
+    $form['actions'] = ['#type' => 'actions'];
+    $form['actions']['submit'] = [
+      '#type' => 'submit',
+      '#value' => $this->t('Save'),
+    ];
+    return $form;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function submitForm(array &$form, FormStateInterface $form_state): void {
+    $this->messenger()->addStatus($this->t('Test form accepted. No content was saved.'));
+    $form_state->setRebuild();
+  }
+
+}
