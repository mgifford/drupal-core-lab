@@ -147,11 +154,23 @@
       // Content can change its size after the dialog opened, for example when
       // a details element opens or an Ajax request adds elements. Recalculate
       // the size and the position, so the dialog stays inside the viewport.
-      const resizeObserver = new ResizeObserver(() => {
-        autoResize({ data: eventData });
-      });
+      let resizeObserver = $element.data('drupalAutoResizeObserver');
+      if (!resizeObserver) {
+        resizeObserver = new ResizeObserver(() => {
+          const latestEventData = $element.data('drupalAutoResizeEventData');
+          $element.data('drupalAutoResize')?.({ data: latestEventData });
+        });
+        $element.data('drupalAutoResizeObserver', resizeObserver);
+      }
