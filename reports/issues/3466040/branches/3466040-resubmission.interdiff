diff --git a/core/misc/dialog/dialog.viewport.css b/core/misc/dialog/dialog.viewport.css
deleted file mode 100644
index fe49eba..0000000
--- a/core/misc/dialog/dialog.viewport.css
+++ /dev/null
@@ -1,56 +0,0 @@
-/**
- * @file
- * Keep auto-resizing modal dialogs inside the available viewport.
- *
- * Content scrolls independently of the title bar and action pane. This is
- * intentionally scoped to modal dialogs managed by Drupal's autoResize API;
- * draggable non-modal dialogs and off-canvas trays are not affected.
- */
-
-.ui-dialog.drupal-dialog--viewport-constrained {
-  position: fixed;
-  top: var(--drupal-dialog-center-y, 50%) !important;
-  left: var(--drupal-dialog-center-x, 50%) !important;
-  box-sizing: border-box;
-  display: flex;
-  flex-direction: column;
-  width: auto;
-  max-width: var(--drupal-dialog-available-width, calc(100vw - 1rem));
-  max-height: var(--drupal-dialog-available-height, calc(100dvh - 1rem));
-  min-width: 0;
-  min-height: 0;
-  overflow: hidden;
-  transform: translate(-50%, -50%);
-}
-
-.ui-dialog.drupal-dialog--viewport-constrained .ui-dialog-titlebar {
-  flex: 0 0 auto;
-  min-width: 0;
-}
-
-.ui-dialog.drupal-dialog--viewport-constrained .ui-dialog-content {
-  flex: 1 1 auto;
-  min-width: 0;
-  min-height: 0 !important;
-  overflow: auto;
-}
-
-.ui-dialog.drupal-dialog--viewport-constrained .ui-dialog-buttonpane {
-  flex: 0 0 auto;
-  min-width: 0;
-  max-height: 40dvh;
-  overflow: auto;
-}
-
-.ui-dialog.drupal-dialog--viewport-constrained .ui-dialog-buttonset {
-  display: flex;
-  float: none;
-  flex-wrap: wrap;
-  justify-content: flex-end;
-}
-
-.ui-dialog.drupal-dialog--viewport-constrained .ui-dialog-buttonset button {
-  max-width: 100%;
-  white-space: normal;
-  overflow-wrap: anywhere;
-}
diff --git a/core/tests/Drupal/FunctionalJavascriptTests/Ajax/DialogTest.php b/core/tests/Drupal/FunctionalJavascriptTests/Ajax/DialogTest.php
index ca3de5e..8abf127 100644
--- a/core/tests/Drupal/FunctionalJavascriptTests/Ajax/DialogTest.php
+++ b/core/tests/Drupal/FunctionalJavascriptTests/Ajax/DialogTest.php
@@ -298,4 +298,74 @@ class DialogTest extends WebDriverTestBase {
     $this->assertSame([], $errors);
   }
 
+  /**
+   * Tests that percentage-height dialogs resize when their content grows.
+   */
+  public function testPercentageHeightDialogResizesAfterContentGrowth(): void {
+    $this->drupalGet('ajax-test/dialog');
+    $this->clickLink('Link 1 (modal)');
+    $dialog = $this->assertSession()->waitForElementVisible('css', '.ui-dialog');
+    $this->assertNotNull($dialog);
+    $close = $dialog->findButton('Close');
+    $this->assertNotNull($close);
+    $close->press();
+
+    $script = <<<'SCRIPT'
+      (function () {
+        const content = document.createElement('div');
+        content.id = 'percentage-height-dialog-content';
+        const expand = document.createElement('button');
+        expand.id = 'expand-percentage-height-dialog';
+        expand.type = 'button';
+        expand.textContent = 'Expand';
+        content.appendChild(expand);
+        document.body.appendChild(content);
+        Drupal.dialog(content, {
+          title: 'Percentage-height dialog',
+          modal: true,
+          height: '50%',
+          width: '50%',
+          buttons: [{ text: 'Save' }],
+        }).showModal();
+        expand.addEventListener('click', function () {
+          const tall = document.createElement('div');
+          tall.style.height = '2000px';
+          content.appendChild(tall);
+        });
+      }())
+      SCRIPT;
+    $this->getSession()->executeScript($script);
+    $dialog = $this->assertSession()->waitForElementVisible('css', '.ui-dialog');
+    $this->assertNotNull($dialog);
+    $expand = $dialog->find('css', '#expand-percentage-height-dialog');
+    $this->assertNotNull($expand);
+    $expand->press();
+
+    $this->assertJsCondition(<<<'SCRIPT'
+      (function () {
+        const content = document.querySelector('#percentage-height-dialog-content');
+        const dialog = content.closest('.ui-dialog');
+        const rect = dialog.getBoundingClientRect();
+        const action = dialog.querySelector('.ui-dialog-buttonpane');
+        const actionRect = action.getBoundingClientRect();
+        const save = action.querySelector('button');
+        const saveRect = save.getBoundingClientRect();
+        return content.scrollHeight > content.clientHeight &&
+          typeof jQuery(content).dialog('option', 'height') === 'number' &&
+          rect.top >= 0 &&
+          rect.left >= 0 &&
+          rect.right <= window.innerWidth &&
+          rect.bottom <= window.innerHeight &&
+          actionRect.top >= 0 &&
+          actionRect.left >= 0 &&
+          actionRect.right <= window.innerWidth &&
+          actionRect.bottom <= window.innerHeight &&
+          saveRect.top >= 0 &&
+          saveRect.left >= 0 &&
+          saveRect.right <= window.innerWidth &&
+          saveRect.bottom <= window.innerHeight;
+      }())
+      SCRIPT);
+  }
+
 }
