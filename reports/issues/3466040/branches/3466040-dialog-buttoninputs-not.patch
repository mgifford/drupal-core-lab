+++ b/core/misc/dialog/dialog.position.js
@@ -144,6 +144,14 @@
         eventData,
         autoResize,
       );
+      // Content can change its size after the dialog opened, for example when
+      // a details element opens or an Ajax request adds elements. Recalculate
+      // the size and the position, so the dialog stays inside the viewport.
+      const resizeObserver = new ResizeObserver(() => {
+        autoResize({ data: eventData });
+      });
+      resizeObserver.observe(e.target);
+      $element.data('drupalAutoResizeObserver', resizeObserver);
     }
   });
 
@@ -153,6 +161,7 @@
     // destroys the jQuery UI instance, so a call that runs after this point
     // would act on a destroyed dialog and throw.
     $(e.target).data('drupalAutoResize')?.cancel();
+    $(e.target).data('drupalAutoResizeObserver')?.disconnect();
     $(window).off('.dialogResize');
     $(document).off('.dialogResize');
   });
