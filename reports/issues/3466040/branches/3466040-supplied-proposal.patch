--- /dev/null
+++ b/core/misc/dialog/dialog.viewport.css
@@ -0,0 +1,56 @@
+/**
+ * @file
+ * Keep auto-resizing modal dialogs inside the available viewport.
+ *
+ * Content scrolls independently of the title bar and action pane. This is
+ * intentionally scoped to modal dialogs managed by Drupal's autoResize API;
+ * draggable non-modal dialogs and off-canvas trays are not affected.
+ */
+
+.ui-dialog.drupal-dialog--viewport-constrained {
+  position: fixed;
+  top: var(--drupal-dialog-center-y, 50%) !important;
+  left: var(--drupal-dialog-center-x, 50%) !important;
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  width: auto;
+  max-width: var(--drupal-dialog-available-width, calc(100vw - 1rem));
+  max-height: var(--drupal-dialog-available-height, calc(100dvh - 1rem));
+  min-width: 0;
+  min-height: 0;
+  overflow: hidden;
+  transform: translate(-50%, -50%);
+}
+
+.ui-dialog.drupal-dialog--viewport-constrained .ui-dialog-titlebar {
+  flex: 0 0 auto;
+  min-width: 0;
+}
+
+.ui-dialog.drupal-dialog--viewport-constrained .ui-dialog-content {
+  flex: 1 1 auto;
+  min-width: 0;
+  min-height: 0 !important;
+  overflow: auto;
+}
+
+.ui-dialog.drupal-dialog--viewport-constrained .ui-dialog-buttonpane {
+  flex: 0 0 auto;
+  min-width: 0;
+  max-height: 40dvh;
+  overflow: auto;
+}
+
+.ui-dialog.drupal-dialog--viewport-constrained .ui-dialog-buttonset {
+  display: flex;
+  float: none;
+  flex-wrap: wrap;
+  justify-content: flex-end;
+}
+
+.ui-dialog.drupal-dialog--viewport-constrained .ui-dialog-buttonset button {
+  max-width: 100%;
+  white-space: normal;
+  overflow-wrap: anywhere;
+}
