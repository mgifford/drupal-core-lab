diff --git a/core/tests/Drupal/FunctionalJavascriptTests/Ajax/DialogTest.php b/core/tests/Drupal/FunctionalJavascriptTests/Ajax/DialogTest.php
index ca3de5e4d127eea42f7d03939644ecf3a811f0a0..7e4677f8fccbb02402acad4c7c9bc182edde1fea 100644
--- a/core/tests/Drupal/FunctionalJavascriptTests/Ajax/DialogTest.php
+++ b/core/tests/Drupal/FunctionalJavascriptTests/Ajax/DialogTest.php
@@ -298,4 +298,59 @@ public function testCloseCancelsScheduledResize(): void {
     $this->assertSame([], $errors);
   }
 
+  /**
+   * Tests that percentage-height dialogs resize when their content grows.
+   */
+  public function testPercentageHeightDialogResizesAfterContentGrowth(): void {
+    $this->drupalGet('ajax-test/dialog');
+    $this->clickLink('Link 1 (modal)');
+    $dialog = $this->assertSession()->waitForElementVisible('css', '.ui-dialog');
+    $this->assertNotNull($dialog);
+    $close = $dialog->findButton('Close');
+    $this->assertNotNull($close);
+    $close->press();
+
+    $script = <<<'SCRIPT'
+      (function () {
+        const content = document.createElement('div');
+        content.id = 'percentage-height-dialog-content';
+        const expand = document.createElement('button');
+        expand.id = 'expand-percentage-height-dialog';
+        expand.type = 'button';
+        expand.textContent = 'Expand';
+        content.appendChild(expand);
+        document.body.appendChild(content);
+        Drupal.dialog(content, {
+          title: 'Percentage-height dialog',
+          modal: true,
+          height: '50%',
+          width: 600,
+          buttons: [{ text: 'Save' }],
+        }).showModal();
+        expand.addEventListener('click', function () {
+          const tall = document.createElement('div');
+          tall.style.height = '2000px';
+          content.appendChild(tall);
+        });
+      }())
+      SCRIPT;
+    $this->getSession()->executeScript($script);
+    $dialog = $this->assertSession()->waitForElementVisible('css', '.ui-dialog');
+    $this->assertNotNull($dialog);
+    $expand = $dialog->find('css', '#expand-percentage-height-dialog');
+    $this->assertNotNull($expand);
+    $expand->press();
+
+    $this->assertJsCondition(<<<'SCRIPT'
+      (function () {
+        const content = document.querySelector('#percentage-height-dialog-content');
+        const dialog = content.closest('.ui-dialog');
+        const rect = dialog.getBoundingClientRect();
+        return content.scrollHeight > content.clientHeight &&
+          rect.top >= 0 &&
+          rect.bottom <= window.innerHeight;
+      }())
+      SCRIPT);
+  }
+
 }
