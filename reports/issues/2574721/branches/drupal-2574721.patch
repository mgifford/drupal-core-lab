-                  </div>
-                {% endif %}
-              </div>
             </div>
           </details>
         </td>
+        <td class="operations">
+          {% if module.links %}
+            {% set link_count = 0 %}
+            {% set first_link = null %}
+            {% set other_links = [] %}
+            {% for link_type in ['configure', 'permissions', 'help'] %}
+              {% if module.links[link_type] %}
+                {% set link_count = link_count + 1 %}
+                {% if first_link is null %}
+                  {% set first_link = module.links[link_type] %}
+                {% else %}
+                  {% set other_links = other_links|merge([module.links[link_type]]) %}
+                {% endif %}
+              {% endif %}
+            {% endfor %}
+            
+            {% if link_count == 1 %}
+              <div class="links">
+                {{ first_link }}
+              </div>
+            {% elseif link_count > 1 %}
+              <div class="dropbutton-wrapper dropbutton-multiple">
+                <div class="dropbutton-widget">
+                  <ul class="dropbutton dropbutton--extrasmall dropbutton--multiple">
+                    <li class="dropbutton__item dropbutton-action">
+                      {{ first_link }}
+                    </li>
+                    {% for link in other_links %}
+                      <li class="dropbutton__item dropbutton-action secondary-action">
+                        {{ link }}
+                      </li>
+                    {% endfor %}
+                  </ul>
+                </div>
+              </div>
+            {% endif %}
+          {% endif %}
+        </td>
       </tr>
     {% endfor %}
   </tbody>
