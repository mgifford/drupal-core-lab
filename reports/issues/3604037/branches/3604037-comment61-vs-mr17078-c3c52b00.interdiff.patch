diff --git a/core/tests/Drupal/Tests/Core/Render/Element/DetailsTest.php b/core/tests/Drupal/Tests/Core/Render/Element/DetailsTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..f536134b59311fa2417743ecd3dc1f502f478269
--- /dev/null
+++ b/core/tests/Drupal/Tests/Core/Render/Element/DetailsTest.php
@@ -0,0 +1,37 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\Core\Render\Element;
+
+use Drupal\Core\Render\Element\Details;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+use Drupal\Tests\UnitTestCase;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+
+/**
+ * Tests Drupal\Core\Render\Element\Details.
+ */
+#[CoversClass(Details::class)]
+#[Group('Render')]
+class DetailsTest extends UnitTestCase {
+
+  /**
+   * Tests child errors when the details element has no title.
+   */
+  public function testPreRenderDetailsWithChildErrorsWithoutTitle(): void {
+    foreach ([[], ['#title' => '']] as $title_properties) {
+      $element = Details::preRenderDetails($title_properties + [
+        '#children_errors' => ['child' => 'Invalid value'],
+        '#attributes' => [],
+      ]);
+
+      $this->assertInstanceOf(TranslatableMarkup::class, $element['#title']);
+      $this->assertSame('Details', $element['#title']->getUntranslatedString());
+      $this->assertContains('error', $element['#attributes']['class']);
+      $this->assertSame(1, $element['#attributes']['data-child-error-count']);
+    }
+  }
+
+}
