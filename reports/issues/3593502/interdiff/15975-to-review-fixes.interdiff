diff --git a/core/modules/menu_tree_ui/tests/modules/menu_tree_ui_test/menu_tree_ui_test.services.yml b/core/modules/menu_tree_ui/tests/modules/menu_tree_ui_test/menu_tree_ui_test.services.yml
new file mode 100644
index 00000000..5a9248ec
--- /dev/null
+++ b/core/modules/menu_tree_ui/tests/modules/menu_tree_ui_test/menu_tree_ui_test.services.yml
@@ -0,0 +1,6 @@
+services:
+  menu_tree_ui_test.route_subscriber:
+    class: Drupal\menu_tree_ui_test\Routing\MenuTreeUiTestRouteSubscriber
+    tags:
+      - { name: event_subscriber }
+
diff --git a/core/modules/menu_tree_ui/tests/modules/menu_tree_ui_test/src/Controller/MenuTreeUiTestCsrfTokenController.php b/core/modules/menu_tree_ui/tests/modules/menu_tree_ui_test/src/Controller/MenuTreeUiTestCsrfTokenController.php
new file mode 100644
index 00000000..adeb49a6
--- /dev/null
+++ b/core/modules/menu_tree_ui/tests/modules/menu_tree_ui_test/src/Controller/MenuTreeUiTestCsrfTokenController.php
@@ -0,0 +1,23 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\menu_tree_ui_test\Controller;
+
+use Drupal\system\Controller\CsrfTokenController;
+
+/**
+ * Delays the session token response to expose initialization races in tests.
+ */
+final class MenuTreeUiTestCsrfTokenController extends CsrfTokenController {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function csrfToken() {
+    usleep(3000000);
+    return parent::csrfToken();
+  }
+
+}
+
diff --git a/core/modules/menu_tree_ui/tests/modules/menu_tree_ui_test/src/Routing/MenuTreeUiTestRouteSubscriber.php b/core/modules/menu_tree_ui/tests/modules/menu_tree_ui_test/src/Routing/MenuTreeUiTestRouteSubscriber.php
new file mode 100644
index 00000000..1b2f8597
--- /dev/null
+++ b/core/modules/menu_tree_ui/tests/modules/menu_tree_ui_test/src/Routing/MenuTreeUiTestRouteSubscriber.php
@@ -0,0 +1,25 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\menu_tree_ui_test\Routing;
+
+use Drupal\Core\Routing\RouteSubscriberBase;
+use Drupal\menu_tree_ui_test\Controller\MenuTreeUiTestCsrfTokenController;
+use Symfony\Component\Routing\RouteCollection;
+
+/**
+ * Replaces the session token controller with a deliberately slow test double.
+ */
+final class MenuTreeUiTestRouteSubscriber extends RouteSubscriberBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function alterRoutes(RouteCollection $collection): void {
+    $route = $collection->get('system.csrftoken');
+    $route?->setDefault('_controller', MenuTreeUiTestCsrfTokenController::class . '::csrfToken');
+  }
+
+}
+
