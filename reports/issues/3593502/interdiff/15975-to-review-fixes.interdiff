diff --git a/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiSearchTest.php b/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiSearchTest.php
index d27d81a4..0d38f8ea 100644
--- a/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiSearchTest.php
+++ b/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiSearchTest.php
@@ -78,4 +78,51 @@ public function testSearchSwapsResultsAndJumps(): void {
     $this->assertSame($apricot_id, $focused_id, 'The jumped-to row receives focus.');
   }
 
+  /**
+   * Escape dismisses results without clearing the search query.
+   */
+  public function testEscapeDismissesResults(): void {
+    $page = $this->getSession()->getPage();
+    $input = $page->find('css', '#menu-tree-ui-search-input');
+    $this->assertNotNull($input);
+
+    $input->setValue('Apple');
+    $this->assertSession()->waitForElementVisible(
+      'css',
+      '#menu-tree-ui-search-results .menu-tree-ui-search-results__list',
+    );
+    $input->keyDown(27);
+    $input->keyUp(27);
+
+    $this->assertSession()->waitForElementRemoved(
+      'css',
+      '#menu-tree-ui-search-results > *',
+    );
+    $this->assertSame('Apple', $input->getValue());
+  }
+
+  /**
+   * Clicking outside the search container dismisses the results.
+   */
+  public function testOutsideClickDismissesResults(): void {
+    $page = $this->getSession()->getPage();
+    $input = $page->find('css', '#menu-tree-ui-search-input');
+    $this->assertNotNull($input);
+
+    $input->setValue('Apple');
+    $this->assertSession()->waitForElementVisible(
+      'css',
+      '#menu-tree-ui-search-results .menu-tree-ui-search-results__list',
+    );
+    $outside = $page->find('css', 'h1');
+    $this->assertNotNull($outside);
+    $outside->click();
+
+    $this->assertSession()->waitForElementRemoved(
+      'css',
+      '#menu-tree-ui-search-results > *',
+    );
+    $this->assertSame('Apple', $input->getValue());
+  }
+
 }
