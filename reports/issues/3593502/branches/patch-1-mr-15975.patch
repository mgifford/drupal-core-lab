@@ -0,0 +1,56 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\menu_tree_ui\Unit;
+
+use Drupal\Core\Menu\MenuLinkDefault;
+use Drupal\Core\Menu\MenuLinkInterface;
+use Drupal\Tests\UnitTestCase;
+use Drupal\menu_tree_ui\MenuLinkMovability;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+
+/**
+ * Tests MenuLinkMovability::isMovable().
+ */
+#[CoversClass(MenuLinkMovability::class)]
+#[Group('menu_tree_ui')]
+final class MenuLinkMovabilityTest extends UnitTestCase {
+
+  /**
+   * A content link (menu_link_content:{uuid}) is movable.
+   */
+  public function testContentLinkIsMovable(): void {
+    $link = $this->createStub(MenuLinkInterface::class);
+    $link->method('getPluginId')->willReturn('menu_link_content:1f5b3f1a-0000-4000-8000-000000000000');
+
+    $this->assertTrue(MenuLinkMovability::isMovable($link));
+  }
+
+  /**
+   * A MenuLinkDefault instance is movable regardless of its plugin ID.
+   *
+   * The instanceof branch wins independently of the prefix check: a mocked
+   * MenuLinkDefault with a static (non menu_link_content:) plugin ID is still
+   * reported movable, because *.links.menu.yml links persist parent/weight
+   * via StaticMenuLinkOverrides.
+   */
+  public function testMenuLinkDefaultIsMovable(): void {
+    $link = $this->createStub(MenuLinkDefault::class);
+    $link->method('getPluginId')->willReturn('system.admin_content');
+
+    $this->assertTrue(MenuLinkMovability::isMovable($link));
+  }
+
+  /**
+   * A static link that is neither content-backed nor a MenuLinkDefault stays locked.
+   */
+  public function testBespokeStaticLinkIsNotMovable(): void {
+    $link = $this->createStub(MenuLinkInterface::class);
+    $link->method('getPluginId')->willReturn('system.admin');
+
+    $this->assertFalse(MenuLinkMovability::isMovable($link));
+  }
+
+}
diff --git a/core/modules/menu_tree_ui/tests/src/Unit/MenuTreeSpliceBeforeTest.php b/core/modules/menu_tree_ui/tests/src/Unit/MenuTreeSpliceBeforeTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..efed7d7240ddc76025d5c861f2c12e1e1f519aa5
--- /dev/null
+++ b/core/modules/menu_tree_ui/tests/src/Unit/MenuTreeSpliceBeforeTest.php
@@ -0,0 +1,114 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\menu_tree_ui\Unit;
+
+use Drupal\Tests\UnitTestCase;
+use Drupal\menu_tree_ui\Service\MenuTreeLoader;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\DataProvider;
+use PHPUnit\Framework\Attributes\Group;
+
+/**
+ * Tests MenuTreeLoader::spliceBefore().
+ */
+#[CoversClass(MenuTreeLoader::class)]
+#[Group('menu_tree_ui')]
+final class MenuTreeSpliceBeforeTest extends UnitTestCase {
+
+  /**
+   * Tests spliceBefore() against a table of orderings.
+   *
+   * @param string[] $order
+   *   The current ordered ids.
+   * @param string $moved
+   *   The id to (re)place.
+   * @param string|null $before_id
+   *   The anchor id, or NULL to append.
+   * @param string[] $expected
+   *   The expected resulting order.
+   */
+  #[DataProvider('providerSpliceBefore')]
+  public function testSpliceBefore(array $order, string $moved, ?string $before_id, array $expected): void {
+    $this->assertSame($expected, MenuTreeLoader::spliceBefore($order, $moved, $before_id));
+  }
+
+  /**
+   * Data provider for testSpliceBefore().
+   *
+   * @return array<string, array{0: string[], 1: string, 2: string|null, 3: string[]}>
+   *   Test cases keyed by description.
+   */
+  public static function providerSpliceBefore(): array {
+    return [
+      'insert before a middle id' => [
+        ['a', 'b', 'c'],
+        'd',
+        'b',
+        ['a', 'd', 'b', 'c'],
+      ],
+      'insert before the first id' => [
+        ['a', 'b', 'c'],
+        'd',
+        'a',
+        ['d', 'a', 'b', 'c'],
+      ],
+      'before_id NULL appends' => [
+        ['a', 'b', 'c'],
+        'd',
+        NULL,
+        ['a', 'b', 'c', 'd'],
+      ],
+      'before_id absent from the list appends' => [
+        ['a', 'b', 'c'],
+        'd',
+        'nonexistent',
+        ['a', 'b', 'c', 'd'],
+      ],
+      'moved not currently in list is inserted at the right spot' => [
+        ['a', 'c'],
+        'b',
+        'c',
+        ['a', 'b', 'c'],
+      ],
+      'moved already present is repositioned, not duplicated' => [
+        ['a', 'b', 'c'],
+        'a',
+        'c',
+        ['b', 'a', 'c'],
+      ],
+      'moved already immediately before its own anchor is a no-op order' => [
+        ['a', 'b', 'c'],
+        'b',
+        'c',
+        ['a', 'b', 'c'],
+      ],
+      'single-element list, append' => [
+        ['a'],
+        'b',
+        NULL,
+        ['a', 'b'],
+      ],
+      'single-element list, moved is the only element and re-appends itself' => [
+        ['a'],
+        'a',
+        NULL,
+        ['a'],
+      ],
+      'empty list appends' => [
+        [],
+        'a',
+        NULL,
+        ['a'],
+      ],
+      'empty list with a before_id still appends, since there is nothing to match' => [
+        [],
+        'a',
+        'b',
+        ['a'],
+      ],
+    ];
+  }
+
+}
diff --git a/core/modules/menu_tree_ui/tests/src/Unit/MenuTreeUiConstantsTest.php b/core/modules/menu_tree_ui/tests/src/Unit/MenuTreeUiConstantsTest.php
