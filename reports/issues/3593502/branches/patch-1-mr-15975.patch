@@ -0,0 +1,117 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\menu_tree_ui\Functional;
+
+use Drupal\Core\Url;
+use Drupal\Tests\BrowserTestBase;
+use Drupal\system\Entity\Menu;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests the menu tabs when the tree UI is enabled.
+ *
+ * With menu_tree_ui on, a menu has three tabs: "Edit" (settings), "Links" (the
+ * scalable tree), and "Links (no js)" (the classic tabledrag fallback).
+ */
+#[Group('menu_tree_ui')]
+#[RunTestsInSeparateProcesses]
+final class MenuTreeUiTabsTest extends BrowserTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'block',
+    'menu_link_content',
+    'menu_tree_ui',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->drupalPlaceBlock('local_tasks_block');
+    Menu::create(['id' => 'tabs-test', 'label' => 'Tabs test'])->save();
+    $this->drupalLogin($this->drupalCreateUser([
+      'administer menu',
+      'access administration pages',
+    ]));
+  }
+
+  /**
+   * The menu shows Edit, Links (tree) and Links (no js) tabs.
+   */
+  public function testThreeTabs(): void {
+    $this->drupalGet('/admin/structure/menu/manage/tabs-test');
+
+    // Edit is the settings page, Links is the tree and Links (no js) is the
+    // classic overview.
+    $this->assertLinkToPath('/admin/structure/menu/manage/tabs-test');
+    $this->assertLinkToPath('/admin/structure/menu/manage/tabs-test/tree');
+    $this->assertLinkToPath('/admin/structure/menu/manage/tabs-test/links');
+
+    // The settings page itself does not carry the link overview.
+    $this->assertSession()->elementNotExists('css', '#menu-overview');
+  }
+
+  /**
+   * The tree route is denied to a user without menu administration access.
+   *
+   * Every tree route requires _entity_access: 'menu.update', granted by the
+   * 'administer menu' permission; a user without it must be refused.
+   */
+  public function testTreeRouteRequiresAccess(): void {
+    $this->drupalLogin($this->drupalCreateUser(['access administration pages']));
+    $this->drupalGet('/admin/structure/menu/manage/tabs-test/tree');
+    $this->assertSession()->statusCodeEquals(403);
+  }
+
+  /**
+   * The Menus list dropbutton has Edit links (tree), Edit links (no js), Edit.
+   */
+  public function testListDropbutton(): void {
+    $this->drupalGet('/admin/structure/menu');
+    // The primary action is the tree, the no-JS action is the classic page
+    // and Edit is the settings page.
+    $this->assertLinkToPath('/admin/structure/menu/manage/tabs-test/tree');
+    $this->assertLinkToPath('/admin/structure/menu/manage/tabs-test/links');
+    $this->assertLinkToPath('/admin/structure/menu/manage/tabs-test');
+  }
+
+  /**
+   * Asserts a link to a path, with or without a destination query.
+   */
+  protected function assertLinkToPath(string $path): void {
+    $this->assertSession()->elementExists('xpath', $this->linkToPathXpath($path));
+  }
+
+  /**
+   * Asserts there is no link to a path, with or without a destination query.
+   */
+  protected function assertNoLinkToPath(string $path): void {
+    $this->assertSession()->elementNotExists('xpath', $this->linkToPathXpath($path));
+  }
+
+  /**
+   * Builds the XPath matching an anchor whose href is $path or "$path?...".
+   *
+   * The path is a site-relative user path; the base path is prepended so the
+   * match holds when the test site runs in a subdirectory.
+   */
+  private function linkToPathXpath(string $path): string {
+    return $this->assertSession()->buildXPathQuery(
+      '//a[@href = :href or starts-with(@href, concat(:href, "?"))]',
+      [':href' => Url::fromUserInput($path)->toString()],
+    );
+  }
+
+}
diff --git a/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiColumnToggleTest.php b/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiColumnToggleTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..80dde94be88bafd495313d44892704859d8588e9
--- /dev/null
+++ b/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiColumnToggleTest.php
@@ -0,0 +1,128 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\menu_tree_ui\FunctionalJavascript;
+
+use Behat\Mink\Element\NodeElement;
+use Drupal\FunctionalJavascriptTests\WebDriverTestBase;
+use Drupal\menu_link_content\Entity\MenuLinkContent;
+use Drupal\menu_link_content\MenuLinkContentInterface;
+use Drupal\system\Entity\Menu;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests the interactive column checkbox end-to-end.
+ *
+ * The "Enabled" column renders a treegrid 'checkbox' cell — a native
+ * <input type="checkbox">. Clicking it flips the checkbox immediately (no
+ * preventDefault) and POSTs the new value to the column-update endpoint, which
+ * writes it to the menu_link_content entity. This drives a real click and
+ * asserts both the optimistic flip and that the change reaches storage.
+ */
+#[Group('menu_tree_ui')]
+#[RunTestsInSeparateProcesses]
+final class MenuTreeUiColumnToggleTest extends WebDriverTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'menu_link_content',
+    'menu_tree_ui',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * The plugin ID of the seeded "A" link.
+   */
+  private string $linkId;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    Menu::create(['id' => 'test', 'label' => 'Test'])->save();
+    $entity = MenuLinkContent::create([
+      'menu_name' => 'test',
+      'title' => 'A',
+      'link' => ['uri' => 'route:<nolink>'],
+      'enabled' => TRUE,
+    ]);
+    $entity->save();
+    $this->linkId = $entity->getPluginId();
+
+    $admin = $this->drupalCreateUser(['administer menu']);
+    $this->drupalLogin($admin);
+    $this->drupalGet('/admin/structure/menu/manage/test/tree');
+    $this->assertSession()->waitForElement(
+      'css',
+      'drupal-treegrid table[role="treegrid"] tbody tr[role="row"]',
+    );
+  }
+
+  /**
+   * Clicking the Enabled checkbox unchecks it and persists enabled = FALSE.
+   */
+  public function testTogglePersists(): void {
+    $checkbox = $this->enabledCheckbox();
+    $this->assertTrue($checkbox->isChecked(), 'The Enabled checkbox starts checked.');
+
+    $checkbox->click();
+    $this->assertFalse(
+      $checkbox->isChecked(),
+      'Clicking the checkbox unchecks it immediately, before the round-trip.',
+    );
+
+    $this->assertEnabledPersistsAs(FALSE);
+  }
+
+  /**
+   * The Enabled column checkbox for the seeded link.
+   */
+  private function enabledCheckbox(): NodeElement {
+    $selector = sprintf(
+      'tr[role="row"][data-id="%s"] input.treegrid-cell-checkbox[data-column-id="enabled"]',
+      $this->linkId,
+    );
+    $checkbox = $this->getSession()->getPage()->find('css', $selector);
+    $this->assertNotNull($checkbox, 'The Enabled checkbox should be present.');
+    return $checkbox;
+  }
+
+  /**
+   * Polls storage until the seeded link's enabled flag matches, or fails.
+   *
+   * The persistence POST is a plain fetch with no DOM-visible completion
+   * signal, so the write is observed by re-reading the entity rather than
+   * waiting on the page.
+   *
+   * @param bool $expected
+   *   The enabled value the link should settle on.
+   */
+  private function assertEnabledPersistsAs(bool $expected): void {
+    $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
+    for ($i = 0; $i < 50; $i++) {
+      $storage->resetCache();
+      $ids = $storage->getQuery()
+        ->accessCheck(FALSE)
+        ->condition('title', 'A')
+        ->execute();
+      $entity = $storage->load(reset($ids));
+      assert($entity instanceof MenuLinkContentInterface);
+      if ($entity->isEnabled() === $expected) {
+        return;
+      }
+      usleep(100000);
+    }
+    $this->fail('The Enabled change was not persisted to storage.');
+  }
+
+}
