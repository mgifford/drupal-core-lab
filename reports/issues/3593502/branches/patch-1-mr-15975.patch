index 0000000000000000000000000000000000000000..17e086efd49d147155758ed68b1f9e71b6ca38f4
--- /dev/null
+++ b/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiDragGestureTrait.php
@@ -0,0 +1,108 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\menu_tree_ui\FunctionalJavascript;
+
+/**
+ * Synthetic pointer-drag drivers for menu_tree_ui tests.
+ *
+ * Fires PointerEvent sequences at the live DragController. Expects the using
+ * class to extend MenuTreeUiJavascriptTestBase (for $linkIds and the tree
+ * helpers).
+ */
+trait MenuTreeUiDragGestureTrait {
+
+  /**
+   * Drags the row labeled $source into the $zone of the row labeled $target.
+   *
+   * Zones map to vertical position inside the target row's rect (the <tr> holds
+   * only its own cells, never its subtree, so the row rect IS the header):
+   *  - 'before' → 10% from top (top zone)
+   *  - 'child'  → 50% (middle zone)
+   *  - 'after'  → 90% (bottom zone)
+   *
+   * The 5px drag threshold in DragController is satisfied by an intermediate
+   * pointermove offset before moving to the target.
+   */
+  private function drag(string $source_label, string $target_label, string $zone): void {
+    $source_id = $this->linkIds[$source_label] ?? throw new \InvalidArgumentException("Unknown source label: $source_label");
+    $target_id = $this->linkIds[$target_label] ?? throw new \InvalidArgumentException("Unknown target label: $target_label");
+    $zone_ratio = match ($zone) {
+      'before' => 0.1,
+      'child'  => 0.5,
+      'after'  => 0.9,
+      default  => throw new \InvalidArgumentException("Unknown zone: $zone"),
+    };
+
+    $script = <<<JS
+      const sourceRow = document.querySelector('tr[role="row"][data-id="$source_id"]');
+      const targetRow = document.querySelector('tr[role="row"][data-id="$target_id"]');
+      if (!sourceRow || !targetRow) throw new Error('source or target row not in DOM');
+      targetRow.scrollIntoView({block: 'center'});
+      const handle = sourceRow.querySelector('.menu-tree-ui-row__handle:not(.menu-tree-ui-row__handle--locked)');
+      if (!handle) throw new Error('no draggable handle on source row');
+      const hRect = handle.getBoundingClientRect();
+      const tRect = targetRow.getBoundingClientRect();
+      const startX = hRect.left + hRect.width / 2;
+      const startY = hRect.top + hRect.height / 2;
+      const endX = tRect.left + tRect.width / 2;
+      const endY = tRect.top + tRect.height * $zone_ratio;
+      function send(t, type, x, y) {
+        t.dispatchEvent(new PointerEvent(type, {
+          bubbles: true, cancelable: true, composed: true,
+          pointerId: 1, isPrimary: true, button: 0,
+          clientX: x, clientY: y, screenX: x, screenY: y,
+        }));
+      }
+      send(handle, 'pointerdown', startX, startY);
+      send(handle, 'pointermove', startX + 10, startY + 10);
+      send(handle, 'pointermove', endX, endY);
+      send(handle, 'pointerup', endX, endY);
+    JS;
+
+    $this->getSession()->executeScript($script);
+    // commitMove flags the <drupal-treegrid> host with data-treegrid-moving
+    // while the server-first POST + group refresh is in flight; wait for that to
+    // clear before assertions run on the rebuilt DOM.
+    $this->getSession()->wait(
+      5000,
+      '!document.querySelector(\'drupal-treegrid[data-treegrid-moving="true"]\')'
+      . ' && !document.querySelector(\'.menu-tree-ui-row--dragging\')'
+      . ' && !document.querySelector(\'[data-loading="true"]\')',
+    );
+  }
+
+  /**
+   * Clicks a destination row in the given zone to aim the active move at it.
+   *
+   * @param string $label
+   *   The destination row label.
+   * @param string $zone
+   *   Where in the row to click: 'before' (top), 'child' (middle) or 'after'
+   *   (bottom).
+   */
+  private function aimAtRow(string $label, string $zone): void {
+    $id = $this->linkIds[$label] ?? throw new \InvalidArgumentException("Unknown label: $label");
+    $ratio = match ($zone) {
+      'before' => 0.1,
+      'child'  => 0.5,
+      'after'  => 0.9,
+      default  => throw new \InvalidArgumentException("Unknown zone: $zone"),
+    };
+    $script = <<<JS
+      const row = document.querySelector('tr[role="row"][data-id="$id"]');
+      if (!row) throw new Error('destination row not in DOM');
+      row.scrollIntoView({block: 'center'});
+      const rect = row.getBoundingClientRect();
+      const x = rect.left + rect.width / 2;
+      const y = rect.top + rect.height * $ratio;
+      row.dispatchEvent(new MouseEvent('click', {
+        bubbles: true, cancelable: true, composed: true,
+        clientX: x, clientY: y, button: 0,
+      }));
+    JS;
+    $this->getSession()->executeScript($script);
+  }
+
+}
diff --git a/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiDragGuardsTest.php b/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiDragGuardsTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..ce3812f4a6849421a24f352b2af490adf2697224
--- /dev/null
+++ b/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiDragGuardsTest.php
@@ -0,0 +1,129 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\menu_tree_ui\FunctionalJavascript;
+
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Regression tests for DragController client-side gesture guards.
+ *
+ * Covers three hardening fixes in treegrid_reorder's DragController:
+ *  - A gesture that crosses the drag threshold but ends up with no valid
+ *    intent (e.g. released over the moved row's own subtree) must not fall
+ *    through to the tap path and pick the row up into keyboard move mode.
+ *  - Dropping a parent onto one of its own descendants must never form a
+ *    drop intent client-side; the server rejection is a backstop, not the
+ *    guard.
+ *  - A second concurrent pointer (e.g. multi-touch) must be ignored while a
+ *    gesture is already in progress, rather than clobbering the first.
+ */
+#[Group('menu_tree_ui')]
+#[RunTestsInSeparateProcesses]
+final class MenuTreeUiDragGuardsTest extends MenuTreeUiJavascriptTestBase {
+
+  use MenuTreeUiDragGestureTrait;
+
+  /**
+   * Seeds a small tree: P (parent of C), Q (leaf), R (leaf).
+   */
+  protected function seedMenu(): void {
+    $this->createTestMenu();
+    $weight = 0;
+    foreach (['P', 'Q', 'R'] as $label) {
+      $this->linkIds[$label] = $this->createLink($label, '', $weight++);
+    }
+    $this->linkIds['C'] = $this->createLink('C', $this->linkIds['P'], 0);
+  }
+
+  /**
+   * Dropping P onto its own child C must not form an intent or commit a move.
+   *
+   * Covers the descendant-drop guard in updateIntent(): C is a descendant of
+   * P, so no intent should ever form. Since the release lands mid-drag with
+   * no valid intent, this also covers the tap-routing fix in onPointerUp():
+   * a canceled drag must not fall through to the tap path and pick P up
+   * into keyboard move mode.
+   */
+  public function testCannotDropParentOntoOwnChild(): void {
+    $this->expandRow('P');
+    $this->drag('P', 'C', 'after');
+
+    $this->assertSiblings(['P', 'Q', 'R'], $this->childRowsSelector(NULL));
+    $this->assertSiblings(['C'], $this->childRowsSelector('P'));
+
+    $grabbed = $this->getSession()->evaluateScript(
+      "return document.querySelector('.menu-tree-ui-row--grabbed') !== null;",
+    );
+    $this->assertFalse(
+      $grabbed,
+      'A drag canceled over an invalid target must not pick the row up into move mode.',
+    );
+  }
+
+  /**
+   * A second concurrent pointer must be ignored, not clobber the first.
+   *
+   * Starts a real drag with pointer 1 on P's handle, then fires a second
+   * pointerdown with pointer 2 on Q's handle mid-gesture. The guard at the
+   * top of onPointerDown should return before Q's handle takes pointer
+   * capture, and pointer 1's gesture should complete normally afterwards
+   * (dropping P after R).
+   */
+  public function testConcurrentPointerIgnored(): void {
+    $p_id = $this->linkIds['P'];
+    $q_id = $this->linkIds['Q'];
+    $r_id = $this->linkIds['R'];
+
+    $script = <<<JS
+      (() => {
+        const pRow = document.querySelector('tr[role="row"][data-id="$p_id"]');
+        const qRow = document.querySelector('tr[role="row"][data-id="$q_id"]');
+        const rRow = document.querySelector('tr[role="row"][data-id="$r_id"]');
+        rRow.scrollIntoView({block: 'center'});
+        const pHandle = pRow.querySelector('.menu-tree-ui-row__handle:not(.menu-tree-ui-row__handle--locked)');
+        const qHandle = qRow.querySelector('.menu-tree-ui-row__handle:not(.menu-tree-ui-row__handle--locked)');
+        const pRect = pHandle.getBoundingClientRect();
+        const qRect = qHandle.getBoundingClientRect();
+        const rRect = rRow.getBoundingClientRect();
+        const startX = pRect.left + pRect.width / 2;
+        const startY = pRect.top + pRect.height / 2;
+        const qX = qRect.left + qRect.width / 2;
+        const qY = qRect.top + qRect.height / 2;
+        const endX = rRect.left + rRect.width / 2;
+        const endY = rRect.top + rRect.height * 0.9;
+        function send(t, type, x, y, pointerId) {
+          t.dispatchEvent(new PointerEvent(type, {
+            bubbles: true, cancelable: true, composed: true,
+            pointerId, isPrimary: pointerId === 1, button: 0,
+            clientX: x, clientY: y, screenX: x, screenY: y,
+          }));
+        }
+        send(pHandle, 'pointerdown', startX, startY, 1);
+        send(qHandle, 'pointerdown', qX, qY, 2);
+        const qCaptured = qHandle.hasPointerCapture(2);
+        send(pHandle, 'pointermove', startX + 10, startY + 10, 1);
+        send(pHandle, 'pointermove', endX, endY, 1);
+        send(pHandle, 'pointerup', endX, endY, 1);
+        return qCaptured;
+      })();
+    JS;
+
+    $q_captured = $this->getSession()->evaluateScript($script);
+    $this->assertFalse(
+      $q_captured,
+      'A second concurrent pointerdown must be ignored and never take pointer capture.',
+    );
+
+    $this->getSession()->wait(
+      5000,
+      '!document.querySelector(\'drupal-treegrid[data-treegrid-moving="true"]\')'
+      . ' && !document.querySelector(\'.menu-tree-ui-row--dragging\')'
+      . ' && !document.querySelector(\'[data-loading="true"]\')',
+    );
+    $this->assertSiblings(['Q', 'R', 'P'], $this->childRowsSelector(NULL));
+  }
+
+}
diff --git a/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiInRowKeysTest.php b/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiInRowKeysTest.php
