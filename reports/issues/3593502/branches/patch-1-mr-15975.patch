--- /dev/null
+++ b/core/modules/treegrid/css/treegrid.css
@@ -0,0 +1,19 @@
+/**
+ * @file
+ * Baseline styling for the <drupal-treegrid> custom element.
+ */
+
+/*
+ * Custom elements are inline by default; the treegrid must lay out as a block.
+ * It also establishes a positioning context so features can place an
+ * absolutely-positioned overlay (such as the reorder drop indicator) within it.
+ */
+drupal-treegrid {
+  position: relative;
+  display: block;
+}
+
+/* Collapse marks a row's descendant run with data-hidden; see expand.js. */
+tr[role="row"][data-hidden="true"] {
+  display: none;
+}
diff --git a/core/modules/treegrid/js/cells.js b/core/modules/treegrid/js/cells.js
new file mode 100644
index 0000000000000000000000000000000000000000..04c63e11a32a107bfdb89b8247a3b408d4f23133
--- /dev/null
+++ b/core/modules/treegrid/js/cells.js
@@ -0,0 +1,88 @@
+/**
+ * @file
+ * The treegrid cell-renderer registry and built-in cell widgets.
+ *
+ * A column plugin's getCellData() returns a cell data array with a 'type' key
+ * (see TreegridColumnInterface). Each type has a JS renderer registered here
+ * that turns the cell data into the widget element a row builder drops into a
+ * gridcell. The Twig template renders the server-side top level by hand and
+ * MUST emit the same markup — keep the two in lockstep when changing a widget.
+ *
+ * treegrid ships:
+ *  - 'checkbox': a boolean control. Non-interactive cells render disabled;
+ *    interactive ones carry data-column-id / data-link-id so the consumer's
+ *    column-update endpoint can persist the change — treegrid ships the cell
+ *    type, not the route or controller.
+ *  - 'markup': an opaque server-rendered HTML string, injected verbatim — the
+ *    escape hatch for cells a client renderer cannot reproduce (e.g. a themed
+ *    dropbutton). It MUST be trusted server-rendered markup: it is written via
+ *    innerHTML, so user-supplied input in a markup cell is an XSS vector.
+ *
+ * Exposes Drupal.treegrid.registerCellRenderer and Drupal.treegrid.renderCell.
+ */
+
+((Drupal) => {
+  Drupal.treegrid = Drupal.treegrid || {};
+
+  const renderers = {};
+
+  /**
+   * Registers a cell renderer for a cell 'type'.
+   *
+   * @param {string} type
+   *   The cell type, matched against a cell data array's 'type' key.
+   * @param {function(object, object): (HTMLElement|null)} renderer
+   *   Builds the widget from (cell, context); context carries
+   *   { colId, rowId }. Returns the element to insert, or null to render
+   *   nothing.
+   */
+  Drupal.treegrid.registerCellRenderer = (type, renderer) => {
+    renderers[type] = renderer;
+  };
+
+  /**
+   * Renders one cell's widget by dispatching on its 'type'.
+   *
+   * @param {object} cell
+   *   The cell data array; must carry a 'type' key.
+   * @param {object} context
+   *   { colId, rowId } naming the owning column and row.
+   *
+   * @return {HTMLElement|null}
+   *   The widget element, or null for an unregistered type — the caller then
+   *   renders an empty cell, so an older client tolerates a new cell type.
+   */
+  Drupal.treegrid.renderCell = (cell, context) => {
+    const renderer = renderers[cell.type];
+    return renderer ? renderer(cell, context) : null;
+  };
+
+  // Boolean control. Native checkbox: the browser owns the checked state and
+  // its keyboard/AT behavior, so the consumer's handler only reads .checked
+  // and persists.
+  Drupal.treegrid.registerCellRenderer('checkbox', (cell, { colId, rowId }) => {
+    const input = document.createElement('input');
+    input.type = 'checkbox';
+    input.className = 'treegrid-cell-checkbox';
+    input.checked = cell.value;
+    input.setAttribute('aria-label', cell.label);
+    if (!cell.interactive) {
+      input.disabled = true;
+    }
+    input.dataset.columnId = colId;
+    input.dataset.linkId = rowId;
+    // An interactive cell control joins the active row's roving tab order.
+    input.dataset.treegridControl = '';
+    return input;
+  });
+
+  // Opaque server-rendered markup, injected verbatim.
+  Drupal.treegrid.registerCellRenderer('markup', (cell) => {
+    const wrapper = document.createElement('div');
+    wrapper.className = 'treegrid-cell-markup';
+    // cell.html must be trusted server-rendered markup (see the @file note);
+    // never a client- or user-supplied string.
+    wrapper.innerHTML = cell.html;
+    return wrapper;
+  });
+})(Drupal);
diff --git a/core/modules/treegrid/js/expand.js b/core/modules/treegrid/js/expand.js
new file mode 100644
index 0000000000000000000000000000000000000000..d7cae9871d031c32578e713a6642bcac28a5e1b5
--- /dev/null
+++ b/core/modules/treegrid/js/expand.js
@@ -0,0 +1,428 @@
+/**
+ * @file
+ * Lazy-load + expand/collapse for the treegrid.
+ *
+ * Collapse flags a row's descendant run with data-hidden (CSS hides them) and
+ * leaves the rows in the DOM; re-expand clears the flag. There are no nested
+ * <ul role="group"> elements — children are sibling <tr>s right after their
+ * parent. "Is this subtree already loaded" is tracked by row.dataset.loaded
+ * rather than the presence of a child <ul>.
+ *
+ * Hands off row construction to an injected renderer and visibility tracking to
+ * RowWindow. Exposes Drupal.treegrid.ExpandManager.
+ */
+
+((Drupal) => {
+  Drupal.treegrid = Drupal.treegrid || {};
+  const {
+    descendantRows,
+    lastDescendantRow,
+    childRows,
+    levelOf,
+    findRow,
+    setRowLevel,
+    setRowControlsActive,
+  } = Drupal.treegrid.treeNav;
+
+  const ROW = 'tr[role="row"]';
+
+  /**
+   * Rewrites a row's aria-level and indent, cascading into its child rows so
+   * descendant levels stay consistent.
+   *
+   * No-op when the depth hasn't changed, so reused rows in a same-level
+   * reorder pay only a single attribute read.
+   *
+   * @param {HTMLTableRowElement} row
+   *   The row to rebase.
+   * @param {number} newDepth
+   *   The depth the row should now render at.
+   */
+  function rebaseRowLevel(row, newDepth) {
+    const oldDepth = Number(row.getAttribute('aria-level') ?? '1');
+    if (oldDepth === newDepth) {
+      return;
+    }
+
+    setRowLevel(row, newDepth);
+    childRows(row).forEach((child) => {
+      rebaseRowLevel(child, newDepth + 1);
+    });
+  }
+
+  /**
+   * Announces a toggled row by name through the live region.
+   *
+   * A screen reader announces the expanded/collapsed state itself from the
+   * row's aria-expanded change, but labels that change positionally ("row N",
+   * counting the header row) instead of by name. This adds the row's name (its
+   * aria-label, set by the consumer's row renderer) so the editor hears which
+   * item changed. The state word is deliberately left out so the screen reader
+   * does not speak it twice. Skipped when a consumer leaves rows unnamed.
+   *
+   * @param {HTMLElement} row
+   *   The toggled row.
+   */
+  function announceToggle(row) {
+    const name = row.getAttribute('aria-label');
+    if (!name) {
+      return;
+    }
+    Drupal.treegrid.announce(name);
+  }
+
+  class ExpandManager {
+    /**
+     * @param {string} childrenUrl
+     *   The endpoint returning one level of children as JSON.
+     * @param {?Drupal.treegrid.RowWindow} rowWindow
+     *   The windowing helper, or undefined when virtualization is off.
+     * @param {HTMLTableElement} tree
+     *   The root treegrid element.
+     * @param {object} rowBuilder
+     *   The consumer's row renderer.
+     * @param {function} rowBuilder.buildRows
+     *   Builds a DocumentFragment of sibling rows from items at a depth.
+     * @param {function} rowBuilder.buildRow
+     *   Builds a single row element from one item.
+     */
+    constructor(childrenUrl, rowWindow, tree, rowBuilder) {
+      this.childrenUrl = childrenUrl;
+      this.rowWindow = rowWindow;
+      this.tree = tree;
+      // The row renderer is injected so the engine stays consumer-agnostic; the
+      // consumer supplies how its items become DOM through the registered
+      // provider. rowBuilder = { buildRows, buildRow }.
+      this.buildRows = rowBuilder.buildRows;
+      this.buildRow = rowBuilder.buildRow;
+      this.inFlight = new Map();
+    }
+
+    /**
+     * Toggles a row between expanded and collapsed.
+     *
+     * @param {HTMLElement} row
+     *   The parent row.
+     *
+     * @return {Promise<void>}
+     *   Resolves once the toggle (and any fetch) is done.
+     */
+    async toggle(row) {
+      if (row.getAttribute('aria-expanded') === 'true') {
+        this.collapse(row, true);
+      } else {
+        await this.expand(row, true);
+      }
+    }
+
+    /**
+     * Expands a row, lazy-loading its children on first open.
+     *
+     * @param {HTMLElement} row
+     *   The parent row.
+     * @param {boolean} [announce]
+     *   Whether to announce the new state by name (user-initiated toggles do).
+     *
+     * @return {Promise<void>}
+     *   Resolves once children are present.
+     */
+    async expand(row, announce = false) {
+      const { id } = row.dataset;
+      if (!id) {
+        return;
+      }
+      row.setAttribute('aria-expanded', 'true');
+      if (announce) {
+        announceToggle(row);
+      }
+
+      if (row.dataset.loaded === 'true') {
+        // showSubtree re-observes each row it reveals; rows that stay collapsed
+        // are left unobserved so the observer only ever tracks visible rows.
+        this.showSubtree(row);
+        return;
+      }
+
+      // Avoid double-fetches if the user mashes the toggle.
+      const existing = this.inFlight.get(id);
+      if (existing) {
+        await existing;
+        return;
+      }
+      const promise = this.loadChildren(row, id);
+      this.inFlight.set(id, promise);
+      try {
+        await promise;
+      } finally {
+        this.inFlight.delete(id);
+      }
+    }
+
+    /**
+     * Collapses a row, hiding its already-loaded descendant rows.
+     *
+     * @param {HTMLElement} row
+     *   The parent row.
+     * @param {boolean} [announce]
+     *   Whether to announce the new state by name (user-initiated toggles do).
+     */
+    // eslint-disable-next-line class-methods-use-this
+    collapse(row, announce = false) {
+      // Never fold away a section that holds a row a feature has asked to keep
+      // visible (e.g. a row being carried in move mode): the editor must be able
+      // to see it, and the cursor would be lost if it vanished. The feature
+      // marks such a row with data-treegrid-keep-visible for the duration.
+      if (
+        descendantRows(row).some(
+          (r) => r.dataset.treegridKeepVisible === 'true',
+        )
+      ) {
+        return;
+      }
+      row.setAttribute('aria-expanded', 'false');
+      if (announce) {
+        announceToggle(row);
+      }
+      this.hideSubtree(row);
+    }
+
+    /**
+     * Flags a row's whole descendant run as hidden.
+     *
+     * @param {HTMLElement} row
+     *   The parent row.
+     */
+    hideSubtree(row) {
+      descendantRows(row).forEach((r) => {
+        r.dataset.hidden = 'true';
+        // Stop tracking hidden rows: otherwise the observer's entry set grows
+        // with every loaded row and never shrinks as sections are collapsed.
+        this.rowWindow?.unobserve(r);
+      });
+    }
+
+    /**
+     * Reveals a row's descendants, respecting still-collapsed intermediates.
+     *
+     * Walks the descendant run; a row deeper than a still-collapsed ancestor
+     * stays hidden so re-expanding a parent doesn't pop open grandchildren the
+     * user had closed.
+     *
+     * @param {HTMLElement} row
+     *   The parent row.
+     */
+    showSubtree(row) {
+      const base = levelOf(row);
+      let n = row.nextElementSibling;
+      let hideBelow = Infinity;
+      while (n && n.matches(ROW)) {
+        const lvl = levelOf(n);
+        if (lvl <= base) {
+          break;
+        }
+        if (lvl <= hideBelow) {
+          delete n.dataset.hidden;
+          this.rowWindow?.observe(n);
+          hideBelow =
+            n.dataset.hasChildren === 'true' &&
+            n.getAttribute('aria-expanded') !== 'true'
+              ? lvl
+              : Infinity;
+        }
+        n = n.nextElementSibling;
+      }
+    }
+
+    /**
+     * Reconciles a parent's children in the DOM against the server's truth.
+     *
+     * Surgical diff rather than blow-the-children-away-and-rebuild: existing
+     * rows are reused by data-id so their subtrees and state survive (each
+     * carries its descendant run as a block); rows new in the server response
+     * are freshly built; rows gone from the response are removed with their
+     * blocks; order follows the server; reused rows whose level changed are
+     * rebased. No-ops when the parent row isn't in the DOM.
+     *
+     * @param {string} parentId
+     *   Plugin ID of the parent, or '' for the root level.
+     *
+     * @return {Promise<boolean>}
+     *   True once the children are reconciled (or there was nothing to do);
+     *   false when the server fetch failed, so the caller can recover.
+     */
+    async refresh(parentId) {
+      const isRoot = parentId === '';
+      const tbody = this.tree.querySelector('tbody');
+      const parentRow = isRoot ? tbody : findRow(this.tree, parentId);
+      if (!parentRow) {
+        return true;
+      }
+
+      const items = await this.fetchChildren(parentId);
+      if (items === null) {
+        return false;
+      }
+
+      // Snapshot existing direct children with their descendant blocks BEFORE
+      // any DOM change, so reused rows can carry their subtrees across.
+      const existingRows = isRoot
+        ? Array.from(tbody.querySelectorAll(`:scope > ${ROW}`)).filter(
+            (r) => r.dataset.parentId === '',
+          )
+        : childRows(parentRow);
+      const blocks = new Map();
+      existingRows.forEach((child) => {
+        const { id } = child.dataset;
+        if (id) {
+          blocks.set(id, { row: child, block: descendantRows(child) });
+        }
+      });
+
+      const childDepth = isRoot ? 1 : levelOf(parentRow) + 1;
+      const setSize = items.length;
+      const result = [];
+      const kept = new Set();
+      items.forEach((item, index) => {
+        const posInSet = index + 1;
+        const entry = blocks.get(item.id);
+        if (entry) {
+          kept.add(item.id);
+          rebaseRowLevel(entry.row, childDepth);
+          entry.row.dataset.parentId = parentId;
+          entry.row.setAttribute('aria-posinset', String(posInSet));
+          entry.row.setAttribute('aria-setsize', String(setSize));
+          result.push({ row: entry.row, block: entry.block, fresh: false });
+        } else {
+          result.push({
+            row: this.buildRow(item, childDepth, posInSet, setSize),
+            block: [],
+            fresh: true,
+          });
+        }
+      });
+
+      // Remove orphan children (and their descendant blocks), unobserving each
+      // so the row window does not retain detached nodes.
+      blocks.forEach((entry, id) => {
+        if (!kept.has(id)) {
+          entry.block.forEach((r) => {
+            this.rowWindow?.unobserve(r);
+            r.remove();
+          });
+          this.rowWindow?.unobserve(entry.row);
+          entry.row.remove();
+        }
+      });
+
+      // Re-insert in server order. insertBefore/after on an existing node is a
+      // move (no clone), so this reorders kept rows and inserts fresh ones.
+      let anchor = isRoot ? null : parentRow;
+      result.forEach(({ row, block }) => {
+        if (anchor) {
+          anchor.after(row);
+        } else {
+          tbody.insertBefore(row, tbody.firstChild);
+        }
+        anchor = row;
+        block.forEach((r) => {
+          anchor.after(r);
+          anchor = r;
+        });
+      });
+
+      // Attach behaviors + observe only the freshly-built rows.
+      result.forEach(({ row, fresh }) => {
+        if (fresh) {
+          if (Drupal.attachBehaviors) {
+            Drupal.attachBehaviors(row);
+          }
+          // Built rows are not the active row, so keep their controls out of the
+          // tab order (set after attachBehaviors, which upgrades the dropbutton).
+          setRowControlsActive(row, false);
+          this.rowWindow?.observe(row);
+        }
+      });
+      return true;
+    }
+
+    /**
+     * Fetches one level of children.
+     *
+     * @param {string} parentId
+     *   Plugin ID of the parent, or '' for the root level.
+     *
+     * @return {Promise<?Array<object>>}
+     *   The child items, or null on transport failure.
+     */
+    async fetchChildren(parentId) {
+      try {
+        const url = new URL(this.childrenUrl, window.location.origin);
+        if (parentId !== '') {
+          url.searchParams.set('parent', parentId);
+        }
+        const response = await fetch(url.toString(), {
+          headers: { Accept: 'application/json' },
+          credentials: 'same-origin',
+        });
+        if (!response.ok) {
+          // eslint-disable-next-line no-console
+          console.error('[treegrid] children fetch failed', response.status);
+          return null;
+        }
+        const data = await response.json();
+        return data.items;
+      } catch (e) {
+        // eslint-disable-next-line no-console
+        console.error('[treegrid] children fetch error', e);
+        return null;
+      }
+    }
+
+    /**
+     * Loads and inserts a row's children on first expand.
+     *
+     * @param {HTMLElement} row
+     *   The parent row.
+     * @param {string} parentId
+     *   The parent's plugin ID.
+     *
+     * @return {Promise<void>}
+     *   Resolves once children are inserted (or the fetch failed).
+     */
+    async loadChildren(row, parentId) {
+      row.dataset.loading = 'true';
+      try {
+        const items = await this.fetchChildren(parentId);
+        if (items === null) {
+          row.setAttribute('aria-expanded', 'false');
+          return;
+        }
+        const depth = levelOf(row) + 1;
+        const fragment = this.buildRows(items, depth);
+        const inserted = Array.from(fragment.children);
+        const anchor = lastDescendantRow(row) ?? row;
+        anchor.after(fragment);
+        row.dataset.loaded = 'true';
+        inserted.forEach((r) => {
+          if (Drupal.attachBehaviors) {
+            Drupal.attachBehaviors(r);
+          }
+          // Built rows are not the active row, so keep their controls out of the
+          // tab order (set after attachBehaviors, which upgrades the dropbutton).
+          setRowControlsActive(r, false);
+          this.rowWindow?.observe(r);
+        });
+        // The row may have been collapsed while this fetch was in flight, when
+        // there were no child rows yet to hide. Hide the children that just
+        // arrived so they do not show under a now-collapsed row.
+        if (row.getAttribute('aria-expanded') !== 'true') {
+          this.hideSubtree(row);
+        }
+      } finally {
+        delete row.dataset.loading;
+      }
+    }
+  }
+
+  Drupal.treegrid.ExpandManager = ExpandManager;
+})(Drupal);
diff --git a/core/modules/treegrid/js/keyboard.js b/core/modules/treegrid/js/keyboard.js
new file mode 100644
index 0000000000000000000000000000000000000000..8642225c16f41bd0476d9096ac9569a003f1bc3d
--- /dev/null
+++ b/core/modules/treegrid/js/keyboard.js
@@ -0,0 +1,106 @@
+/**
+ * @file
+ * WAI-ARIA tree keyboard pattern.
+ *
+ * Pure handler — takes the event plus a context object. Covers navigation and
+ * expand/collapse only; reorder and other features intercept keys ahead of this
+ * through the element's key-handler registry (see <drupal-treegrid>).
+ *
+ * Exposes Drupal.treegrid.handleKeyDown.
+ */
+
+((Drupal) => {
+  Drupal.treegrid = Drupal.treegrid || {};
+  const {
+    childRows,
+    findRow,
+    firstVisibleRow,
+    focusRow,
+    lastVisibleRow,
+    nextVisibleRow,
+    previousVisibleRow,
+    rowOf,
+  } = Drupal.treegrid.treeNav;
+
+  // Elements that must keep their native/authored key behavior instead of the
+  // row's, e.g. Enter on a link or Space on a checkbox. The expand toggle is
+  // exempted: it is a <button> that legitimately takes focus on mouse click
+  // and must keep responding to Enter/Space.
+  const INTERACTIVE = 'a, button, input, select, textarea';
+
+  /**
+   * Handles a keydown on the tree.
+   *
+   * @param {KeyboardEvent} event
+   *   The keydown event.
+   * @param {object} ctx
+   *   Context: {tree: HTMLTableElement, expand: ExpandManager}.
+   */
+  function handleKeyDown(event, ctx) {
+    const row = rowOf(event.target);
+    if (!row) {
+      return;
+    }
+
+    // Let a focused in-row control (title link, checkbox, operations button)
+    // handle its own keys instead of the row hijacking them.
+    const control = event.target !== row && event.target.closest(INTERACTIVE);
+    if (control && !control.closest('[data-treegrid-toggle]')) {
+      return;
+    }
+
+    switch (event.key) {
+      case 'ArrowDown':
+        event.preventDefault();
+        focusRow(ctx.tree, nextVisibleRow(ctx.tree, row));
+        break;
+      case 'ArrowUp':
+        event.preventDefault();
+        focusRow(ctx.tree, previousVisibleRow(ctx.tree, row));
+        break;
+      case 'ArrowRight': {
+        event.preventDefault();
+        if (row.dataset.hasChildren !== 'true') {
+          break;
+        }
+        if (row.getAttribute('aria-expanded') === 'false') {
+          ctx.expand.expand(row, true);
+        } else {
+          focusRow(ctx.tree, childRows(row)[0] ?? null);
+        }
+        break;
+      }
+      case 'ArrowLeft': {
+        event.preventDefault();
+        if (row.getAttribute('aria-expanded') === 'true') {
+          ctx.expand.collapse(row, true);
+        } else {
+          focusRow(ctx.tree, findRow(ctx.tree, row.dataset.parentId));
+        }
+        break;
+      }
+      case 'Home':
+        event.preventDefault();
+        focusRow(ctx.tree, firstVisibleRow(ctx.tree));
+        break;
+      case 'End':
+        event.preventDefault();
+        focusRow(ctx.tree, lastVisibleRow(ctx.tree));
+        break;
+      case 'Enter':
+      case ' ':
+        // Enter and Space toggle expand/collapse on parents. A feature (e.g.
+        // reorder) may claim Space ahead of this via the key-handler registry;
+        // it only reaches here when no feature consumed it.
+        if (row.dataset.hasChildren === 'true') {
+          event.preventDefault();
+          ctx.expand.toggle(row);
+        }
+        break;
+      default:
+        break;
+    }
+  }
+
+  Drupal.treegrid.handleKeyDown = handleKeyDown;
+})(Drupal);
