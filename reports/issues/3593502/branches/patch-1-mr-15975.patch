+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\treegrid_reorder;
+
+/**
+ * A request to move one tree item to a new parent and position.
+ *
+ * The same shape the client POSTs ({id, new_parent, before_id}) and that the
+ * working copy records, carried across the reorder seam so the manager and the
+ * consumer's move handler share one vocabulary.
+ *
+ * @api
+ */
+final readonly class MoveIntent {
+
+  /**
+   * @param string $id
+   *   Id of the item being moved.
+   * @param string $newParent
+   *   Id of the new parent, or '' for the tree root.
+   * @param string|null $beforeId
+   *   Id of the sibling the moved item should sit before, or NULL for the end.
+   */
+  public function __construct(
+    public string $id,
+    public string $newParent,
+    public ?string $beforeId,
+  ) {}
+
+}
diff --git a/core/modules/treegrid_reorder/src/TreeMoveHandlerInterface.php b/core/modules/treegrid_reorder/src/TreeMoveHandlerInterface.php
new file mode 100644
index 0000000000000000000000000000000000000000..362b53276e20d6345238879810d462302cd92c72
--- /dev/null
+++ b/core/modules/treegrid_reorder/src/TreeMoveHandlerInterface.php
@@ -0,0 +1,73 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\treegrid_reorder;
+
+/**
+ * The domain seam for reordering a particular kind of tree.
+ *
+ * TreeReorderManager owns the universal parts of a move — the self-target and
+ * cycle checks, and the validate-then-apply commit loop — and delegates
+ * everything domain-specific to an implementation of this interface. A consumer
+ * module implements it to say which items may move, what local rules apply
+ * (such as a depth cap), how ancestry is resolved, and how a move is written.
+ * Nothing here knows about the manager's orchestration, and the
+ * manager knows nothing about the consumer's storage — they meet only at this
+ * contract.
+ *
+ * @api
+ */
+interface TreeMoveHandlerInterface {
+
+  /**
+   * Validates a move against the consumer's domain rules.
+   *
+   * Called by TreeReorderManager after its universal structural checks
+   * (self-target, cycle) pass. Implementations enforce their own rules here —
+   * which items are movable, ownership/scope, depth limits, vetoes — and must
+   * NOT re-implement the structural checks.
+   *
+   * @param string $tree_id
+   *   The tree the move happens within.
+   * @param \Drupal\treegrid_reorder\MoveIntent $intent
+   *   The requested move.
+   *
+   * @return array{ok: bool, code?: string, message?: string}
+   *   ['ok' => TRUE] when the move is allowed, otherwise an error outcome.
+   */
+  public function validateConstraints(string $tree_id, MoveIntent $intent): array;
+
+  /**
+   * Returns the ancestor item ids of $parent_id, for the manager's cycle check.
+   *
+   * The manager rejects a move whose item appears among the new parent's
+   * ancestors. Implementations should return the parent's root path (the chain
+   * from the tree root down to and including $parent_id).
+   *
+   * @param string $tree_id
+   *   The tree the move happens within.
+   * @param string $parent_id
+   *   The prospective new parent id (never '' — the manager skips the cycle
+   *   check for a move to the root).
+   *
+   * @return string[]
+   *   The ancestor ids.
+   */
+  public function getAncestorIds(string $tree_id, string $parent_id): array;
+
+  /**
+   * Writes a validated move to storage and fires any domain reactions.
+   *
+   * Called by TreeReorderManager only after the move has just re-validated.
+   * Implementations persist the new parent/position and may invoke their own
+   * post-move hooks. The caller owns transaction boundaries.
+   *
+   * @param string $tree_id
+   *   The tree the move happens within.
+   * @param \Drupal\treegrid_reorder\MoveIntent $intent
+   *   The validated move to apply.
+   */
+  public function applyMove(string $tree_id, MoveIntent $intent): void;
+
+}
diff --git a/core/modules/treegrid_reorder/src/TreeReorderManager.php b/core/modules/treegrid_reorder/src/TreeReorderManager.php
new file mode 100644
index 0000000000000000000000000000000000000000..29bfaf5b29fdb6e7bd58ed84fd204d1ac41df429
--- /dev/null
+++ b/core/modules/treegrid_reorder/src/TreeReorderManager.php
@@ -0,0 +1,161 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\treegrid_reorder;
+
+use Drupal\Core\StringTranslation\StringTranslationTrait;
+
+/**
+ * Orchestrates a tree move: universal validation and the commit replay.
+ *
+ * The reusable half of reordering. It enforces the two structural rules that
+ * hold for every tree — you cannot drop an item onto itself, nor into one of
+ * its own descendants — and runs the Save-time commit: validate the whole batch
+ * up front, then apply each move in order, re-validating immediately before its
+ * write so a move made invalid by an earlier one (a newly formed cycle) is
+ * caught. Everything domain-specific (movability, scope, depth, ancestry, the
+ * write) is delegated to a TreeMoveHandlerInterface, so this class never knows
+ * how a particular tree is stored.
+ *
+ * Instantiated directly rather than injected (see the constructor note on the
+ * consuming move handler), so it has no constructor-injected translation
+ * service; StringTranslationTrait::getStringTranslation() falls back to
+ * \Drupal::translation() in that case, which is acceptable here since the
+ * messages below are only ever reached from within a running Drupal request.
+ *
+ * @api
+ */
+final class TreeReorderManager {
+
+  use StringTranslationTrait;
+
+  /**
+   * Validates a single move: the universal checks, then the domain rules.
+   *
+   * @param string $tree_id
+   *   The tree the move happens within.
+   * @param \Drupal\treegrid_reorder\MoveIntent $intent
+   *   The requested move.
+   * @param \Drupal\treegrid_reorder\TreeMoveHandlerInterface $handler
+   *   The consumer's move handler.
+   *
+   * @return array{ok: bool, code?: string, message?: string}
+   *   ['ok' => TRUE] when the move is allowed, otherwise an error outcome.
+   */
+  public function validateMove(string $tree_id, MoveIntent $intent, TreeMoveHandlerInterface $handler): array {
+    if ($intent->newParent === $intent->id) {
+      return [
+        'ok' => FALSE,
+        'code' => 'self_target',
+        'message' => (string) $this->t('Cannot drop an item onto itself.'),
+      ];
+    }
+
+    if ($intent->newParent !== '' && in_array($intent->id, $handler->getAncestorIds($tree_id, $intent->newParent), TRUE)) {
+      return [
+        'ok' => FALSE,
+        'code' => 'cycle',
+        'message' => (string) $this->t('Cannot drop an item into one of its own descendants.'),
+      ];
+    }
+
+    return $handler->validateConstraints($tree_id, $intent);
+  }
+
+  /**
+   * Commits a batch of pending working-copy moves to storage.
+   *
+   * Validates every recorded move first, so a batch with an individually
+   * invalid move aborts before anything is written, then applies the moves in
+   * order, re-validating each against the now-current state. Non-move ops are
+   * ignored. The caller clears the working copy after a successful commit.
+   *
+   * Application is best-effort, not transactional: the pre-flight pass prevents
+   * a known-bad batch from writing anything, but if a move fails partway
+   * through (e.g. a cycle formed by an earlier applied move), the moves already
+   * applied stand — applyMove() is not assumed to be wrapped in a transaction.
+   * The returned 'applied_ops' lets the caller reconcile the working copy with
+   * what actually got written.
+   *
+   * @param string $tree_id
+   *   The tree whose working copy to commit.
+   * @param array<int, array<string, mixed>> $ops
+   *   The recorded ops, in order.
+   * @param \Drupal\treegrid_reorder\TreeMoveHandlerInterface $handler
+   *   The consumer's move handler.
+   *
+   * @return array{ok: bool, code?: string, message?: string, failed_op?: int, applied_ops?: array<int, int>}
+   *   ['ok' => TRUE] on success, otherwise the first failing op's outcome plus
+   *   the $ops indices of any moves from this batch already applied before the
+   *   failure — the caller must drop those from the working copy so a retry
+   *   does not replay them.
+   */
+  public function commitWorkingCopy(string $tree_id, array $ops, TreeMoveHandlerInterface $handler): array {
+    $move_indices = [];
+    foreach ($ops as $index => $op) {
+      if (($op['type'] ?? '') === 'move') {
+        $move_indices[] = $index;
+      }
+    }
+    if ($move_indices === []) {
+      return ['ok' => TRUE];
+    }
+
+    $intents = array_map(static function (int $index) use ($ops): MoveIntent {
+      $op = $ops[$index];
+      $before_id = $op['before_id'] ?? NULL;
+      return new MoveIntent(
+        (string) ($op['id'] ?? ''),
+        (string) ($op['new_parent'] ?? ''),
+        $before_id === NULL ? NULL : (string) $before_id,
+      );
+    }, $move_indices);
+
+    // Pre-flight: reject the batch if any op is individually invalid, before
+    // writing anything.
+    foreach ($intents as $i => $intent) {
+      $validation = $this->validateMove($tree_id, $intent, $handler);
+      if (!$validation['ok']) {
+        return $this->commitFailure($validation, $move_indices[$i]);
+      }
+    }
+
+    // Apply in order, re-validating against the now-current state.
+    $applied = [];
+    foreach ($intents as $i => $intent) {
+      $validation = $this->validateMove($tree_id, $intent, $handler);
+      if (!$validation['ok']) {
+        return $this->commitFailure($validation, $move_indices[$i], $applied);
+      }
+      $handler->applyMove($tree_id, $intent);
+      $applied[] = $move_indices[$i];
+    }
+
+    return ['ok' => TRUE];
+  }
+
+  /**
+   * Shapes a failed-op outcome for commitWorkingCopy().
+   *
+   * @param array{code?: string, message?: string} $validation
+   *   The failing validateMove() result.
+   * @param int $index
+   *   The $ops index of the failing move.
+   * @param array<int, int> $applied
+   *   The $ops indices of moves from this batch already applied.
+   *
+   * @return array{ok: false, code: string, message: string, failed_op: int, applied_ops: array<int, int>}
+   *   The commit failure outcome.
+   */
+  private function commitFailure(array $validation, int $index, array $applied = []): array {
+    return [
+      'ok' => FALSE,
+      'code' => $validation['code'] ?? 'commit_failed',
+      'message' => $validation['message'] ?? (string) $this->t('A pending change could not be saved.'),
+      'failed_op' => $index,
+      'applied_ops' => $applied,
+    ];
+  }
+
+}
diff --git a/core/modules/treegrid_reorder/src/TreegridWorkingCopy.php b/core/modules/treegrid_reorder/src/TreegridWorkingCopy.php
new file mode 100644
index 0000000000000000000000000000000000000000..5f33ec67c06c7c5539917c8d5399850de65b4098
--- /dev/null
+++ b/core/modules/treegrid_reorder/src/TreegridWorkingCopy.php
@@ -0,0 +1,224 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\treegrid_reorder;
+
+use Drupal\Core\Session\AccountInterface;
+use Drupal\Core\TempStore\Lock;
+use Drupal\Core\TempStore\SharedTempStore;
+use Drupal\Core\TempStore\SharedTempStoreFactory;
+
+/**
+ * A per-tree working copy of pending reorder operations.
+ *
+ * Committing each move immediately leaves an editor no way to back out. The
+ * working copy restores Save/cancel by recording moves in the shared tempstore
+ * instead of writing them, and replaying them on Save (see TreeReorderManager).
+ *
+ * A full snapshot of the tree's mutable state would defeat the lazy-load design
+ * these UIs exist for: a large tree would be expensive to snapshot and hold.
+ * Instead this stores a bounded, ordered list of operations (one per move) that
+ * the consumer overlays at read time onto each lazily-loaded level. The cost is
+ * proportional to the number of edits, not the size of the tree.
+ *
+ * Uses the shared (not private) tempstore so its owner/lock metadata can warn
+ * when a second user is already editing the same tree — the model Views UI and
+ * Layout Builder use.
+ *
+ * Each consumer owns a tempstore collection (passed at construction) and keys
+ * entries within it by a tree id; collections keep two
+ * consumers' ids from colliding.
+ *
+ * @api
+ */
+final class TreegridWorkingCopy {
+
+  /**
+   * Per-request cache of decoded op lists, keyed by tree id.
+   *
+   * @var array<string, array<int, array<string, mixed>>>
+   */
+  private array $cache = [];
+
+  /**
+   * Constructs the working copy store.
+   *
+   * @param \Drupal\Core\TempStore\SharedTempStoreFactory $tempStoreFactory
+   *   The shared tempstore factory.
+   * @param \Drupal\Core\Session\AccountInterface $currentUser
+   *   The current user, recorded as the owner of locks and pending edits.
+   * @param string $collection
+   *   The tempstore collection name. Must be unique to the consuming module
+   *   (e.g. 'my_module.working_copy') so two consumers editing same-named
+   *   trees do not collide.
+   */
+  public function __construct(
+    private readonly SharedTempStoreFactory $tempStoreFactory,
+    private readonly AccountInterface $currentUser,
+    private readonly string $collection,
+  ) {}
+
+  /**
+   * Returns the pending operations for a tree, in the order they were recorded.
+   *
+   * @param string $id
+   *   The tree id.
+   *
+   * @return array<int, array<string, mixed>>
+   *   The ordered op list; empty when there are no pending changes.
+   */
+  public function getOps(string $id): array {
+    if (isset($this->cache[$id])) {
+      return $this->cache[$id];
+    }
+    $stored = $this->store()->get($id);
+    $ops = is_array($stored['ops'] ?? NULL) ? $stored['ops'] : [];
+    $this->cache[$id] = $ops;
+    return $ops;
+  }
+
+  /**
+   * Appends a pending operation to a tree's working copy.
+   *
+   * Recording is atomic against a concurrent editor: an isLocked() check
+   * followed by an unconditional write would let a second editor pass the
+   * check and then overwrite (and re-own) the first editor's working copy
+   * before it writes. Instead the write itself is the gate — setIfNotExists()
+   * for the first op on a tree only succeeds if no entry exists yet, and
+   * setIfOwner() for later ops only succeeds if the entry still belongs to the
+   * current user, so a race between two editors leaves exactly one of them
+   * owning the copy.
+   *
+   * @param string $id
+   *   The tree id.
+   * @param array<string, mixed> $op
+   *   The operation to record (e.g. ['type' => 'move', 'id' => …]).
+   *
+   * @return bool
+   *   TRUE if recorded; FALSE when another user holds the working copy.
+   */
+  public function addOp(string $id, array $op): bool {
+    $existing = $this->getOps($id);
+    $ops = $existing;
+    $ops[] = $op;
+    $set = $existing === []
+      ? $this->store()->setIfNotExists($id, ['ops' => $ops])
+      : $this->store()->setIfOwner($id, ['ops' => $ops]);
+    if ($set) {
+      $this->cache[$id] = $ops;
+    }
+    return $set;
+  }
+
+  /**
+   * Whether a tree has any pending changes.
+   *
+   * @param string $id
+   *   The tree id.
+   *
+   * @return bool
+   *   TRUE when there is at least one pending op.
+   */
+  public function hasChanges(string $id): bool {
+    return $this->getOps($id) !== [];
+  }
+
+  /**
+   * Discards a tree's working copy.
+   *
+   * Only clears a working copy owned by the current user, so a Cancel cannot
+   * discard another editor's pending changes. To release someone else's
+   * abandoned lock, use breakLock().
+   *
+   * @param string $id
+   *   The tree id.
+   */
+  public function clear(string $id): void {
+    if ($this->store()->deleteIfOwner($id)) {
+      unset($this->cache[$id]);
+    }
+  }
+
+  /**
+   * Discards a tree's working copy regardless of who owns it.
+   *
+   * Bypasses ownership deliberately: this exists for an administrator to
+   * release a lock abandoned by another user (e.g. a closed browser tab),
+   * not for a user's own Cancel — see clear() for that.
+   *
+   * @param string $id
+   *   The tree id.
+   */
+  public function breakLock(string $id): void {
+    $this->store()->delete($id);
+    unset($this->cache[$id]);
+  }
+
+  /**
+   * Drops specific recorded operations from a tree's working copy.
+   *
+   * Used after a partial commit: operations already written to live storage
+   * must not remain in the working copy, or a retry would replay them.
+   *
+   * @param string $id
+   *   The tree id.
+   * @param array<int, int> $indices
+   *   The zero-based indices (as returned by getOps()) of the operations to
+   *   remove.
+   *
+   * @return bool
+   *   TRUE if the working copy was updated (or there was nothing to drop);
+   *   FALSE when another user now holds the working copy.
+   */
+  public function dropOps(string $id, array $indices): bool {
+    if ($indices === []) {
+      return TRUE;
+    }
+    $ops = $this->getOps($id);
+    if ($ops === []) {
+      return TRUE;
+    }
+    $remaining = array_values(array_diff_key($ops, array_flip($indices)));
+    $set = $this->store()->setIfOwner($id, ['ops' => $remaining]);
+    if ($set) {
+      $this->cache[$id] = $remaining;
+    }
+    return $set;
+  }
+
+  /**
+   * Whether the working copy is held by a different user.
+   *
+   * @param string $id
+   *   The tree id.
+   *
+   * @return bool
+   *   TRUE when a working copy exists and its owner is not the current user.
+   */
+  public function isLocked(string $id): bool {
+    $lock = $this->getLockMetadata($id);
+    return $lock !== NULL && (string) $lock->getOwnerId() !== (string) $this->currentUser->id();
+  }
+
+  /**
+   * Returns the working copy's lock metadata, or NULL when none exists.
+   *
+   * @param string $id
+   *   The tree id.
+   *
+   * @return \Drupal\Core\TempStore\Lock|null
+   *   The lock (owner + updated time), or NULL.
+   */
+  public function getLockMetadata(string $id): ?Lock {
+    return $this->store()->getMetadata($id);
+  }
+
+  /**
+   * Returns the shared tempstore for this consumer's collection.
+   */
+  private function store(): SharedTempStore {
+    return $this->tempStoreFactory->get($this->collection);
+  }
+
+}
diff --git a/core/modules/treegrid_reorder/tests/modules/treegrid_reorder_test/css/treegrid-reorder-test.css b/core/modules/treegrid_reorder/tests/modules/treegrid_reorder_test/css/treegrid-reorder-test.css
new file mode 100644
index 0000000000000000000000000000000000000000..81c95e34f0ffd1a9ccb8ca0e061c54945a5a8f52
--- /dev/null
+++ b/core/modules/treegrid_reorder/tests/modules/treegrid_reorder_test/css/treegrid-reorder-test.css
@@ -0,0 +1,41 @@
+/**
+ * @file
+ * Minimal styling for the reorder gesture test consumer.
+ *
+ * Only what the gestures need: a drag handle, the absolutely-positioned
+ * drop line (the host gets its positioning context from treegrid's own CSS),
+ * and visible drag/grab/flash states. Not meant to be pretty.
+ */
+
+.reorder-test-handle {
+  display: inline-block;
+  width: 1rem;
+  height: 1rem;
+  margin-inline-end: 0.5rem;
+  cursor: grab;
+  vertical-align: middle;
+  background: #ccc;
+}
+
+.reorder-test-dragging {
+  opacity: 0.5;
+}
+
+.reorder-test-grabbed {
+  outline: 2px solid blue;
+}
+
+.reorder-test-drop-indicator {
+  position: absolute;
+  display: none;
+  height: 2px;
+  background: blue;
+}
+
+.reorder-test-drop-as-child {
+  outline: 1px dashed green;
+}
+
+.reorder-test-flash {
+  background: yellow;
+}
diff --git a/core/modules/treegrid_reorder/tests/modules/treegrid_reorder_test/js/treegrid-reorder-test.js b/core/modules/treegrid_reorder/tests/modules/treegrid_reorder_test/js/treegrid-reorder-test.js
