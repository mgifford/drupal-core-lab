@@ -0,0 +1,44 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\treegrid\Plugin\TreegridColumn;
+
+use Drupal\Component\Plugin\PluginBase;
+use Drupal\Core\StringTranslation\StringTranslationTrait;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+
+/**
+ * Base class for TreegridColumn plugins.
+ *
+ * Concrete columns must implement getCellData(). handleUpdate() defaults to
+ * FALSE (read-only) — override it for interactive columns.
+ *
+ * @api
+ */
+abstract class TreegridColumnBase extends PluginBase implements TreegridColumnInterface {
+
+  use StringTranslationTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getHeader(): TranslatableMarkup {
+    return $this->pluginDefinition['title'];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  abstract public function getCellData(object $context): array;
+
+  /**
+   * {@inheritdoc}
+   *
+   * Read-only by default. Interactive columns must override this.
+   */
+  public function handleUpdate(string $link_id, mixed $value): bool {
+    return FALSE;
+  }
+
+}
diff --git a/core/modules/treegrid/src/Plugin/TreegridColumn/TreegridColumnInterface.php b/core/modules/treegrid/src/Plugin/TreegridColumn/TreegridColumnInterface.php
new file mode 100644
index 0000000000000000000000000000000000000000..c1a6a5c33e680ddf698cb7c49dbeb228ccc175c7
--- /dev/null
+++ b/core/modules/treegrid/src/Plugin/TreegridColumn/TreegridColumnInterface.php
@@ -0,0 +1,90 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\treegrid\Plugin\TreegridColumn;
+
+use Drupal\Component\Plugin\PluginInspectionInterface;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+
+/**
+ * Interface for TreegridColumn plugins.
+ *
+ * A column plugin contributes one column to a treegrid admin UI. The same cell
+ * data shape must be renderable by both the Twig template (server-rendered top
+ * level) and a JS cell renderer (lazy-loaded children). Cells declare a 'type'
+ * key naming the widget; a matching JS renderer is registered with
+ * Drupal.treegrid.registerCellRenderer(type, fn), and the Twig template draws
+ * the same markup. treegrid ships these cell types:
+ *   - 'checkbox': a boolean control, optionally interactive.
+ *   - 'markup': an opaque server-rendered HTML string, injected verbatim. It
+ *     MUST be trusted server-rendered markup — it is written through |raw and
+ *     innerHTML, so user-supplied input in a markup cell is an XSS vector.
+ *
+ * Read-only columns return FALSE from handleUpdate().
+ *
+ * @api
+ */
+interface TreegridColumnInterface extends PluginInspectionInterface {
+
+  /**
+   * Returns the column header label.
+   */
+  public function getHeader(): TranslatableMarkup;
+
+  /**
+   * Returns structured cell data for a given row.
+   *
+   * Return an empty array to indicate that this column has no cell for the
+   * given row (e.g. a column that only applies to parent items should return
+   * [] for leaves). Callers filter empty returns and do not render a cell at
+   * all — no wrapper is emitted.
+   *
+   * When a non-empty array is returned it MUST contain a 'type' key naming the
+   * cell widget. All other keys are type-specific. Example for type 'checkbox':
+   * @code
+   * [
+   *   'type'        => 'checkbox',
+   *   'value'       => bool,
+   *   'label'       => string,   // aria-label for the control
+   *   'interactive' => bool,     // FALSE → render disabled
+   *   'link_id'     => string,   // plugin ID sent back on update
+   * ]
+   * @endcode
+   *
+   * @param object $context
+   *   The row context. Its concrete type is defined by the consumer module
+   *   that registers the column and calls this method — treegrid passes it
+   *   through opaquely (e.g. a consumer editing taxonomy terms would pass a
+   *   term tree element).
+   *
+   * @return array<string, mixed>
+   *   Cell data array with a 'type' key, or [] to skip this cell entirely.
+   */
+  public function getCellData(object $context): array;
+
+  /**
+   * Applies a value change to the row identified by $link_id.
+   *
+   * Called by the consumer's column-update controller when the client POSTs an
+   * interactive cell change. treegrid defines this contract but ships no route
+   * or controller for it — the consumer owns the persistence endpoint. Return
+   * FALSE for read-only columns — the controller responds with a 400 rather
+   * than saving.
+   * Implementations should also return FALSE when the row is not one this
+   * column can update.
+   *
+   * @param string $link_id
+   *   The row identifier, as reported in the cell's 'link_id' key. Its meaning
+   *   (e.g. an entity ID or plugin ID) is defined by the consumer module that
+   *   registers the column; treegrid passes it through opaquely.
+   * @param mixed $value
+   *   The new value sent from the client (e.g. TRUE/FALSE for a toggle).
+   *
+   * @return bool
+   *   TRUE if the update was applied, FALSE if this column is read-only or
+   *   the row is not supported by this column.
+   */
+  public function handleUpdate(string $link_id, mixed $value): bool;
+
+}
diff --git a/core/modules/treegrid/src/TreegridColumnManager.php b/core/modules/treegrid/src/TreegridColumnManager.php
new file mode 100644
index 0000000000000000000000000000000000000000..773205e5fcfe8e4f2608b6673e3181dfc0b524f5
--- /dev/null
+++ b/core/modules/treegrid/src/TreegridColumnManager.php
@@ -0,0 +1,71 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\treegrid;
+
+use Drupal\Core\Cache\CacheBackendInterface;
+use Drupal\Core\Extension\ModuleHandlerInterface;
+use Drupal\Core\Plugin\DefaultPluginManager;
+use Drupal\treegrid\Attribute\TreegridColumn;
+use Drupal\treegrid\Plugin\TreegridColumn\TreegridColumnInterface;
+
+/**
+ * Discovers and instantiates TreegridColumn plugins.
+ *
+ * Modules add columns by placing a class implementing TreegridColumnInterface
+ * inside src/Plugin/TreegridColumn/ and decorating it with #[TreegridColumn].
+ * The alter hook hook_treegrid_column_info_alter() lets modules modify or
+ * remove definitions after discovery.
+ *
+ * @api
+ */
+final class TreegridColumnManager extends DefaultPluginManager {
+
+  /**
+   * Memoized sorted column instances.
+   *
+   * @var \Drupal\treegrid\Plugin\TreegridColumn\TreegridColumnInterface[]|null
+   */
+  private ?array $sortedColumns = NULL;
+
+  public function __construct(
+    \Traversable $namespaces,
+    CacheBackendInterface $cache_backend,
+    ModuleHandlerInterface $module_handler,
+  ) {
+    parent::__construct(
+      'Plugin/TreegridColumn',
+      $namespaces,
+      $module_handler,
+      TreegridColumnInterface::class,
+      TreegridColumn::class,
+    );
+    $this->alterInfo('treegrid_column_info');
+    $this->setCacheBackend($cache_backend, 'treegrid_column_plugins');
+  }
+
+  /**
+   * Returns all column plugin instances sorted by weight.
+   *
+   * Result is memoized: instances are shared across calls within the same
+   * request to avoid redundant createInstance() work.
+   *
+   * @return \Drupal\treegrid\Plugin\TreegridColumn\TreegridColumnInterface[]
+   *   Keyed by plugin ID, sorted by the 'weight' attribute property.
+   */
+  public function getSortedColumns(): array {
+    if ($this->sortedColumns !== NULL) {
+      return $this->sortedColumns;
+    }
+    $definitions = $this->getDefinitions();
+    uasort($definitions, static fn(array $a, array $b): int => ($a['weight'] ?? 0) <=> ($b['weight'] ?? 0));
+    $columns = [];
+    foreach (array_keys($definitions) as $id) {
+      $columns[$id] = $this->createInstance($id);
+    }
+    $this->sortedColumns = $columns;
+    return $this->sortedColumns;
+  }
+
+}
