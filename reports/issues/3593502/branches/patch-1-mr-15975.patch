index 0000000000000000000000000000000000000000..5c0f83ba1fd4871c3274f3f09877f8f4e55742d6
--- /dev/null
+++ b/core/modules/treegrid_reorder/README.md
@@ -0,0 +1,70 @@
+# Tree grid reorder
+
+Experimental drag-and-drop and keyboard reordering layer for
+[Tree grid](../treegrid/README.md) screens. It supplies the generic gesture
+handling, universal move validation, and an optional Save/Cancel buffer; a
+consuming module supplies the domain rules and the write. It has no
+user-facing UI of its own.
+
+## What it adds
+
+- **Pointer drag-and-drop** reorder and re-parent, with a drop-line indicator
+  between rows and an "as-child" outline highlight, plus an aria-live
+  announcement of what would happen on release.
+- **Keyboard move mode**: Space to pick a row up, arrows to step through the
+  same before/after/child drop-intent space as drag, Enter to drop, Escape to
+  cancel.
+- **Shift+Arrow** as a quick keyboard equivalent for a same-level sibling
+  reorder, without entering move mode.
+- **Universal move validation**, shared by drag, keyboard move mode, and
+  commit: a node cannot be dropped onto itself, nor into one of its own
+  descendants (a cycle). `TreeReorderManager` enforces these two structural
+  rules before delegating to the consumer's domain rules.
+- **Optional `TreegridWorkingCopy`** Save/Cancel buffer: instead of writing
+  each move immediately, moves are recorded as an ordered op list in a shared
+  tempstore and overlaid at read time onto lazily-loaded levels. Save replays
+  the recorded ops through the same validate-then-apply path used for a single
+  move; Cancel discards them. Cost is proportional to the number of pending
+  edits, not the size of the tree. Uses the *shared* (not private) tempstore so
+  a second editor sees a lock notice naming the current owner.
+
+## Consumer contract
+
+**Implement `TreeMoveHandlerInterface`** to supply the domain seam:
+- `validateConstraints(string $tree_id, MoveIntent $intent): array` — your
+  rules (movability, scope, depth limits, vetoes), called after
+  `TreeReorderManager`'s structural checks pass. Return
+  `['ok' => TRUE]` or `['ok' => FALSE, 'code' => …, 'message' => …]`.
+- `getAncestorIds(string $tree_id, string $parent_id): array` — the root path
+  of a prospective parent, for the manager's cycle check.
+- `applyMove(string $tree_id, MoveIntent $intent): void` — persist the move
+  and fire any domain-specific reactions (for example, your own post-move
+  hook).
+
+**Run moves through `TreeReorderManager`**: `validateMove()` for a
+record-time check (drag drop, keyboard move-mode confirm, Shift+Arrow), and
+`commitWorkingCopy()` to replay a working copy's ops on Save — it validates
+the whole batch first, then applies in order, re-validating each move
+immediately before its write so one move invalidated by an earlier one in the
+same batch (a newly formed cycle) is caught rather than silently applied.
+
+**`MoveIntent`** is the shared move vocabulary: `{ id, newParent, beforeId }`
+— the same shape the client POSTs and the working copy records.
+
+**To buffer moves for Save/Cancel**, instantiate `TreegridWorkingCopy` with a
+tempstore collection name unique to your module, so two consumers editing
+same-named trees do not collide.
+
+**On the client**, load the `treegrid_reorder/treegrid_reorder` library and
+pass a configuration object naming your own CSS classes and selectors — for
+example a drag handle selector, a "locked" class for non-movable rows, a
+"dragging" class, the drop-line and as-child highlight classes, and a
+row-title selector used in announcements — so the gesture code (`controller.js`,
+`move-mode.js`, `indicator.js`, `reorder-keys.js`) carries no markup knowledge
+of its own.
+
+## No UI of its own
+
+Tree grid reorder ships no admin pages, forms, or routes. It only activates
+once a consumer wires its move endpoint, `TreeMoveHandlerInterface`
+implementation, and (optionally) a `TreegridWorkingCopy` collection together.
diff --git a/core/modules/treegrid_reorder/js/commit.js b/core/modules/treegrid_reorder/js/commit.js
new file mode 100644
index 0000000000000000000000000000000000000000..5ef372e461d4912102d63956a15d1e908bbcf900
--- /dev/null
+++ b/core/modules/treegrid_reorder/js/commit.js
@@ -0,0 +1,253 @@
+/**
+ * @file
+ * Translates a DropIntent into a server move + visible-state refresh.
+ *
+ * Server is the only source of truth. We POST to the move endpoint with no DOM
+ * mutation up front; on success we re-fetch the affected levels (from-parent and
+ * to-parent) and rebuild their rows in place. The whole class of "client moved
+ * the DOM but forgot to update attribute X" bugs goes away — any attribute the
+ * row needs is set by the renderer from the server's JSON.
+ *
+ * Trade-off: a moved row's previously-expanded descendants collapse after the
+ * refresh. Acceptable for v1 — replay-expansion can be added later.
+ *
+ * The move response shape is {ok: boolean, weight?, code?, message?}.
+ *
+ * Per-row metadata that the children endpoint cannot express (e.g. whether a
+ * parent now has children) is the consumer's concern: it is supplied as the
+ * options.applyParentMetadata callback, and options.onCommitted fires after a
+ * successful move so the consumer can react (reveal an unsaved notice, etc.).
+ *
+ * Exposes Drupal.treegridReorder.commitMove.
+ */
+
+((Drupal) => {
+  Drupal.treegridReorder = Drupal.treegridReorder || {};
+  const { childRows, findRow, focusRow, nextSiblingRow } =
+    Drupal.treegrid.treeNav;
+  const { announce } = Drupal.treegrid;
+
+  /**
+   * Resolves the parent id the moved row should end up under.
+   *
+   * @param {object} intent
+   *   The DropIntent.
+   *
+   * @return {string}
+   *   The destination parent id, or ''.
+   */
+  function resolveNewParentId(intent) {
+    if (intent.kind === 'child') {
+      return intent.target.dataset.id ?? '';
+    }
+    return intent.target.dataset.parentId ?? '';
+  }
+
+  /**
+   * Resolves the before_id payload for the move.
+   *
+   * 'before' → the target; 'after' → the target's next sibling row (or null
+   * for end-of-list); 'child' → the target's first existing child, so the
+   * moved row lands as the FIRST child (right under the parent header, where
+   * the drop is aimed). A collapsed parent whose children aren't in the DOM,
+   * and a leaf, fall through to null (the only / appended child), which the
+   * server and commit-time auto-expand handle.
+   *
+   * @param {object} intent
+   *   The DropIntent.
+   *
+   * @return {?string}
+   *   The before_id, or null.
+   */
+  function resolveBeforeId(intent) {
+    if (intent.kind === 'child') {
+      return childRows(intent.target)[0]?.dataset.id ?? null;
+    }
+    if (intent.kind === 'before') {
+      return intent.target.dataset.id ?? null;
+    }
+    return nextSiblingRow(intent.target)?.dataset.id ?? null;
+  }
+
+  /**
+   * The inner commit pipeline (wrapped by commitMove for the in-flight flag).
+   *
+   * @param {HTMLTableRowElement} row
+   *   The moved row.
+   * @param {object} intent
+   *   The DropIntent.
+   * @param {string} moveUrl
+   *   The move endpoint.
+   * @param {object} expand
+   *   The treegrid ExpandManager, for destination auto-expand + group
+   *   refreshes.
+   * @param {?HTMLTableElement} tree
+   *   The root treegrid element.
+   * @param {string} movedId
+   *   The moved row's id.
+   * @param {string} csrfToken
+   *   The X-CSRF-Token value, or ''.
+   * @param {object} options
+   *   { applyParentMetadata, onCommitted } consumer callbacks.
+   *
+   * @return {Promise<void>}
+   *   Resolves once the move is committed and refreshed (or bailed).
+   */
+  async function runCommit(
+    row,
+    intent,
+    moveUrl,
+    expand,
+    tree,
+    movedId,
+    csrfToken,
+    options,
+  ) {
+    const oldParentId = row.dataset.parentId ?? '';
+    const newParentId = resolveNewParentId(intent);
+    const { target } = intent;
+
+    if (
+      intent.kind === 'child' &&
+      target.dataset.hasChildren === 'true' &&
+      target.getAttribute('aria-expanded') !== 'true'
+    ) {
+      await expand.expand(target);
+      if (target.getAttribute('aria-expanded') !== 'true') {
+        announce(
+          Drupal.t('Could not open the destination. Move canceled.'),
+          'assertive',
+        );
+        return;
+      }
+    }
+
+    // Resolve before_id AFTER any auto-expand: for a 'child' drop the first
+    // child is only in the DOM once the parent is open, and first-child
+    // placement depends on finding it.
+    let beforeId = resolveBeforeId(intent);
+    // A drop released just below the row above the dragged row resolves to
+    // the dragged row's own id, i.e. "before yourself", which the server
+    // treats as end-of-list. Remap to the current next sibling, as move mode
+    // already does for its own no-op guard.
+    if (beforeId === movedId) {
+      beforeId = nextSiblingRow(row)?.dataset.id ?? null;
+    }
+
+    let body;
+    try {
+      const response = await fetch(moveUrl, {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+          Accept: 'application/json',
+          'X-CSRF-Token': csrfToken ?? '',
+        },
+        credentials: 'same-origin',
+        body: JSON.stringify({
+          id: movedId,
+          new_parent: newParentId,
+          before_id: beforeId,
+        }),
+      });
+      body = await response.json().catch(() => ({ ok: false }));
+      if (!response.ok || !body.ok) {
+        announce(body.message ?? Drupal.t('Move failed.'), 'assertive');
+        return;
+      }
+    } catch (e) {
+      // eslint-disable-next-line no-console
+      console.error('[treegrid-reorder] move fetch failed', e);
+      announce(Drupal.t('Network error. Move canceled.'), 'assertive');
+      return;
+    }
+
+    // Server confirmed. Re-fetch the visible state of both affected groups.
+    // When from === to (sibling reorder under the same parent) the second
+    // refresh is a no-op but harmless.
+    const okFrom = await expand.refresh(oldParentId);
+    let okTo = true;
+    if (newParentId !== oldParentId) {
+      okTo = await expand.refresh(newParentId);
+    }
+    // A refresh whose fetch failed would leave the tree half-synced (a
+    // duplicated row, or no tab stop). Reload so the tree resyncs from the
+    // server rather than continuing from an inconsistent DOM.
+    if (!okFrom || !okTo) {
+      announce(Drupal.t('Could not refresh the tree. Reloading.'), 'assertive');
+      window.location.reload();
+      return;
+    }
+
+    options.applyParentMetadata?.(oldParentId);
+    options.applyParentMetadata?.(newParentId);
+
+    // row and intent.target are detached after refresh — re-find by id. Only
+    // pull focus back to the tree if it is still there (or on body because the
+    // refresh detached the focused row); a user who moved to the search field
+    // during the async round-trip keeps their place.
+    if (tree) {
+      const fresh = findRow(tree, movedId);
+      const active = document.activeElement;
+      if (fresh && (active === document.body || tree.contains(active))) {
+        focusRow(tree, fresh);
+      }
+    }
+
+    announce(Drupal.t('Item moved.'), 'polite');
+    options.onCommitted?.();
+  }
+
+  /**
+   * Commits a drag-and-drop move, flagging the host while in-flight.
+   *
+   * Tests wait on the data-treegrid-moving flag's absence to know all asynchronous
+   * refresh work is done; humans never see it.
+   *
+   * @param {HTMLTableRowElement} row
+   *   The moved row.
+   * @param {object} intent
+   *   The DropIntent.
+   * @param {string} moveUrl
+   *   The move endpoint.
+   * @param {object} expand
+   *   The treegrid ExpandManager.
+   * @param {string} csrfToken
+   *   The X-CSRF-Token value, or ''.
+   * @param {object} options
+   *   { applyParentMetadata, onCommitted } consumer callbacks.
+   *
+   * @return {Promise<void>}
+   *   Resolves once the commit completes.
+   */
+  async function commitMove(row, intent, moveUrl, expand, csrfToken, options) {
+    const movedId = row.dataset.id;
+    if (!movedId) {
+      return;
+    }
+
+    const tree = row.closest('table[role="treegrid"]');
+    const host = tree?.closest('drupal-treegrid') ?? null;
+    host?.setAttribute('data-treegrid-moving', 'true');
+    try {
+      await runCommit(
+        row,
+        intent,
+        moveUrl,
+        expand,
+        tree,
+        movedId,
+        csrfToken,
+        options,
+      );
+    } finally {
+      host?.removeAttribute('data-treegrid-moving');
+    }
+  }
+
+  Drupal.treegridReorder.commitMove = commitMove;
+  // Exported so keyboard move mode can resolve an intent to {new_parent,
+  // before_id} for its no-op-drop guard, without duplicating the logic.
+  Drupal.treegridReorder.resolveNewParentId = resolveNewParentId;
+  Drupal.treegridReorder.resolveBeforeId = resolveBeforeId;
+})(Drupal);
diff --git a/core/modules/treegrid_reorder/js/controller.js b/core/modules/treegrid_reorder/js/controller.js
new file mode 100644
index 0000000000000000000000000000000000000000..6763fbea706ff08533e9b3d21330d85af28e730c
--- /dev/null
+++ b/core/modules/treegrid_reorder/js/controller.js
@@ -0,0 +1,335 @@
+/**
+ * @file
+ * Pointer-event drag controller for a treegrid.
+ *
+ * Owns the state machine (idle / armed / dragging) and dispatches to:
+ *  - intent.js for zone math
+ *  - indicator.js for visual feedback
+ *  - commit.js for the optimistic DOM move + server commit
+ *
+ * Drag threshold of 5 px so a tap on the handle doesn't start a drag — this
+ * matters more on touch (every tap has some pointer drift) than mouse.
+ *
+ * The consumer supplies its CSS class/selector names (handle, locked, dragging)
+ * and the commit callbacks via the options object.
+ *
+ * Exposes Drupal.treegridReorder.DragController.
+ */
+
+((Drupal) => {
+  Drupal.treegridReorder = Drupal.treegridReorder || {};
+  const { commitMove, computeIntent, sameIntent } = Drupal.treegridReorder;
+  const { descendantRows } = Drupal.treegrid.treeNav;
+
+  const DRAG_THRESHOLD_PX = 5;
+  const HOVER_EXPAND_MS = 1000;
+  const ROW = 'tr[role="row"]';
+
+  class DragController {
+    /**
+     * @param {HTMLTableElement} tree
+     *   The root treegrid element.
+     * @param {string} moveUrl
+     *   The move endpoint.
+     * @param {object} expand
+     *   The treegrid ExpandManager, for hover-to-expand and commit refreshes.
+     * @param {string} csrfToken
+     *   The X-CSRF-Token value passed to commit, or ''.
+     * @param {Drupal.treegridReorder.DropIndicator} indicator
+     *   The shared drop indicator (owned by the host, also used by move mode).
+     * @param {function()} onGestureStart
+     *   Called when a drag arms, so the host can cancel any active keyboard
+     *   move mode before the pointer gesture takes over the shared indicator.
+     * @param {function(HTMLElement)} onTap
+     *   Called when a handle is clicked without dragging, so a mouse user can
+     *   pick a row up into keyboard move mode (click to pick up, click a
+     *   destination, confirm with the keyboard).
+     * @param {object} options
+     *   { handleSelector, lockedClass, draggingClass, applyParentMetadata,
+     *   onCommitted } — the consumer's CSS names and the commit callbacks.
+     */
+    constructor(
+      tree,
+      moveUrl,
+      expand,
+      csrfToken,
+      indicator,
+      onGestureStart,
+      onTap,
+      options,
+    ) {
+      this.tree = tree;
+      this.moveUrl = moveUrl;
+      this.expand = expand;
+      this.csrfToken = csrfToken;
+      this.indicator = indicator;
+      this.onGestureStart = onGestureStart;
+      this.onTap = onTap;
+      this.options = options;
+      this.handleSelector = options.handleSelector;
+      this.lockedClass = options.lockedClass;
+      this.draggingClass = options.draggingClass;
+
+      this.pointerId = null;
+      this.moved = null;
+      this.activeHandle = null;
+      this.dragging = false;
+      this.startX = 0;
+      this.startY = 0;
+      this.intent = null;
+      this.hoverTarget = null;
+      this.hoverTimer = null;
+
+      this.onPointerDown = this.onPointerDown.bind(this);
+      this.onPointerMove = this.onPointerMove.bind(this);
+      this.onPointerUp = this.onPointerUp.bind(this);
+      this.onPointerCancel = this.onPointerCancel.bind(this);
+    }
+
+    /**
+     * Binds the persistent pointerdown listener on the tree.
+     */
+    attach() {
+      this.tree.addEventListener('pointerdown', this.onPointerDown);
+    }
+
+    /**
+     * Removes listeners and tears down the indicator.
+     */
+    detach() {
+      this.tree.removeEventListener('pointerdown', this.onPointerDown);
+      this.cleanup();
+      // The host owns the shared indicator's lifecycle, so only clear it here.
+      this.indicator.clear();
+    }
+
+    /**
+     * Arms a drag gesture on pointerdown over an unlocked handle.
+     *
+     * @param {PointerEvent} event
+     *   The pointerdown event.
+     */
+    onPointerDown(event) {
+      if (this.pointerId !== null) {
+        // A gesture is already in progress; ignore a second concurrent
+        // pointer (e.g. multi-touch) rather than clobbering the first.
+        return;
+      }
+      if (event.button !== undefined && event.button !== 0) {
+        return;
+      }
+      const { target } = event;
+      if (!(target instanceof Element)) {
+        return;
+      }
+      const handle = target.closest(this.handleSelector);
+      if (!handle || handle.classList.contains(this.lockedClass)) {
+        return;
+      }
+      const row = handle.closest(ROW);
+      if (!row) {
+        return;
+      }
+
+      this.moved = row;
+      this.activeHandle = handle;
+      this.pointerId = event.pointerId;
+      this.startX = event.clientX;
+      this.startY = event.clientY;
+      this.dragging = false;
+
+      handle.setPointerCapture(event.pointerId);
+      handle.addEventListener('pointermove', this.onPointerMove);
+      handle.addEventListener('pointerup', this.onPointerUp);
+      handle.addEventListener('pointercancel', this.onPointerCancel);
+      event.preventDefault();
+    }
+
+    /**
+     * Tracks pointer movement, starting the drag past the threshold.
+     *
+     * @param {PointerEvent} event
+     *   The pointermove event.
+     */
+    onPointerMove(event) {
+      if (event.pointerId !== this.pointerId || !this.moved) {
+        return;
+      }
+      if (!this.dragging) {
+        const dx = event.clientX - this.startX;
+        const dy = event.clientY - this.startY;
+        if (dx * dx + dy * dy < DRAG_THRESHOLD_PX * DRAG_THRESHOLD_PX) {
+          return;
+        }
+        this.dragging = true;
+        // A pointer drag is taking over; cancel any active keyboard move so the
+        // two gestures never share the one drop indicator at the same time. A
+        // mere press-and-release (a tap) never reaches here, so it can pick a
+        // row up into move mode instead (see onPointerUp).
+        this.onGestureStart?.();
+        this.moved.classList.add(this.draggingClass);
+      }
+      this.updateIntent(event.clientX, event.clientY);
+    }
+
+    /**
+     * Commits the move on pointerup if a drag was in progress.
+     *
+     * @param {PointerEvent} event
+     *   The pointerup event.
+     */
+    onPointerUp(event) {
+      if (event.pointerId !== this.pointerId) {
+        return;
+      }
+      if (this.dragging && this.intent && this.moved) {
+        const row = this.moved;
+        const { intent } = this;
+        // Snapshot before cleanup, then commit asynchronously.
+        this.cleanup();
+        commitMove(
+          row,
+          intent,
+          this.moveUrl,
+          this.expand,
+          this.csrfToken,
+          this.options,
+        );
+      } else {
+        // A tap (press and release without crossing the drag threshold): pick
+        // the row up into keyboard move mode rather than starting a drag. A
+        // gesture that did cross the threshold but ends up with no valid
+        // intent (released over the moved row itself, its subtree, or off
+        // any row) is a canceled drag, not a tap, and should not pick the
+        // row up.
+        const row = this.moved;
+        const wasTap = !this.dragging;
+        this.cleanup();
+        if (wasTap && row) {
+          this.onTap?.(row);
+        }
+      }
+    }
+
+    /**
+     * Bails out cleanly on pointercancel.
+     *
+     * @param {PointerEvent} event
+     *   The pointercancel event.
+     */
+    onPointerCancel(event) {
+      if (event.pointerId !== this.pointerId) {
+        return;
+      }
+      this.cleanup();
+    }
+
+    /**
+     * Recomputes and renders the drop intent for a pointer position.
+     *
+     * @param {number} x
+     *   The pointer clientX.
+     * @param {number} y
+     *   The pointer clientY.
+     */
+    updateIntent(x, y) {
+      if (!this.moved) {
+        return;
+      }
+      const elem = document.elementFromPoint(x, y);
+      const target = elem?.closest(ROW) ?? null;
+      if (
+        !target ||
+        target === this.moved ||
+        descendantRows(this.moved).includes(target)
+      ) {
+        this.intent = null;
+        this.indicator.clear();
+        this.clearHoverExpand();
+        return;
+      }
+      this.updateHoverExpand(target);
+      const intent = computeIntent(target, y);
+      if (sameIntent(this.intent, intent)) {
+        return;
+      }
+      this.intent = intent;
+      this.indicator.render(intent);
+      this.indicator.announce(intent);
+    }
+
+    /**
+     * Arms a 1-second timer to auto-expand a hovered collapsed parent.
+     *
+     * Restarts the timer whenever the pointer enters a different collapsed
+     * parent. If the user moves off, the parent is left alone — same UX as
+     * file-explorer drag-hover-to-open.
+     *
+     * @param {HTMLElement} target
+     *   The row currently under the pointer.
+     */
+    updateHoverExpand(target) {
+      const isCollapsedParent =
+        target.dataset.hasChildren === 'true' &&
+        target.getAttribute('aria-expanded') !== 'true';
+      if (!isCollapsedParent) {
+        this.clearHoverExpand();
+        return;
+      }
+      if (this.hoverTarget === target) {
+        return;
+      }
+      this.clearHoverExpand();
+      this.hoverTarget = target;
+      this.hoverTimer = window.setTimeout(() => {
+        const row = this.hoverTarget;
+        this.hoverTarget = null;
+        this.hoverTimer = null;
+        if (row) {
+          this.expand.expand(row);
+        }
+      }, HOVER_EXPAND_MS);
+    }
+
+    /**
+     * Cancels any pending hover-to-expand timer.
+     */
+    clearHoverExpand() {
+      if (this.hoverTimer !== null) {
+        window.clearTimeout(this.hoverTimer);
+        this.hoverTimer = null;
+      }
+      this.hoverTarget = null;
+    }
+
+    /**
+     * Resets all gesture state and removes per-gesture listeners.
+     */
+    cleanup() {
+      this.clearHoverExpand();
+      if (this.activeHandle && this.pointerId !== null) {
+        this.activeHandle.removeEventListener(
+          'pointermove',
+          this.onPointerMove,
+        );
+        this.activeHandle.removeEventListener('pointerup', this.onPointerUp);
+        this.activeHandle.removeEventListener(
+          'pointercancel',
+          this.onPointerCancel,
+        );
+        if (this.activeHandle.hasPointerCapture(this.pointerId)) {
+          this.activeHandle.releasePointerCapture(this.pointerId);
+        }
+      }
+      this.moved?.classList.remove(this.draggingClass);
+      this.indicator.clear();
+      this.moved = null;
+      this.activeHandle = null;
+      this.pointerId = null;
+      this.dragging = false;
+      this.intent = null;
+    }
+  }
+
+  Drupal.treegridReorder.DragController = DragController;
+})(Drupal);
diff --git a/core/modules/treegrid_reorder/js/indicator.js b/core/modules/treegrid_reorder/js/indicator.js
new file mode 100644
index 0000000000000000000000000000000000000000..1b55aa7249f49aaba3ed53711bcd24094d980455
--- /dev/null
+++ b/core/modules/treegrid_reorder/js/indicator.js
@@ -0,0 +1,121 @@
+/**
+ * @file
+ * Visual feedback for drag intent: the line indicator (between drops) plus the
+ * "as-child" outline highlight, with an aria-live announcement so screen
+ * readers track what would happen on release.
+ *
+ * The consumer supplies its own CSS class names and the row-title selector, so
+ * this carries no domain-specific markup knowledge.
+ *
+ * Exposes Drupal.treegridReorder.DropIndicator.
+ */
+
+((Drupal) => {
+  Drupal.treegridReorder = Drupal.treegridReorder || {};
+  const { rowHeaderRect } = Drupal.treegridReorder;
+
+  class DropIndicator {
+    /**
+     * @param {HTMLElement} host
+     *   The element the indicator positions itself within.
+     * @param {object} options
+     *   { lineClass, dropAsChildClass, titleSelector } — the consumer's CSS
+     *   class for the drop line, the class toggled on an as-child target, and
+     *   the selector for a row's title text used in announcements.
+     */
+    constructor(host, options) {
+      this.host = host;
+      this.lineClass = options.lineClass;
+      this.dropAsChildClass = options.dropAsChildClass;
+      this.titleSelector = options.titleSelector;
+      this.highlighted = null;
+      this.line = document.createElement('div');
+      this.line.className = this.lineClass;
+      this.line.setAttribute('aria-hidden', 'true');
+      host.appendChild(this.line);
+    }
+
+    /**
+     * Removes the indicator's DOM nodes.
+     */
+    destroy() {
+      this.line.remove();
+    }
+
+    /**
+     * Renders the indicator for an intent.
+     *
+     * @param {object} intent
+     *   The DropIntent.
+     */
+    render(intent) {
+      if (intent.kind === 'child') {
+        this.hideLine();
+        if (this.highlighted !== intent.target) {
+          this.clearChildHighlight();
+          intent.target.classList.add(this.dropAsChildClass);
+          this.highlighted = intent.target;
+        }
+        return;
+      }
+      this.clearChildHighlight();
+      const header = rowHeaderRect(intent.target);
+      const hostRect = this.host.getBoundingClientRect();
+      const top = intent.kind === 'before' ? header.top : header.bottom;
+      this.line.style.display = 'block';
+      this.line.style.left = `${header.left - hostRect.left}px`;
+      this.line.style.top = `${top - hostRect.top}px`;
+      this.line.style.width = `${header.width}px`;
+    }
+
+    /**
+     * Clears all visual feedback.
+     */
+    clear() {
+      this.hideLine();
+      this.clearChildHighlight();
+    }
+
+    /**
+     * Announces the would-be drop to assistive tech.
+     *
+     * @param {object} intent
+     *   The DropIntent.
+     */
+    announce(intent) {
+      const title =
+        intent.target.querySelector(this.titleSelector)?.textContent?.trim() ??
+        '';
+      let message;
+      if (intent.kind === 'child') {
+        message = Drupal.t('Drop as child of @title', { '@title': title });
+      } else if (intent.kind === 'before') {
+        message = Drupal.t('Drop before @title', { '@title': title });
+      } else {
+        message = Drupal.t('Drop after @title', { '@title': title });
+      }
+      if (Drupal.announce) {
+        Drupal.announce(message);
+      }
+    }
+
+    /**
+     * Hides the drop line.
+     */
+    hideLine() {
+      this.line.style.display = 'none';
+    }
+
+    /**
+     * Removes the as-child highlight, if any.
+     */
+    clearChildHighlight() {
+      if (this.highlighted) {
+        this.highlighted.classList.remove(this.dropAsChildClass);
+        this.highlighted = null;
+      }
+    }
+  }
+
+  Drupal.treegridReorder.DropIndicator = DropIndicator;
+})(Drupal);
diff --git a/core/modules/treegrid_reorder/js/intent.js b/core/modules/treegrid_reorder/js/intent.js
new file mode 100644
index 0000000000000000000000000000000000000000..cca66ce56564ca2045ddc1fcb737390eab02676c
--- /dev/null
+++ b/core/modules/treegrid_reorder/js/intent.js
@@ -0,0 +1,88 @@
+/**
+ * @file
+ * Drop-intent computation for tree drag.
+ *
+ * Splits the target row into three zones:
+ *   top 30% → before
+ *   middle  → child
+ *   bottom 30% → after
+ *
+ * The row IS its own header: a <tr> holds only its own cells, never its subtree
+ * (children are sibling rows), so the row's bounding rect is the header box and
+ * the middle "child" zone stays usable on parents with many expanded children.
+ *
+ * Drop-as-child on a collapsed parent stays as 'child' — commitMove is
+ * responsible for expanding the destination before applying the move, so the
+ * dropped row lands visibly inside.
+ *
+ * A DropIntent is {kind: ('before'|'after'|'child'), target: HTMLElement}.
+ *
+ * Exposes Drupal.treegridReorder.{computeIntent, rowHeaderRect, sameIntent}.
+ */
+
+((Drupal) => {
+  Drupal.treegridReorder = Drupal.treegridReorder || {};
+
+  const CHILD_ZONE_FROM = 0.3;
+  const CHILD_ZONE_TO = 0.7;
+
+  /**
+   * The row's header box — the <tr> rect, which holds only the row's own cells
+   * (children are sibling rows, not nested in this one).
+   *
+   * @param {HTMLElement} row
+   *   The row.
+   *
+   * @return {DOMRect}
+   *   The header bounding rect.
+   */
+  function rowHeaderRect(row) {
+    return row.getBoundingClientRect();
+  }
+
+  /**
+   * Returns the drop intent for a pointer position over a target row.
+   *
+   * @param {HTMLElement} target
+   *   The row under the pointer.
+   * @param {number} y
+   *   The pointer's clientY.
+   *
+   * @return {object}
+   *   The DropIntent.
+   */
+  function computeIntent(target, y) {
+    const headerRect = rowHeaderRect(target);
+    const rel = (y - headerRect.top) / headerRect.height;
+
+    if (rel < CHILD_ZONE_FROM) {
+      return { kind: 'before', target };
+    }
+    if (rel > CHILD_ZONE_TO) {
+      return { kind: 'after', target };
+    }
+    return { kind: 'child', target };
+  }
+
+  /**
+   * Equality check for two intents, to skip redundant re-renders.
+   *
+   * @param {?object} a
+   *   The first intent, or null.
+   * @param {?object} b
+   *   The second intent, or null.
+   *
+   * @return {boolean}
+   *   True if the intents are equivalent.
+   */
+  function sameIntent(a, b) {
+    if (a === null || b === null) {
+      return a === b;
+    }
+    return a.kind === b.kind && a.target === b.target;
+  }
+
+  Drupal.treegridReorder.rowHeaderRect = rowHeaderRect;
+  Drupal.treegridReorder.computeIntent = computeIntent;
+  Drupal.treegridReorder.sameIntent = sameIntent;
+})(Drupal);
diff --git a/core/modules/treegrid_reorder/js/move-mode.js b/core/modules/treegrid_reorder/js/move-mode.js
new file mode 100644
index 0000000000000000000000000000000000000000..e5bde91301454d822890eb19d241cdb75d128644
--- /dev/null
+++ b/core/modules/treegrid_reorder/js/move-mode.js
@@ -0,0 +1,821 @@
+/**
+ * @file
+ * Keyboard grab/select move mode for a treegrid.
+ *
+ * The keyboard counterpart to pointer drag. Space (or a click on the drag
+ * handle) picks up the focused row; the arrow keys move it; Enter drops;
+ * Escape cancels. It commits through the SAME commitMove() path as drag, so
+ * both produce identical server moves and announcements.
+ *
+ * Instead of drawing a borrowed drop indicator, this carries the grabbed row
+ * itself: as the cursor moves, the row (with its descendant subtree) is moved
+ * in the DOM to the candidate slot and re-indented to the landing depth, so the
+ * editor sees exactly where it will land. The carry is purely visual — on
+ * commit the row is restored to its origin and the normal commitMove() runs
+ * against the pre-move DOM; on cancel it is restored and left.
+ *
+ * Position model. The cursor is a (gap, depth) pair over the visible rows
+ * (excluding the carried row and its subtree):
+ *  - gap is a slot between two consecutive visible rows. Up/Down move it one
+ *    visual position, so the carried row travels straight up and down the list.
+ *  - depth is the level the row would land at in that gap. Left/Right change it,
+ *    clamped to what the neighbors allow: at most one level deeper than the row
+ *    above, and no shallower than the row below. Right onto a closed parent
+ *    opens it so the row can nest among its children; the held row stays visible
+ *    throughout — no gesture closes the section it sits in.
+ *
+ * A (gap, depth) pair resolves to a DropIntent {kind, target} so the carry and
+ * commit reuse the drag code. A pointer click on a row while a row is grabbed
+ * sets the cursor to the clicked zone (reusing the drag intent zones), so
+ * keyboard select and mouse positioning combine. The move also survives a
+ * search: focus moving to the search field does not cancel it, and jumping to a
+ * result re-aims the cursor at that row.
+ *
+ * The consumer supplies its CSS class/selector names via the options object.
+ *
+ * Exposes Drupal.treegridReorder.MoveModeController.
+ */
+
+((Drupal) => {
+  Drupal.treegridReorder = Drupal.treegridReorder || {};
+  const {
+    commitMove,
+    sameIntent,
+    resolveNewParentId,
+    resolveBeforeId,
+    computeIntent,
+  } = Drupal.treegridReorder;
+  const {
+    descendantRows,
+    lastDescendantRow,
+    nextSiblingRow,
+    visibleRows,
+    findRow,
+    levelOf,
+    setRowLevel,
+  } = Drupal.treegrid.treeNav;
+  const { announce } = Drupal.treegrid;
+
+  /**
+   * Clamps a number to an inclusive range.
+   *
+   * @param {number} value
+   *   The value.
+   * @param {number} min
+   *   The lower bound.
+   * @param {number} max
+   *   The upper bound.
+   *
+   * @return {number}
+   *   The clamped value.
+   */
+  function clamp(value, min, max) {
+    return Math.min(Math.max(value, min), max);
+  }
+
+  /**
+   * Reads a row's own title text.
+   *
+   * @param {HTMLElement} row
+   *   The row.
+   * @param {string} titleSelector
+   *   The consumer's selector for a row's title.
+   *
+   * @return {string}
+   *   The trimmed title, or ''.
+   */
+  function titleOf(row, titleSelector) {
+    return row.querySelector(titleSelector)?.textContent?.trim() ?? '';
+  }
+
+  /**
+   * The translated "picked up" announcement for a prospective drop.
+   *
+   * Built as three full sentences (one per drop kind) rather than concatenating
+   * translated fragments, so each is translatable on its own.
+   *
+   * @param {string} item
+   *   The title of the picked-up item.
+   * @param {object} intent
+   *   The DropIntent.
+   * @param {string} titleSelector
+   *   The consumer's selector for a row's title.
+   *
+   * @return {string}
+   *   The translated placement sentence.
+   */
+  function placementMessage(item, intent, titleSelector) {
+    const target = titleOf(intent.target, titleSelector);
+    if (intent.kind === 'child') {
+      return Drupal.t('Picked up @item. It will drop as a child of @target.', {
+        '@item': item,
+        '@target': target,
+      });
+    }
+    if (intent.kind === 'before') {
+      return Drupal.t('Picked up @item. It will drop before @target.', {
+        '@item': item,
+        '@target': target,
+      });
+    }
+    return Drupal.t('Picked up @item. It will drop after @target.', {
+      '@item': item,
+      '@target': target,
+    });
+  }
+
+  /**
+   * Reads the id of a row's following sibling row, or null.
+   *
+   * @param {HTMLElement} row
+   *   The row.
+   *
+   * @return {?string}
+   *   The next sibling's data-id, or null at end-of-list.
+   */
+  function nextSiblingId(row) {
+    return nextSiblingRow(row)?.dataset.id ?? null;
+  }
+
+  class MoveModeController {
+    /**
+     * @param {HTMLTableElement} tree
+     *   The root treegrid element.
+     * @param {string} moveUrl
+     *   The move endpoint.
+     * @param {object} expand
+     *   The treegrid ExpandManager, for open/close and passed to commitMove.
+     * @param {Drupal.treegridReorder.DropIndicator} indicator
+     *   The shared drop indicator (its announce() is reused for speech).
+     * @param {function():(string|undefined)} getCsrfToken
+     *   Returns the current X-CSRF-Token. Read late because the token may
+     *   arrive after construction; keyboard users should not have to wait.
+     * @param {object} options
+     *   { grabbedClass, titleSelector, rowControlsSelector,
+     *   applyParentMetadata, onCommitted } — the consumer's CSS names and the
+     *   commit callbacks.
+     */
+    constructor(tree, moveUrl, expand, indicator, getCsrfToken, options) {
+      this.tree = tree;
+      this.moveUrl = moveUrl;
+      this.expand = expand;
+      this.indicator = indicator;
+      this.getCsrfToken = getCsrfToken;
+      this.options = options;
+      this.grabbedClass = options.grabbedClass;
+      this.titleSelector = options.titleSelector;
+      this.rowControlsSelector = options.rowControlsSelector;
+
+      this.active = false;
+      this.grabbed = null;
+      this.block = [];
+      this.blockDelta = new Map();
+      this.origLevel = 1;
+      this.originParent = null;
+      this.originNext = null;
+      // The cursor: a slot index between visible rows, and the depth the row
+      // would land at there.
+      this.gap = 0;
+      this.depth = 1;
+      this.intent = null;
+      // Bumped on every cursor move. openInto() captures it before its async
+      // expand and bails on return if the cursor has moved since, so a slow
+      // open never yanks the row back from where later keys put it.
+      this.cursorSeq = 0;
+    }
+
+    /**
+     * @return {boolean}
+     *   Whether a row is currently picked up.
+     */
+    isActive() {
+      return this.active;
+    }
+
+    /**
+     * @param {?HTMLElement} row
+     *   The row to test, or null.
+     *
+     * @return {boolean}
+     *   Whether the row is the picked-up row or part of its carried subtree.
+     */
+    isGrabbed(row) {
+      return !!row && (row === this.grabbed || this.block.includes(row));
+    }
+
+    /**
+     * Picks up a row to start a keyboard move.
+     *
+     * @param {HTMLElement} row
+     *   The row to grab.
+     *
+     * @return {boolean}
+     *   True if move mode was entered (caller should preventDefault). False if
+     *   the row is not movable or there is nowhere to move it - the caller
+     *   then falls through to its normal handling (e.g. expand toggle).
+     */
+    tryGrab(row) {
+      if (
+        this.active ||
+        !row ||
+        row.dataset.movable !== 'true' ||
+        !row.dataset.id
+      ) {
+        return false;
+      }
+      this.grabbed = row;
+      this.snapshotOrigin();
+      if (this.visibleList().length === 0) {
+        this.grabbed = null;
+        announce(Drupal.t('There is nowhere to move this item.'), 'assertive');
+        return false;
+      }
+
+      this.active = true;
+      row.classList.add(this.grabbedClass);
+      // Tell the treegrid to keep this row visible: its collapse guard refuses
+      // to fold a section containing a data-treegrid-keep-visible row, so the
+      // carried row never vanishes mid-move.
+      row.dataset.treegridKeepVisible = 'true';
+      // The grabbed row is the selection (aria-selected) and the single tab stop
+      // while it is held; the cursor (focus) follows it through the carry.
+      const prevStop = this.tree.querySelector('tr[role="row"][tabindex="0"]');
+      if (prevStop && prevStop !== row) {
+        prevStop.setAttribute('tabindex', '-1');
+      }
+      row.tabIndex = 0;
+      row.setAttribute('aria-selected', 'true');
+      this.setInitialCursor();
+
+      const instructions = Drupal.t(
+        'Use the Up and Down arrows to move it, Left and Right to change its indent, Enter to drop, or Escape to cancel.',
+      );
+      announce(
+        `${placementMessage(titleOf(row, this.titleSelector), this.intent, this.titleSelector)} ${instructions}`,
+        'assertive',
+      );
+      return true;
+    }
+
+    /**
+     * Records the grabbed row's subtree and original slot, for carry + restore.
+     */
+    snapshotOrigin() {
+      this.origLevel = levelOf(this.grabbed);
+      this.block = descendantRows(this.grabbed);
+      this.blockDelta = new Map(
+        this.block.map((r) => [r, levelOf(r) - this.origLevel]),
+      );
+      const last = this.block.length
+        ? this.block[this.block.length - 1]
+        : this.grabbed;
+      this.originParent = this.grabbed.parentNode;
+      this.originNext = last.nextElementSibling;
+    }
+
+    /**
+     * Handles a keydown while move mode is active.
+     *
+     * @param {KeyboardEvent} event
+     *   The keydown event.
+     *
+     * @return {boolean}
+     *   True if the key was consumed (caller should preventDefault). Tab and
+     *   any other key return false so focus can leave; the move survives that
+     *   and is ended only by Escape, a drop, or a pointer press outside the UI.
+     */
+    handleKey(event) {
+      switch (event.key) {
+        case 'ArrowDown':
+          this.step(1);
+          return true;
+        case 'ArrowUp':
+          this.step(-1);
+          return true;
+        case 'ArrowRight':
+          this.deepen();
+          return true;
+        case 'ArrowLeft':
+          this.shallow();
+          return true;
+        case 'Enter':
+        case ' ':
+          this.commit();
+          return true;
+        case 'Escape':
+          this.cancel();
+          return true;
+        default:
+          return false;
+      }
+    }
+
+    /**
+     * Sets the cursor from a pointer click on a row, so mouse and keyboard
+     * positioning combine.
+     *
+     * @param {MouseEvent} event
+     *   The click event.
+     *
+     * @return {boolean}
+     *   True if the click set a position (caller should preventDefault).
+     */
+    handlePointer(event) {
+      if (!this.active || !(event.target instanceof Element)) {
+        return false;
+      }
+      // Leave row controls (toggle, column switch, operations) clickable so the
+      // editor can still expand a parent to aim inside it.
+      if (event.target.closest(this.rowControlsSelector)) {
+        return false;
+      }
+      const row = event.target.closest('tr[role="row"]');
+      if (!row || row === this.grabbed || this.block.includes(row)) {
+        return false;
+      }
+      const list = this.visibleList();
+      const placed = this.gapDepthForIntent(
+        computeIntent(row, event.clientY),
+        list,
+      );
+      if (!placed) {
+        return false;
+      }
+      this.setCursor(placed.gap, placed.depth, list);
+      return true;
+    }
+
+    /**
+     * Re-aims the cursor at a row reached via search jump-to, keeping the grab.
+     *
+     * @param {HTMLElement} row
+     *   The jumped-to row.
+     */
+    aimAt(row) {
+      if (!this.active || row === this.grabbed || this.block.includes(row)) {
+        return;
+      }
+      const list = this.visibleList();
+      const gap = list.indexOf(row);
+      if (gap === -1) {
+        return;
+      }
+      const { min, max } = this.gapBounds(gap, list);
+      this.setCursor(gap, clamp(this.depth, min, max), list);
+    }
+
+    /**
+     * The visible rows the cursor moves over: every visible row except the
+     * carried row and its subtree.
+     *
+     * @return {HTMLElement[]}
+     *   The candidate rows, in document order.
+     */
+    visibleList() {
+      const skip = new Set([this.grabbed, ...this.block]);
+      return visibleRows(this.tree).filter((row) => !skip.has(row));
+    }
+
+    /**
+     * The depth range allowed at a gap.
+     *
+     * The carried row can be at most one level deeper than the row above the
+     * gap, and no shallower than the row below it (going shallower there would
+     * orphan that row). With no row above, only the root level is allowed.
+     *
+     * @param {number} gap
+     *   The gap index (0..list.length).
+     * @param {HTMLElement[]} list
+     *   The visible candidate rows.
+     *
+     * @return {{prev: ?HTMLElement, min: number, max: number}}
+     *   The row above the gap and the inclusive depth bounds.
+     */
+    // eslint-disable-next-line class-methods-use-this
+    gapBounds(gap, list) {
+      const prev = list[gap - 1] ?? null;
+      const next = list[gap] ?? null;
+      const max = prev ? levelOf(prev) + 1 : 1;
+      const min = Math.min(next ? levelOf(next) : 1, max);
+      return { prev, min, max };
+    }
+
+    /**
+     * Resolves a (gap, depth) cursor to a DropIntent.
+     *
+     * Above the first row it is a "before" drop. Otherwise the row lands after
+     * the row above (prev): one level deeper makes it prev's first child;
+     * otherwise it is a sibling placed after the subtree of prev's ancestor at
+     * the chosen depth.
+     *
+     * @param {number} gap
+     *   The gap index.
+     * @param {number} depth
+     *   The chosen depth.
+     * @param {HTMLElement[]} list
+     *   The visible candidate rows.
+     *
+     * @return {?object}
+     *   The DropIntent, or null when there is nowhere to drop.
+     */
+    resolveIntent(gap, depth, list) {
+      const prev = list[gap - 1] ?? null;
+      if (!prev) {
+        return list[0] ? { kind: 'before', target: list[0] } : null;
+      }
+      if (depth >= levelOf(prev) + 1) {
+        return { kind: 'child', target: prev };
+      }
+      let ancestor = prev;
+      while (ancestor && levelOf(ancestor) > depth) {
+        ancestor = findRow(this.tree, ancestor.dataset.parentId);
+      }
+      return { kind: 'after', target: ancestor ?? prev };
+    }
+
+    /**
+     * Maps a pointer-zone DropIntent to the (gap, depth) the cursor uses.
+     *
+     * @param {object} intent
+     *   A {kind, target} intent from computeIntent().
+     * @param {HTMLElement[]} list
+     *   The visible candidate rows.
+     *
+     * @return {?{gap: number, depth: number}}
+     *   The cursor, or null when the target isn't a candidate row.
+     */
+    // eslint-disable-next-line class-methods-use-this
+    gapDepthForIntent(intent, list) {
+      const i = list.indexOf(intent.target);
+      if (i === -1) {
+        return null;
+      }
+      const level = levelOf(intent.target);
+      if (intent.kind === 'child') {
+        return { gap: i + 1, depth: level + 1 };
+      }
+      if (intent.kind === 'before') {
+        return { gap: i, depth: level };
+      }
+      // 'after' lands past the target's whole visible subtree.
+      let j = i + 1;
+      while (j < list.length && levelOf(list[j]) > level) {
+        j += 1;
+      }
+      return { gap: j, depth: level };
+    }
+
+    /**
+     * Sets the initial cursor to the grabbed row's current slot, so an
+     * immediate Enter is a no-op and the arrows start from where the row is.
+     */
+    setInitialCursor() {
+      const list = this.visibleList();
+      const gap =
+        this.originNext && list.includes(this.originNext)
+          ? list.indexOf(this.originNext)
+          : list.length;
+      const { min, max } = this.gapBounds(gap, list);
+      this.setCursor(gap, clamp(this.origLevel, min, max), list, false);
+    }
+
+    /**
+     * Moves the cursor up (-1) or down (+1) one visual position, keeping the
+     * depth where the new gap allows it.
+     *
+     * @param {number} direction
+     *   -1 for up, +1 for down.
+     */
+    step(direction) {
+      const list = this.visibleList();
+      const gap = clamp(this.gap + direction, 0, list.length);
+      if (gap === this.gap) {
+        return;
+      }
+      const { min, max } = this.gapBounds(gap, list);
+      this.setCursor(gap, clamp(this.depth, min, max), list);
+    }
+
+    /**
+     * Right-arrow: nest one level deeper, opening a closed parent so the row
+     * can land among its children.
+     */
+    deepen() {
+      const list = this.visibleList();
+      const { prev, max } = this.gapBounds(this.gap, list);
+      if (this.depth >= max) {
+        return;
+      }
+      const depth = this.depth + 1;
+      this.setCursor(this.gap, depth, list);
+      if (
+        prev &&
+        depth === levelOf(prev) + 1 &&
+        prev.dataset.hasChildren === 'true' &&
+        prev.getAttribute('aria-expanded') !== 'true'
+      ) {
+        this.openInto(prev);
+      }
+    }
+
+    /**
+     * Left-arrow: pull the row out one level, down to what the gap allows.
+     *
+     * Never collapses anything — the carried row stays visible (see the file
+     * docblock); going shallower simply re-targets the drop to a higher
+     * ancestor.
+     */
+    shallow() {
+      const list = this.visibleList();
+      const { min } = this.gapBounds(this.gap, list);
+      if (this.depth <= min) {
+        return;
+      }
+      this.setCursor(this.gap, this.depth - 1, list);
+    }
+
+    /**
+     * Opens a collapsed parent the cursor just nested into, then keeps the
+     * carried row as its first child.
+     *
+     * @param {HTMLElement} prev
+     *   The parent row to open.
+     *
+     * @return {Promise<void>}
+     *   Resolves once the children are in DOM and the cursor is re-placed.
+     */
+    async openInto(prev) {
+      const seq = this.cursorSeq;
+      await this.expand.expand(prev);
+      // The move may have been committed or canceled during the fetch, or the
+      // editor may have moved the cursor on - in which case the open is done
+      // (the section is now navigable) but the cursor must be left where it is.
+      if (!this.active || !this.grabbed || this.cursorSeq !== seq) {
+        return;
+      }
+      // loadChildren() reverts aria-expanded to 'false' when the children fetch
+      // fails; announce that instead of a success that didn't happen, and leave
+      // the cursor where it is rather than re-placing it as if it opened.
+      if (prev.getAttribute('aria-expanded') !== 'true') {
+        announce(
+          Drupal.t('Could not open @title.', {
+            '@title': titleOf(prev, this.titleSelector),
+          }),
+          'assertive',
+        );
+        return;
+      }
+      announce(
+        Drupal.t('Opened @title.', {
+          '@title': titleOf(prev, this.titleSelector),
+        }),
+      );
+      const list = this.visibleList();
+      const gap = list.indexOf(prev) + 1;
+      const { min, max } = this.gapBounds(gap, list);
+      this.setCursor(gap, clamp(levelOf(prev) + 1, min, max), list);
+    }
+
+    /**
+     * Selects a (gap, depth) cursor: carries the row there and announces it.
+     *
+     * @param {number} gap
+     *   The gap index.
+     * @param {number} depth
+     *   The chosen depth.
+     * @param {HTMLElement[]} list
+     *   The visible candidate rows the cursor was computed against.
+     * @param {boolean} [doAnnounce]
+     *   Whether to announce the position (the grab path passes false and
+     *   announces a fuller message itself).
+     */
+    setCursor(gap, depth, list, doAnnounce = true) {
+      const intent = this.resolveIntent(gap, depth, list);
+      if (!intent) {
+        return;
+      }
+      this.gap = gap;
+      this.depth = depth;
+      this.cursorSeq += 1;
+      if (sameIntent(this.intent, intent)) {
+        return;
+      }
+      this.intent = intent;
+      this.carryTo(intent);
+      if (doAnnounce) {
+        this.indicator.announce(intent);
+      }
+    }
+
+    /**
+     * Moves the grabbed row (and its subtree) to the candidate slot.
+     *
+     * The unit is detached first so the geometry helpers see a clean tree, then
+     * re-indented to the landing depth and re-inserted: before the target, after
+     * the target's whole subtree, or — for a "child" drop — immediately after
+     * the target as its first child.
+     *
+     * @param {object} intent
+     *   The DropIntent.
+     */
+    carryTo(intent) {
+      const { target } = intent;
+      const targetLevel = levelOf(target);
+      // Detach first so the insertion reference is computed against a clean
+      // tree: otherwise lastDescendantRow(target) could resolve to the carried
+      // row itself (when it was previously dropped inside this target), and
+      // re-inserting against a detached anchor would leave the row out of DOM.
+      this.detachUnit();
+      let depth;
+      let ref;
+      let after;
+      if (intent.kind === 'child') {
+        depth = targetLevel + 1;
+        ref = target;
+        after = true;
+      } else if (intent.kind === 'before') {
+        depth = targetLevel;
+        ref = target;
+        after = false;
+      } else {
+        depth = targetLevel;
+        ref = lastDescendantRow(target) ?? target;
+        after = true;
+      }
+
+      this.setUnitLevel(depth);
+      this.insertUnit(ref, after);
+      // The carried row must always be visible, even when it lands inside a
+      // collapsed run (see request: "I should always be able to see it").
