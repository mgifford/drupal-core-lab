@@ -0,0 +1,26 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\menu_tree_ui;
+
+use Drupal\Core\Menu\MenuLinkTreeElement;
+use Drupal\menu_link_content\MenuLinkContentInterface;
+
+/**
+ * The per-row context menu_tree_ui hands to its TreegridColumn plugins.
+ *
+ * TreegridColumnInterface::getCellData() receives a consumer-defined row
+ * context (typed as a generic `object`). menu_tree_ui's columns need the tree
+ * element, and the operations column also needs the row's content entity —
+ * which the controller batch-loads once per level so columns never query per
+ * row. This bundles the two; $entity is NULL for static/yml-defined links.
+ */
+final readonly class MenuTreeRowContext {
+
+  public function __construct(
+    public MenuLinkTreeElement $element,
+    public ?MenuLinkContentInterface $entity,
+  ) {}
+
+}
diff --git a/core/modules/menu_tree_ui/src/MenuTreeUiConstants.php b/core/modules/menu_tree_ui/src/MenuTreeUiConstants.php
new file mode 100644
index 0000000000000000000000000000000000000000..007317b331e8e74ef8fa0341bc71e5a7902dede7
--- /dev/null
+++ b/core/modules/menu_tree_ui/src/MenuTreeUiConstants.php
@@ -0,0 +1,61 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\menu_tree_ui;
+
+/**
+ * Shared constants for the menu_tree_ui module.
+ *
+ * @internal
+ */
+final class MenuTreeUiConstants {
+
+  /**
+   * Plugin ID prefix that identifies a menu_link_content entity link.
+   *
+   * Plugin IDs look like "menu_link_content:{uuid}". Anything else (e.g.
+   * "system.admin_content") is a static yml-defined link.
+   */
+  const string CONTENT_PLUGIN_PREFIX = 'menu_link_content:';
+
+  /**
+   * Maximum top-level rows server-rendered, and the client fetch page size.
+   *
+   * The top level is server-rendered for first paint and the no-JS fallback. A
+   * very wide top level (thousands of siblings) would make that render, and its
+   * per-row operations dropbuttons, expensive. The first TOP_LEVEL_PAGE_SIZE
+   * rows render on the server; the client fetches the rest one page of this
+   * size at a time as the editor scrolls.
+   */
+  const int TOP_LEVEL_PAGE_SIZE = 200;
+
+  /**
+   * Whether a plugin ID belongs to a menu_link_content entity link.
+   *
+   * @param string $plugin_id
+   *   The menu link plugin ID.
+   *
+   * @return bool
+   *   TRUE for "menu_link_content:{uuid}" IDs, FALSE for static links.
+   */
+  public static function isContentLink(string $plugin_id): bool {
+    return str_starts_with($plugin_id, self::CONTENT_PLUGIN_PREFIX);
+  }
+
+  /**
+   * Extracts the entity UUID from a content link's plugin ID.
+   *
+   * @param string $plugin_id
+   *   The menu link plugin ID.
+   *
+   * @return string|null
+   *   The UUID, or NULL when the ID is not a content link.
+   */
+  public static function uuidFromPluginId(string $plugin_id): ?string {
+    return self::isContentLink($plugin_id)
+      ? substr($plugin_id, strlen(self::CONTENT_PLUGIN_PREFIX))
+      : NULL;
+  }
+
+}
diff --git a/core/modules/menu_tree_ui/src/Plugin/TreegridColumn/EnabledColumn.php b/core/modules/menu_tree_ui/src/Plugin/TreegridColumn/EnabledColumn.php
new file mode 100644
index 0000000000000000000000000000000000000000..4dbe66188a95948d04e6d80676bf85bf28d8618f
--- /dev/null
+++ b/core/modules/menu_tree_ui/src/Plugin/TreegridColumn/EnabledColumn.php
@@ -0,0 +1,142 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\menu_tree_ui\Plugin\TreegridColumn;
+
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Menu\MenuLinkManagerInterface;
+use Drupal\Core\Plugin\ContainerFactoryPluginInterface;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+use Drupal\menu_link_content\MenuLinkContentInterface;
+use Drupal\menu_link_content\MenuLinkContentStorageInterface;
+use Drupal\menu_tree_ui\MenuLinkMovability;
+use Drupal\menu_tree_ui\MenuTreeRowContext;
+use Drupal\menu_tree_ui\MenuTreeUiConstants;
+use Drupal\treegrid\Attribute\TreegridColumn;
+use Drupal\treegrid\Plugin\TreegridColumn\TreegridColumnBase;
+use Symfony\Component\DependencyInjection\ContainerInterface;
+
+/**
+ * Column plugin for the menu link 'enabled' flag.
+ *
+ * "Enabled" controls whether a menu link appears in rendered menus. This column
+ * exposes it as an inline checkbox so editors can disable a link without
+ * opening the full edit form. It applies to every link, leaf or parent.
+ *
+ * The checkbox is interactive for any movable link — a menu_link_content
+ * entity or a static MenuLinkDefault link overridden via
+ * StaticMenuLinkOverrides — and disabled for links backed by a bespoke plugin
+ * class that supports neither.
+ *
+ * @internal
+ */
+#[TreegridColumn(
+  id: 'enabled',
+  title: new TranslatableMarkup('Enabled'),
+  weight: 5,
+)]
+final class EnabledColumn extends TreegridColumnBase implements ContainerFactoryPluginInterface {
+
+  public function __construct(
+    array $configuration,
+    string $plugin_id,
+    mixed $plugin_definition,
+    private readonly MenuLinkManagerInterface $menuLinkManager,
+    private readonly EntityTypeManagerInterface $entityTypeManager,
+  ) {
+    parent::__construct($configuration, $plugin_id, $plugin_definition);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function create(ContainerInterface $container, array $configuration, $plugin_id, $plugin_definition): static {
+    return new static(
+      $configuration,
+      $plugin_id,
+      $plugin_definition,
+      $container->get('plugin.manager.menu.link'),
+      $container->get('entity_type.manager'),
+    );
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getCellData(object $context): array {
+    assert($context instanceof MenuTreeRowContext);
+    $link = $context->element->link;
+
+    return [
+      'type' => 'checkbox',
+      'value' => $link->isEnabled(),
+      'label' => (string) $this->t('Enabled'),
+      'interactive' => MenuLinkMovability::isMovable($link),
+      'link_id' => $link->getPluginId(),
+    ];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function handleUpdate(string $link_id, mixed $value): bool {
+    if (!$this->menuLinkManager->hasDefinition($link_id)) {
+      return FALSE;
+    }
+
+    if (MenuTreeUiConstants::isContentLink($link_id)) {
+      return $this->handleContentLinkUpdate($link_id, (bool) $value);
+    }
+
+    $link = $this->menuLinkManager->createInstance($link_id);
+    if (!MenuLinkMovability::isMovable($link)) {
+      return FALSE;
+    }
+
+    $this->menuLinkManager->updateDefinition($link_id, ['enabled' => (bool) $value]);
+    return TRUE;
+  }
+
+  /**
+   * Applies an enabled-flag update to a menu_link_content-backed link.
+   *
+   * @param string $link_id
+   *   The "menu_link_content:{uuid}" plugin ID.
+   * @param bool $value
+   *   The new enabled value.
+   *
+   * @return bool
+   *   TRUE if the update was applied, FALSE if the entity does not exist, is
+   *   not editable by the current user, or has a pending revision.
+   */
+  private function handleContentLinkUpdate(string $link_id, bool $value): bool {
+    $uuid = MenuTreeUiConstants::uuidFromPluginId($link_id);
+    /** @var \Drupal\menu_link_content\MenuLinkContentStorageInterface $storage */
+    $storage = $this->entityTypeManager->getStorage('menu_link_content');
+    $ids = $storage->getQuery()
+      ->accessCheck(TRUE)
+      ->condition('uuid', $uuid)
+      ->range(0, 1)
+      ->execute();
+    if (!$ids) {
+      return FALSE;
+    }
+
+    /** @var \Drupal\menu_link_content\MenuLinkContentInterface $entity */
+    $entity = $storage->load(reset($ids));
+    if (!$entity instanceof MenuLinkContentInterface || !$entity->access('update')) {
+      return FALSE;
+    }
+
+    assert($storage instanceof MenuLinkContentStorageInterface);
+    if (in_array($entity->id(), $storage->getMenuLinkIdsWithPendingRevisions(), TRUE)) {
+      return FALSE;
+    }
+
+    $entity->set('enabled', $value);
+    $entity->save();
+    return TRUE;
+  }
+
+}
diff --git a/core/modules/menu_tree_ui/src/Plugin/TreegridColumn/OperationsColumn.php b/core/modules/menu_tree_ui/src/Plugin/TreegridColumn/OperationsColumn.php
new file mode 100644
index 0000000000000000000000000000000000000000..c2a80f657e3661fec26e7647a9c94c1b1dc8a2fa
--- /dev/null
+++ b/core/modules/menu_tree_ui/src/Plugin/TreegridColumn/OperationsColumn.php
@@ -0,0 +1,177 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\menu_tree_ui\Plugin\TreegridColumn;
+
+use Drupal\Component\Plugin\Exception\PluginException;
+use Drupal\Core\Extension\ModuleHandlerInterface;
+use Drupal\Core\Menu\MenuLinkTreeElement;
+use Drupal\Core\Menu\MenuTreeStorage;
+use Drupal\Core\Plugin\ContainerFactoryPluginInterface;
+use Drupal\Core\Render\RendererInterface;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+use Drupal\Core\Url;
+use Drupal\menu_link_content\MenuLinkContentInterface;
+use Drupal\menu_tree_ui\MenuTreeRowContext;
+use Drupal\treegrid\Attribute\TreegridColumn;
+use Drupal\treegrid\Plugin\TreegridColumn\TreegridColumnBase;
+use Symfony\Component\DependencyInjection\ContainerInterface;
+
+/**
+ * Column plugin for a menu link's row operations (Edit, Delete, Add child, …).
+ *
+ * Operations render as a 'markup' cell. The dropbutton's appearance is owned by
+ * the active admin theme's CSS, and themes expect different markup, so the
+ * server renders the dropbutton — exactly as the classic menu
+ * admin does — and the client injects the finished HTML verbatim (see the
+ * markup renderer in treegrid/js/cells.js). The column is read-only and last.
+ *
+ * @internal
+ */
+#[TreegridColumn(
+  id: 'operations',
+  title: new TranslatableMarkup('Operations'),
+  weight: 100,
+)]
+final class OperationsColumn extends TreegridColumnBase implements ContainerFactoryPluginInterface {
+
+  public function __construct(
+    array $configuration,
+    string $plugin_id,
+    mixed $plugin_definition,
+    private readonly RendererInterface $renderer,
+    private readonly ModuleHandlerInterface $moduleHandler,
+  ) {
+    parent::__construct($configuration, $plugin_id, $plugin_definition);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function create(ContainerInterface $container, array $configuration, $plugin_id, $plugin_definition): static {
+    return new static(
+      $configuration,
+      $plugin_id,
+      $plugin_definition,
+      $container->get('renderer'),
+      $container->get('module_handler'),
+    );
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getCellData(object $context): array {
+    assert($context instanceof MenuTreeRowContext);
+    $links = $this->buildOperationsLinks($context->element, $context->entity);
+    if (!$links) {
+      return [];
+    }
+
+    $build = [
+      '#type' => 'container',
+      '#attributes' => [
+        'class' => ['menu-tree-ui-row__operations'],
+        // The treegrid roving tab order includes this container's focusable
+        // operation links for the active row.
+        'data-treegrid-control' => '',
+      ],
+      'operations' => [
+        '#type' => 'operations',
+        '#links' => $links,
+      ],
+    ];
+    // The dropbutton is theme-owned markup, so render it here and ship the
+    // finished HTML; renderInIsolation keeps this row's render out of the
+    // page's bubbling, matching how the lazy-loaded children are built.
+    $html = (string) $this->renderer->renderInIsolation($build);
+
+    return [
+      'type' => 'markup',
+      'html' => $html,
+    ];
+  }
+
+  /**
+   * Assembles the operations list for a row.
+   *
+   * Returns a keyed array of ['title', 'url', 'weight'] entries — the same
+   * shape as hook_entity_operation(). Invokes
+   * hook_menu_tree_ui_row_operations_alter() so third-party modules can add,
+   * modify, or remove operations.
+   *
+   * @param \Drupal\Core\Menu\MenuLinkTreeElement $element
+   *   The tree element whose operations to build.
+   * @param \Drupal\menu_link_content\MenuLinkContentInterface|null $entity
+   *   The row's pre-loaded content entity, or NULL for a static/yml link.
+   *
+   * @return array
+   *   Operations keyed by ID; each has 'title', 'url' and 'weight'.
+   */
+  private function buildOperationsLinks(MenuLinkTreeElement $element, ?MenuLinkContentInterface $entity): array {
+    $link = $element->link;
+    $operations = [];
+
+    // A content link whose entity was deleted can linger in the menu tree as an
+    // orphaned plugin definition; resolving its edit route loads the missing
+    // entity and throws. Skip the edit operation for such links rather than
+    // crashing the whole tree — the row still renders from the cached
+    // definition, and Delete is already omitted (the entity is not loaded).
+    try {
+      $edit_route = $link->getEditRoute();
+    }
+    catch (PluginException) {
+      $edit_route = NULL;
+    }
+    if ($edit_route) {
+      $operations['edit'] = [
+        'title' => $this->t('Edit'),
+        'url' => $edit_route,
+        'weight' => 0,
+      ];
+    }
+
+    if ($entity instanceof MenuLinkContentInterface) {
+      $operations['delete'] = [
+        'title' => $this->t('Delete'),
+        'url' => $entity->toUrl('delete-form'),
+        'weight' => 100,
+      ];
+    }
+
+    // "Add child" mirrors menu_ui's MenuForm: a child sits one level deeper, so
+    // offer it only while that stays within the materialized-path depth cap.
+    if ($element->depth < MenuTreeStorage::MAX_DEPTH) {
+      $operations['add-child'] = [
+        'title' => $this->t('Add child'),
+        'url' => Url::fromRoute(
+          'entity.menu.add_link_form',
+          ['menu' => $link->getMenuName()],
+          ['query' => ['parent' => $link->getPluginId()]],
+        ),
+        'weight' => 20,
+      ];
+    }
+
+    $this->moduleHandler->alter('menu_tree_ui_row_operations', $operations, $element);
+
+    // Every row action returns to this menu-tree page, regardless of how deep
+    // the row is nested. Operation URLs otherwise inherit the *current request*
+    // as their destination: harmless for the server-rendered top level, but a
+    // row from the children endpoint would send the user back to its JSON
+    // response after saving. Setting the destination explicitly keeps all
+    // levels consistent.
+    $destination = Url::fromRoute('menu_tree_ui.edit', ['menu' => $link->getMenuName()])->toString();
+    foreach ($operations as &$operation) {
+      if (($operation['url'] ?? NULL) instanceof Url) {
+        $operation['url']->setOption('query', ['destination' => $destination] + ($operation['url']->getOption('query') ?? []));
+      }
+    }
+    unset($operation);
+
+    uasort($operations, static fn(array $a, array $b): int => ($a['weight'] ?? 0) <=> ($b['weight'] ?? 0));
+    return $operations;
+  }
+
+}
diff --git a/core/modules/menu_tree_ui/src/SearchProvider/MenuLinkContentSearchProvider.php b/core/modules/menu_tree_ui/src/SearchProvider/MenuLinkContentSearchProvider.php
new file mode 100644
index 0000000000000000000000000000000000000000..d94793df31f5bf45414fc12d8750e731948eea11
--- /dev/null
+++ b/core/modules/menu_tree_ui/src/SearchProvider/MenuLinkContentSearchProvider.php
@@ -0,0 +1,93 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\menu_tree_ui\SearchProvider;
+
+use Drupal\Core\Database\Connection;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Menu\MenuTreeStorageInterface;
+
+/**
+ * Search provider for menu_link_content entities.
+ *
+ * Covers user-created menu links (the dominant link type in large menus).
+ * Static links defined by *.links.menu.yml are intentionally excluded here;
+ * a separate provider can be added to cover them.
+ *
+ * @internal
+ */
+final class MenuLinkContentSearchProvider implements MenuTreeSearchProviderInterface {
+
+  public function __construct(
+    private readonly EntityTypeManagerInterface $entityTypeManager,
+    private readonly MenuTreeStorageInterface $treeStorage,
+    private readonly Connection $database,
+  ) {}
+
+  /**
+   * {@inheritdoc}
+   */
+  public function search(string $menu_name, string $query, int $limit): array {
+    $storage = $this->entityTypeManager->getStorage('menu_link_content');
+    $like = '%' . $this->database->escapeLike($query) . '%';
+    $entity_query = $storage->getQuery()
+      ->accessCheck(TRUE)
+      ->condition('menu_name', $menu_name)
+      ->condition('title', $like, 'LIKE')
+      ->sort('title')
+      ->range(0, $limit);
+    $ids = $entity_query->execute();
+    if (!$ids) {
+      return [];
+    }
+
+    /** @var \Drupal\menu_link_content\MenuLinkContentInterface[] $entities */
+    $entities = $storage->loadMultiple($ids);
+    $results = [];
+    foreach ($entities as $entity) {
+      $plugin_id = $entity->getPluginId();
+      [$breadcrumb_ids, $breadcrumb_titles] = $this->buildAncestorChain($plugin_id);
+      $results[] = [
+        'id' => $plugin_id,
+        'title' => (string) $entity->getTitle(),
+        'enabled' => (bool) $entity->isEnabled(),
+        'edit_url' => $entity->toUrl('edit-form')->toString(),
+        'breadcrumb' => $breadcrumb_titles,
+        'breadcrumb_ids' => $breadcrumb_ids,
+      ];
+    }
+    return $results;
+  }
+
+  /**
+   * Returns the ancestor chain of a plugin as [ids[], titles[]], root first.
+   *
+   * @param string $plugin_id
+   *   The plugin ID to build the ancestor chain for.
+   *
+   * @return array
+   *   A two-element array: [ancestor IDs, ancestor titles], both root-first.
+   */
+  private function buildAncestorChain(string $plugin_id): array {
+    $path_ids = $this->treeStorage->getRootPathIds($plugin_id);
+    // getRootPathIds includes the link itself at index 0 — drop it so the
+    // chain only contains ancestors.
+    array_shift($path_ids);
+    $path_ids = array_reverse($path_ids);
+    if (!$path_ids) {
+      return [[], []];
+    }
+    $definitions = $this->treeStorage->loadMultiple($path_ids);
+    $ids = [];
+    $titles = [];
+    foreach ($path_ids as $id) {
+      if (isset($definitions[$id]['title'])) {
+        $ids[] = $id;
+        $titles[] = (string) $definitions[$id]['title'];
+      }
+    }
+    return [$ids, $titles];
+  }
+
+}
diff --git a/core/modules/menu_tree_ui/src/SearchProvider/MenuTreeSearchProviderInterface.php b/core/modules/menu_tree_ui/src/SearchProvider/MenuTreeSearchProviderInterface.php
new file mode 100644
index 0000000000000000000000000000000000000000..939539419c3fda005465edd85c1d3a9ed4689c6a
--- /dev/null
+++ b/core/modules/menu_tree_ui/src/SearchProvider/MenuTreeSearchProviderInterface.php
@@ -0,0 +1,50 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\menu_tree_ui\SearchProvider;
+
+/**
+ * Interface for menu tree search providers.
+ *
+ * @api
+ *
+ * Tag a service with { name: menu_tree_ui.search_provider, priority: N } to
+ * register it. Higher priority providers run first; results are merged and
+ * deduplicated by plugin ID before the alter hook fires.
+ *
+ * The default implementation covers menu_link_content entities. Other modules
+ * can add providers to cover, for example, static yml-defined links.
+ */
+interface MenuTreeSearchProviderInterface {
+
+  /**
+   * Returns search results matching $query in $menu_name.
+   *
+   * Matching semantics are the provider's choice; the default provider does a
+   * case-insensitive substring match on the link title, with entity access
+   * checks applied. Results are returned in the provider's display order (the
+   * default provider sorts by title); the loader preserves that order within
+   * each provider's slice of the merged list.
+   *
+   * @param string $menu_name
+   *   Menu entity ID (e.g. 'main').
+   * @param string $query
+   *   Raw, non-empty search string (trimming is the caller's responsibility).
+   * @param int $limit
+   *   Maximum results to return from this provider.
+   *
+   * @return array<int, array{
+   *   id: string,
+   *   title: string,
+   *   enabled: bool,
+   *   edit_url: string|null,
+   *   breadcrumb: string[],
+   *   breadcrumb_ids: string[],
+   *   }>
+   *   The results. A NULL edit_url means the result has no edit form; the
+   *   results list then renders the title without an Edit link.
+   */
+  public function search(string $menu_name, string $query, int $limit): array;
+
+}
diff --git a/core/modules/menu_tree_ui/src/Service/MenuTreeLoader.php b/core/modules/menu_tree_ui/src/Service/MenuTreeLoader.php
new file mode 100644
index 0000000000000000000000000000000000000000..73809cdf5d58a5a2abe8f2f803b3d7c49d97788f
--- /dev/null
+++ b/core/modules/menu_tree_ui/src/Service/MenuTreeLoader.php
@@ -0,0 +1,312 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\menu_tree_ui\Service;
+
+use Drupal\Core\Extension\ModuleHandlerInterface;
+use Drupal\Core\Menu\MenuLinkManagerInterface;
+use Drupal\Core\Menu\MenuLinkTreeElement;
+use Drupal\Core\Menu\MenuLinkTreeInterface;
+use Drupal\Core\Menu\MenuTreeParameters;
+use Drupal\Core\Menu\MenuTreeStorageInterface;
+use Drupal\treegrid_reorder\TreegridWorkingCopy;
+
+/**
+ * Loads slices of a menu tree for lazy-loaded admin UI consumption.
+ *
+ * Read paths come in two forms. loadLevel() returns the live tree.
+ * loadLevelForEditing() returns the live tree with the menu's pending
+ * working-copy moves overlaid (see TreegridWorkingCopy), so the UI reflects
+ * unsaved reorders without writing them; the overlay is bounded by the number
+ * of edits, never the menu size. search() is a thin orchestrator: it collects
+ * from all tagged MenuTreeSearchProviderInterface services, deduplicates, and
+ * fires hook_menu_tree_ui_search_results_alter() before returning.
+ *
+ * @internal
+ */
+final class MenuTreeLoader {
+
+  /**
+   * Constructs a MenuTreeLoader.
+   *
+   * @param \Drupal\Core\Menu\MenuLinkTreeInterface $menuTree
+   *   The menu link tree service.
+   * @param \Drupal\Core\Menu\MenuTreeStorageInterface $treeStorage
+   *   The menu tree storage.
+   * @param \Drupal\Core\Extension\ModuleHandlerInterface $moduleHandler
+   *   The module handler.
+   * @param iterable<\Drupal\menu_tree_ui\SearchProvider\MenuTreeSearchProviderInterface> $searchProviders
+   *   Tagged iterator: all services tagged menu_tree_ui.search_provider.
+   * @param \Drupal\treegrid_reorder\TreegridWorkingCopy $workingCopy
+   *   The per-menu working copy of pending moves.
+   * @param \Drupal\Core\Menu\MenuLinkManagerInterface $menuLinkManager
+   *   The menu link manager, for materializing moved-in elements.
+   */
+  public function __construct(
+    private readonly MenuLinkTreeInterface $menuTree,
+    private readonly MenuTreeStorageInterface $treeStorage,
+    private readonly ModuleHandlerInterface $moduleHandler,
+    private readonly iterable $searchProviders,
+    private readonly TreegridWorkingCopy $workingCopy,
+    private readonly MenuLinkManagerInterface $menuLinkManager,
+  ) {}
+
+  /**
+   * Loads a single level of a menu.
+   *
+   * @param string $menu_name
+   *   Menu entity ID (e.g. 'main', 'admin').
+   * @param string|null $parent_id
+   *   Plugin ID of the parent to load children of, or NULL for the top level.
+   *
+   * @return \Drupal\Core\Menu\MenuLinkTreeElement[]
+   *   Tree elements at one level, access-checked and sorted by weight.
+   */
+  public function loadLevel(string $menu_name, ?string $parent_id = NULL): array {
+    $params = new MenuTreeParameters();
+    if ($parent_id !== NULL && $parent_id !== '') {
+      $params->setRoot($parent_id)->excludeRoot();
+    }
+    $params->setMaxDepth(1);
+
+    $tree = $this->menuTree->load($menu_name, $params);
+
+    $manipulators = [
+      ['callable' => 'menu.default_tree_manipulators:checkAccess'],
+      ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
+    ];
+    $tree = $this->menuTree->transform($tree, $manipulators);
+
+    $elements = array_values(array_filter($tree, static fn(MenuLinkTreeElement $e) =>
+      $e->access === NULL || $e->access->isAllowed()
+    ));
+
+    $this->moduleHandler->alter('menu_tree_ui_level', $elements, $menu_name, $parent_id);
+
+    return $elements;
+  }
+
+  /**
+   * Loads a single level with the menu's pending working-copy moves applied.
+   *
+   * Same as loadLevel(), then overlays the recorded moves so the editing UI
+   * shows unsaved reorders. The overlay is a pure replay of the ops against
+   * this one level's membership and order, so its cost tracks the number of
+   * edits, not the size of the menu — preserving the lazy-load profile.
+   *
+   * @param string $menu_name
+   *   Menu entity ID (e.g. 'main', 'admin').
+   * @param string|null $parent_id
+   *   Plugin ID of the parent to load children of, or NULL for the top level.
+   *
+   * @return \Drupal\Core\Menu\MenuLinkTreeElement[]
+   *   Tree elements at one level, with pending moves applied.
+   */
+  public function loadLevelForEditing(string $menu_name, ?string $parent_id = NULL): array {
+    $elements = $this->loadLevel($menu_name, $parent_id);
+    $ops = $this->workingCopy->getOps($menu_name);
+    if ($ops === []) {
+      return $elements;
+    }
+    return $this->applyOverlay($elements, $ops, $parent_id ?? '');
+  }
+
+  /**
+   * Returns the pending re-parent of each moved link, keyed by plugin ID.
+   *
+   * Collapses the menu's working-copy move ops into a map of link plugin ID to
+   * its pending new parent (last move wins). Callers overlay this on live
+   * parent lookups so validation reflects the tree the editor is looking at,
+   * not just live storage. The root-level key ('') is never present.
+   *
+   * @param string $menu_name
+   *   Menu entity ID.
+   *
+   * @return array<string, string>
+   *   Plugin ID => pending new parent plugin ID ('' for the menu root).
+   */
+  public function getPendingParentMap(string $menu_name): array {
+    $map = [];
+    foreach ($this->workingCopy->getOps($menu_name) as $op) {
+      if (($op['type'] ?? '') === 'move') {
+        $moved = (string) ($op['id'] ?? '');
+        if ($moved !== '') {
+          $map[$moved] = (string) ($op['new_parent'] ?? '');
+        }
+      }
+    }
+    return $map;
+  }
+
+  /**
+   * Replays pending move ops against one level's membership and order.
+   *
+   * Simulates the recorded moves sequentially on a working list that starts as
+   * the live children of $parent_id: a move whose destination is this level
+   * inserts (or repositions) the link before its before_id; a move of a link
+   * currently in this level to anywhere else removes it. A link moved in from
+   * elsewhere is materialized on demand.
+   *
+   * @param \Drupal\Core\Menu\MenuLinkTreeElement[] $elements
+   *   The live elements at this level, in display order.
+   * @param array<int, array<string, mixed>> $ops
+   *   The menu's pending ops, in recorded order.
+   * @param string $parent_id
+   *   The level's parent plugin ID, or '' for the top level.
+   *
+   * @return \Drupal\Core\Menu\MenuLinkTreeElement[]
+   *   The overlaid elements, in display order.
+   */
+  private function applyOverlay(array $elements, array $ops, string $parent_id): array {
+    $by_id = [];
+    $order = [];
+    foreach ($elements as $element) {
+      $id = $element->link->getPluginId();
+      $by_id[$id] = $element;
+      $order[] = $id;
+    }
+
+    foreach ($ops as $op) {
+      if (($op['type'] ?? '') !== 'move') {
+        continue;
+      }
+      $moved = (string) ($op['id'] ?? '');
+      $new_parent = (string) ($op['new_parent'] ?? '');
+      $before_id = $op['before_id'] ?? NULL;
+      $before_id = $before_id === NULL ? NULL : (string) $before_id;
+      $in_list = in_array($moved, $order, TRUE);
+
+      if ($new_parent === $parent_id) {
+        if (!$in_list) {
+          $element = $this->materializeElement($moved, $parent_id);
+          if ($element === NULL) {
+            continue;
+          }
+          $by_id[$moved] = $element;
+        }
+        $order = self::spliceBefore($order, $moved, $before_id);
+      }
+      elseif ($in_list) {
+        $order = array_values(array_filter($order, static fn(string $id): bool => $id !== $moved));
+        unset($by_id[$moved]);
+      }
+    }
+
+    $result = [];
+    foreach ($order as $id) {
+      if (isset($by_id[$id])) {
+        $result[] = $by_id[$id];
+      }
+    }
+    return $result;
+  }
+
+  /**
+   * Inserts a link id before another in an ordered list (or appends it).
+   *
+   * The moved id is removed if already present, then placed immediately before
+   * $before_id, or at the end when there is no anchor or the anchor is absent.
+   * Shared by the read-side overlay here and the write-side re-weight in
+   * MenuTreeMover::renumberSiblings() so both produce the same order.
+   *
+   * @param string[] $order
+   *   The current ordered ids.
+   * @param string $moved
+   *   The id to (re)place.
+   * @param string|null $before_id
+   *   The anchor id, or NULL to append.
+   *
+   * @return string[]
+   *   The new order.
+   */
+  public static function spliceBefore(array $order, string $moved, ?string $before_id): array {
+    $order = array_values(array_filter($order, static fn(string $id): bool => $id !== $moved));
+    $out = [];
+    $inserted = FALSE;
+    foreach ($order as $id) {
+      if (!$inserted && $before_id !== NULL && $id === $before_id) {
+        $out[] = $moved;
+        $inserted = TRUE;
+      }
+      $out[] = $id;
+    }
+    if (!$inserted) {
+      $out[] = $moved;
+    }
+    return $out;
+  }
+
+  /**
+   * Builds a tree element for a link moved in from another level.
+   *
+   * The link's own properties (title, route, access) are unaffected by a move,
+   * so a freshly built element is sufficient; only parent/weight change, which
+   * the overlay already encodes through placement. The depth is derived from
+   * the destination parent's live root path rather than the link's own (now
+   * stale) live depth, so OperationsColumn's depth-cap check sees where the
+   * link is pending to land, not where it currently lives. This does not
+   * account for the destination parent itself being pending-moved elsewhere in
+   * the same working copy — a rare double-pending case left as an
+   * approximation.
+   *
+   * @param string $plugin_id
+   *   The moved link's plugin ID.
+   * @param string $parent_id
+   *   The destination parent's plugin ID, or '' for the menu root.
+   *
+   * @return \Drupal\Core\Menu\MenuLinkTreeElement|null
+   *   The element, or NULL when the link no longer exists.
+   */
+  private function materializeElement(string $plugin_id, string $parent_id): ?MenuLinkTreeElement {
+    if (!$this->menuLinkManager->hasDefinition($plugin_id)) {
+      return NULL;
+    }
+    $link = $this->menuLinkManager->createInstance($plugin_id);
+    $has_children = $this->treeStorage->getSubtreeHeight($plugin_id) > 1;
+    $depth = $parent_id === '' ? 1 : count($this->treeStorage->getRootPathIds($parent_id)) + 1;
+    return new MenuLinkTreeElement($link, $has_children, $depth, FALSE, []);
+  }
+
+  /**
+   * Searches a menu by link title across all registered search providers.
+   *
+   * Providers run in tag priority order. Results are merged, deduplicated by
+   * plugin ID (first-seen wins), and sliced to $limit before the alter hook
+   * fires. hook_menu_tree_ui_search_results_alter() may add, remove, or
+   * reorder entries after the fact.
+   *
+   * @return array<int, array{
+   *   id: string,
+   *   title: string,
+   *   enabled: bool,
+   *   edit_url: string|null,
+   *   breadcrumb: string[],
+   *   breadcrumb_ids: string[],
+   *   }>
+   */
+  public function search(string $menu_name, string $query, int $limit = 25): array {
+    $query = trim($query);
+    if ($query === '') {
+      return [];
+    }
+
+    $seen = [];
+    $merged = [];
+    foreach ($this->searchProviders as $provider) {
+      foreach ($provider->search($menu_name, $query, $limit) as $result) {
+        if (!isset($seen[$result['id']])) {
+          $seen[$result['id']] = TRUE;
+          $merged[] = $result;
+        }
+      }
+    }
+
+    $results = array_slice($merged, 0, $limit);
+
+    $this->moduleHandler->alter('menu_tree_ui_search_results', $results, $menu_name, $query);
+
+    return $results;
+  }
+
+}
diff --git a/core/modules/menu_tree_ui/src/Service/MenuTreeMover.php b/core/modules/menu_tree_ui/src/Service/MenuTreeMover.php
new file mode 100644
index 0000000000000000000000000000000000000000..11da35c979d93d28f128e82dd0cf96399717eba8
--- /dev/null
+++ b/core/modules/menu_tree_ui/src/Service/MenuTreeMover.php
@@ -0,0 +1,451 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\menu_tree_ui\Service;
+
+use Drupal\Component\Plugin\Exception\PluginException;
+use Drupal\Core\Extension\ModuleHandlerInterface;
+use Drupal\Core\Menu\MenuLinkInterface;
+use Drupal\Core\Menu\MenuLinkManagerInterface;
+use Drupal\Core\Menu\MenuTreeStorageInterface;
+use Drupal\Core\StringTranslation\StringTranslationTrait;
+use Drupal\Core\StringTranslation\TranslationInterface;
+use Drupal\menu_tree_ui\MenuLinkMovability;
+use Drupal\treegrid_reorder\MoveIntent;
+use Drupal\treegrid_reorder\TreeMoveHandlerInterface;
+use Drupal\treegrid_reorder\TreeReorderManager;
+use Psr\Log\LoggerInterface;
+
+/**
+ * Moves a menu link to a new parent + position.
+ *
+ * Read paths live on MenuTreeLoader; this service owns the single write
+ * operation in v1 (drag-and-drop / keyboard reorder). The universal parts of a
+ * move — the self-target and cycle checks, and the validate-then-apply commit
+ * loop — belong to TreeReorderManager; this class is the menu move handler it
+ * delegates to, supplying the menu-specific rules and the write. Its public
+ * validateMove()/commitWorkingCopy() are thin facades over the manager so the
+ * controller's surface is unchanged.
+ *
+ * Both menu_link_content links and static (*.links.menu.yml) links that support
+ * parent/weight overrides are moveable — see MenuLinkMovability. Writes go
+ * through the menu link manager, which persists to the entity or to
+ * StaticMenuLinkOverrides as appropriate, exactly as core's menu overview form
+ * does. Links whose plugin can't persist the change are refused up front.
+ *
+ * Extension without subclassing:
+ *   - hook_menu_tree_ui_pre_move_alter() — veto a move before the menu checks.
+ *   - hook_menu_tree_ui_post_move() — react after a successful move.
+ *
+ * Uses StringTranslationTrait for the user-facing messages below, with the
+ * translation service injected.
+ *
+ * @internal
+ */
+final class MenuTreeMover implements TreeMoveHandlerInterface {
+
+  use StringTranslationTrait;
+
+  /**
+   * The generic reorder orchestrator.
+   *
+   * Stateless and dependency-free, so it is instantiated rather than injected:
+   * making it a container service would force every consumer's container to
+   * resolve a cross-module reference at install time for no benefit.
+   */
+  private readonly TreeReorderManager $reorderManager;
+
+  /**
+   * Pending re-parents to overlay on live ancestry, or NULL for live-only.
+   *
+   * Set only for the duration of a record-time validateMove() so the cycle and
+   * depth checks see the tree the editor is looking at (live storage with the
+   * menu's pending working-copy moves applied). NULL during commit, where ops
+   * are replayed against live storage as they apply and the overlay must not be
+   * counted on top.
+   *
+   * @var array<string, string>|null
+   */
+  private ?array $overlayEffectiveParents = NULL;
+
+  public function __construct(
+    private readonly MenuTreeStorageInterface $treeStorage,
+    private readonly ModuleHandlerInterface $moduleHandler,
+    private readonly MenuTreeLoader $loader,
+    private readonly MenuLinkManagerInterface $menuLinkManager,
+    private readonly LoggerInterface $logger,
+    TranslationInterface $string_translation,
+  ) {
+    $this->stringTranslation = $string_translation;
+    $this->reorderManager = new TreeReorderManager();
+  }
+
+  /**
+   * Validates a move without persisting it.
+   *
+   * Thin facade over TreeReorderManager: the manager runs the universal
+   * structural checks (self-target, cycle) and then calls back into this
+   * handler's menu rules. The editing UI records a move only after this
+   * passes, and Save re-runs it, so a move that became invalid after an earlier
+   * pending change (or a concurrent edit) is caught at commit time.
+   *
+   * @param string $menu_name
+   *   The menu the move is happening within.
+   * @param string $moved_id
+   *   Plugin ID of the link being moved.
+   * @param string $new_parent_id
+   *   Plugin ID of the new parent, or empty string for the menu root.
+   * @param string|null $before_id
+   *   Plugin ID of the sibling the moved link should sit before, or NULL.
+   *
+   * @return array{ok: bool, code?: string, message?: string}
+   *   ['ok' => TRUE] when the move is allowed, otherwise an error outcome.
+   */
+  public function validateMove(
+    string $menu_name,
+    string $moved_id,
+    string $new_parent_id,
+    ?string $before_id,
+  ): array {
+    // Validate against the overlaid tree the editor sees: live storage with the
+    // menu's already-pending moves applied. The move being recorded is not yet
+    // in the working copy, so it is not double-counted.
+    $this->overlayEffectiveParents = $this->loader->getPendingParentMap($menu_name);
+    try {
+      return $this->reorderManager->validateMove(
+        $menu_name,
+        new MoveIntent($moved_id, $new_parent_id, $before_id),
+        $this,
+      );
+    }
+    finally {
+      $this->overlayEffectiveParents = NULL;
+    }
+  }
+
+  /**
+   * Commits a menu's pending working-copy moves to live storage.
+   *
+   * Thin facade over TreeReorderManager::commitWorkingCopy(); the manager owns
+   * the validate-all-then-apply-in-order replay and calls back into this
+   * handler to validate and write each move. Menu link writes are not safe to
+   * wrap in a database transaction — the menu storage rebuild closes it — so
+   * this is ordered, best-effort application, matching core's menu overview
+   * form. The caller clears the working copy after a successful commit.
+   *
+   * @param string $menu_name
+   *   The menu whose working copy to commit.
+   * @param array<int, array<string, mixed>> $ops
+   *   The recorded ops, in order.
+   *
+   * @return array{ok: bool, code?: string, message?: string, failed_op?: int, applied_ops?: array<int, int>}
+   *   ['ok' => TRUE] on success, otherwise the first failing op's outcome plus
+   *   the $ops indices of any moves from this batch already applied.
+   */
+  public function commitWorkingCopy(string $menu_name, array $ops): array {
+    return $this->reorderManager->commitWorkingCopy($menu_name, $ops, $this);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function validateConstraints(string $tree_id, MoveIntent $intent): array {
+    // Allow modules to veto the move before the menu's own checks.
+    // Implementing hook_menu_tree_ui_pre_move_alter() and setting
+    // $veto['veto'] = TRUE will block the move; set $veto['message'] to
+    // provide a user-facing reason. alter() binds its context arguments by
+    // reference, so they are passed as locals rather than readonly MoveIntent
+    // properties.
+    $menu_name = $tree_id;
+    $moved_id = $intent->id;
+    $new_parent_id = $intent->newParent;
+    $before_id = $intent->beforeId;
+    $veto = [];
+    $this->moduleHandler->alter('menu_tree_ui_pre_move', $veto, $menu_name, $moved_id, $new_parent_id, $before_id);
+    if (!empty($veto['veto'])) {
+      return [
+        'ok' => FALSE,
+        'code' => 'vetoed',
+        'message' => $veto['message'] ?? (string) $this->t('Move blocked by a module.'),
+      ];
+    }
+
+    $link = $this->loadLink($intent->id);
+    if ($link === NULL || !MenuLinkMovability::isMovable($link)) {
+      return [
+        'ok' => FALSE,
+        'code' => 'not_moveable',
+        'message' => (string) $this->t('This menu link cannot be reordered.'),
+      ];
+    }
+    if ($link->getMenuName() !== $tree_id) {
+      return [
+        'ok' => FALSE,
+        'code' => 'menu_mismatch',
+        'message' => (string) $this->t('Link belongs to a different menu.'),
+      ];
+    }
+
+    if ($intent->beforeId !== NULL && $intent->beforeId === $intent->id) {
+      return [
+        'ok' => FALSE,
+        'code' => 'before_self',
+        'message' => (string) $this->t('A link cannot be placed before itself.'),
+      ];
+    }
+
+    // MenuTreeStorage::preSave() derives a link's menu from its parent, so a
+    // move into another menu's parent would silently re-home the link if this
+    // were not caught here, before the depth-cap check reads the parent's
+    // root path.
+    if ($intent->newParent !== '') {
+      if (!$this->menuLinkManager->hasDefinition($intent->newParent)) {
+        return [
+          'ok' => FALSE,
+          'code' => 'unknown_parent',
+          'message' => (string) $this->t('The destination no longer exists.'),
+        ];
+      }
+      $new_parent_definition = $this->menuLinkManager->getDefinition($intent->newParent);
+      if ($new_parent_definition['menu_name'] !== $tree_id) {
+        return [
+          'ok' => FALSE,
+          'code' => 'parent_menu_mismatch',
+          'message' => (string) $this->t('The destination is in a different menu.'),
+        ];
+      }
+    }
+
+    if (!$this->fitsWithinDepthCap($intent->id, $intent->newParent)) {
+      return [
+        'ok' => FALSE,
+        'code' => 'too_deep',
+        'message' => (string) $this->t('Moving here would exceed the 9-level depth limit.'),
+      ];
+    }
+
+    return ['ok' => TRUE];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getAncestorIds(string $tree_id, string $parent_id): array {
+    // A parent id that no longer exists (e.g. deleted by a concurrent editor)
+    // has no ancestors to check against; returning an empty list here lets
+    // validateConstraints() report a clean 'unknown_parent' outcome instead of
+    // MenuTreeStorage::getRootPathIds() throwing on an unknown id.
+    if (!$this->menuLinkManager->hasDefinition($parent_id)) {
+      return [];
+    }
+    // During a record-time validation, walk the effective chain so a pending
+    // move that relocated an ancestor is reflected; otherwise the materialized
+    // path (root → … → parent) gives O(1) lookups against the menu_tree table.
+    if ($this->overlayEffectiveParents !== NULL) {
+      return $this->overlayAncestorChain($parent_id);
+    }
+    return $this->treeStorage->getRootPathIds($parent_id);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function applyMove(string $tree_id, MoveIntent $intent): void {
+    $weight = $this->persistMove($tree_id, $intent->id, $intent->newParent, $intent->beforeId);
+    $this->moduleHandler->invokeAll(
+      'menu_tree_ui_post_move',
+      [$tree_id, $intent->id, $intent->newParent, $weight],
+    );
+  }
+
+  /**
+   * Writes a validated move to live storage (no transaction, no validation).
+   *
+   * Renumbers the destination siblings first — reading their current order
+   * (before the move) and re-weighting everything except the moved link, which
+   * yields the weight the moved link should take — then writes the moved link's
+   * parent and weight together through the menu link manager, which routes to
+   * the entity or to StaticMenuLinkOverrides. Callers own the transaction so a
+   * single move and a batched Save can each wrap their work atomically without
+   * nesting transactions.
+   *
+   * @param string $menu_name
+   *   The menu the move happens within.
+   * @param string $moved_id
+   *   Plugin ID of the link being moved.
+   * @param string $new_parent_id
+   *   Plugin ID of the new parent, or '' for the menu root.
+   * @param string|null $before_id
+   *   Plugin ID of the sibling the moved link should sit before, or NULL.
+   *
+   * @return int
+   *   The weight the moved link was given.
+   */
+  private function persistMove(
+    string $menu_name,
+    string $moved_id,
+    string $new_parent_id,
+    ?string $before_id,
+  ): int {
+    $new_weight = $this->renumberSiblings($moved_id, $menu_name, $new_parent_id, $before_id);
+    $this->menuLinkManager->updateDefinition($moved_id, [
+      'parent' => $new_parent_id,
+      'weight' => $new_weight,
+    ]);
+    return $new_weight;
+  }
+
+  /**
+   * Loads the menu link plugin instance by plugin ID, or NULL if unknown.
+   */
+  private function loadLink(string $plugin_id): ?MenuLinkInterface {
+    if (!$this->menuLinkManager->hasDefinition($plugin_id)) {
+      return NULL;
+    }
+    return $this->menuLinkManager->createInstance($plugin_id);
+  }
+
+  /**
+   * Checks that moved subtree height + new parent depth <= core's 9 limit.
+   *
+   * During a record-time validation the new parent's depth is measured on the
+   * overlaid tree, so a pending move that deepened the parent is accounted for.
+   */
+  private function fitsWithinDepthCap(string $moved_id, string $new_parent_id): bool {
+    $max = $this->treeStorage->maxDepth();
+    if ($new_parent_id === '') {
+      $new_parent_depth = 0;
+    }
+    elseif ($this->overlayEffectiveParents !== NULL) {
+      $new_parent_depth = count($this->overlayAncestorChain($new_parent_id));
+    }
+    else {
+      $new_parent_depth = count($this->treeStorage->getRootPathIds($new_parent_id));
+    }
+    $moved_height = $this->treeStorage->getSubtreeHeight($moved_id);
+    return ($new_parent_depth + $moved_height) <= $max;
+  }
+
+  /**
+   * The ancestor chain of a link, following pending moves.
+   *
+   * Walks from $start up to the menu root, taking each step's parent from the
+   * pending overlay when the link was moved and from live storage otherwise.
+   * The chain includes $start itself, matching getRootPathIds(). A visited set
+   * and the depth cap guard against a malformed pending set forming a loop.
+   *
+   * @param string $start
+   *   Plugin ID to walk up from.
+   *
+   * @return string[]
+   *   The chain from $start to the root, $start first.
+   */
+  private function overlayAncestorChain(string $start): array {
+    $chain = [];
+    $seen = [];
+    $current = $start;
+    $limit = $this->treeStorage->maxDepth() + 1;
+    while ($current !== '' && !isset($seen[$current]) && count($chain) < $limit) {
+      $seen[$current] = TRUE;
+      $chain[] = $current;
+      $current = $this->effectiveParent($current);
+    }
+    return $chain;
+  }
+
+  /**
+   * The parent of a link under the pending overlay, else its live parent.
+   *
+   * @param string $link_id
+   *   Plugin ID whose parent to resolve.
+   *
+   * @return string
+   *   The parent plugin ID, or '' for the menu root.
+   */
+  private function effectiveParent(string $link_id): string {
+    if (isset($this->overlayEffectiveParents[$link_id])) {
+      return $this->overlayEffectiveParents[$link_id];
+    }
+    $definition = $this->menuLinkManager->getDefinition($link_id, FALSE);
+    return $definition === NULL ? '' : (string) ($definition['parent'] ?? '');
+  }
+
+  /**
+   * Renumbers destination siblings so the moved link lands at the right spot.
+   *
+   * Works on the canonical sibling order the UI shows — every link type, not
+   * just menu_link_content. That matters for two reasons:
+   *  - $before_id may point at a static (module-defined) link such as the front
+   *    page; an entity-only query would never find it, so the moved link would
+   *    silently fall through to the end of the list.
+   *  - Static links must be re-weighted alongside content links to keep the
+   *    overall order intact — exactly as core's menu overview form does via
+   *    MenuLinkManager::updateDefinition(). Leaving them untouched is what made
+   *    a link dropped above the front page jump to the bottom.
+   *
+   * Called before the moved link is updated, so the loaded order reflects the
+   * pre-move state; the moved link is spliced in by plugin ID. The caller
+   * persists the moved link's own parent + weight, so this method skips it and
+   * only writes the *other* siblings.
+   *
+   * @param string $moved_id
+   *   Plugin ID of the link being moved.
+   * @param string $menu_name
+   *   The menu the move happens within.
+   * @param string $parent_id
+   *   Plugin ID of the destination parent, or '' for the menu root.
+   * @param string|null $before_id
+   *   Plugin ID of the sibling the moved link should sit before, or NULL to
+   *   drop at the end.
+   *
+   * @return int
+   *   The new weight the moved link should take.
+   */
+  private function renumberSiblings(
+    string $moved_id,
+    string $menu_name,
+    string $parent_id,
+    ?string $before_id,
+  ): int {
+    $ordered = [];
+    $current_weight = [];
+    foreach ($this->loader->loadLevel($menu_name, $parent_id === '' ? NULL : $parent_id) as $element) {
+      $id = $element->link->getPluginId();
+      $ordered[] = $id;
+      $current_weight[$id] = (int) $element->link->getWeight();
+    }
+
+    // Pluck the moved link out and splice it back in before $before_id (or at
+    // the end). Shared with MenuTreeLoader::spliceBefore() so the read overlay
+    // and this write-side re-weight produce the same order.
+    $reordered = MenuTreeLoader::spliceBefore($ordered, $moved_id, $before_id);
+
+    $assigned_weight = 0;
+    foreach ($reordered as $offset => $id) {
+      if ($id === $moved_id) {
+        $assigned_weight = $offset;
+        // The caller writes the moved link's parent + weight in one save.
+        continue;
+      }
+      if (($current_weight[$id] ?? NULL) !== $offset) {
+        try {
+          $this->menuLinkManager->updateDefinition($id, ['weight' => $offset]);
+        }
+        catch (PluginException $e) {
+          // A sibling whose backing entity has gone (an orphaned menu link)
+          // must not abort the whole save. Skip it - it keeps its old weight,
+          // the remaining links stay correctly ordered - and log it so the
+          // stale row can be cleaned up.
+          $this->logger->warning('Could not re-weight menu link %id while saving menu %menu; its backing entity is missing. %message', [
+            '%id' => $id,
+            '%menu' => $menu_name,
+            '%message' => $e->getMessage(),
+          ]);
+        }
+      }
+    }
+    return $assigned_weight;
+  }
+
+}
diff --git a/core/modules/menu_tree_ui/templates/menu-tree-ui-page.html.twig b/core/modules/menu_tree_ui/templates/menu-tree-ui-page.html.twig
new file mode 100644
index 0000000000000000000000000000000000000000..7b52a9adf0620832aac6716149517d7a181f250f
--- /dev/null
+++ b/core/modules/menu_tree_ui/templates/menu-tree-ui-page.html.twig
@@ -0,0 +1,192 @@
+{#
+/**
+ * @file
+ * Tree UI for one menu. Server-renders the top level so:
+ *  - no-JS users see at least the top level
+ *  - the custom element upgrades existing DOM rather than rebuilding
+ *  - first paint is the actual tree, not a loading spinner.
+ *
+ * Available variables:
+ * - menu:             the menu entity
+ * - top_level:        rendered row render-arrays for the root level
+ * - columns:          array of column header info keyed by plugin ID,
+ *                     each entry: { id, label }
+ * - search_action:    URL for the search partial endpoint
+ * - children_action:  URL for the children JSON endpoint
+ */
+#}
+<div class="menu-tree-ui">
+  <noscript>
+    <div class="messages messages--warning">
+      {% if truncated %}
+        {{ 'Only the first @shown of @total links are shown. This tree UI needs JavaScript to load the rest, expand levels, and search. To edit @menu without JavaScript, use the classic menu administration:'|t({'@shown': page_size, '@total': total, '@menu': menu.label}) }}
+      {% else %}
+        {{ 'This tree UI needs JavaScript to expand levels and search. To edit @menu without JavaScript, use the classic menu administration:'|t({'@menu': menu.label}) }}
+      {% endif %}
+      <a href="{{ path('entity.menu.links', {menu: menu.id}) }}">{{ 'Open the classic administration for @menu'|t({'@menu': menu.label}) }}</a>
+    </div>
+  </noscript>
+
+  {#
+    The "Keyboard commands" dialog. A native <dialog> opened by the trigger at
+    the end of the instruction line below; the close button uses
+    <form method="dialog"> so closing needs no JS. menu-tree.js wires the open.
+  #}
+  <dialog class="menu-tree-ui__help-dialog" aria-labelledby="menu-tree-ui-help-title">
+    <div class="menu-tree-ui__help-dialog-inner">
+      <h2 id="menu-tree-ui-help-title">{{ 'Keyboard commands'|t }}</h2>
+
+      <h3>{{ 'Moving around'|t }}</h3>
+      <dl class="menu-tree-ui__help-list">
+        <dt><kbd>{{ 'Up'|t }}</kbd> / <kbd>{{ 'Down'|t }}</kbd></dt>
+        <dd>{{ 'Move between items.'|t }}</dd>
+        <dt><kbd>{{ 'Right'|t }}</kbd></dt>
+        <dd>{{ 'Open an item that has children, or move to its first child.'|t }}</dd>
+        <dt><kbd>{{ 'Left'|t }}</kbd></dt>
+        <dd>{{ 'Close an item, or move to its parent.'|t }}</dd>
+        <dt><kbd>{{ 'Home'|t }}</kbd> / <kbd>{{ 'End'|t }}</kbd></dt>
+        <dd>{{ 'Jump to the first or last item.'|t }}</dd>
+        <dt><kbd>{{ 'Enter'|t }}</kbd></dt>
+        <dd>{{ 'Open or close an item that has children.'|t }}</dd>
+      </dl>
+
+      <h3>{{ 'Moving an item'|t }}</h3>
+      <dl class="menu-tree-ui__help-list">
+        <dt><kbd>{{ 'Space'|t }}</kbd></dt>
+        <dd>{{ 'Pick up the focused item to move it. The item then moves with you to show where it will land, and stays in view the whole time.'|t }}</dd>
+        <dt><kbd>{{ 'Up'|t }}</kbd> / <kbd>{{ 'Down'|t }}</kbd></dt>
+        <dd>{{ 'Move the item up or down one position.'|t }}</dd>
+        <dt><kbd>{{ 'Right'|t }}</kbd> / <kbd>{{ 'Left'|t }}</kbd></dt>
+        <dd>{{ 'Change how deeply the item is nested. Right nests it under the item above, opening that item if it is closed; Left moves it back out.'|t }}</dd>
+        <dt><kbd>{{ 'Enter'|t }}</kbd> / <kbd>{{ 'Space'|t }}</kbd></dt>
+        <dd>{{ 'Drop the item at the position you chose.'|t }}</dd>
+        <dt><kbd>{{ 'Escape'|t }}</kbd></dt>
+        <dd>{{ 'Cancel the move and put the item back.'|t }}</dd>
+        <dt>{{ 'Mouse'|t }}</dt>
+        <dd>{{ 'Click the handle to pick an item up, click a row to set where it goes, then click the handle again to drop it. Searching for a destination keeps the item picked up.'|t }}</dd>
+      </dl>
+
+      <h3>{{ 'Quick reorder'|t }}</h3>
+      <dl class="menu-tree-ui__help-list">
+        <dt><kbd>{{ 'Shift'|t }}</kbd> + <kbd>{{ 'Up'|t }}</kbd> / <kbd>{{ 'Shift'|t }}</kbd> + <kbd>{{ 'Down'|t }}</kbd></dt>
+        <dd>{{ 'Move an item up or down among its siblings.'|t }}</dd>
+      </dl>
+
+      <form method="dialog">
+        <button class="menu-tree-ui__help-close">{{ 'Close'|t }}</button>
+      </form>
+    </div>
+  </dialog>
+
+  {#
+    Add link. The primary create action for the menu, kept distinct from the
+    Save/Cancel bar (which keeps or discards reorders). It links to the standard
+    menu-link add form with a destination back to this page.
+  #}
+  {% if add_link_url %}
+    <div class="menu-tree-ui__primary-actions">
+      <a href="{{ add_link_url }}" class="button button--action button--primary menu-tree-ui__add-link">{{ 'Add link'|t }}</a>
+    </div>
+  {% endif %}
+
+  {# Search bar above the list, with results popover anchored to the input. #}
+  <div class="menu-tree-ui__search-container" role="search">
+    <label for="menu-tree-ui-search-input" class="visually-hidden">
+      {{ 'Search @menu'|t({'@menu': menu.label}) }}
+    </label>
+    <input
+      id="menu-tree-ui-search-input"
+      type="search"
+      name="q"
+      class="menu-tree-ui__search-input form-element"
+      placeholder="{{ 'Search menu links…'|t }}"
+      autocomplete="off"
+      hx-get="{{ search_action }}"
+      hx-trigger="keyup changed delay:250ms, search"
+      hx-target="#menu-tree-ui-search-results"
+      hx-swap="innerHTML"
+    >
+    <div
+      id="menu-tree-ui-search-results"
+      class="menu-tree-ui__search-results"
+      aria-live="polite"
+    ></div>
+  </div>
+
+  {% if locked %}
+    <div class="menu-tree-ui__lock messages messages--warning" role="alert">
+      {{ '@user is currently editing this menu. Your changes cannot be saved until they finish.'|t({'@user': lock_owner}) }}
+      {% if lock_updated %}
+        {{ 'Their changes were last saved @time.'|t({'@time': lock_updated|format_date('short')}) }}
+      {% endif %}
+      {% if break_lock_url %}
+        <a href="{{ break_lock_url }}">{{ 'Break lock'|t }}</a>
+      {% endif %}
+    </div>
+  {% endif %}
+
+  {#
+    Save / Cancel action bar. Moves are recorded in a per-user working copy
+    rather than written immediately, so the editor can apply many changes and
+    then keep or discard them. working-copy.js posts to the save/cancel routes
+    and toggles the unsaved notice after the first change.
+
+    The bar (and only the bar) is sticky at the top while the tree scrolls.
+    Save/Cancel lead; the unsaved notice sits to their right and wraps above
+    them when the row is too narrow. Other page messages use the normal space.
+  #}
+  <div class="menu-tree-ui__action-bar">
+    <div class="menu-tree-ui__actions">
+      <button type="button" class="menu-tree-ui__save button button--primary" data-mtu-action="save"{{ locked ? ' disabled' : '' }}>{{ 'Save'|t }}</button>
+      <button type="button" class="menu-tree-ui__cancel button" data-mtu-action="cancel"{{ locked ? ' disabled' : '' }}>{{ 'Cancel'|t }}</button>
+    </div>
+    <div
+      class="menu-tree-ui__unsaved messages messages--warning{{ has_changes ? '' : ' js-hide' }}"
+      aria-live="polite"
+      role="status"
+    >{{ 'You have unsaved changes.'|t }}</div>
+  </div>
+
+  {#
+    Always-visible interaction hint, with the "Keyboard commands" dialog trigger
+    at the end of the line. The tree is one tab stop and is then driven with the
+    arrow keys, which is easy to miss; this names the keys up front and is the
+    treegrid's aria-describedby target, so assistive tech announces it on entry.
+    The full shortcut list is in the dialog the trigger opens.
+  #}
+  <p class="menu-tree-ui__instructions">
+    <span id="menu-tree-ui-instructions">{{ "Use the arrow keys to move between items, Space to pick one up and move it, and Tab to reach a row's controls."|t }}</span>
+    <button type="button" class="menu-tree-ui__help-toggle">{{ 'All keyboard commands'|t }}</button>
+  </p>
+
+  {% if truncated %}
+    <div class="menu-tree-ui__truncation messages messages--status" role="status">
+      {{ 'Showing the first @shown of @total links. The rest load as you scroll.'|t({'@shown': page_size, '@total': total}) }}
+    </div>
+  {% endif %}
+
+  <drupal-treegrid
+    class="menu-tree-ui__tree"
+    data-provider="menu_tree_ui"
+    data-menu="{{ menu.id }}"
+    data-children-url="{{ children_action }}"
+    data-treegrid-top-total="{{ total }}"
+    data-treegrid-page-size="{{ page_size }}"
+  >
+    <table role="treegrid" aria-label="{{ menu.label }}" aria-describedby="menu-tree-ui-instructions" class="menu-tree-ui__table">
+      <thead>
+        <tr>
+          <th scope="col" class="menu-tree-ui__col menu-tree-ui__col--name">{{ 'Name'|t }}</th>
+          {% for col in columns %}
+            <th scope="col" class="menu-tree-ui__col {{ col.id == 'operations' ? 'menu-tree-ui__col--operations' : 'menu-tree-ui__col--data' }}">{{ col.label }}</th>
+          {% endfor %}
+        </tr>
+      </thead>
+      <tbody>
+        {% for row in top_level %}
+          {{ row }}
+        {% endfor %}
+      </tbody>
+    </table>
+  </drupal-treegrid>
+</div>
diff --git a/core/modules/menu_tree_ui/templates/menu-tree-ui-row.html.twig b/core/modules/menu_tree_ui/templates/menu-tree-ui-row.html.twig
new file mode 100644
index 0000000000000000000000000000000000000000..1cdec4b4b12567da66abef530bec3327b1873286
--- /dev/null
+++ b/core/modules/menu_tree_ui/templates/menu-tree-ui-row.html.twig
@@ -0,0 +1,127 @@
+{#
+/**
+ * @file
+ * A single row in the menu tree.
+ *
+ * Rendered as a flat <tr role="row"> in a <table role="treegrid">. Hierarchy is
+ * not structural (tables cannot nest rows): a row's depth is carried by
+ * aria-level and its parent by data-parent-id, and children are inserted as
+ * sibling <tr>s immediately after their parent. See js/tree-nav.js for the
+ * descendant-run helpers that read this shape.
+ *
+ * Variables:
+ * - element:    \Drupal\Core\Menu\MenuLinkTreeElement
+ * - parent_id:  parent link plugin ID, or '' for the top level
+ * - depth:      1-based depth (matches aria-level)
+ * - pos_in_set: 1-based position among siblings
+ * - set_size:   total siblings at this level
+ * - movable:    whether the link supports parent/weight changes
+ * - columns:    keyed by column plugin ID, each a cell data array (the
+ *               operations dropbutton is the last column, a 'markup' cell)
+ */
+#}
+{% set link = element.link %}
+{% set has_children = element.hasChildren %}
+{% set plugin_id = link.getPluginId() %}
+{% set title = link.getTitle() %}
+{% set enabled = link.isEnabled() %}
+
+<tr
+  role="row"
+  class="menu-tree-ui-row {{ enabled ? '' : 'menu-tree-ui-row--disabled' }} {{ has_children ? 'menu-tree-ui-row--parent' : 'menu-tree-ui-row--leaf' }}"
+  data-id="{{ plugin_id }}"
+  data-parent-id="{{ parent_id }}"
+  data-has-children="{{ has_children ? 'true' : 'false' }}"
+  data-movable="{{ movable ? 'true' : 'false' }}"
+  aria-level="{{ depth }}"
+  aria-posinset="{{ pos_in_set }}"
+  aria-setsize="{{ set_size }}"
+  {% if has_children %}aria-expanded="false"{% endif %}
+  {#
+    The row carries its own accessible name so a screen reader announces one
+    curated string (the title, plus "(locked)" when the link cannot be
+    reordered) instead of flattening every control in the row into one
+    utterance. Per-column state is announced by each cell's own control on Tab,
+    so this name stays column-agnostic.
+  #}
+  aria-label="{{ movable ? title : '@title (locked)'|t({'@title': title}) }}"
+  {#
+    The row is the keyboard cursor and the tree's single roving tab stop: the
+    first top-level row is the initial stop, every other row starts at -1 and is
+    promoted as the cursor moves (see js/tree-nav.js focusRow). aria-selected is
+    added only while a row is picked up for a move (see js/move-mode.js).
+  #}
+  tabindex="{{ (parent_id == '' and pos_in_set == 1) ? '0' : '-1' }}"
+>
+  {#
+    Menu-link cell. Like the classic menu admin, the drag handle, expand toggle,
+    and title share one cell, and the whole group is indented by depth, so the
+    handle moves with the item. Keyboard focus lives on the row, not the handle:
+    the handle is a pointer/drag affordance only and is hidden from assistive
+    technology (aria-hidden), since keyboard users reorder from the row (Space)
+    and the row's aria-label already names the item. Movable links (content
+    links and static links that support parent/weight overrides) grab to
+    reorder; the rest keep the locked class so the pointer drag skips them.
+    See \Drupal\menu_tree_ui\MenuLinkMovability.
+  #}
+  <td role="gridcell" class="menu-tree-ui-row__cell menu-tree-ui-row__cell--name">
+    <div class="menu-tree-ui-row__name" data-treegrid-name-cell style="padding-inline-start: {{ (depth - 1) * 1.25 }}rem;">
+      {% if movable %}
+        <span
+          class="menu-tree-ui-row__handle"
+          title="{{ 'Drag to reorder, or click to pick up'|t }}"
+          aria-hidden="true"
+        >
+          <span class="menu-tree-ui-row__handle-icon"></span>
+        </span>
+      {% else %}
+        <span
+          class="menu-tree-ui-row__handle menu-tree-ui-row__handle--locked"
+          aria-hidden="true"
+        >
+          <span class="menu-tree-ui-row__handle-icon">·</span>
+        </span>
+      {% endif %}
+
+      {% if has_children %}
+        <button
+          type="button"
+          class="menu-tree-ui-row__toggle"
+          aria-label="{{ 'Toggle children of @title'|t({'@title': title}) }}"
+          data-treegrid-toggle
+          tabindex="-1"
+        >
+          <span aria-hidden="true" class="menu-tree-ui-row__chevron">▸</span>
+        </button>
+      {% else %}
+        <span class="menu-tree-ui-row__toggle menu-tree-ui-row__toggle--spacer" aria-hidden="true"></span>
+      {% endif %}
+
+      {% if linked %}
+        <a href="{{ url }}" class="menu-tree-ui-row__title" data-treegrid-control>{{ title }}</a>
+      {% else %}
+        <span class="menu-tree-ui-row__title">{{ title }}</span>
+      {% endif %}
+    </div>
+  </td>
+
+  {# Column cells — one gridcell per active column plugin. #}
+  {% for col_id, cell in columns %}
+    <td role="gridcell" class="menu-tree-ui-row__cell menu-tree-ui-row__column" data-column="{{ col_id }}">
+      {% if cell.type == 'checkbox' %}
+        <input
+          type="checkbox"
+          class="treegrid-cell-checkbox"
+          {% if cell.value %}checked{% endif %}
+          {% if not cell.interactive %}disabled{% endif %}
+          aria-label="{{ cell.label }}"
+          data-column-id="{{ col_id }}"
+          data-link-id="{{ plugin_id }}"
+          data-treegrid-control
+        >
+      {% elseif cell.type == 'markup' %}
+        <div class="treegrid-cell-markup">{{ cell.html|raw }}</div>
+      {% endif %}
+    </td>
+  {% endfor %}
+</tr>
diff --git a/core/modules/menu_tree_ui/templates/menu-tree-ui-search-results.html.twig b/core/modules/menu_tree_ui/templates/menu-tree-ui-search-results.html.twig
new file mode 100644
index 0000000000000000000000000000000000000000..c26d731918547153eeb3d3ab4a644ebae0079d5c
--- /dev/null
+++ b/core/modules/menu_tree_ui/templates/menu-tree-ui-search-results.html.twig
@@ -0,0 +1,56 @@
+{#
+/**
+ * @file
+ * Search results partial — swapped into the popover by htmx.
+ *
+ * Variables:
+ * - results: list of { id, title, enabled, edit_url, breadcrumb: string[], breadcrumb_ids: string[] }
+ * - query:   the search string
+ *
+ * UX contract: an empty query renders nothing. The popover (which targets
+ * #menu-tree-ui-search-results) hides itself via `:not(:has(*))` when there
+ * are no element children, so the input is "closed" until the user types.
+ *
+ * Each result's title is rendered as a button that dispatches a "jump to"
+ * action to the tree: walk the ancestor chain (breadcrumb_ids), expand each
+ * level in turn, then scroll/focus the target row. The JS handler lives in
+ * js/jump-to.js and listens at document level for clicks on
+ * [data-mtu-jump-id] so it works even though search results are htmx-injected.
+ */
+#}
+{% if query is not empty %}
+  {% if results is empty %}
+    <p class="menu-tree-ui-search-results__empty">
+      {{ 'No matches for "@q".'|t({'@q': query}) }}
+    </p>
+  {% else %}
+    <p class="menu-tree-ui-search-results__summary">
+      {% trans %}
+        1 result for "{{ query }}"
+      {% plural results|length %}
+        @count results for "{{ query }}"
+      {% endtrans %}
+    </p>
+    <ul class="menu-tree-ui-search-results__list">
+      {% for result in results %}
+        <li class="menu-tree-ui-search-results__item {{ result.enabled ? '' : 'menu-tree-ui-search-results__item--disabled' }}">
+          <button
+            type="button"
+            class="menu-tree-ui-search-results__title"
+            data-mtu-jump-id="{{ result.id }}"
+            data-mtu-jump-path="{{ result.breadcrumb_ids|join(',') }}"
+            title="{{ 'Reveal in tree'|t }}"
+          >{{ result.title }}</button>
+          {% if result.breadcrumb is not empty %}
+            <div class="menu-tree-ui-search-results__breadcrumb">
+              {{ result.breadcrumb|join(' › ') }}
+            </div>
+          {% endif %}
+          {% if result.edit_url %}
+            <a class="menu-tree-ui-search-results__edit" href="{{ result.edit_url }}">{{ 'Edit'|t }}</a>
+          {% endif %}
+        </li>
+      {% endfor %}
+    </ul>
+  {% endif %}
+{% endif %}
