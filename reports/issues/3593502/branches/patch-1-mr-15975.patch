@@ -0,0 +1,81 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\menu_tree_ui\FunctionalJavascript;
+
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests the htmx-driven search popover on the menu tree page.
+ *
+ * Typing into the search field issues an htmx GET to the search route and
+ * swaps the returned HTML partial into the results popover. Picking a result
+ * expands its ancestors and focuses the matching row in the tree.
+ */
+#[Group('menu_tree_ui')]
+#[RunTestsInSeparateProcesses]
+final class MenuTreeUiSearchTest extends MenuTreeUiJavascriptTestBase {
+
+  /**
+   * Seeds Apple, Banana and Cherry at top level, with Apricot under Banana.
+   *
+   * Three top-level rows keep the tree above the small-tree auto-expand
+   * threshold, so Banana starts collapsed.
+   */
+  protected function seedMenu(): void {
+    $this->createTestMenu();
+    $this->linkIds['Apple'] = $this->createLink('Apple', '', 0);
+    $this->linkIds['Banana'] = $this->createLink('Banana', '', 1);
+    $this->linkIds['Cherry'] = $this->createLink('Cherry', '', 2);
+    $this->linkIds['Apricot'] = $this->createLink('Apricot', $this->linkIds['Banana'], 0);
+  }
+
+  /**
+   * Typing swaps results in, an empty query swaps them out, a result jumps.
+   */
+  public function testSearchSwapsResultsAndJumps(): void {
+    $page = $this->getSession()->getPage();
+    $assert = $this->assertSession();
+
+    $input = $page->find('css', '#menu-tree-ui-search-input');
+    $this->assertNotNull($input);
+    $assert->elementNotExists('css', '#menu-tree-ui-search-results > *');
+    $this->assertNull($this->row('Apricot'), 'Apricot is not loaded while Banana is collapsed.');
+
+    // A query with matches swaps the result list into the popover.
+    $input->setValue('Ap');
+    $assert->waitForElementVisible('css', '#menu-tree-ui-search-results .menu-tree-ui-search-results__list');
+    $titles = array_map(
+      static fn($element) => $element->getText(),
+      $page->findAll('css', '.menu-tree-ui-search-results__title'),
+    );
+    sort($titles);
+    $this->assertSame(['Apple', 'Apricot'], $titles);
+    $assert->elementTextContains('css', '.menu-tree-ui-search-results__summary', '2 results for "Ap"');
+    $assert->elementTextContains('css', '.menu-tree-ui-search-results__breadcrumb', 'Banana');
+
+    // A query without matches swaps in the empty message.
+    $input->setValue('zzz');
+    $assert->waitForElementVisible('css', '.menu-tree-ui-search-results__empty');
+    $assert->elementTextContains('css', '.menu-tree-ui-search-results__empty', 'No matches for "zzz"');
+
+    // Clearing the field swaps in nothing, which closes the popover.
+    $input->setValue('');
+    $assert->waitForElementRemoved('css', '#menu-tree-ui-search-results > *');
+
+    // Picking a result expands the collapsed parent and focuses the row.
+    $input->setValue('Apricot');
+    $assert->waitForElementVisible('css', '.menu-tree-ui-search-results__title');
+    $page->find('css', '.menu-tree-ui-search-results__title')->click();
+    $apricot_id = $this->linkIds['Apricot'];
+    $assert->waitForElementVisible('css', sprintf('tr[role="row"][data-id="%s"]', $apricot_id));
+    $this->assertSame('true', $this->row('Banana')->getAttribute('aria-expanded'));
+    $focused_id = $this->getSession()->evaluateScript(
+      'document.activeElement.closest("tr[role=\"row\"]")?.dataset.id ?? null',
+    );
+    $this->assertSame($apricot_id, $focused_id, 'The jumped-to row receives focus.');
+  }
+
+}
diff --git a/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiShiftReorderTest.php b/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiShiftReorderTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..b60fa1dfeb0e6428eccabe2658806637e7f0450b
--- /dev/null
+++ b/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiShiftReorderTest.php
@@ -0,0 +1,88 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\menu_tree_ui\FunctionalJavascript;
+
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests the menu_tree_ui Shift+Arrow sibling reorder end-to-end.
+ *
+ * Shift+Up/Down persists a same-parent sibling swap through the same move
+ * endpoint as drag and keyboard move mode (see reorder-keys.js), but is
+ * driven directly at the row rather than through the grab/select move mode.
+ * This covers the fix where a successful reorder never fired the working
+ * copy's onCommitted callback, so the unsaved-changes notice stayed hidden
+ * even though the server had already recorded the move.
+ */
+#[Group('menu_tree_ui')]
+#[RunTestsInSeparateProcesses]
+final class MenuTreeUiShiftReorderTest extends MenuTreeUiJavascriptTestBase {
+
+  /**
+   * Seeds two top-level siblings, A and B.
+   */
+  protected function seedMenu(): void {
+    $this->createTestMenu();
+    $this->linkIds['A'] = $this->createLink('A', '', 0);
+    $this->linkIds['B'] = $this->createLink('B', '', 1);
+  }
+
+  /**
+   * Shift+ArrowDown on A swaps it past B and reveals the unsaved notice.
+   */
+  public function testShiftArrowDownRevealsUnsavedNotice(): void {
+    $notice = $this->getSession()->getPage()->find('css', '.menu-tree-ui__unsaved');
+    $this->assertNotNull($notice, 'The unsaved notice element should be present.');
+    $this->assertTrue(
+      $notice->hasClass('js-hide'),
+      'The unsaved notice should start hidden (js-hide).',
+    );
+
+    $this->dispatchShiftArrow('A', 'ArrowDown');
+
+    // The optimistic swap happens synchronously; the notice only appears once
+    // the move POST round-trips and fires onCommitted, so wait for it rather
+    // than asserting immediately after the DOM order changes.
+    $this->assertJsCondition(
+      "!document.querySelector('.menu-tree-ui__unsaved').classList.contains('js-hide')",
+    );
+    $this->assertSiblings(['B', 'A'], $this->childRowsSelector(NULL));
+
+    // The swap should renumber both rows' aria-posinset to their new slots.
+    $this->assertSame(
+      '1',
+      $this->row('B')->getAttribute('aria-posinset'),
+      'B should report position 1 after moving ahead of A.',
+    );
+    $this->assertSame(
+      '2',
+      $this->row('A')->getAttribute('aria-posinset'),
+      'A should report position 2 after B passed it.',
+    );
+  }
+
+  /**
+   * Focuses $label and dispatches a Shift+$key keydown at it.
+   *
+   * MenuTreeUiKeyboardMoveTrait::dispatchKeys() sends unmodified keys only
+   * (move mode's own keys are never chorded), so Shift+Arrow needs its own
+   * sender here.
+   */
+  private function dispatchShiftArrow(string $label, string $key): void {
+    $id = $this->linkIds[$label] ?? throw new \InvalidArgumentException("Unknown label: $label");
+    $script = <<<JS
+      const row = document.querySelector('tr[role="row"][data-id="$id"]');
+      if (!row) throw new Error('row not in DOM');
+      row.tabIndex = 0;
+      row.focus();
+      row.dispatchEvent(new KeyboardEvent('keydown', {
+        key: '$key', shiftKey: true, bubbles: true, cancelable: true,
+      }));
+    JS;
+    $this->getSession()->executeScript($script);
+  }
+
+}
diff --git a/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiTopLevelPagingTest.php b/core/modules/menu_tree_ui/tests/src/FunctionalJavascript/MenuTreeUiTopLevelPagingTest.php
