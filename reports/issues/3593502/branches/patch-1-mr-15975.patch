diff --git a/core/modules/treegrid/tests/modules/treegrid_test_ui/js/treegrid-test-ui.js b/core/modules/treegrid/tests/modules/treegrid_test_ui/js/treegrid-test-ui.js
new file mode 100644
index 0000000000000000000000000000000000000000..741502f2374622c5239c061d2bf4548a87e207c7
--- /dev/null
+++ b/core/modules/treegrid/tests/modules/treegrid_test_ui/js/treegrid-test-ui.js
@@ -0,0 +1,110 @@
+/**
+ * @file
+ * A minimal treegrid consumer that exercises the spine in isolation.
+ *
+ * Registers a row renderer as a <drupal-treegrid> provider so the element,
+ * lazy expand, keyboard navigation, and the cell-renderer registry can be
+ * tested within the treegrid module itself, with no consuming module involved.
+ * It adds no behavior of its own: the spine (element, tree-nav, keyboard,
+ * expand, cells) is all treegrid's. Column cells go through
+ * Drupal.treegrid.renderCell so the checkbox/markup renderers are covered on
+ * lazily-built rows.
+ */
+
+((Drupal) => {
+  const { setRowLevel } = Drupal.treegrid.treeNav;
+
+  /**
+   * Builds one <tr role="row"> from a child item, matching the server markup.
+   *
+   * @param {object} item
+   *   The child item.
+   * @param {number} depth
+   *   The 1-based depth.
+   * @param {number} posInSet
+   *   The 1-based position among siblings.
+   * @param {number} setSize
+   *   The number of siblings.
+   *
+   * @return {HTMLTableRowElement}
+   *   The row element.
+   */
+  function buildRow(item, depth, posInSet, setSize) {
+    const tr = document.createElement('tr');
+    tr.setAttribute('role', 'row');
+    tr.dataset.id = item.id;
+    tr.dataset.parentId = item.parent_id ?? '';
+    tr.dataset.hasChildren = String(item.has_children);
+    tr.setAttribute('aria-posinset', String(posInSet));
+    tr.setAttribute('aria-setsize', String(setSize));
+    tr.setAttribute('aria-label', `Row ${item.id}`);
+    if (item.has_children) {
+      tr.setAttribute('aria-expanded', 'false');
+    }
+    tr.setAttribute('tabindex', '-1');
+
+    const name = document.createElement('td');
+    name.setAttribute('role', 'gridcell');
+    name.className = 'tgu-name';
+    name.dataset.treegridNameCell = '';
+    if (item.has_children) {
+      const toggle = document.createElement('button');
+      toggle.type = 'button';
+      toggle.className = 'tgu-toggle';
+      toggle.setAttribute('data-treegrid-toggle', '');
+      toggle.tabIndex = -1;
+      toggle.setAttribute('aria-label', `Toggle ${item.id}`);
+      toggle.textContent = '▸';
+      name.appendChild(toggle);
+    } else {
+      const spacer = document.createElement('span');
+      spacer.className = 'tgu-toggle-spacer';
+      spacer.setAttribute('aria-hidden', 'true');
+      name.appendChild(spacer);
+    }
+    const title = document.createElement('span');
+    title.className = 'tgu-title';
+    title.textContent = item.title;
+    name.appendChild(title);
+    tr.appendChild(name);
+
+    Object.entries(item.columns).forEach(([colId, cell]) => {
+      const td = document.createElement('td');
+      td.setAttribute('role', 'gridcell');
+      td.dataset.column = colId;
+      const widget = Drupal.treegrid.renderCell(cell, {
+        colId,
+        rowId: item.id,
+      });
+      if (widget) {
+        td.appendChild(widget);
+      }
+      tr.appendChild(td);
+    });
+
+    setRowLevel(tr, depth);
+    return tr;
+  }
+
+  /**
+   * Builds a fragment of sibling rows.
+   *
+   * @param {Array<object>} items
+   *   The child items.
+   * @param {number} depth
+   *   The depth to render at.
+   *
+   * @return {DocumentFragment}
+   *   The rows.
+   */
+  function buildRows(items, depth) {
+    const fragment = document.createDocumentFragment();
+    const setSize = items.length;
+    items.forEach((item, i) => {
+      fragment.appendChild(buildRow(item, depth, i + 1, setSize));
+    });
+    return fragment;
+  }
+
+  Drupal.treegrid.registerProvider('treegrid_test_ui', { buildRows, buildRow });
+})(Drupal);
diff --git a/core/modules/treegrid/tests/modules/treegrid_test_ui/src/Controller/TreegridTestUiController.php b/core/modules/treegrid/tests/modules/treegrid_test_ui/src/Controller/TreegridTestUiController.php
new file mode 100644
index 0000000000000000000000000000000000000000..e3e58989b9dc0e3010e4eeb0e52e11248af68bcf
--- /dev/null
+++ b/core/modules/treegrid/tests/modules/treegrid_test_ui/src/Controller/TreegridTestUiController.php
@@ -0,0 +1,173 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\treegrid_test_ui\Controller;
+
+use Drupal\Component\Utility\Html;
+use Drupal\Core\Controller\ControllerBase;
+use Drupal\Core\Render\Markup;
+use Drupal\Core\Url;
+use Symfony\Component\HttpFoundation\JsonResponse;
+use Symfony\Component\HttpFoundation\Request;
+
+/**
+ * Serves a minimal treegrid for exercising the spine JS in isolation.
+ *
+ * A fixed two/three-level tree: page() server-renders the top level into a
+ * <drupal-treegrid>, and children() feeds the lazy-expand engine one level at a
+ * time. Each row carries a 'checkbox' and a 'markup' column cell so the client
+ * cell-renderer registry is exercised on lazily-built rows. There is no write
+ * path — this consumer only drives the read/navigate/expand spine.
+ */
+final class TreegridTestUiController extends ControllerBase {
+
+  /**
+   * Child IDs keyed by parent ID ('' is the root).
+   */
+  private const CHILDREN = [
+    '' => ['p1', 'p2', 'leaf1'],
+    'p1' => ['c1a', 'c1b'],
+    'c1b' => ['c1b1'],
+    'p2' => ['c2a', 'c2b'],
+  ];
+
+  /**
+   * Parent ID keyed by item ID.
+   */
+  private const PARENT = [
+    'p1' => '',
+    'p2' => '',
+    'leaf1' => '',
+    'c1a' => 'p1',
+    'c1b' => 'p1',
+    'c1b1' => 'c1b',
+    'c2a' => 'p2',
+    'c2b' => 'p2',
+  ];
+
+  /**
+   * Depth (1-based) keyed by item ID.
+   */
+  private const DEPTH = [
+    'p1' => 1,
+    'p2' => 1,
+    'leaf1' => 1,
+    'c1a' => 2,
+    'c1b' => 2,
+    'c1b1' => 3,
+    'c2a' => 2,
+    'c2b' => 2,
+  ];
+
+  /**
+   * Renders the test page: the server-rendered top level of the tree.
+   */
+  public function page(): array {
+    $top = self::CHILDREN[''];
+    $set_size = count($top);
+    $rows = '';
+    foreach ($top as $i => $id) {
+      $rows .= $this->renderRow($this->item($id), $i + 1, $set_size);
+    }
+
+    $children_url = Url::fromRoute('treegrid_test_ui.children')->toString();
+    $html = '<drupal-treegrid data-provider="treegrid_test_ui" data-children-url="'
+      . Html::escape($children_url) . '" data-auto-expand-threshold="0">'
+      . '<table role="treegrid"><tbody>' . $rows . '</tbody></table></drupal-treegrid>';
+
+    return [
+      '#markup' => Markup::create($html),
+      '#attached' => [
+        'library' => ['treegrid_test_ui/treegrid_test_ui'],
+      ],
+      '#cache' => ['max-age' => 0],
+    ];
+  }
+
+  /**
+   * Returns one level of children as JSON for the lazy-expand engine.
+   */
+  public function children(Request $request): JsonResponse {
+    $parent = (string) $request->query->get('parent', '');
+    $ids = self::CHILDREN[$parent] ?? [];
+    $items = array_map(fn(string $id): array => $this->item($id), $ids);
+    return new JsonResponse(['parent' => $parent ?: NULL, 'items' => array_values($items)]);
+  }
+
+  /**
+   * Builds the data array for one item, including its column cells.
+   *
+   * @param string $id
+   *   The item ID.
+   *
+   * @return array<string, mixed>
+   *   The item data, matching the JSON shape the spine consumes.
+   */
+  private function item(string $id): array {
+    // Checkbox value varies by ID so a test can assert the renderer reads it:
+    // IDs containing "a" render unchecked, the rest checked.
+    $checked = !str_contains($id, 'a');
+    return [
+      'id' => $id,
+      'parent_id' => self::PARENT[$id],
+      'title' => 'Item ' . $id,
+      'has_children' => isset(self::CHILDREN[$id]),
+      'depth' => self::DEPTH[$id],
+      'columns' => [
+        'check' => [
+          'type' => 'checkbox',
+          'value' => $checked,
+          'label' => 'Toggle ' . $id,
+          'interactive' => TRUE,
+          'link_id' => $id,
+        ],
+        'mark' => [
+          'type' => 'markup',
+          'html' => '<span class="tgu-mark">m-' . Html::escape($id) . '</span>',
+        ],
+      ],
+    ];
+  }
+
+  /**
+   * Server-renders one row, matching the DOM the JS row builder produces.
+   *
+   * @param array<string, mixed> $item
+   *   The item data.
+   * @param int $pos_in_set
+   *   The 1-based position among siblings.
+   * @param int $set_size
+   *   The number of siblings.
+   *
+   * @return string
+   *   The row HTML.
+   */
+  private function renderRow(array $item, int $pos_in_set, int $set_size): string {
+    $id = Html::escape($item['id']);
+    $has_children = $item['has_children'];
+    $tabindex = ($item['parent_id'] === '' && $pos_in_set === 1) ? '0' : '-1';
+
+    $disclosure = $has_children
+      ? '<button type="button" class="tgu-toggle" data-treegrid-toggle tabindex="-1" aria-label="Toggle ' . $id . '">&#9656;</button>'
+      : '<span class="tgu-toggle-spacer" aria-hidden="true"></span>';
+
+    $check = $item['columns']['check'];
+    $checkbox = '<input type="checkbox" class="treegrid-cell-checkbox" aria-label="'
+      . Html::escape($check['label']) . '" data-column-id="check" data-link-id="' . $id . '"'
+      . ($check['value'] ? ' checked' : '') . '>';
+    $markup = '<div class="treegrid-cell-markup">' . $item['columns']['mark']['html'] . '</div>';
+
+    return '<tr role="row" data-id="' . $id . '" data-parent-id="' . Html::escape($item['parent_id'])
+      . '" data-has-children="' . ($has_children ? 'true' : 'false') . '"'
+      . ' aria-level="' . $item['depth'] . '" aria-posinset="' . $pos_in_set
+      . '" aria-setsize="' . $set_size . '"' . ($has_children ? ' aria-expanded="false"' : '')
+      . ' aria-label="Row ' . $id . '" tabindex="' . $tabindex . '">'
+      . '<td role="gridcell" class="tgu-name">' . $disclosure
+      . '<span class="tgu-title">' . Html::escape($item['title']) . '</span></td>'
+      . '<td role="gridcell" data-column="check">' . $checkbox . '</td>'
+      . '<td role="gridcell" data-column="mark">' . $markup . '</td>'
+      . '</tr>';
+  }
+
+}
