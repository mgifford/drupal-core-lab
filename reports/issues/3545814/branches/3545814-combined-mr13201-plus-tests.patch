@@ -24,7 +24,7 @@ class FilterTest extends ViewTestBase {
    *
    * @var array
    */
-  public static $testViews = ['test_filter', 'test_filter_in_operator_ui'];
+  public static $testViews = ['test_filter', 'test_filter_in_operator_ui', 'test_filter_exposed_operator_labels'];
 
   /**
    * {@inheritdoc}
@@ -177,6 +177,31 @@ public function testInOperatorSelectAllOptions(): void {
     $this->assertSession()->pageTextNotContains('The submitted value "page" in the Type element is not allowed.');
   }
 
+  /**
+   * Tests that exposed filters with exposed operators keep their labels.
+   *
+   * A value control must have a native label association, and therefore an
+   * accessible name, when its operator is exposed too.
+   */
+  public function testExposedOperatorLabels(): void {
+    $this->drupalGet('test-filter-exposed-operator-labels');
+    $this->assertSession()->statusCodeEquals(200);
+    $page = $this->getSession()->getPage();
+
+    $value = $page->find('css', 'input[name="id[value]"]');
+    $this->assertNotNull($value, 'The numeric value field is rendered.');
+    // Take the ID from the rendered element instead of assuming a generated one.
+    $label = $page->find('css', 'label[for="' . $value->getAttribute('id') . '"]');
+    $this->assertNotNull($label, 'The numeric value field has a native label.');
+    $this->assertSame('Value', trim($label->getText()), 'The numeric value field is labelled "Value".');
+
+    $type = $page->find('css', 'select[name="type"]');
+    $this->assertNotNull($type, 'The content type select is rendered.');
+    $label = $page->find('css', 'label[for="' . $type->getAttribute('id') . '"]');
+    $this->assertNotNull($label, 'The content type select has a native label.');
+    $this->assertSame('Content types', trim($label->getText()), 'The content type select is labelled "Content types".');
+  }
+
   /**
    * Tests the limit of the expose operator functionality.
    */
diff --git a/core/modules/views_ui/tests/src/Functional/FilterNumericWebTest.php b/core/modules/views_ui/tests/src/Functional/FilterNumericWebTest.php
index 3145b85ac2..bd79eb5bef 100644
--- a/core/modules/views_ui/tests/src/Functional/FilterNumericWebTest.php
+++ b/core/modules/views_ui/tests/src/Functional/FilterNumericWebTest.php
@@ -150,6 +150,28 @@ public function testFilterNumericUI(): void {
     // Make sure the label is visible and that there's no fieldset wrapper.
     $this->assertSession()->elementsCount('xpath', '//label[contains(@for, "edit-age") and contains(text(), "Age greater than")]', 1);
     $this->assertSession()->elementNotExists('xpath', '//fieldset[contains(@id, "edit-age-wrapper")]');
+
+    // Expose the operator. The value field must keep a native label: an
+    // exposed filter whose operator is also exposed used to lose the title of
+    // its value control, leaving it without an accessible name.
+    $this->drupalGet('admin/structure/views/nojs/handler/test_view/default/filter/age');
+    $this->submitForm([
+      'options[expose][use_operator]' => TRUE,
+      'options[expose][operator_id]' => 'age_op',
+    ], 'Apply');
+    $this->drupalGet('admin/structure/views/view/test_view');
+    $this->submitForm([], 'Save');
+    $this->submitForm([], 'Update preview');
+
+    $page = $this->getSession()->getPage();
+    $value = $page->find('css', 'fieldset#edit-age-wrapper input[name="age[value]"]');
+    $this->assertNotNull($value, 'The numeric value field is rendered in the exposed-operator wrapper.');
+    // Take the ID from the rendered element instead of assuming a generated one.
+    $label = $page->find('css', 'label[for="' . $value->getAttribute('id') . '"]');
+    $this->assertNotNull($label, 'The numeric value field has a native label.');
+    $this->assertSame('Value', trim($label->getText()), 'The numeric value field is labelled "Value".');
+    // The configured filter label still groups the operator and value controls.
+    $this->assertSession()->elementTextContains('css', 'fieldset#edit-age-wrapper legend', 'Age greater than');
   }
 
