   }
 
+  /**
+   * Tests that cleanup uses the name recorded when the landmark was added.
+   */
+  public function testLandmarkNameChange(): void {
+    $web_assert = $this->assertSession();
+    $this->drupalGet('js_message_test_link');
+    $web_assert->waitForElement('css', '[data-drupal-messages]');
+
+    // Add a message with the original translation.
+    $this->getSession()->executeScript("window.__originalT = Drupal.t; window.__testMessage = new Drupal.Message(); window.__testMessage.add('Original language', {type: 'status', announce: ''});");
+    $web_assert->elementExists('css', '[data-drupal-messages][role="region"][aria-label="System messages"]');
+
+    // Change what Drupal.t() returns for the landmark name, then clear.
+    $this->getSession()->executeScript("Drupal.t = function (str) { return str === 'System messages' ? 'Renamed messages' : window.__originalT.apply(Drupal, arguments); }; window.__testMessage.clear(); Drupal.t = window.__originalT;");
+    $web_assert->elementNotExists('css', '[data-drupal-messages][role="region"]');
+    $web_assert->elementNotExists('css', '[data-drupal-messages][aria-label="System messages"]');
+    $web_assert->elementNotExists('css', '[data-drupal-messages][data-drupal-message-landmark]');
+  }
+
