+  <div role="region" aria-label="{{ status_headings[type] }}"{{ attributes|without('role', 'aria-label') }}>
+    <div role="{{ type == 'error' ? 'alert' : 'status' }}">
     {% if status_headings[type] %}
       <h2 class="visually-hidden">{{ status_headings[type] }}</h2>
     {% endif %}
@@ -41,6 +40,7 @@
     {% else %}
       {{ messages|first }}
     {% endif %}
+    </div>
   </div>
 {% endfor %}
 </div>
