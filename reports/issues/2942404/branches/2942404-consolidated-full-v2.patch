+  /**
+   * Tests the System messages landmark lifecycle.
+   */
+  public function testLandmarkLifecycle(): void {
+    $web_assert = $this->assertSession();
+    $this->drupalGet('js_message_test_link');
+    $web_assert->waitForElement('css', '[data-drupal-messages]');
+
+    // Constructing a Drupal.Message instance must not create the landmark.
+    $web_assert->elementNotExists('css', '[data-drupal-messages][role]');
+    $web_assert->elementNotExists('css', '[data-drupal-messages][aria-label]');
+
+    // The first successful add creates one consolidated landmark.
+    $this->click('[id="add--status"]');
+    $web_assert->waitForElement('css', '[data-drupal-messages][role="region"][aria-label="System messages"]');
+    $web_assert->elementsCount('css', '[data-drupal-messages][role="region"][aria-label="System messages"]', 1);
+
+    // Repeated additions keep one landmark.
+    $this->click('[id="add--warning"]');
+    $web_assert->elementsCount('css', '[data-drupal-messages][role="region"][aria-label="System messages"]', 1);
+
+    // Removing one message keeps the landmark while another remains.
+    $this->click('[id="remove--status"]');
+    $web_assert->elementExists('css', '[data-drupal-messages][role="region"][aria-label="System messages"]');
+
+    // Removing the last message removes the landmark.
+    $this->click('[id="remove--warning"]');
+    $web_assert->elementNotExists('css', '[data-drupal-messages][role="region"]');
+    $web_assert->elementNotExists('css', '[data-drupal-messages][aria-label="System messages"]');
+
+    // Adding again restores it.
+    $this->click('[id="add--status"]');
+    $web_assert->elementExists('css', '[data-drupal-messages][role="region"][aria-label="System messages"]');
+
+    // Adding and clearing messages does not move focus.
+    $this->getSession()->executeScript("document.getElementById('add--status').focus();");
+    $this->click('[id="add--status"]');
+    $focus = $this->getSession()->evaluateScript("return document.activeElement.id;");
+    $this->assertSame('add--status', $focus, 'Adding a message moved focus.');
+    $this->getSession()->executeScript("window.__testMessage = new Drupal.Message(); window.__testMessage.clear();");
+    $focus = $this->getSession()->evaluateScript("return document.activeElement.id;");
+    $this->assertSame('add--status', $focus, 'Clearing messages moved focus.');
+
+    // A contextual wrapper supplied by the caller gets no landmark.
+    $this->click('[id="add-[data-drupal-messages-other]-status"]');
+    $web_assert->elementExists('css', '[data-drupal-messages-other] .messages--status');
+    $web_assert->elementNotExists('css', '[data-drupal-messages-other][role]');
+    $web_assert->elementNotExists('css', '[data-drupal-messages-other][aria-label]');
+    $web_assert->elementNotExists('css', '[data-drupal-messages][role="region"]');
+
+    // Author-provided role and name are preserved.
+    $this->getSession()->executeScript("document.querySelector('[data-drupal-messages]').setAttribute('role', 'region'); document.querySelector('[data-drupal-messages]').setAttribute('aria-label', 'Author messages');");
+    $this->click('[id="add--status"]');
+    $web_assert->elementExists('css', '[data-drupal-messages][role="region"][aria-label="Author messages"]');
+    $web_assert->elementNotExists('css', '[data-drupal-messages][aria-label="System messages"]');
+    $this->getSession()->executeScript("const el = document.querySelector('[data-drupal-messages]'); el.removeAttribute('role'); el.removeAttribute('aria-label');");
+  }
+
+  /**
