diff --git a/core/tests/Drupal/FunctionalJavascriptTests/Core/MessageLandmarkTest.php b/core/tests/Drupal/FunctionalJavascriptTests/Core/MessageLandmarkTest.php
new file mode 100644
index 0000000000..186d29fa20
--- /dev/null
+++ b/core/tests/Drupal/FunctionalJavascriptTests/Core/MessageLandmarkTest.php
@@ -0,0 +1,69 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\FunctionalJavascriptTests\Core;
+
+use Drupal\FunctionalJavascriptTests\WebDriverTestBase;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests the System messages landmark in the system status messages template.
+ */
+#[Group('Javascript')]
+#[RunTestsInSeparateProcesses]
+class MessageLandmarkTest extends WebDriverTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = ['js_message_test'];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * Tests one consolidated landmark around server and JavaScript messages.
+   */
+  public function testConsolidatedLandmark(): void {
+    $web_assert = $this->assertSession();
+    $this->drupalGet('js_message_test_link_with_system_messages');
+
+    // Server-rendered messages: one region, and the per-type roles unchanged.
+    $web_assert->elementExists('css', '[data-drupal-messages][role="region"][aria-label="System messages"]');
+    $web_assert->elementsCount('css', '[data-drupal-messages][role="region"]', 1);
+    $web_assert->elementExists('css', '[data-drupal-messages] [role="status"][aria-label="Status message"]');
+    $web_assert->elementExists('css', '[data-drupal-messages] [role="alert"][aria-label="Warning message"]');
+    $web_assert->elementExists('css', '[data-drupal-messages] [role="alert"][aria-label="Error message"]');
+
+    // The system template has no internal wrapper. A JavaScript message must
+    // not be appended inside an existing alert or status group.
+    $this->click('[id="add--status"]');
+    $web_assert->waitForElement('css', '[data-drupal-messages] .messages--status[data-drupal-message-id]');
+    $nested = $this->getSession()->evaluateScript("return !!document.querySelector('[data-drupal-messages] [data-drupal-message-id]').parentElement.closest('[role=alert],[role=status],[aria-live]');");
+    $this->assertFalse($nested, 'A JavaScript message was nested inside an existing live region.');
+    $web_assert->elementsCount('css', '[data-drupal-messages][role="region"]', 1);
+    $web_assert->elementExists('css', '[data-drupal-messages][role="region"][aria-label="System messages"]');
+
+    // Removing the JavaScript message leaves the server-rendered landmark and
+    // the server messages in place.
+    $this->click('[id="clear-all"]');
+    $web_assert->elementNotExists('css', '[data-drupal-messages] [data-drupal-message-id]');
+    $web_assert->elementExists('css', '[data-drupal-messages][role="region"][aria-label="System messages"]');
+    $web_assert->elementsCount('css', '[data-drupal-messages][role="region"]', 1);
+    $web_assert->pageTextContains('PHP Status');
+    $web_assert->pageTextContains('PHP Warning');
+    $web_assert->pageTextContains('PHP Error');
+
+    // A caller-supplied contextual wrapper keeps its own semantics.
+    $this->click('[id="add-[data-drupal-messages-other]-status"]');
+    $web_assert->waitForElement('css', '[data-drupal-messages-other] .messages--status');
+    $web_assert->elementNotExists('css', '[data-drupal-messages-other][role]');
+    $web_assert->elementNotExists('css', '[data-drupal-messages-other][aria-label]');
+    $web_assert->elementsCount('css', '[data-drupal-messages][role="region"]', 1);
+  }
+
+}
