+    $this->getSession()->executeScript("document.querySelector('[data-drupal-messages]').insertAdjacentHTML('beforeend', '<span id=\"external-name\" class=\"visually-hidden\">External name</span>'); document.querySelector('[data-drupal-messages]').setAttribute('aria-labelledby', 'external-name');");
+    $this->getSession()->executeScript("window.__testMessage.add('Labelled by author', {type: 'status', announce: ''});");
+    $web_assert->elementExists('css', '[data-drupal-messages][aria-labelledby="external-name"]');
+    $web_assert->elementNotExists('css', '[data-drupal-messages][aria-label="System messages"]');
+    $web_assert->elementNotExists('css', '[data-drupal-messages][role="region"]');
+    $this->getSession()->executeScript("const el = document.querySelector('[data-drupal-messages]'); el.removeAttribute('aria-labelledby'); document.getElementById('external-name').remove(); window.__testMessage.clear();");
+  }
+
+  /**
+   * Tests that cleanup uses the name recorded when the landmark was added.
+   */
+  public function testLandmarkNameChange(): void {
+    $web_assert = $this->assertSession();
+    $this->drupalGet('js_message_test_link');
+    $web_assert->waitForElement('css', '[data-drupal-messages]');
+
+    // Add a message with the original translation.
+    $this->getSession()->executeScript("window.__originalT = Drupal.t; window.__testMessage = new Drupal.Message(); window.__testMessage.add('Original language', {type: 'status', announce: ''});");
