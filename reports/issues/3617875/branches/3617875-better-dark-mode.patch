diff --git a/core/themes/default_admin/tests/src/Nightwatch/Tests/disabledFormControlsTest.js b/core/themes/default_admin/tests/src/Nightwatch/Tests/disabledFormControlsTest.js
new file mode 100644
index 00000000000..7829726092b
--- /dev/null
+++ b/core/themes/default_admin/tests/src/Nightwatch/Tests/disabledFormControlsTest.js
@@ -0,0 +1,87 @@
+const selectors = {
+  disabledCheckbox: '.module-list__checkbox .form-checkbox:disabled',
+  enabledCheckbox: '.module-list__checkbox .form-checkbox:not(:disabled)',
+};
+
+const schemes = {
+  light: {
+    disabledBackground: 'rgb(234, 234, 234)',
+    disabledBorder: 'rgb(194, 194, 194)',
+    enabledBackground: 'rgb(255, 255, 255)',
+    enabledBorder: 'rgb(142, 146, 156)',
+  },
+  dark: {
+    disabledBackground: 'rgb(71, 71, 76)',
+    disabledBorder: 'rgb(100, 100, 100)',
+    enabledBackground: 'rgb(59, 59, 63)',
+    enabledBorder: 'rgb(118, 119, 123)',
+  },
+};
+
+module.exports = {
+  '@tags': ['core', 'default_admin'],
+  before(browser) {
+    browser
+      .drupalInstall()
+      .drupalEnableTheme('default_admin', true)
+      .drupalLoginAsAdmin(() => {
+        browser
+          .drupalRelativeURL('/admin/modules/uninstall')
+          .waitForElementVisible(selectors.disabledCheckbox)
+          .waitForElementVisible(selectors.enabledCheckbox);
+      });
+  },
+  after(browser) {
+    browser.drupalUninstall();
+  },
+  'Disabled checkboxes are distinguishable in light mode': (browser) => {
+    browser.execute(() => {
+      document.documentElement.classList.remove('gin--dark-mode');
+    });
+
+    browser.expect
+      .element(selectors.disabledCheckbox)
+      .to.have.css('backgroundColor', schemes.light.disabledBackground);
+    browser.expect
+      .element(selectors.disabledCheckbox)
+      .to.have.css('borderTopColor', schemes.light.disabledBorder);
+    browser.expect
+      .element(selectors.enabledCheckbox)
+      .to.have.css('backgroundColor', schemes.light.enabledBackground);
+    browser.expect
+      .element(selectors.enabledCheckbox)
+      .to.have.css('borderTopColor', schemes.light.enabledBorder);
+    browser.expect
+      .element(selectors.disabledCheckbox)
+      .to.have.css('backgroundImage')
+      .which.contains('linear-gradient');
+    browser.expect
+      .element(selectors.enabledCheckbox)
+      .to.have.css('backgroundImage', 'none');
+  },
+  'Disabled checkboxes are distinguishable in dark mode': (browser) => {
+    browser.execute(() => {
+      document.documentElement.classList.add('gin--dark-mode');
+    });
+
+    browser.expect
+      .element(selectors.disabledCheckbox)
+      .to.have.css('backgroundColor', schemes.dark.disabledBackground);
+    browser.expect
+      .element(selectors.disabledCheckbox)
+      .to.have.css('borderTopColor', schemes.dark.disabledBorder);
+    browser.expect
+      .element(selectors.enabledCheckbox)
+      .to.have.css('backgroundColor', schemes.dark.enabledBackground);
+    browser.expect
+      .element(selectors.enabledCheckbox)
+      .to.have.css('borderTopColor', schemes.dark.enabledBorder);
+    browser.expect
+      .element(selectors.disabledCheckbox)
+      .to.have.css('backgroundImage')
+      .which.contains('linear-gradient');
+    browser.expect
+      .element(selectors.enabledCheckbox)
+      .to.have.css('backgroundImage', 'none');
+  },
+};
