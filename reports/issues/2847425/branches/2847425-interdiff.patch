@@ -392,17 +392,24 @@ class ManagedFile extends FormElementBase {
     }
 
     // The wrapper rendered by file_managed_file keeps #attributes, including
-    // data-drupal-states, so visibility states already apply to the whole
-    // element. The required state marks the label of the element that carries
-    // #states, so copy #states to the upload control, or to the file IDs
-    // element when a file is present and the upload control is not rendered.
-    if (!empty($element['#states'])) {
-      if ($fids) {
-        $element['fids']['#states'] = $element['#states'];
-      }
-      else {
-        $element['upload']['#states'] = $element['#states'];
-      }
+    // data-drupal-states, so visibility, disabled and the other states apply
+    // to the whole element. "required" and its inverse "optional" are
+    // different: states.js marks the label that references the ID of the
+    // element that carries the state, and sets the HTML required attribute,
+    // so they belong on the file input itself. They are not copied to the file
+    // IDs element: that is a hidden input, where "required" is invalid and no
+    // label can reference it, and where "disabled" would stop the IDs of the
+    // files that are already present from being submitted.
+    $required_states = array_intersect_key($element['#states'] ?? [], [
+      'required' => TRUE,
+      'optional' => TRUE,
+    ]);
+    if ($required_states) {
+      $upload_states = $element['upload']['#states'] ?? [];
+      $element['upload']['#states'] = $upload_states + $required_states;
+      // A required attribute on the wrapper <div> is invalid and does nothing,
+      // so the wrapper does not also carry these states.
+      unset($element['#states']['required'], $element['#states']['optional']);
     }
 
     // Prefix and suffix used for Ajax replacement.
