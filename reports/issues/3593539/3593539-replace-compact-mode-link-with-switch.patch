diff --git a/core/modules/system/css/system.admin_compact.css b/core/modules/system/css/system.admin_compact.css
index e356454b96..7acf312459 100644
--- a/core/modules/system/css/system.admin_compact.css
+++ b/core/modules/system/css/system.admin_compact.css
@@ -6,3 +6,59 @@
 :root[data-admin-compact-mode] [data-admin-compact-collapsible] {
   display: none;
 }
+
+.compact-link__switch {
+  position: relative;
+  box-sizing: border-box;
+  width: 2.5rem;
+  height: 1.5rem;
+  margin: 0 0.5rem 0 0;
+  padding: 0;
+  cursor: pointer;
+  vertical-align: middle;
+  color: currentColor;
+  border: 2px solid currentColor;
+  border-radius: 1rem;
+  background: transparent;
+  appearance: none;
+}
+
+.compact-link__switch::before {
+  position: absolute;
+  inset-block-start: 0.25rem;
+  inset-inline-start: 0.25rem;
+  width: 0.75rem;
+  height: 0.75rem;
+  content: "";
+  border-radius: 50%;
+  background: currentColor;
+}
+
+.compact-link__switch:checked {
+  background: currentColor;
+}
+
+.compact-link__switch:checked::before {
+  color: Canvas;
+  transform: translateX(1rem);
+}
+
+.compact-link__switch:checked:dir(rtl)::before {
+  transform: translateX(-1rem);
+}
+
+.compact-link__switch:focus-visible {
+  outline: 3px solid currentColor;
+  outline-offset: 2px;
+}
+
+.compact-link__label {
+  cursor: pointer;
+  vertical-align: middle;
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .compact-link__switch::before {
+    transition: transform 0.2s;
+  }
+}
