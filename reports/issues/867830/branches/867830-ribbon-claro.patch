diff --git a/css/components/unpublished-status.css b/css/components/unpublished-status.css
new file mode 100644
index 0000000000000000000000000000000000000000..e3216db9e2f343cc784ad620035856307ce2247e
--- /dev/null
+++ b/css/components/unpublished-status.css
@@ -0,0 +1,137 @@
+/*
+ * DO NOT EDIT THIS FILE.
+ * See the following change record for more information,
+ * https://www.drupal.org/node/3084859
+ * @preserve
+ */
+
+/**
+ * @file
+ * Local publication status, independent of the Navigation Top Bar.
+ */
+
+/* Each entity starts with its own theme defaults, not its parent's status. */
+:where(.node, .comment) {
+  --unpublished-accent: var(--color-absolutezero);
+  --unpublished-on-accent: var(--color-white);
+  --unpublished-paper: var(--color-white);
+  --unpublished-node-surface: color-mix(in sRGB, var(--unpublished-accent) 4%, var(--unpublished-paper));
+  --unpublished-comment-surface: color-mix(in sRGB, var(--unpublished-accent) 8%, var(--unpublished-paper));
+  --unpublished-gutter: 1rem;
+}
+
+.node.node--unpublished,
+.comment.comment--unpublished {
+  position: relative;
+  /* The border-width shorthand retains pixels in the theme's PCSS build. */
+  border-width: 0 4px;
+  border-inline-end-style: solid;
+  border-inline-end-color: var(--unpublished-accent);
+  border-inline-start-width: 0;
+  background-color: var(--unpublished-node-surface);
+  min-inline-size: 0;
+  padding-block: 0 1.5rem;
+  padding-inline: var(--unpublished-gutter);
+}
+
+.comment:not(.comment--unpublished) {
+  background-color: var(--unpublished-paper);
+}
+
+.comment.comment--unpublished {
+  border-width: 0 3px;
+  border-inline-start-width: 0;
+  background-color: var(--unpublished-comment-surface);
+}
+
+.node--unpublished > .unpublished-status-row,
+.comment--unpublished > .unpublished-status-row {
+  display: flex;
+  grid-column: 1 / -1;
+  justify-content: flex-end;
+  min-inline-size: 0;
+  margin-inline-end: calc(-1 * var(--unpublished-gutter));
+  /* Reserve triangle space after wrapped labels, not a fixed-height overlay. */
+  padding-block-end: 1rem;
+}
+
+.node--unpublished > .unpublished-status-row > .unpublished-status,
+.comment--unpublished > .unpublished-status-row > .unpublished-status {
+  position: relative;
+  align-self: flex-start;
+  box-sizing: border-box;
+  text-align: center;
+  color: var(--unpublished-on-accent);
+  background-color: var(--unpublished-accent);
+  font-size: 0.875rem;
+  font-weight: bold;
+  line-height: 1.35;
+  max-inline-size: 100%;
+  padding-block: 0.45rem;
+  padding-inline: 0.9rem;
+  overflow-wrap: anywhere;
+  border-end-start-radius: 0.2rem;
+}
+
+.comment--unpublished > .unpublished-status-row > .unpublished-status {
+  padding-block: 0.35rem;
+  padding-inline: 0.65rem;
+  font-size: 0.8rem;
+}
+
+/* Real logical borders mirror in RTL and survive forced colors. */
+.node--unpublished > .unpublished-status-row > .unpublished-status::after,
+.comment--unpublished > .unpublished-status-row > .unpublished-status::after {
+  position: absolute;
+  inset-block-start: 100%;
+  inset-inline-end: 0;
+  inline-size: 0;
+  block-size: 0;
+  content: "";
+  pointer-events: none;
+  border-block-start: 0.85rem solid var(--unpublished-accent);
+  border-inline-start: 0.85rem solid transparent;
+}
+
+.comment--unpublished::after {
+  position: absolute;
+  inset-block-end: 0;
+  inset-inline-end: 0;
+  inline-size: 0;
+  block-size: 0;
+  content: "";
+  pointer-events: none;
+  border-block-end: 1rem solid var(--unpublished-accent);
+  border-inline-start: 1rem solid transparent;
+}
+
+@media (forced-colors: active) {
+  .node.node--unpublished,
+  .comment.comment--unpublished {
+    color: CanvasText;
+    border-inline-end-color: CanvasText;
+    background-color: Canvas;
+  }
+
+  .comment:not(.comment--unpublished) {
+    background-color: Canvas;
+  }
+
+  .node--unpublished > .unpublished-status-row > .unpublished-status,
+  .comment--unpublished > .unpublished-status-row > .unpublished-status {
+    color: CanvasText;
+    border: 1px solid CanvasText;
+    background-color: Canvas;
+  }
+
+  .node--unpublished > .unpublished-status-row > .unpublished-status::after,
+  .comment--unpublished > .unpublished-status-row > .unpublished-status::after {
+    border-block-start-color: CanvasText;
+    border-inline-start-color: Canvas;
+  }
+
+  .comment--unpublished::after {
+    border-block-end-color: CanvasText;
+    border-inline-start-color: Canvas;
+  }
+}
