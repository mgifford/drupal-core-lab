diff --git a/core/modules/node/tests/src/Kernel/UnpublishedStatusTest.php b/core/modules/node/tests/src/Kernel/UnpublishedStatusTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..d7557182dd1b3fd1574d1bdb35f6462914d67381
--- /dev/null
+++ b/core/modules/node/tests/src/Kernel/UnpublishedStatusTest.php
@@ -0,0 +1,187 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\node\Kernel;
+
+use Drupal\comment\Entity\Comment;
+use Drupal\comment\Tests\CommentTestTrait;
+use Drupal\Component\Utility\Html;
+use Drupal\Core\StringTranslation\Translator\StaticTranslation;
+use Drupal\KernelTests\Core\Entity\EntityKernelTestBase;
+use Drupal\node\Entity\Node;
+use Drupal\node\Entity\NodeType;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+use PHPUnit\Framework\Attributes\TestWith;
+
+// cspell:ignore العقدة منشورة التعليق منشور
+/**
+ * Tests local publication markers without Navigation or a Top Bar.
+ */
+#[Group('node')]
+#[Group('comment')]
+#[RunTestsInSeparateProcesses]
+class UnpublishedStatusTest extends EntityKernelTestBase {
+
+  use CommentTestTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = ['node', 'comment'];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->installSchema('node', ['node_access']);
+    $this->installSchema('comment', ['comment_entity_statistics']);
+    $this->installConfig(['system', 'user', 'node', 'comment']);
+    $this->setUpCurrentUser([], [
+      'access content',
+      'access comments',
+      'administer comments',
+      'bypass node access',
+    ]);
+  }
+
+  /**
+   * Tests generic and theme templates with both publication states.
+   */
+  #[TestWith(['stark'])]
+  #[TestWith(['default_admin'])]
+  #[TestWith(['starterkit_theme'])]
+  public function testPublicationMarkers(string $theme): void {
+    $this->activateTheme($theme);
+    // Both bundles use the same local publication pattern, including when
+    // submission metadata is hidden. Full and teaser renders must agree.
+    foreach (['page', 'article'] as $bundle) {
+      $type = NodeType::create(['type' => $bundle, 'name' => $bundle]);
+      $type->save();
+      $this->addDefaultCommentField('node', $bundle);
+      foreach ([TRUE, FALSE] as $submitted) {
+        $type->setDisplaySubmitted($submitted);
+        $type->save();
+        foreach ([TRUE, FALSE] as $published) {
+          $node = Node::create([
+            'type' => $bundle,
+            'title' => 'Publication status test',
+            'uid' => $this->container->get('current_user')->id(),
+            'status' => $published,
+          ]);
+          $node->save();
+          $comments = [];
+          foreach ([TRUE, FALSE] as $comment_published) {
+            $comment = Comment::create([
+              'comment_type' => 'comment',
+              'entity_type' => 'node',
+              'entity_id' => $node->id(),
+              'field_name' => 'comment',
+              'subject' => 'Comment publication status test',
+              'uid' => $this->container->get('current_user')->id(),
+              'status' => $comment_published,
+            ]);
+            $comment->save();
+            $comments[] = $comment;
+
+            // A comment's marker depends only on its own publication state,
+            // even when rendered separately from its parent node.
+            $xpath = $this->renderEntity($comment);
+            $this->assertMarker($xpath, '//article', !$comment_published, 'This comment is Unpublished');
+          }
+          foreach (['full', 'teaser'] as $view_mode) {
+            $xpath = $this->renderEntity($node, $view_mode);
+            $this->assertMarker($xpath, '//article[not(ancestor::article)]', !$published, 'This node is Unpublished');
+            // The default full display includes comments. Check each local
+            // marker independently of the node's state and metadata setting.
+            if ($view_mode === 'full') {
+              foreach ($comments as $comment) {
+                $selector = '//article[@id="comment-' . $comment->id() . '"]';
+                $this->assertSame(1, $xpath->query($selector)->length);
+                $this->assertMarker($xpath, $selector, !$comment->isPublished(), 'This comment is Unpublished');
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+
+  /**
+   * Tests translation of the entire sentence, including hidden context.
+   */
+  #[TestWith(['stark'])]
+  #[TestWith(['default_admin'])]
+  #[TestWith(['starterkit_theme'])]
+  public function testTranslatedMarkers(string $theme): void {
+    $this->activateTheme($theme);
+    $translation = $this->container->get('string_translation');
+    $translation->addTranslator(new StaticTranslation([
+      'ar' => [
+        '' => [
+          '<span class="visually-hidden">This node is </span>Unpublished' => '<span class="visually-hidden">هذه العقدة </span>غير منشورة',
+          '<span class="visually-hidden">This comment is </span>Unpublished' => '<span class="visually-hidden">هذا التعليق </span>غير منشور',
+        ],
+      ],
+    ]), 100);
+    $translation->setDefaultLangcode('ar');
+
+    NodeType::create(['type' => 'page', 'name' => 'Page', 'display_submitted' => FALSE])->save();
+    $this->addDefaultCommentField('node', 'page');
+    $node = Node::create([
+      'type' => 'page',
+      'title' => 'Translated status',
+      'uid' => $this->container->get('current_user')->id(),
+      'status' => FALSE,
+    ]);
+    $node->save();
+    $comment = Comment::create([
+      'comment_type' => 'comment',
+      'entity_type' => 'node',
+      'entity_id' => $node->id(),
+      'field_name' => 'comment',
+      'subject' => 'Translated comment status',
+      'uid' => $this->container->get('current_user')->id(),
+      'status' => FALSE,
+    ]);
+    $comment->save();
+    $xpath = $this->renderEntity($node);
+    $this->assertMarker($xpath, '//article[not(ancestor::article)]', TRUE, 'هذه العقدة غير منشورة');
+    $this->assertMarker($xpath, '//article[@id="comment-' . $comment->id() . '"]', TRUE, 'هذا التعليق غير منشور');
+  }
+
+  /**
+   * Selects the templates under test.
+   */
+  private function activateTheme(string $theme): void {
+    $this->container->get('theme_installer')->install([$theme]);
+    $this->container->get('theme.manager')->setActiveTheme(
+      $this->container->get('theme.initialization')->getActiveThemeByName($theme)
+    );
+  }
+
+  /**
+   * Renders an entity, exercising its real view builder and Twig translation.
+   */
+  private function renderEntity(Node|Comment $entity, string $view_mode = 'full'): \DOMXPath {
+    $build = $this->entityTypeManager->getViewBuilder($entity->getEntityTypeId())->view($entity, $view_mode);
+    $html = (string) $this->container->get('renderer')->renderInIsolation($build);
+    return new \DOMXPath(Html::load($html));
+  }
+
+  /**
+   * Asserts exactly one local marker and hidden context, or neither.
+   */
+  private function assertMarker(\DOMXPath $xpath, string $entity_selector, bool $unpublished, string $sentence): void {
+    $markers = $xpath->query($entity_selector . '/div[@class="unpublished-status-row"]/span[@class="unpublished-status"]');
+    $this->assertSame((int) $unpublished, $markers->length);
+    if ($unpublished) {
+      $this->assertSame($sentence, $markers->item(0)->textContent);
+      $this->assertSame(1, $xpath->query('span[@class="visually-hidden"]', $markers->item(0))->length);
+    }
+    $this->assertSame((int) $unpublished, $xpath->query($entity_selector . '/div[@class="unpublished-status-row"]')->length);
+  }
+
+}
