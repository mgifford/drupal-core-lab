+$schema: https://git.drupalcode.org/project/drupal/-/raw/HEAD/core/assets/schemas/v1/metadata.schema.json
+name: Sidebar toggle
+noUi: true
+description: Button that shows or hides the meta sidebar panel on entity forms.
+props:
+  type: object
+  required:
+    - label
+    - controls
+  properties:
+    label:
+      type: string
+      title: Label
+      description: Visually hidden label and title (tooltip) of the button.
+    controls:
+      type: string
+      title: Controls
+      description: ID of the sidebar element the button toggles (aria-controls).
+    expanded:
+      type: boolean
+      title: Expanded
+      description: Initial expanded state of the sidebar (aria-expanded).
+      default: true
+libraryOverrides:
+  dependencies:
+    - core/once
diff --git a/core/themes/default_admin/components/sidebar-toggle/sidebar-toggle.css b/core/themes/default_admin/components/sidebar-toggle/sidebar-toggle.css
new file mode 100644
index 0000000000000000000000000000000000000000..89c74422daf800d9b5d013f4896e7892d5807881
--- /dev/null
+++ b/core/themes/default_admin/components/sidebar-toggle/sidebar-toggle.css
@@ -0,0 +1,59 @@
+/*
+ * DO NOT EDIT THIS FILE.
+ * See the following change record for more information,
+ * https://www.drupal.org/node/3084859
+ * @preserve
+ */
+
+/**
+ * @file
+ * Sidebar panel and controls.
+ */
+
+:root[data-meta-sidebar="closed"] {
+  --admin-theme-sidebar-offset: 0px;
+}
+
+:is(#extra-specificity-hack, [data-drupal-admin-styles]) .meta-sidebar__trigger,
+.meta-sidebar__trigger {
+  display: block;
+  width: 2rem;
+  height: 2rem;
+  padding: 0;
+  cursor: pointer;
+  border: 0;
+  border-radius: var(--admin-radius-m);
+  background: transparent;
+
+  &::before {
+    display: inline-block;
+    width: 100%;
+    height: 100%;
+    content: "";
+    border-radius: 50%;
+    background-color: var(--admin-color-icon);
+    mask-repeat: no-repeat;
+    mask-position: center center;
+    mask-image: url("data:image/svg+xml,%3csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3e  %3cg fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e    %3crect x='2' y='2' width='20' height='18' rx='4' ry='4'%3e%3c/rect%3e    %3cline x1='14' y1='2' x2='14' y2='20'%3e%3c/line%3e    %3cline x1='17.25' y1='7' x2='18.5' y2='7'%3e%3c/line%3e    %3cline x1='17.25' y1='11.5' x2='18.5' y2='11.5'%3e%3c/line%3e  %3c/g%3e%3c/svg%3e");
+    mask-size: var(--admin-icon-size-sidebar-toggle) var(--admin-icon-size-sidebar-toggle);
+  }
+
+  &:hover,
+  &:focus,
+  &.is-active,
+  &.is-active:hover {
+    background-color: var(--admin-color-primary-soft);
+
+    &::before {
+      background-color: var(--admin-color-primary);
+    }
+  }
+
+  &.is-active {
+    background-color: var(--admin-color-bg-item-hover);
+  }
+
+  @media (prefers-reduced-motion: no-preference) {
+    transition: background var(--admin-transition-slow);
+  }
+}
diff --git a/core/themes/default_admin/components/sidebar-toggle/sidebar-toggle.js b/core/themes/default_admin/components/sidebar-toggle/sidebar-toggle.js
new file mode 100644
index 0000000000000000000000000000000000000000..ac8760b4f6851c28a7eb14a2fda3beb869f1fc58
--- /dev/null
+++ b/core/themes/default_admin/components/sidebar-toggle/sidebar-toggle.js
@@ -0,0 +1,256 @@
+/**
+ * @file
+ * Interactions for the collapsible sidebar on entity edit forms.
+ *
+ * - Opens and closes the sidebar from the toggle button, the close button and
+ *   the overlay, and keeps the toggle's aria-expanded state in sync. Stores
+ *   values in localstorage.
+ * - Re-applies the state when the viewport crosses the large breakpoint, and
+ *   collapses the Navigation toolbar when the sidebar opens below the wide
+ *   breakpoint.
+ * - Below the large breakpoint, where the sidebar overlays the page: applies
+ *   focus trap, closes on Escape and returns focus when closed.
+ * - Measures Navigation control bar and top bar, and exposes their heights
+ *   as CSS variables on <html> so the sidebar sits below them.
+ */
+
+/* eslint-disable func-names, comma-dangle, strict */
+((Drupal, once) => {
+  // Matches the `--admin-large` custom media query, and the check in
+  // init.js that sets the initial sidebar state.
+  const largeQuery = window.matchMedia('(min-width: 64em)');
+  // Matches the `--admin-wide` custom media query.
+  const wideQuery = window.matchMedia('(min-width: 80em)');
+  const storageMobile = 'Drupal.defaultAdmin.sidebarExpanded.mobile';
+  const storageDesktop = 'Drupal.defaultAdmin.sidebarExpanded.desktop';
+  // Elements that stay interactive while the sidebar overlays the page.
+  const keepInteractive = '.meta-sidebar__overlay, [aria-live]';
+  // Elements made inert while the sidebar overlays the page, and the element
+  // that had focus before it opened.
+  let inertElements = [];
+  let returnFocusTo = null;
+
+  /**
+   * Makes an element inert, unless it is or contains one that must stay usable.
+   *
+   * @param {HTMLElement} el
+   *   The element to make inert.
+   */
+  const makeInert = (el) => {
+    if (el.inert || el.matches(`script, ${keepInteractive}`)) {
+      return;
+    }
+    // An inert element's descendants can't be re-enabled, so descend instead.
+    if (el.querySelector(keepInteractive)) {
+      [...el.children].forEach(makeInert);
+      return;
+    }
+    el.inert = true;
+    inertElements.push(el);
+  };
+
+  Drupal.behaviors.adminSidebar = {
+    attach: function attach(context) {
+      Drupal.adminSidebar.init(context);
+    },
+  };
+
+  Drupal.adminSidebar = {
+    init: function (context) {
+      once('adminSidebarInit', '#default_admin_sidebar', context).forEach(
+        () => {
+          // If variable does not exist, create it, default being to show sidebar.
+          if (!localStorage.getItem(storageDesktop)) {
+            localStorage.setItem(storageDesktop, 'true');
+          }
+
+          // Sync the toggle with the initial state, then re-run only when the
+          // viewport crosses the breakpoint.
+          this.handleResize();
+          largeQuery.addEventListener('change', () => this.handleResize());
+
+          // Escape closes the sidebar while it overlays the page. Handlers
+          // inside the sidebar, such as autocomplete, prevent the default
+          // when they use Escape themselves.
+          document.addEventListener('keydown', (e) => {
+            if (
+              e.key === 'Escape' &&
+              !e.defaultPrevented &&
+              inertElements.length
+            ) {
+              this.collapseSidebar();
+            }
+          });
+        },
+      );
+
+      // The sidebar is positioned below Navigation's control bar and top bar
+      // using CSS fallback heights. The top bar grows when its content wraps,
+      // and the control bar is hidden on desktop, so expose their measured
+      // heights whenever they change.
+      once('adminSidebarTopBar', '.admin--navigation-top-bar', context).forEach(
+        (topBar) => {
+          const bars = new Map([
+            [topBar, '--admin-theme-top-bar-height'],
+            [
+              document.querySelector('.admin-toolbar-control-bar'),
+              '--admin-theme-control-bar-height',
+            ],
+          ]);
+          const observer = new ResizeObserver((entries) => {
+            entries.forEach((entry) => {
+              document.documentElement.style.setProperty(
+                bars.get(entry.target),
+                `${entry.borderBoxSize[0].blockSize}px`,
+              );
+            });
+          });
+          bars.forEach((property, bar) => bar && observer.observe(bar));
+        },
+      );
+
+      // Toolbar toggle
+      once('adminSidebarToggle', '.meta-sidebar__trigger', context).forEach(
+        (el) =>
+          el.addEventListener('click', () => {
+            this.toggleSidebar();
+          }),
+      );
+
+      // Toolbar close
+      once(
+        'adminSidebarClose',
+        '.meta-sidebar__close, .meta-sidebar__overlay',
+        context,
+      ).forEach((el) =>
+        el.addEventListener('click', () => {
+          this.collapseSidebar();
+        }),
+      );
+    },
+
+    toggleSidebar: () => {
+      // Set active state.
+      if (
+        document
+          .querySelector('.meta-sidebar__trigger')
+          .classList.contains('is-active')
+      ) {
+        Drupal.adminSidebar.collapseSidebar();
+        Drupal.adminStickyFormActions?.hideMoreActions();
+      } else {
+        Drupal.adminSidebar.showSidebar();
+        Drupal.adminStickyFormActions?.hideMoreActions();
+      }
+    },
+
+    showSidebar: () => {
+      const chooseStorage = largeQuery.matches ? storageDesktop : storageMobile;
+      const sidebarTrigger = document.querySelector('.meta-sidebar__trigger');
+
+      sidebarTrigger?.setAttribute('aria-expanded', 'true');
+      sidebarTrigger?.classList.add('is-active');
+      // State lives on <html> because init.js sets the initial value from
+      // <head>, before <body> exists and before first paint.
+      document.documentElement.setAttribute('data-meta-sidebar', 'open');
+
+      // Expose to localStorage.
+      localStorage.setItem(chooseStorage, 'true');
+
+      // Check which toolbar is active.
+      if (!wideQuery.matches) {
+        Drupal.adminCoreNavigation?.collapseToolbar();
+      }
+
+      // Below the large breakpoint the sidebar overlays the page content.
+      if (largeQuery.matches) {
+        Drupal.adminSidebar.restoreCoveredContent(false);
+      } else {
+        Drupal.adminSidebar.inertCoveredContent();
+      }
+    },
+
+    collapseSidebar: () => {
+      const chooseStorage = largeQuery.matches ? storageDesktop : storageMobile;
+      const sidebarTrigger = document.querySelector('.meta-sidebar__trigger');
+
+      sidebarTrigger?.setAttribute('aria-expanded', 'false');
+      sidebarTrigger?.classList.remove('is-active');
+      document.documentElement.setAttribute('data-meta-sidebar', 'closed');
+
+      // Expose to localStorage.
+      localStorage.setItem(chooseStorage, 'false');
+
+      Drupal.adminSidebar.restoreCoveredContent(true);
+    },
+
+    inertCoveredContent: () => {
+      if (inertElements.length) {
+        return;
+      }
+      const sidebar = document.getElementById('default_admin_sidebar');
+      if (!sidebar) {
+        return;
+      }
+
+      // Make the content under the overlay inert, so keyboard and assistive
+      // technology users can't reach it. Walk up from the sidebar and make the
+      // siblings at each level inert, stopping at the main canvas. Navigation
+      // and the top bar are outside it and are not covered by the overlay, so
+      // they stay interactive.
+      const boundary =
+        sidebar.closest('.dialog-off-canvas-main-canvas') || document.body;
+      let node = sidebar;
+      while (node !== boundary && node.parentElement) {
+        [...node.parentElement.children].forEach((sibling) => {
+          if (sibling !== node) {
+            makeInert(sibling);
+          }
+        });
+        node = node.parentElement;
+      }
+
+      // Move focus into the sidebar. It comes before Navigation and the top
+      // bar in the DOM, so tabbing continues from the sidebar to those.
+      returnFocusTo = document.activeElement;
+      (sidebar.querySelector('.meta-sidebar__close') || sidebar).focus();
+    },
+
+    restoreCoveredContent: (returnFocus) => {
+      if (!inertElements.length) {
+        return;
+      }
+      inertElements.forEach((el) => {
+        el.inert = false;
+      });
+      inertElements = [];
+
+      // Return focus to where it was before the sidebar opened, normally the
+      // toggle, if focus was in the now hidden sidebar.
+      const sidebar = document.getElementById('default_admin_sidebar');
+      if (
+        returnFocus &&
+        returnFocusTo?.isConnected &&
+        (sidebar?.contains(document.activeElement) ||
+          document.activeElement === document.body)
+      ) {
+        returnFocusTo.focus();
+      }
+      returnFocusTo = null;
+    },
+
+    handleResize: () => {
+      // If small viewport, always collapse sidebar.
+      if (!largeQuery.matches) {
+        Drupal.adminSidebar.collapseSidebar();
+      } else {
+        // If large viewport, show sidebar if it was open before.
+        if (localStorage.getItem(storageDesktop) === 'true') {
+          Drupal.adminSidebar.showSidebar();
+        } else {
+          Drupal.adminSidebar.collapseSidebar();
+        }
+      }
+    },
+  };
+})(Drupal, once);
