diff --git a/core/themes/default_admin/components/sidebar-toggle/sidebar-toggle.twig b/core/themes/default_admin/components/sidebar-toggle/sidebar-toggle.twig
new file mode 100644
index 0000000000000000000000000000000000000000..3c4d8c68efe7b0224aa1452c15108f3484e51aef
--- /dev/null
+++ b/core/themes/default_admin/components/sidebar-toggle/sidebar-toggle.twig
@@ -0,0 +1,23 @@
+{#
+/**
+ * @file
+ * Sidebar toggle button.
+ *
+ * Available variables:
+ * - label: Visually hidden label and title attribute of the button.
+ * - controls: ID of the sidebar element the button toggles.
+ * - expanded: Initial expanded state of the sidebar.
+ * - attributes: Additional attributes for the button element.
+ */
+#}
+{%
+  set attributes = attributes
+    .setAttribute('type', 'button')
+    .setAttribute('title', label)
+    .setAttribute('aria-controls', controls)
+    .setAttribute('aria-expanded', expanded ? 'true' : 'false')
+    .addClass(['meta-sidebar__trigger', 'trigger'])
+%}
+<button{{ attributes }}>
+  <span class="visually-hidden">{{ label }}</span>
+</button>
