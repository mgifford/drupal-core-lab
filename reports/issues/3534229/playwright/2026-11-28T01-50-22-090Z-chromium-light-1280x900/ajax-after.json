        "selector": "#filter-settings-wrapper",
        "data": "<div id=\"filter-settings-wrapper\" data-drupal-wrapper-selector=\"edit-filter-settings\" class=\"js-form-item form-item js-form-type-vertical-tabs form-type--vertical-tabs js-form-item- form-item--\">\n            <label for=\"edit-filter-settings--4gdZLbezAR8\" class=\"form-item__label\">Filter settings</label>\n              <div data-drupal-selector=\"edit-filter-settings\" class=\"vertical-tabs__items\" data-vertical-tabs-panes><details data-drupal-selector=\"edit-filters-filter-html-settings\" class=\"vertical-tabs__item vertical-tabs__item--first js-form-wrapper form-wrapper details details--vertical-tabs-item\" id=\"edit-filters-filter-html-settings--f3nckmSSwGM\" open=\"open\">    <summary role=\"button\" aria-controls=\"edit-filters-filter-html-settings--f3nckmSSwGM\" aria-expanded=\"true\" class=\"details__summary details__summary--vertical-tabs-item\">Limit allowed HTML tags and correct faulty HTML</summary><div class=\"details__wrapper details-wrapper details__wrapper--vertical-tabs-item\">\n    <div class=\"details__content details__content--vertical-tabs-item\">\n      <div class=\"form-disabled js-form-item form-item js-form-type-textarea form-type--textarea js-form-item-filters-filter-html-settings-allowed-html form-item--filters-filter-html-settings-allowed-html\" data-drupal-wrapper-selector=\"edit-filters-filter-html-settings-allowed-html\">\n            <label for=\"edit-filters-filter-html-settings-allowed-html--e8eqIeByfv8\" class=\"form-item__label\">Allowed HTML tags</label>\n              <div class=\"form-textarea-wrapper\">\n  <textarea readonly data-drupal-selector=\"edit-filters-filter-html-settings-allowed-html\" aria-describedby=\"edit-filters-filter-html-settings-allowed-html--e8eqIeByfv8--description\" id=\"edit-filters-filter-html-settings-allowed-html--e8eqIeByfv8\" name=\"filters[filter_html][settings][allowed_html]\" rows=\"5\" cols=\"60\" class=\"form-textarea resize-vertical form-element form-element--type-textarea form-element--api-textarea\"></textarea>\n</div>\n\n              <div id=\"edit-filters-filter-html-settings-allowed-html--e8eqIeByfv8--description\" class=\"form-item__description\">\n      With CKEditor 5 this is a\n          read-only field. The allowed HTML tags and attributes are determined\n          by the CKEditor 5 configuration. Manually removing tags would break\n          enabled functionality, and any manually added tags would be removed by\n          CKEditor 5 on render.\n    </div>\n  </div>\n<div data-drupal-wrapper-selector=\"edit-filters-filter-html-settings-filter-html-help\" class=\"js-form-item form-item js-form-type-checkbox form-type--checkbox form-type--boolean js-form-item-filters-filter-html-settings-filter-html-help form-item--filters-filter-html-settings-filter-html-help\">\n            <input data-drupal-selector=\"edit-filters-filter-html-settings-filter-html-help\" type=\"checkbox\" id=\"edit-filters-filter-html-settings-filter-html-help--y_U0G6uwthc\" name=\"filters[filter_html][settings][filter_html_help]\" value=\"1\" checked=\"checked\" class=\"form-checkbox form-boolean form-boolean--type-checkbox\"/>\n\n              <label for=\"edit-filters-filter-html-settings-filter-html-help--y_U0G6uwthc\" class=\"form-item__label option\">Display basic HTML help in long filter tips</label>\n            </div>\n<div data-drupal-wrapper-selector=\"edit-filters-filter-html-settings-filter-html-nofollow\" class=\"js-form-item form-item js-form-type-checkbox form-type--checkbox form-type--boolean js-form-item-filters-filter-html-settings-filter-html-nofollow form-item--filters-filter-html-settings-filter-html-nofollow\">\n            <input data-drupal-selector=\"edit-filters-filter-html-settings-filter-html-nofollow\" type=\"checkbox\" id=\"edit-filters-filter-html-settings-filter-html-nofollow--MvSXo6Mskfk\" name=\"filters[filter_html][settings][filter_html_nofollow]\" value=\"1\" class=\"form-checkbox form-boolean form-boolean--type-checkbox\"/>\n\n              <label for=\"edit-filters-filter-html-settings-filter-html-nofollow--MvSXo6Mskfk\" class=\"form-item__label option\">Add rel=\"nofollow\" to all links</label>\n            </div>\n</div>\n  </div>\n</details>\n<details data-drupal-selector=\"edit-filters-filter-url-settings\" class=\"vertical-tabs__item vertical-tabs__item--last js-form-wrapper form-wrapper details details--vertical-tabs-item\" id=\"edit-filters-filter-url-settings--lqd5ZuykSgQ\" open=\"open\">    <summary role=\"button\" aria-controls=\"edit-filters-filter-url-settings--lqd5ZuykSgQ\" aria-expanded=\"true\" class=\"details__summary details__summary--vertical-tabs-item\">Convert URLs into links</summary><div class=\"details__wrapper details-wrapper details__wrapper--vertical-tabs-item\">\n    <div class=\"details__content details__content--vertical-tabs-item\">\n      <div data-drupal-wrapper-selector=\"edit-filters-filter-url-settings-filter-url-length\" class=\"js-form-item form-item js-form-type-number form-type--number js-form-item-filters-filter-url-settings-filter-url-length form-item--filters-filter-url-settings-filter-url-length\">\n            <label for=\"edit-filters-filter-url-settings-filter-url-length--8PgtY52463I\" class=\"form-item__label\">Maximum link text length</label>\n                <input data-drupal-selector=\"edit-filters-filter-url-settings-filter-url-length\" aria-describedby=\"edit-filters-filter-url-settings-filter-url-length--8PgtY52463I--description\" type=\"number\" id=\"edit-filters-filter-url-settings-filter-url-length--8PgtY52463I\" name=\"filters[filter_url][settings][filter_url_length]\" value=\"72\" step=\"1\" min=\"1\" class=\"form-number form-element form-element--type-number form-element--api-number\"/>\n      <span class=\"form-item__suffix\">characters</span>\n              <div id=\"edit-filters-filter-url-settings-filter-url-length--8PgtY52463I--description\" class=\"form-item__description\">\n      URLs longer than this number of characters will be truncated to prevent long strings that break formatting. The link itself will be retained; just the text portion of the link will be truncated.\n    </div>\n  </div>\n</div>\n  </div>\n</details>\n  <input class=\"vertical-tabs__active-tab\" data-drupal-selector=\"edit-filter-settings-filter-settings-active-tab\" type=\"hidden\" name=\"filter_settings[filter_settings__active_tab]\" value=\"edit-filters-filter-url-settings\"/></div>\n\n          </div>\n",
