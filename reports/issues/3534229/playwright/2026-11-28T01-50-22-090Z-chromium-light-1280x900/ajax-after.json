        "method": "replaceWith",
        "selector": "#plugin-settings-wrapper",
        "data": "<div id=\"plugin-settings-wrapper\" data-drupal-wrapper-selector=\"edit-editor-settings-plugin-settings\" class=\"js-form-item form-item js-form-type-vertical-tabs form-type--vertical-tabs js-form-item- form-item--\">\n            <label for=\"edit-editor-settings-plugin-settings--ma-fmwt_oJs\" class=\"form-item__label\">CKEditor 5 plugin settings</label>\n              <div data-drupal-selector=\"edit-editor-settings-plugin-settings\" class=\"vertical-tabs__items\" data-vertical-tabs-panes><details data-ckeditor5-plugin-id=\"ckeditor5_heading\" data-drupal-selector=\"edit-editor-settings-plugins-ckeditor5-heading\" class=\"vertical-tabs__item vertical-tabs__item--first js-form-wrapper form-wrapper details details--vertical-tabs-item\" id=\"edit-editor-settings-plugins-ckeditor5-heading--UIUihzKrAtc\" open=\"open\">    <summary role=\"button\" aria-controls=\"edit-editor-settings-plugins-ckeditor5-heading--UIUihzKrAtc\" aria-expanded=\"true\" class=\"details__summary details__summary--vertical-tabs-item\">Headings</summary><div class=\"details__wrapper details-wrapper details__wrapper--vertical-tabs-item\">\n    <div class=\"details__content details__content--vertical-tabs-item\">\n      <fieldset data-drupal-selector=\"edit-editor-settings-plugins-ckeditor5-heading-enabled-headings\" aria-describedby=\"edit-editor-settings-plugins-ckeditor5-heading-enabled-headings--A88xqavEVho--description\" id=\"edit-editor-settings-plugins-ckeditor5-heading-enabled-headings--A88xqavEVho\" class=\"fieldset js-form-item form-item js-form-wrapper form-wrapper\">\n          <legend class=\"fieldset__legend fieldset__legend--visible\">\n      <span class=\"fieldset__label\">Enabled Headings</span>\n    </legend>\n      <div class=\"fieldset__wrapper\">\n        \n            <div data-drupal-wrapper-selector=\"edit-editor-settings-plugins-ckeditor5-heading-enabled-headings-heading1\" class=\"js-form-item form-item js-form-type-checkbox form-type--checkbox form-type--