image--Jx5zUnnu-xM\" aria-expanded=\"true\" class=\"details__summary details__summary--vertical-tabs-item\">Image</summary><div class=\"details__wrapper details-wrapper details__wrapper--vertical-tabs-item\">\n    <div class=\"details__content details__content--vertical-tabs-item\">\n      <div data-drupal-wrapper-selector=\"edit-editor-settings-plugins-ckeditor5-image-status\" class=\"js-form-item form-item js-form-type-checkbox form-type--checkbox form-type--boolean js-form-item-editor-settings-plugins-ckeditor5-image-status form-item--editor-settings-plugins-ckeditor5-image-status\">\n            <input data-editor-image-upload=\"status\" data-drupal-selector=\"edit-editor-settings-plugins-ckeditor5-image-status\" aria-describedby=\"edit-editor-settings-plugins-ckeditor5-image-status--WtfxfV3EVIU--description\" type=\"checkbox\" id=\"edit-editor-settings-plugins-ckeditor5-image-status--WtfxfV3EVIU\" name=\"editor[settings][plugins][ckeditor5_image][status]\" value=\"1\" checked=\"checked\" class=\"form-checkbox form-boolean form-boolean--type-checkbox\"/>\n\n              <label for=\"edit-editor-settings-plugins-ckeditor5-image-status--WtfxfV3EVIU\" class=\"form-item__label option\">Enable image uploads</label>\n                <div id=\"edit-editor-settings-plugins-ckeditor5-image-status--WtfxfV3EVIU--description\" class=\"form-item__description\">\n      When enabled, images can only be uploaded. When disabled, images can only be added by URL.\n    </div>\n  </div>\n<div data-drupal-wrapper-selector=\"edit-editor-settings-plugins-ckeditor5-image-directory\" class=\"js-form-item form-item js-form-type-textfield form-type--textfield js-form-item-editor-settings-plugins-ckeditor5-image-directory form-item--editor-settings-plugins-ckeditor5-image-directory\">\n            <label for=\"edit-editor-settings-plugins-ckeditor5-image-directory--PgToKXSo6fY\" class=\"form-item__label\">Upload directory</label>\n                <input data-drupal-selector=\"edit-editor-settings-plugins-ckeditor5-image-directory\" aria-describedby=\"edit-editor-settings-plugins-ckeditor5-image-directory--PgToKXSo6fY--description\" type=\"text\" id=\"edit-editor-settings-plugins-ckeditor5-image-directory--PgToKXSo6fY\" name=\"editor[settings][plugins][ckeditor5_image][directory]\" value=\"inline-images\" size=\"60\" maxlength=\"128\" class=\"form-text form-element form-element--type-text form-element--api-textfield\" data-drupal-states=\"{&quot;visible&quot;:{&quot;:input[data-editor-image-upload=\\u0022status\\u0022]&quot;:{&quot;checked&quot;:true}}}\"/>\n              <div id=\"edit-editor-settings-plugins-ckeditor5-image-director…(cut)",
