ings-plugins-ckeditor5-heading-enabled-headings-heading5 form-item--editor-settings-plugins-ckeditor5-heading-enabled-headings-heading5\">\n            <input data-drupal-selector=\"edit-editor-settings-plugins-ckeditor5-heading-enabled-headings-heading5\" type=\"checkbox\" id=\"edit-editor-settings-plugins-ckeditor5-heading-enabled-headings-heading5--8YYM3Cg5ZBc\" name=\"editor[settings][plugins][ckeditor5_heading][enabled_headings][heading5]\" value=\"heading5\" checked=\"checked\" class=\"form-checkbox form-boolean form-boolean--type-checkbox\"/>\n\n              <label class=\"ck-heading_heading5 ck form-item__label option\" for=\"edit-editor-settings-plugins-ckeditor5-heading-enabled-headings-heading5--8YYM3Cg5ZBc\">Heading 5</label>\n            </div>\n<div data-drupal-wrapper-selector=\"edit-editor-settings-plugins-ckeditor5-heading-enabled-headings-heading6\" class=\"js-form-item form-item js-form-type-checkbox form-type--checkbox form-type--boolean js-form-item-editor-settings-plugins-ckeditor5-heading-enabled-headings-heading6 form-item--editor-settings-plugins-ckeditor5-heading-enabled-headings-heading6\">\n            <input data-drupal-selector=\"edit-editor-settings-plugins-ckeditor5-heading-enabled-headings-heading6\" type=\"checkbox\" id=\"edit-editor-settings-plugins-ckeditor5-heading-enabled-headings-heading6--Q8iEJ9OO0Pc\" name=\"editor[settings][plugins][ckeditor5_heading][enabled_headings][heading6]\" value=\"heading6\" checked=\"checked\" class=\"form-checkbox form-boolean form-boolean--type-checkbox\"/>\n\n              <label class=\"ck-heading_heading6 ck form-item__label option\" for=\"edit-editor-settings-plugins-ckeditor5-heading-enabled-headings-heading6--Q8iEJ9OO0Pc\">Heading 6</label>\n            </div>\n\n                          <div id=\"edit-editor-settings-plugins-ckeditor5-heading-enabled-headings--A88xqavEVho--description\" data-drupal-field-elements=\"description\" class=\"fieldset__description\">These are the headings that will appear in the headings dropdown. If a heading is not chosen here, it does not necessarily mean the corresponding tag is disallowed in the text format.</div>\n      \n        </div>\n</fieldset>\n</div>\n  </div>\n</details>\n<details data-ckeditor5-plugin-id=\"ckeditor5_sourceEditing\" data-drupal-selector=\"edit-editor-settings-plugins-ckeditor5-sourceediting\" class=\"vertical-tabs__item js-form-wrapper form-wrapper details details--vertical-tabs-item\" id=\"edit-editor-settings-plugins-ckeditor5-sourceediting--UVzVK9bUdEw\" open=\"open\">    <summary role=\"button\" aria-controls=\"edit-editor-settings-plugins-ckeditor5-sourceediting--UVzVK9bUdEw\" aria-expanded=\"true\" class=\"details__summary details__summary--vertical-tabs-item\">Source editing</summary><div class=\"details__wrapper details-wrapper details__wrapper--vertical-tabs-item\">\n    <div class=\"details__content details__content--vertical-tabs-item\">\n      <div data-drupal-wrapper-selector=\"edit-editor-settings-plugins-ckeditor5-sourceediting-allowed-tags\" class=\"js-form-item form-item js-form-type-textarea form-type--textarea js-form-item-editor-settings-plugins-ckeditor5-sourceediting-allowed-tags form-item--editor-settings-plugins-ckeditor5-sourceediting-allowed-tags\">\n            <label for=\"edit-editor-settings-plugins-ckeditor5-sourceediting-allowed-tags--fnyOGecScpM\" class=\"form-item__label\">Manually editable HTML tags</label>\n              <div class=\"form-textarea-wrapper\">\n  <textarea data-drupal-selector=\"edit-editor-settings-plugins-ckeditor5-sourceediting-allowed-tags\" aria-describedby=\"edit-editor-settings-plugins-ckeditor5-sourceediting-allowed-tags--fnyOGecScpM--description\" data-refocus-blur=\"true\" id=\"edit-editor-settings-plugins-ckeditor5-sourceediting-allowed-tags--fnyOGecScpM\" name=\"editor[settings][plugins][ckeditor5_sourceEditing][allowed_tags]\" rows=\"5\" cols=\"60\" class=\"form-textarea resize-vertical form-element form-element--type-textarea form-element--api-textarea\"></textarea>\n</div>\n\n              <div id=\"edit-editor-settings-plugins-ckeditor5-sourceediting-allowed-tags--fnyOGecScpM--description\" class=\"form-item__description\">\n      A list of HTML tags that can be used while editing source. It is only necessary to add tags that are not already supported by other enabled plugins. For example, if \"Bold\" is enabled, it is not necessary to add the <code>&lt;strong&gt;</code> tag, but it may be necessary to add <code>&lt;dl&gt;&lt;dt&gt;&lt;dd&gt;</code> in a format that does not have a definition list plugin, but requires definition list markup.\n    </div>\n  </div>\n</div>\n  </div>\n</details>\n<details data-ckeditor5-plugin-id=\"ckeditor5_codeBlock\" data-drupal-selector=\"edit-editor-settings-plugins-ckeditor5-codeblock\" class=\"vertical-tabs__item js-form-wrapper form-wrapper details details--vertical-tabs-item\" id=\"edit-editor-settings-plugins-ckeditor5-codeblock--EU-CmHg1-bc\" open=\"open\">    <summary role=\"button\" aria-controls=\"edit-editor-settings-plugins-ckeditor5-codeblock--EU-CmHg1-bc\" aria-expanded=\"true\" class=\"details__summary details__summary--vertical-tabs-item\">Code Block</summary><div class=\"details__wrapper details-wrapper details__wrapper--vertical-tabs-item\">\n    <div class=\"details__content details__content--vertical-tabs-item\">\n      <div data-drupal-wrapper-selector=\"edit-editor-settings-plugins-ckeditor5-codeblock-languages\" class=\"js-form-item form-item js-form-type-textarea form-type--textarea js-form-item-editor-settings-plugins-ckeditor5-codeblock-languages form-item--editor-settings-plugins-ckeditor5-codeblock-languages\">\n            <label for=\"edit-editor-settings-plugins-ckeditor5-codeblock-languages--9VIm2eunQlo\" class=\"form-item__label\">Programming languages</label>\n              <div class=\"form-textarea-wrapper\">\n  <textarea data-drupal-selector=\"edit-editor-settings-plugins-ckeditor5-codeblock-languages\" aria-describ