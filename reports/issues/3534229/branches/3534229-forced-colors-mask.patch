 .ckeditor5-toolbar-button-alignment {
@@ -43,3 +63,35 @@
   right: 10px;
   background-position-x: 10px;
 }
+
+@media (forced-colors: active) {
+  @container style(--ckeditor5-toolbar-icon) {
+    /*
+     * The alignment dropdown carries both an icon and a ::after caret. A mask
+     * on the control itself would clip the caret, so the icon moves to the free
+     * ::before surface and the caret keeps its forced CanvasText border.
+     */
+    .ckeditor5-toolbar-item .ckeditor5-toolbar-button.ckeditor5-toolbar-button-alignment,
+    .ckeditor5-toolbar-item .ckeditor5-toolbar-button.ckeditor5-toolbar-button-alignment:hover {
+      position: relative;
+      background-color: transparent;
+      background-image: none;
+      mask-image: none;
+    }
+
+    .ckeditor5-toolbar-button-alignment::before {
+      position: absolute;
+      inset: 0;
+      content: "";
+      background-color: CanvasText;
+      mask-image: var(--ckeditor5-toolbar-icon);
+      mask-repeat: no-repeat;
+      mask-position: 10px center;
+      mask-size: 20px;
+    }
+
+    [dir="rtl"] .ckeditor5-toolbar-button-alignment::before {
+      mask-position: 30px center;
+    }
+  }
+}
