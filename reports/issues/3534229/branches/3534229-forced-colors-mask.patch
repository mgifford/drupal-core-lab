diff --git a/core/modules/ckeditor5/css/toolbar.admin.css b/core/modules/ckeditor5/css/toolbar.admin.css
index 40b04dd951244e04e41468289d5ce8a86f137361..f049a2eba70ff92e327ba8c396efb35406b2c924 100644
--- a/core/modules/ckeditor5/css/toolbar.admin.css
+++ b/core/modules/ckeditor5/css/toolbar.admin.css
@@ -97,3 +97,50 @@
 .ckeditor5-toolbar-button[data-expanded="true"] + .ckeditor5-toolbar-tooltip {
   visibility: visible;
 }
+
+@media (forced-colors: active) {
+  /*
+   * Forced colors are the user's chosen palette: a theme-level dark-mode color
+   * filter (for example the one proposed in #3637246) must not invert them. The
+   * extra element raises specificity above `.dark-mode .ckeditor5-toolbar-button`.
+   */
+  .dark-mode .ckeditor5-toolbar-item .ckeditor5-toolbar-button {
+    filter: none;
+  }
+
+  @container style(--ckeditor5-toolbar-icon) {
+    /*
+     * Forced-colors mode keeps `url()` background images (only background
+     * images without a `url()` are forced to `none`), but an SVG keeps its
+     * baked-in black fill and disappears on a dark Canvas. Repaint the icon as
+     * a mask in the user's CanvasText instead. This applies only to toolbar
+     * items whose stylesheet defines --ckeditor5-toolbar-icon, so contributed
+     * plugins that only supply a background-image keep their current
+     * rendering. To opt in, a CKEditor 5 plugin's admin stylesheet defines the
+     * icon URL once:
+     *
+     * @code
+     * .ckeditor5-toolbar-item-myToolbarItem {
+     *   --ckeditor5-toolbar-icon: url(../icons/my-icon.svg);
+     * }
+     *
+     * .ckeditor5-toolbar-button-myToolbarItem {
+     *   background-image: var(--ckeditor5-toolbar-icon);
+     * }
+     * @endcode
+     */
+    .ckeditor5-toolbar-item .ckeditor5-toolbar-button {
+      background-color: CanvasText;
+      background-image: none;
+      mask-image: var(--ckeditor5-toolbar-icon);
+      mask-repeat: no-repeat;
+      mask-position: center;
+      mask-size: 20px;
+    }
+
+    /* Keep the icon painted when the pointer hovers the control. */
+    .ckeditor5-toolbar-item .ckeditor5-toolbar-button:hover {
+      background-color: CanvasText;
+    }
+  }
+}
