 namespace Drupal\text_summary_test\Hook;
 
+use Drupal\Core\Form\FormStateInterface;
 use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\Core\Render\Element;
 use Drupal\Core\State\StateInterface;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
 
 /**
  * Hook implementations for text_summary_test.
@@ -15,11 +18,51 @@ class TextSummaryTestHooks {
   public function __construct(protected readonly StateInterface $state) {}
 
   /**
- * Implements hook_page_attachments_alter().
- */
+   * Implements hook_page_attachments_alter().
+   */
   #[Hook('page_attachments_alter')]
   public function pageAttachmentsAlter(array &$attachments) : void {
     $attachments['#attached']['library'][] = 'text_summary_test/text-summary-override';
   }
 
+  /**
+   * Implements hook_form_alter().
+   *
+   * Adds a form validator that can put an error on an empty summary. The
+   * summary textarea only exists after the form has been built, so the error
+   * is added in a form #validate callback rather than in an element callback.
+   */
+  #[Hook('form_alter')]
+  public function formAlter(array &$form, FormStateInterface $form_state, $form_id): void {
+    if (str_starts_with($form_id, 'node_')) {
+      $form['#validate'][] = [static::class, 'validateForm'];
+    }
+  }
+
+  /**
+   * Sets an error on the summary field for a test-only title value.
+   */
+  public static function validateForm(array &$form, FormStateInterface $form_state): void {
+    if ($form_state->getValue(['title', 0, 'value']) === 'trigger-empty-summary-error') {
+      static::setSummaryError($form, $form_state);
+    }
+  }
+
+  /**
+   * Finds the first summary textarea and sets an error on it.
+   */
+  protected static function setSummaryError(array &$element, FormStateInterface $form_state): bool {
+    $parents = $element['#parents'] ?? [];
+    if (($element['#type'] ?? NULL) === 'textarea' && $parents !== [] && end($parents) === 'summary') {
+      $form_state->setError($element, new TranslatableMarkup('The summary validation error.'));
+      return TRUE;
+    }
+    foreach (Element::children($element) as $key) {
+      if (is_array($element[$key]) && static::setSummaryError($element[$key], $form_state)) {
+        return TRUE;
+      }
+    }
+    return FALSE;
+  }
+
 }
