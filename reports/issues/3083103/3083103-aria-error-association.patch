diff --git a/core/modules/inline_form_errors/src/FormErrorHandler.php b/core/modules/inline_form_errors/src/FormErrorHandler.php
index 2a449ab89da..6fe6fd9bec1 100644
--- a/core/modules/inline_form_errors/src/FormErrorHandler.php
+++ b/core/modules/inline_form_errors/src/FormErrorHandler.php
@@ -50,6 +50,113 @@ public function __construct(TranslationInterface $string_translation, RendererIn
     $this->messenger = $messenger;
   }
 
+  /**
+   * {@inheritdoc}
+   */
+  public function handleFormErrors(array &$form, FormStateInterface $form_state): static {
+    parent::handleFormErrors($form, $form_state);
+
+    if (!empty($form_state->getErrors()) && empty($form['#disable_inline_form_errors'])) {
+      $this->setElementInlineErrors($form);
+    }
+    return $this;
+  }
+
+  /**
+   * Sets inline errors on form elements.
+   *
+   * This method sets ARIA attributes on all form elements with errors,
+   * including table and tableselect elements. It ensures proper
+   * programmatic association of error messages with form controls.
+   *
+   * @param array $elements
+   *   An associative array of form elements.
+   */
+  protected function setElementInlineErrors(array &$elements): void {
+    foreach ($elements as &$element) {
+      if (!is_array($element)) {
+        continue;
+      }
+
+      // Recurse into children first.
+      $this->setElementInlineErrors($element);
+
+      // Process this element if it has errors and is not suppressed.
+      if (!empty($element['#errors']) && empty($element['#error_no_message'])) {
+        $error_id = static::getErrorId($element);
+
+        // Set aria-invalid on the element.
+        $element['#attributes']['aria-invalid'] = 'true';
+
+        // Set aria-errormessage to point to the error container.
+        $element['#attributes']['aria-errormessage'] = $error_id;
+
+        // Update aria-describedby to include the error ID as the first token.
+        $this->prependErrorToDescribedby($element, $error_id);
+      }
+    }
+  }
+
+  /**
+   * Sets inline errors on table and tableselect elements.
+   *
+   * The parent FormErrorHandler does not set inline errors on table and
+   * tableselect elements because they are compound elements. This method
+   * ensures they display inline errors via aria-describedby.
+   *
+   * @param array $elements
+   *   An associative array of form elements.
+   */
+  protected function setTableElementInlineErrors(array &$elements): void {
+    foreach ($elements as &$element) {
+      if (!is_array($element)) {
+        continue;
+      }
+
+      if (in_array($element['#type'] ?? NULL, ['table', 'tableselect'], TRUE)
+        && !empty($element['#errors'])
+        && empty($element['#error_no_message'])
+      ) {
+        $error_id = static::getErrorId($element);
+        $existing_prefix = (string) ($element['#prefix'] ?? '');
+
+        $error_markup = '<div id="' . $error_id . '" class="form-item--error-message">' . $element['#errors'] . '</div>';
+        $element['#prefix'] = $error_markup . $existing_prefix;
+
+        if (empty($element['#attributes']['aria-describedby'])) {
+          $element['#attributes']['aria-describedby'] = $error_id;
+        }
+        else {
+          $element['#attributes']['aria-describedby'] .= ' ' . $error_id;
+        }
+      }
+      else {
+        $this->setTableElementInlineErrors($element);
+      }
+    }
+  }
+
+  /**
+   * Prepends the error ID to aria-describedby.
+   *
+   * This method ensures the error ID is the first token in the
+   * aria-describedby attribute, preserving any existing description IDs.
+   *
+   * @param array &$element
+   *   The form element to update.
+   * @param string $error_id
+   *   The error message ID to prepend.
+   */
+  protected function prependErrorToDescribedby(array &$element, string $error_id): void {
+    $existing = $element['#attributes']['aria-describedby'] ?? '';
+    $tokens = preg_split('/\s+/', trim($existing));
+    $tokens = array_filter($tokens, function ($token) use ($error_id) {
+      return $token !== $error_id;
+    });
+    array_unshift($tokens, $error_id);
+    $element['#attributes']['aria-describedby'] = trim(implode(' ', $tokens));
+  }
+
   /**
    * Loops through and displays all form errors.
    *
