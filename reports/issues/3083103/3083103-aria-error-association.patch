+  /**
+   * Tests that ARIA attributes are set correctly on elements with errors.
+   */
+  public function testAriaAttributesSetCorrectly(): void {
+    $form_state = new FormState();
+    $form_state->setErrorByName('test1', 'invalid');
+    $this->formErrorHandler->handleFormErrors($this->testForm, $form_state);
+
+    // Assert aria-invalid is set.
+    $this->assertSame('true', $this->testForm['test1']['#attributes']['aria-invalid']);
+    // Assert aria-errormessage is set.
+    $this->assertSame('edit-test1--error-message', $this->testForm['test1']['#attributes']['aria-errormessage']);
+    // Assert aria-describedby contains the error ID as the first token.
+    $this->assertSame('edit-test1--error-message', $this->testForm['test1']['#attributes']['aria-describedby']);
+  }
+
+  /**
+   * Tests that aria-describedby preserves existing descriptions.
+   */
+  public function testAriaDescribedbyPreservesExistingDescriptions(): void {
+    $this->testForm['test1']['#description'] = 'Help text for test1';
+    $this->testForm['test1']['#attributes']['aria-describedby'] = 'edit-test1--description';
+
+    $form_state = new FormState();
+    $form_state->setErrorByName('test1', 'invalid');
+    $this->formErrorHandler->handleFormErrors($this->testForm, $form_state);
+
+    // Assert aria-describedby has error ID first, then description ID.
+    $this->assertSame('edit-test1--error-message edit-test1--description', $this->testForm['test1']['#attributes']['aria-describedby']);
+  }
+
+  /**
