   use MessengerTrait;
 
+  /**
+   * Resolves the error message ID for a form element.
+   *
+   * The ID is used for:
+   * - The `id` attribute on the error message container.
+   * - The `aria-errormessage` attribute on the form control.
+   * - The first token in the `aria-describedby` attribute when present.
+   *
+   * @param array $element
+   *   The form element array.
+   *
+   * @return string
+   *   The error message ID.
+   */
+  public static function getErrorId(array $element): string {
+    if (!empty($element['#error_id'])) {
+      return $element['#error_id'];
+    }
+    if (!empty($element['#id'])) {
+      return $element['#id'] . '--error-message';
+    }
+    // Fallback for elements without an ID.
+    return 'form-error-' . substr(md5(serialize($element['#array_parents'] ?? [])), 0, 12);
+  }
+
