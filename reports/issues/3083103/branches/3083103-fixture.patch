 class FormTestController extends ControllerBase {
 
+  /**
+   * Returns one or two instances of the error association test form.
+   *
+   * @param string $variant
+   *   'single', 'two' (two instances on one page) or 'no-ife'.
+   *
+   * @return array
+   *   A render array.
+   */
+  public function errorAssociationForms($variant = 'single') {
+    $return = [];
+    if ($variant === 'two') {
+      $return['form_one'] = $this->formBuilder()->getForm(FormTestErrorAssociationForm::class, 'one', FALSE);
+      $return['form_two'] = $this->formBuilder()->getForm(FormTestErrorAssociationForm::class, 'two', FALSE);
+    }
+    else {
+      $return['form'] = $this->formBuilder()->getForm(FormTestErrorAssociationForm::class, 'single', $variant === 'no-ife');
+    }
+    return $return;
+  }
