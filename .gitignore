# Core checkouts and per-patch environments are disposable. Reports are not.
envs/*
!envs/README.md
# A second clone made inside this one by mistake (scripts/test-mr.mjs says so): keep it out of `git status` and `git stash -u`.
/drupal-core-lab/
node_modules/
vendor/
.DS_Store
.playwright-mcp/
test-results/
playwright-report/
# Never commit credentials
.env
.env.*
*.token
*gitlab-token*
# Playwright/browser session state holds live cookies
*auth-state*.json
**/storageState*.json

# Built bundles (regenerate with scripts/make-bundle.mjs)
dist/

# axe-core is installed from npm at setup time, not committed
tools/compare/.deps/
tools/playwright/node_modules/
.lab-viewer.*
.lab-browser/

# Complete issue snapshots (scripts/issue-intake.mjs); the manifest and comment index in reports/ are what is committed
.lab-cache/

# Raw design snapshots; retain compressed evidence instead.
/reports/issues/*/playwright/*/design/observations*.json

# Written by `ddev coder-setup` in a DDEV Coder workspace: per workspace, regenerated by scripts/cloud-bootstrap.mjs
tools/compare/site/.ddev/config.coder.yaml
tools/compare/site/.ddev/docker-compose.coder-*.yaml
tools/compare/cloud/*/.ddev/config.coder.yaml
tools/compare/cloud/*/.ddev/docker-compose.coder-*.yaml
