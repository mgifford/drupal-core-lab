# Core checkouts and per-patch environments are disposable. Reports are not.
envs/*
!envs/README.md
node_modules/
vendor/
.DS_Store
.playwright-mcp/
test-results/
playwright-report/
# Never commit credentials
.env
.env.*
*.token
*gitlab-token*
# Playwright/browser session state holds live cookies
*auth-state*.json
**/storageState*.json

# Built bundles (regenerate with scripts/make-bundle.mjs)
dist/

# axe-core is installed from npm at setup time, not committed
tools/compare/.deps/
tools/playwright/node_modules/
.lab-viewer.*
.lab-browser/
