{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mgifford/drupal-core-lab/tools/compare/issue-status.schema.json",
  "title": "Drupal Core Lab issue status snapshot",
  "description": "Version 1. The state scripts/issue-status.mjs last saw on drupal.org and GitLab. Extra fields are preserved: older snapshots and hand-written notes may add information this schema does not map yet.",
  "type": "object",
  "required": ["nid", "title", "url", "status", "statusCode"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "nid": { "type": "string", "pattern": "^[0-9]{1,8}$" },
    "title": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "pattern": "^https?://" },
    "status": { "type": "string", "minLength": 1 },
    "statusCode": { "type": ["integer", "null"] },
    "priority": { "type": ["string", "null"] },
    "category": { "type": ["string", "null"] },
    "component": { "type": ["string", "null"] },
    "version": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "changed": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "since": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "comments": { "type": ["integer", "null"], "minimum": 0 },
    "latest": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "mr": { "$ref": "#/$defs/mr" },
    "otherMrs": { "type": "array", "items": { "$ref": "#/$defs/mr" } }
  },
  "$defs": {
    "mr": {
      "type": ["object", "null"],
      "required": ["iid"],
      "additionalProperties": true,
      "properties": {
        "iid": { "type": ["integer", "null"], "minimum": 1 },
        "state": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "sha": { "type": ["string", "null"] },
        "updated": { "type": ["string", "null"] },
        "draft": { "type": ["boolean", "null"] },
        "url": { "type": ["string", "null"] }
      }
    }
  }
}
