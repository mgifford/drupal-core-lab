{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mgifford/drupal-core-lab/tools/compare/contributions.schema.json",
  "title": "Drupal Core Lab contribution record",
  "description": "Version 1. A concise, human-curated account of who originated an idea, what AI added or got wrong, which approaches were rejected and what remains uncertain. It is not a commit-author inference engine.",
  "type": "object",
  "required": ["schemaVersion", "issue", "entries"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "issue": { "type": "string", "pattern": "^[0-9]{5,8}$" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "kind", "by", "what", "date"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^K[0-9]{3}$" },
        "kind": {
          "enum": ["human-origin", "inherited-decision", "ai-addition", "ai-test-discovery", "human-correction", "rejected-ai-approach", "human-decision", "independent-verification", "uncertainty"]
        },
        "by": { "type": "string", "minLength": 1 },
        "what": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "links": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "verified_by_human": { "type": ["boolean", "null"] },
        "note": { "type": ["string", "null"] },
        "history": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    }
  }
}
