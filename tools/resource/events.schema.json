            },
            "repeated_targets": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "repeated_lookups": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "failed_searches": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "exploration_after_failure": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "exploration_after_edit": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "loop_sequences": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "code_map_calls": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "unique_files": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "result_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
