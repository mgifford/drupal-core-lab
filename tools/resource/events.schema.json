                ]
              },
              "subcategory": {
                "enum": [
                  "source_discovery",
                  "symbol_lookup",
                  "reference_tracing",
                  "dependency_investigation",
                  "test_discovery",
                  "issue_history",
                  "failure_investigation",
                  "documentation_lookup",
                  "history_investigation",
                  "change_inspection",
                  "repeated_lookup",
                  "exploration_other",
                  null
                ]
              }
            }
          }
        },
        "exploration": {
          "type": "object",
