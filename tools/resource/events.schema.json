{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mgifford/drupal-core-lab/tools/resource/events.schema.json",
  "title": "Drupal Core Lab resource accounting event",
  "description": "Version 1.0.0. One normalized measurement from one source. Missing values are null and described in quality.missing; zero is a real measured zero. Provider-reported, measured, derived and estimated values are kept distinct.",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "recorded_at",
    "occurred_at",
    "project",
    "issue",
    "variant",
    "task",
    "activity",
    "tool",
    "model",
    "provider",
    "environment",
    "outcome",
    "validation",
    "commit",
    "patch",
    "source",
    "measurements",
    "quality"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_type": {
      "enum": [
        "ai-usage",
        "process",
        "container",
        "github-actions",
        "prompt-size",
        "context-size",
        "budget",
        "monitoring",
        "manual",
        "ai-request"
      ]
    },
    "recorded_at": {
      "$ref": "#/$defs/timestamp"
    },
    "occurred_at": {
      "$ref": "#/$defs/timestamp"
    },
    "duration_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "issue": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9:_-]{1,40}$"
    },
    "variant": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9:._-]{1,80}$"
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "label",
        "execution_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "execution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            null,
            "issue-reproduction",
            "patch-development",
            "accessibility-evaluation",
            "tooling",
            "maintenance",
            "investigation",
            "documentation",
            "other"
          ]
        },
        "state": {
          "enum": [
            null,
            "planned",
            "in_progress",
            "blocked",
            "paused",
            "completed_claimed",
            "completed_verified",
            "abandoned",
            "unknown"
          ]
        },
        "expected_deliverable": {
          "enum": [
            null,
            "reproduction",
            "variant",
            "patch",
            "interdiff",
            "phpunit-test",
            "playwright-evidence",
            "accessibility-findings",
            "lighthouse-measurements",
            "comparison-evidence",
            "documentation",
            "issue-comment-draft",
            "investigation-report",
            "none",
            "other"
          ]
        },
        "verified": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "activity": {
      "enum": [
        "issue-intake",
        "issue-analysis",
        "code-exploration",
        "patch-development",
        "model-evaluation",
        "phpunit-execution",
        "playwright-testing",
        "accessibility-scanning",
        "lighthouse-testing",
        "validation",
        "environment-setup",
        "composer-install",
        "cache-rebuild",
        "documentation-generation",
        "resource-measurement",
        "github-actions",
        "infrastructure",
        "monitoring",
        "unknown"
      ]
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment": {
      "type": "object",
      "required": [
        "os",
        "node",
        "runner",
        "ddev",
        "docker"
      ],
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "runner": {
          "type": [
            "string",
            "null"
          ]
        },
        "ddev": {
          "type": [
            "string",
            "null"
          ]
        },
        "docker": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "outcome": {
      "enum": [
        "success",
        "failure",
        "cancelled",
        "partial",
        "unknown"
      ]
    },
    "validation": {
      "enum": [
        "passed",
        "failed",
        "not-run",
        "unknown"
      ]
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "patch": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "adapter",
        "method",
        "confidence",
        "reference"
      ],
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "measured",
            "provider-reported",
            "derived",
            "estimated",
            "unavailable"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "measurements": {
      "type": "object",
      "required": [
        "tokens",
        "cost",
        "tools",
        "context",
        "latency",
        "cpu",
        "memory",
        "io",
        "network",
        "github"
      ],
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "object",
          "required": [
            "input_total",
            "uncached_input",
            "output",
            "cache_creation",
            "cache_read",
            "reasoning",
            "model_requests",
            "token_basis"
          ],
          "additionalProperties": false,
          "properties": {
            "input_total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "uncached_input": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "output": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "cache_creation": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "cache_read": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "reasoning": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "model_requests": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "token_basis": {
              "enum": [
                "provider-reported",
                "estimated",
                "unavailable"
              ]
            }
          }
        },
        "cost": {
          "type": "object",
          "required": [
            "reported_usd",
            "estimated_usd",
            "basis",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "reported_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "estimated_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "basis": {
              "enum": [
                "provider-reported",
                "client-reported-estimate",
                "estimated",
                "subscription-allowance",
                "unavailable"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "tools": {
          "type": "object",
          "required": [
            "invocations",
            "result_bytes",
            "repeated_reads",
            "errors"
          ],
          "additionalProperties": false,
          "properties": {
            "invocations": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "result_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "repeated_reads": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "errors": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "context": {
          "type": "object",
          "required": [
            "start_tokens",
            "average_tokens",
            "growth_tokens"
          ],
          "additionalProperties": false,
          "properties": {
            "start_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "average_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "growth_tokens": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "latency": {
          "type": "object",
          "required": [
            "api_ms",
            "tool_ms"
          ],
          "additionalProperties": false,
          "properties": {
            "api_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "tool_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "cpu": {
          "type": "object",
          "required": [
            "user_seconds",
            "system_seconds",
            "total_seconds",
            "cpu_percent",
            "measurement",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "user_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "system_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "total_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "cpu_percent": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "measurement": {
              "enum": [
                "measured",
                "sampled",
                "derived",
                "unavailable"
              ]
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "memory": {
          "type": "object",
          "required": [
            "peak_rss_bytes",
            "peak_container_bytes",
            "peak_php_mb",
            "measurement"
          ],
          "additionalProperties": false,
          "properties": {
            "peak_rss_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "peak_container_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "peak_php_mb": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "measurement": {
              "enum": [
                "measured",
                "sampled",
                "unavailable"
              ]
            }
          }
        },
        "io": {
          "type": "object",
          "required": [
            "read_ops",
            "write_ops",
            "read_bytes",
            "write_bytes",
            "measurement"
          ],
          "additionalProperties": false,
          "properties": {
            "read_ops": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "write_ops": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "read_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "write_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "measurement": {
              "enum": [
                "measured",
                "sampled",
                "derived",
                "unavailable"
              ]
            }
          }
        },
        "network": {
          "type": "object",
          "required": [
            "rx_bytes",
            "tx_bytes",
            "measurement"
          ],
          "additionalProperties": false,
          "properties": {
            "rx_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "tx_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "measurement": {
              "enum": [
                "measured",
                "sampled",
                "unavailable"
              ]
            }
          }
        },
        "github": {
          "type": "object",
          "required": [
            "workflow",
            "job",
            "event",
            "runner",
            "attempt",
            "potentially_superseded",
            "billable_minutes",
            "queue_seconds"
          ],
          "additionalProperties": false,
          "properties": {
            "workflow": {
              "type": [
                "string",
                "null"
              ]
            },
            "job": {
              "type": [
                "string",
                "null"
              ]
            },
            "event": {
              "type": [
                "string",
                "null"
              ]
            },
            "runner": {
              "type": [
                "string",
                "null"
              ]
            },
            "attempt": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "potentially_superseded": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "billable_minutes": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "queue_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "allocations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "activity",
              "tokens",
              "cpu_seconds",
              "method"
            ],
            "additionalProperties": false,
            "properties": {
              "activity": {
                "$ref": "#/$defs/activity"
              },
              "tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "cpu_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "enum": [
                  "unrecognized_tool",
                  "unrecognized_command",
                  "compound_command",
                  "ambiguous_activity",
                  "missing_tool_details",
                  "model_only_request",
                  "missing_task",
                  "missing_issue",
                  "incomplete_transcript",
                  "unsupported_client",
                  "missing_usage",
                  "parser_error",
                  "unclassified_other",
