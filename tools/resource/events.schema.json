                "enum": [
                  "unrecognized_tool",
                  "unrecognized_command",
                  "compound_command",
                  "ambiguous_activity",
                  "missing_tool_details",
                  "model_only_request",
                  "missing_task",
                  "missing_issue",
                  "incomplete_transcript",
                  "unsupported_client",
                  "missing_usage",
                  "parser_error",
                  "unclassified_other"
                ]
              },
